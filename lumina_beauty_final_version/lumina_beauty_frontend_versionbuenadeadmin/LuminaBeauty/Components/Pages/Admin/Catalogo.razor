@page "/admin/catalogo"
@layout AdminLayout

@using LuminaBeauty.Components.Layout
@using LuminaBeauty.Models
@using LuminaBeauty.Services
@using LuminaBeauty.Servicios.REST

@inject ProductoRestService ProductoRestService
@inject AuthService Auth
@inject NavigationManager Navigation

<div class="admin-page">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1" style="color: #6a3849;">Catálogo</h2>
            <p class="text-muted mb-0">
                Administra los productos disponibles en Lumina Beauty.
            </p>
        </div>

        <button class="btn text-white px-4 py-2 rounded-3 shadow-sm"
                style="background-color: #6a3849;"
                @onclick="OpenAddProductModal">
            <i class="bi bi-plus-lg"></i>
            Nuevo producto
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show"
             role="alert">
            @mensaje

            <button type="button"
                    class="btn-close"
                    @onclick="ClearMessage">
            </button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <small class="text-muted fw-semibold">Total productos</small>
                <h2 class="fw-bold mb-0 mt-2">@Productos.Count</h2>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <small class="text-muted fw-semibold">Marcas activas</small>
                <h2 class="fw-bold mb-0 mt-2">@Marcas.Count</h2>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <small class="text-muted fw-semibold">Categorías</small>
                <h2 class="fw-bold mb-0 mt-2">@Categorias.Count</h2>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100"
                 style="background-color: #fdf5f5;">
                <small class="fw-semibold" style="color: #b02a37;">Sin stock</small>
                <h2 class="fw-bold mb-0 mt-2" style="color: #b02a37;">
                    @ZeroStockCount
                </h2>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4">

        <div class="row g-3 mb-4 pb-4 border-bottom">
            <div class="col-12 col-md-4">
                <label class="form-label text-muted small fw-bold text-uppercase">
                    Producto
                </label>

                <input type="text"
                       class="form-control bg-light"
                       placeholder="Buscar por nombre..."
                       value="@FiltroProducto"
                       @oninput="OnFiltroProductoChanged" />
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label text-muted small fw-bold text-uppercase">
                    Categoría
                </label>

                <select class="form-select bg-light"
                        @bind="SelectedCategoryId">
                    <option value="0">Todas las categorías</option>

                    @foreach (var categoria in Categorias)
                    {
                        <option value="@categoria.IdCategoria">
                            @categoria.Nombre
                        </option>
                    }
                </select>
            </div>

            <div class="col-12 col-md-2">
                <label class="form-label text-muted small fw-bold text-uppercase">
                    Tipo de piel
                </label>

                <select class="form-select bg-light"
                        @bind="SelectedSkinType">
                    <option value="">Todos</option>

                    @foreach (var tipo in TiposPiel)
                    {
                        <option value="@tipo">@tipo</option>
                    }
                </select>
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label text-muted small fw-bold text-uppercase">
                    Marca
                </label>

                <select class="form-select bg-light"
                        @bind="SelectedBrandId">
                    <option value="0">Todas las marcas</option>

                    @foreach (var marca in Marcas)
                    {
                        <option value="@marca.IdMarca">
                            @marca.Nombre
                        </option>
                    }
                </select>
            </div>
        </div>

        @if (cargando)
        {
            <div class="text-center py-5 text-muted">
                Cargando catálogo...
            </div>
        }
        else if (!PagedProducts.Any())
        {
            <div class="text-center py-5 text-muted">
                No se encontraron productos.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Producto</th>
                            <th>Categoría</th>
                            <th>Marca</th>
                            <th>Tipo de piel</th>
                            <th>Precio</th>
                            <th>Stock</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int numeroFila = ((paginaActual - 1) * productosPorPagina) + 1;
                        }

                        @foreach (var producto in PagedProducts)
                        {
                            <tr>
                                <td>@numeroFila</td>

                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-3 overflow-hidden border"
                                             style="width: 48px; height: 48px; background-color: #f8f9fa;">
                                            @if (!string.IsNullOrWhiteSpace(producto.Imagen))
                                            {
                                                <img src="@producto.Imagen"
                                                     alt="@producto.Nombre"
                                                     class="w-100 h-100 object-fit-cover" />
                                            }
                                            else
                                            {
                                                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                                                    <i class="bi bi-image"></i>
                                                </div>
                                            }
                                        </div>

                                        <div>
                                            <div class="fw-semibold text-dark">
                                                @producto.Nombre
                                            </div>

                                            <small class="text-muted">
                                                @producto.Sku
                                            </small>
                                        </div>
                                    </div>
                                </td>

                                <td>@(producto.Categoria?.Nombre ?? "-")</td>
                                <td>@(producto.Marca?.Nombre ?? "-")</td>
                                <td>@(producto.TipoPiel ?? "-")</td>
                                <td class="fw-semibold">S/ @producto.Precio.ToString("F2")</td>

                                <td>
                                    <span class="badge rounded-pill text-dark"
                                          style="background-color: @GetStockBgColor(producto.Stock);">
                                        @producto.Stock uds.
                                    </span>
                                </td>

                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-danger"
                                            title="Eliminar producto"
                                            @onclick="() => DeleteProduct(producto)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>

                            numeroFila++;
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3">
                <small class="text-muted">
                    Mostrando @FirstVisibleProduct - @LastVisibleProduct de @TotalFilteredProducts productos
                </small>

                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary"
                            disabled="@(paginaActual == 1)"
                            @onclick="PreviousPage">
                        <i class="bi bi-chevron-left"></i>
                    </button>

                    <span class="px-2 py-1 text-muted">
                        @paginaActual / @TotalPages
                    </span>

                    <button class="btn btn-sm btn-outline-secondary"
                            disabled="@(paginaActual >= TotalPages)"
                            @onclick="NextPage">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<AddProductModal @bind-IsVisible="showAddProductModal"
                 OnProductAdded="OnProductAdded"
                 Categorias="Categorias"
                 Marcas="Marcas"
                 TiposPiel="TiposPiel" />

@code {
    private List<Producto> Productos = new();
    private List<CategoriaProducto> Categorias = new();
    private List<Marca> Marcas = new();

    private readonly List<string> TiposPiel = new()
    {
        "Normal",
        "Seca",
        "Grasa",
        "Mixta",
        "Sensible"
    };

    private bool cargando = true;
    private bool showAddProductModal;

    private int paginaActual = 1;
    private const int productosPorPagina = 7;

    private int _selectedCategoryId;
    private int _selectedBrandId;
    private string _selectedSkinType = string.Empty;

    private int SelectedCategoryId
    {
        get => _selectedCategoryId;
        set
        {
            _selectedCategoryId = value;
            paginaActual = 1;
        }
    }

    private int SelectedBrandId
    {
        get => _selectedBrandId;
        set
        {
            _selectedBrandId = value;
            paginaActual = 1;
        }
    }

    private string SelectedSkinType
    {
        get => _selectedSkinType;
        set
        {
            _selectedSkinType = value;
            paginaActual = 1;
        }
    }
    private string _filtroProducto = string.Empty;

    private string FiltroProducto
    {
        get => _filtroProducto;
        set
        {
            _filtroProducto = value;
            paginaActual = 1;
        }
    }

    private string mensaje = string.Empty;
    private bool esError;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAdmin)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        cargando = true;

        try
        {
            Productos = await ProductoRestService.ListarProductosTodosAsync();
            Categorias = await ProductoRestService.ListarCategoriasAsync();
            Marcas = await ProductoRestService.ListarMarcasAsync();

            foreach (var producto in Productos)
            {
                if (producto.Categoria != null)
                {
                    producto.Categoria = Categorias.FirstOrDefault(c =>
                        c.IdCategoria == producto.Categoria.IdCategoria);
                }

                if (producto.Marca != null)
                {
                    producto.Marca = Marcas.FirstOrDefault(m =>
                        m.IdMarca == producto.Marca.IdMarca);
                }
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"No se pudo cargar el catálogo: {ex.Message}", true);
        }
        finally
        {
            cargando = false;
        }
    }

    private IEnumerable<Producto> FilteredProducts =>
        Productos
            .Where(producto =>
                string.IsNullOrWhiteSpace(FiltroProducto)
|| producto.Nombre.Contains(
    FiltroProducto,
                    StringComparison.OrdinalIgnoreCase
                ))
            .Where(producto =>
                SelectedCategoryId == 0
                || producto.Categoria?.IdCategoria == SelectedCategoryId)
            .Where(producto =>
                SelectedBrandId == 0
                || producto.Marca?.IdMarca == SelectedBrandId)
            .Where(producto =>
                string.IsNullOrWhiteSpace(SelectedSkinType)
                || string.Equals(
                    producto.TipoPiel,
                    SelectedSkinType,
                    StringComparison.OrdinalIgnoreCase
                ));

    private IEnumerable<Producto> PagedProducts =>
        FilteredProducts
            .Skip((paginaActual - 1) * productosPorPagina)
            .Take(productosPorPagina);

    private int TotalFilteredProducts => FilteredProducts.Count();

    private int TotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(TotalFilteredProducts / (double)productosPorPagina)
        );

    private int ZeroStockCount =>
        Productos.Count(producto => producto.Stock <= 0);

    private int FirstVisibleProduct =>
        TotalFilteredProducts == 0
            ? 0
            : ((paginaActual - 1) * productosPorPagina) + 1;

    private int LastVisibleProduct =>
        Math.Min(paginaActual * productosPorPagina, TotalFilteredProducts);

    private void OpenAddProductModal()
    {
        showAddProductModal = true;
    }

    private async Task OnProductAdded(Producto producto)
    {
        var productoRegistrado =
            await ProductoRestService.RegistrarProductoAsync(producto);

        if (productoRegistrado == null)
        {
            ShowMessage("No se pudo registrar el producto.", true);
            return;
        }

        showAddProductModal = false;
        ShowMessage("Producto registrado correctamente.", false);

        await CargarDatosAsync();
    }

    private async Task DeleteProduct(Producto producto)
    {
        int resultado =
            await ProductoRestService.EliminarProductoAsync(producto.IdProducto);

        if (resultado == 0)
        {
            ShowMessage("No se pudo eliminar el producto.", true);
            return;
        }

        ShowMessage("Producto eliminado correctamente.", false);

        await CargarDatosAsync();
    }

    private void PreviousPage()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
        }
    }

    private void NextPage()
    {
        if (paginaActual < TotalPages)
        {
            paginaActual++;
        }
    }

    private void ShowMessage(string text, bool error)
    {
        mensaje = text;
        esError = error;
    }

    private void ClearMessage()
    {
        mensaje = string.Empty;
    }

    private static string GetStockBgColor(int stock)
    {
        if (stock <= 0)
        {
            return "#f8d7da";
        }

        if (stock <= 12)
        {
            return "#fff3cd";
        }

        return "#d1e7dd";
    }

    private void OnFiltroProductoChanged(ChangeEventArgs e)
    {
        FiltroProducto = e.Value?.ToString() ?? string.Empty;
    }
}