@page "/admin/pedidos"
@layout AdminLayout

@using LuminaBeauty.Models
@using LuminaBeauty.Services
@using LuminaBeauty.Servicios.REST

@inject PedidoRestService PedidoRestService
@inject ClienteRestService ClienteRestService
@inject AuthService Auth
@inject NavigationManager Navigation

<div class="admin-page">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1" style="color: #6a3849;">Pedidos</h2>
            <p class="text-muted mb-0">
                Consulta y actualiza el estado de los pedidos registrados.
            </p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @mensaje
            <button type="button" class="btn-close" @onclick="ClearMessage"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <small class="text-muted fw-semibold">Total de pedidos</small>
                <h2 class="fw-bold mt-2 mb-0">@TodosLosPedidos.Count</h2>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <small class="text-muted fw-semibold">Pendientes</small>
                <h2 class="fw-bold mt-2 mb-0" style="color: #fd7e14;">
                    @PedidosPendientes
                </h2>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <small class="text-muted fw-semibold">Enviados</small>
                <h2 class="fw-bold mt-2 mb-0" style="color: #0d6efd;">
                    @PedidosEnviados
                </h2>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <small class="text-muted fw-semibold">Ingresos registrados</small>
                <h2 class="fw-bold mt-2 mb-0">
                    S/ @IngresosRegistrados.ToString("N2")
                </h2>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4">
        <div class="row g-3 mb-4 pb-4 border-bottom">
            <div class="col-12 col-md-4">
                <label class="form-label text-muted small fw-bold text-uppercase">
                    Código o ID de pedido
                </label>

                <input type="text"
                       class="form-control bg-light"
                       placeholder="Ej. ORD-0001 o 15"
                       value="@FiltroPedido"
                       @oninput="OnFiltroPedidoChanged" />
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label text-muted small fw-bold text-uppercase">
                    Cliente
                </label>

                <input type="text"
                       class="form-control bg-light"
                       placeholder="Buscar por nombre..."
                       value="@FiltroCliente"
                       @oninput="OnFiltroClienteChanged" />
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label text-muted small fw-bold text-uppercase">
                    Estado
                </label>

                <select class="form-select bg-light" @bind="FiltroEstado">
                    <option value="">Todos los estados</option>
                    <option value="PENDIENTE">Pendiente</option>
                    <option value="CONFIRMADO">Confirmado</option>
                    <option value="EN_PROCESO">En proceso</option>
                    <option value="ENVIADO">Enviado</option>
                    <option value="ENTREGADO">Entregado</option>
                    <option value="CANCELADO">Cancelado</option>
                </select>
            </div>
        </div>

        @if (cargando)
        {
            <div class="text-center py-5 text-muted">
                Cargando pedidos...
            </div>
        }
        else if (!PedidosPaginados.Any())
        {
            <div class="text-center py-5 text-muted">
                No se encontraron pedidos.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Pedido</th>
                            <th>Cliente</th>
                            <th>Estado</th>
                            <th>Total</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int numeroFila = ((paginaActual - 1) * pedidosPorPagina) + 1;
                        }

                        @foreach (var pedido in PedidosPaginados)
                        {
                            <tr>
                                <td>@numeroFila</td>

                                <td>
                                    <div class="fw-semibold">
                                        @(string.IsNullOrWhiteSpace(pedido.CodigoPedido)
                                            ? $"Pedido #{pedido.IdPedido}"
                                            : pedido.CodigoPedido)
                                    </div>

                                    <small class="text-muted">
                                        ID: @pedido.IdPedido
                                    </small>
                                </td>

                                <td>
                                    <div class="fw-semibold">
                                        @NombreCliente(pedido.Cliente)
                                    </div>

                                    <small class="text-muted">
                                        @(pedido.Cliente?.Correo ?? "-")
                                    </small>
                                </td>

                                <td>
                                    <span class="badge rounded-pill text-dark"
                                          style="background-color: @GetEstadoBgColor(pedido.Estado);">
                                        @FormatoEstado(pedido.Estado)
                                    </span>
                                </td>

                                <td class="fw-semibold">
                                    S/ @pedido.Total.ToString("F2")
                                </td>

                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => VerPedido(pedido)">
                                        <i class="bi bi-eye"></i>
                                        Detalles
                                    </button>
                                </td>
                            </tr>

                            numeroFila++;
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3">
                <small class="text-muted">
                    Mostrando @PrimeroVisible - @UltimoVisible de @TotalPedidosFiltrados pedidos
                </small>

                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary"
                            disabled="@(paginaActual == 1)"
                            @onclick="PreviousPage">
                        <i class="bi bi-chevron-left"></i>
                    </button>

                    <span class="px-2 py-1 text-muted">
                        @paginaActual / @TotalPaginas
                    </span>

                    <button class="btn btn-sm btn-outline-secondary"
                            disabled="@(paginaActual >= TotalPaginas)"
                            @onclick="NextPage">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@if (mostrarDetalle && pedidoSeleccionado != null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.45);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-bottom-0 px-4 pt-4">
                    <div>
                        <h5 class="modal-title fw-bold" style="color: #6a3849;">
                            Detalle del pedido
                        </h5>

                        <p class="text-muted small mb-0">
                            @(string.IsNullOrWhiteSpace(pedidoSeleccionado.CodigoPedido)
                                ? $"Pedido #{pedidoSeleccionado.IdPedido}"
                                : pedidoSeleccionado.CodigoPedido)
                        </p>
                    </div>

                    <button type="button"
                            class="btn-close"
                            @onclick="CerrarDetalle">
                    </button>
                </div>

                <div class="modal-body px-4 py-3">
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <small class="text-muted text-uppercase fw-bold">
                                Cliente
                            </small>

                            <div class="fw-semibold mt-1">
                                @NombreCliente(pedidoSeleccionado.Cliente)
                            </div>

                            <small class="text-muted">
                                @(pedidoSeleccionado.Cliente?.Correo ?? "-")
                            </small>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted text-uppercase fw-bold">
                                Estado actual
                            </small>

                            <div class="mt-1">
                                <span class="badge rounded-pill text-dark"
                                      style="background-color: @GetEstadoBgColor(pedidoSeleccionado.Estado);">
                                    @FormatoEstado(pedidoSeleccionado.Estado)
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="border rounded-4 p-3 bg-light mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal de productos</span>
                            <strong>S/ @pedidoSeleccionado.SubtotalProductos.ToString("F2")</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Costo de envío</span>
                            <strong>S/ @pedidoSeleccionado.CostoEnvio.ToString("F2")</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Descuento</span>
                            <strong>- S/ @pedidoSeleccionado.Descuento.ToString("F2")</strong>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between fs-5">
                            <strong>Total</strong>
                            <strong style="color: #6a3849;">
                                S/ @pedidoSeleccionado.Total.ToString("F2")
                            </strong>
                        </div>
                    </div>

                    <div>
                        <label class="form-label fw-semibold">
                            Cambiar estado del pedido
                        </label>

                        <select class="form-select" @bind="nuevoEstado">
                            <option value="PENDIENTE">Pendiente</option>
                            <option value="CONFIRMADO">Confirmado</option>
                            <option value="EN_PROCESO">En proceso</option>
                            <option value="ENVIADO">Enviado</option>
                            <option value="ENTREGADO">Entregado</option>
                            <option value="CANCELADO">Cancelado</option>
                        </select>
                    </div>
                </div>

                <div class="modal-footer border-top-0 px-4 pb-4">
                    <button type="button"
                            class="btn btn-light border"
                            @onclick="CerrarDetalle">
                        Cerrar
                    </button>

                    <button type="button"
                            class="btn text-white"
                            style="background-color: #6a3849;"
                            @onclick="GuardarEstadoAsync">
                        Guardar estado
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Pedido> TodosLosPedidos = new();

    private bool cargando = true;
    private bool mostrarDetalle;

    private Pedido? pedidoSeleccionado;
    private string nuevoEstado = string.Empty;

    private int paginaActual = 1;
    private const int pedidosPorPagina = 8;

    private string _filtroPedido = string.Empty;
    private string _filtroCliente = string.Empty;
    private string _filtroEstado = string.Empty;

    private string FiltroPedido
    {
        get => _filtroPedido;
        set
        {
            _filtroPedido = value;
            paginaActual = 1;
        }
    }

    private string FiltroCliente
    {
        get => _filtroCliente;
        set
        {
            _filtroCliente = value;
            paginaActual = 1;
        }
    }

    private string FiltroEstado
    {
        get => _filtroEstado;
        set
        {
            _filtroEstado = value;
            paginaActual = 1;
        }
    }

    private string mensaje = string.Empty;
    private bool esError;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAdmin)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        await CargarPedidosAsync();
    }

    private async Task CargarPedidosAsync()
    {
        cargando = true;

        try
        {
            TodosLosPedidos = await PedidoRestService.ListarPedidosAsync();

            // Enriquecer clientes (el backend no incluye nombre/apellido en /listar)
            var cacheClientes = new Dictionary<int, Cliente>();
            foreach (var pedido in TodosLosPedidos)
            {
                if (pedido.Cliente == null || pedido.Cliente.Id <= 0) continue;
                if (!string.IsNullOrWhiteSpace(pedido.Cliente.Nombre)) continue;

                int idCliente = pedido.Cliente.Id;
                if (!cacheClientes.ContainsKey(idCliente))
                {
                    var c = await ClienteRestService.BuscarClienteAsync(idCliente);
                    if (c != null) cacheClientes[idCliente] = c;
                }

                if (cacheClientes.TryGetValue(idCliente, out var clienteCompleto))
                {
                    pedido.Cliente.Nombre = clienteCompleto.Nombre;
                    pedido.Cliente.Apellido = clienteCompleto.Apellido;
                    pedido.Cliente.Correo = clienteCompleto.Correo;
                }
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"No se pudieron cargar los pedidos: {ex.Message}", true);
        }
        finally
        {
            cargando = false;
        }
    }

    private void OnFiltroPedidoChanged(ChangeEventArgs e)
    {
        FiltroPedido = e.Value?.ToString() ?? string.Empty;
    }

    private void OnFiltroClienteChanged(ChangeEventArgs e)
    {
        FiltroCliente = e.Value?.ToString() ?? string.Empty;
    }

    private IEnumerable<Pedido> PedidosFiltrados =>
        TodosLosPedidos
            .Where(pedido =>
                string.IsNullOrWhiteSpace(FiltroPedido)
                || pedido.IdPedido.ToString().Contains(FiltroPedido)
                || pedido.CodigoPedido.Contains(
                    FiltroPedido,
                    StringComparison.OrdinalIgnoreCase
                ))
            .Where(pedido =>
                string.IsNullOrWhiteSpace(FiltroCliente)
                || NombreCliente(pedido.Cliente).Contains(
                    FiltroCliente,
                    StringComparison.OrdinalIgnoreCase
                ))
            .Where(pedido =>
                string.IsNullOrWhiteSpace(FiltroEstado)
                || string.Equals(
                    pedido.Estado,
                    FiltroEstado,
                    StringComparison.OrdinalIgnoreCase
                ));

    private IEnumerable<Pedido> PedidosPaginados =>
        PedidosFiltrados
            .Skip((paginaActual - 1) * pedidosPorPagina)
            .Take(pedidosPorPagina);

    private int TotalPedidosFiltrados => PedidosFiltrados.Count();

    private int TotalPaginas =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                TotalPedidosFiltrados / (double)pedidosPorPagina
            )
        );

    private int PrimeroVisible =>
        TotalPedidosFiltrados == 0
            ? 0
            : ((paginaActual - 1) * pedidosPorPagina) + 1;

    private int UltimoVisible =>
        Math.Min(paginaActual * pedidosPorPagina, TotalPedidosFiltrados);

    private int PedidosPendientes =>
        TodosLosPedidos.Count(pedido =>
            string.Equals(
                pedido.Estado,
                "PENDIENTE",
                StringComparison.OrdinalIgnoreCase
            ));

    private int PedidosEnviados =>
        TodosLosPedidos.Count(pedido =>
            string.Equals(
                pedido.Estado,
                "ENVIADO",
                StringComparison.OrdinalIgnoreCase
            ));

    private decimal IngresosRegistrados =>
        TodosLosPedidos
            .Where(pedido =>
                !string.Equals(
                    pedido.Estado,
                    "CANCELADO",
                    StringComparison.OrdinalIgnoreCase
                ))
            .Sum(pedido => pedido.Total);

    private void VerPedido(Pedido pedido)
    {
        pedidoSeleccionado = pedido;
        nuevoEstado = pedido.Estado;
        mostrarDetalle = true;
    }

    private void CerrarDetalle()
    {
        mostrarDetalle = false;
        pedidoSeleccionado = null;
        nuevoEstado = string.Empty;
    }

    private async Task GuardarEstadoAsync()
    {
        if (pedidoSeleccionado == null
            || string.IsNullOrWhiteSpace(nuevoEstado)
            || string.Equals(
                pedidoSeleccionado.Estado,
                nuevoEstado,
                StringComparison.OrdinalIgnoreCase
            ))
        {
            return;
        }

        var actualizado = await PedidoRestService.ActualizarEstadoPedidoAsync(
            pedidoSeleccionado.IdPedido,
            nuevoEstado
        );

        if (actualizado == null)
        {
            ShowMessage("No se pudo actualizar el estado del pedido.", true);
            return;
        }

        pedidoSeleccionado.Estado = actualizado.Estado;
        ShowMessage("Estado del pedido actualizado correctamente.", false);

        await CargarPedidosAsync();
        CerrarDetalle();
    }

    private void PreviousPage()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
        }
    }

    private void NextPage()
    {
        if (paginaActual < TotalPaginas)
        {
            paginaActual++;
        }
    }

    private void ShowMessage(string texto, bool error)
    {
        mensaje = texto;
        esError = error;
    }

    private void ClearMessage()
    {
        mensaje = string.Empty;
    }

    private static string NombreCliente(Cliente? cliente)
    {
        if (cliente == null)
        {
            return "Sin cliente";
        }

        return $"{cliente.Nombre} {cliente.Apellido}".Trim();
    }

    private static string FormatoEstado(string estado)
    {
        return estado switch
        {
            "EN_PROCESO" => "En proceso",
            "PENDIENTE" => "Pendiente",
            "CONFIRMADO" => "Confirmado",
            "ENVIADO" => "Enviado",
            "ENTREGADO" => "Entregado",
            "CANCELADO" => "Cancelado",
            _ => estado
        };
    }

    private static string GetEstadoBgColor(string estado)
    {
        return estado switch
        {
            "PENDIENTE" => "#f8d7da",
            "CONFIRMADO" => "#fff3cd",
            "EN_PROCESO" => "#fff3cd",
            "ENVIADO" => "#cff4fc",
            "ENTREGADO" => "#d1e7dd",
            "CANCELADO" => "#e2e3e5",
            _ => "#f8f9fa"
        };
    }
}