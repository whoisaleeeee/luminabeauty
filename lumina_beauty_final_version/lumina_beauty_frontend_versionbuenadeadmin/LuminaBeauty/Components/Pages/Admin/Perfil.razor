@page "/admin/perfil"
@layout AdminLayout

@using LuminaBeauty.Models
@using LuminaBeauty.Services

@inject AuthService Auth
@inject NavigationManager Navigation

<div class="admin-page">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1" style="color: #6a3849;">Mi perfil</h2>
            <p class="text-muted mb-0">
                Información de la cuenta administradora actual.
            </p>
        </div>
    </div>

    @if (EmpleadoActual is null)
    {
        <div class="alert alert-warning">
            No se encontró información del empleado autenticado.
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div style="height: 120px; background: linear-gradient(135deg, #fcf0f4 0%, #f7eff1 100%);"></div>

                    <div class="card-body px-4 pb-4 pt-0 text-center">
                        <div class="rounded-circle bg-white shadow d-inline-flex align-items-center justify-content-center"
                             style="width: 100px; height: 100px; margin-top: -50px;">
                            <i class="bi bi-person-fill fs-1" style="color: #6a3849;"></i>
                        </div>

                        <h4 class="fw-bold mt-3 mb-1">
                            @NombreCompleto
                        </h4>

                        <p class="text-muted small mb-3">
                            @EmpleadoActual.Rol
                        </p>

                        <span class="badge rounded-pill"
                              style="background-color: #d1e7dd; color: #198754;">
                            Activo
                        </span>

                        <div class="text-start border-top pt-4 mt-4">
                            <div class="mb-3">
                                <small class="text-muted d-block">Correo electrónico</small>
                                <span class="fw-semibold">@EmpleadoActual.Correo</span>
                            </div>

                            <div class="mb-3">
                                <small class="text-muted d-block">Teléfono</small>
                                <span class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(EmpleadoActual.Telefono)
                                        ? "No registrado"
                                        : EmpleadoActual.Telefono)
                                </span>
                            </div>

                            <div>
                                <small class="text-muted d-block">Documento</small>
                                <span class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(EmpleadoActual.Dni)
                                        ? "No registrado"
                                        : EmpleadoActual.Dni)
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                    <h5 class="fw-bold mb-4" style="color: #6a3849;">
                        Información personal
                    </h5>

                    <div class="row g-4">
                        <div class="col-12 col-md-6">
                            <label class="form-label text-muted small fw-bold text-uppercase">
                                Nombres
                            </label>

                            <input class="form-control bg-light"
                                   value="@EmpleadoActual.Nombre"
                                   readonly />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-muted small fw-bold text-uppercase">
                                Apellidos
                            </label>

                            <input class="form-control bg-light"
                                   value="@EmpleadoActual.Apellido"
                                   readonly />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-muted small fw-bold text-uppercase">
                                Correo electrónico
                            </label>

                            <input class="form-control bg-light"
                                   value="@EmpleadoActual.Correo"
                                   readonly />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-muted small fw-bold text-uppercase">
                                Rol
                            </label>

                            <input class="form-control bg-light"
                                   value="@EmpleadoActual.Rol"
                                   readonly />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-muted small fw-bold text-uppercase">
                                Teléfono
                            </label>

                            <input class="form-control bg-light"
                                   value="@EmpleadoActual.Telefono"
                                   readonly />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label text-muted small fw-bold text-uppercase">
                                DNI
                            </label>

                            <input class="form-control bg-light"
                                   value="@EmpleadoActual.Dni"
                                   readonly />
                        </div>
                    </div>

                    <div class="alert alert-light border mt-5 mb-0">
                        La edición del perfil y cambio de contraseña requieren endpoints
                        específicos para empleados. Esta vista muestra la sesión actual.
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private Empleado? EmpleadoActual => Auth.CurrentEmployee;

    private string NombreCompleto =>
        EmpleadoActual is null
            ? "Administrador"
            : $"{EmpleadoActual.Nombre} {EmpleadoActual.Apellido}".Trim();

    protected override void OnInitialized()
    {
        if (!Auth.IsAdmin)
        {
            Navigation.NavigateTo("/login", true);
        }
    }
}