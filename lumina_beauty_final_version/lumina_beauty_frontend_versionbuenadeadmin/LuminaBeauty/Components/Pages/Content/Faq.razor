@page "/faq"
@inject NavigationManager Navigator

<PageTitle>Preguntas frecuentes | Lumina Beauty</PageTitle>

<div class="mx-auto w-full max-w-6xl px-4 py-12 sm:px-6">

    <nav class="mb-8 flex items-center gap-2 text-xs font-semibold text-stone-400 select-none">
        <span class="cursor-pointer transition hover:text-[#C7346A]"
              @onclick='() => Navigator.NavigateTo("/")'>
            Inicio
        </span>

        <span class="text-stone-300">/</span>

        <span class="font-bold text-stone-600">
            Preguntas frecuentes
        </span>
    </nav>

    <section class="mt-8 rounded-[2rem] border border-stone-200/70 bg-white/85 p-7 shadow-sm sm:p-10">

        <div class="border-b border-stone-100 pb-6">
            <h1 class="mt-2 font-serif text-xl font-semibold text-stone-800 sm:text-xl">
                Preguntas frecuentes
            </h1>

            <p class="mt-2 text-xs leading-relaxed text-stone-500">
                Encuentra información sobre pedidos, entregas, productos y tu cuenta Lumina.
            </p>
        </div>

        <div class="mt-8 space-y-4">
            @for (int index = 0; index < _faqs.Count; index++)
            {
                var currentIndex = index;
                var item = _faqs[currentIndex];
                var isOpen = _openedFaqIndex == currentIndex;

                <article class="overflow-hidden rounded-2xl border border-stone-200 bg-stone-50/45 transition">
                    <button @onclick="() => ToggleFaq(currentIndex)"
                            class="flex w-full items-center justify-between gap-5 px-5 py-5 text-left transition hover:bg-[#FFF0F3]/60 cursor-pointer">

                        <span class="text-sm font-semibold text-stone-800">
                            @item.Question
                        </span>

                        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border transition @(isOpen
                                                          ? "border-[#FCD1DB] bg-[#FFF0F3] text-[#C7346A]"
                                                          : "border-stone-200 bg-white text-stone-400")">
            <svg class="h-4 w-4 transition-transform @(isOpen ? "rotate-45" : "")"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8">
                <path d="M12 5v14" />
                <path d="M5 12h14" />
            </svg>
        </span>
    </button>

    @if (isOpen)
    {
        <div class="border-t border-stone-100 bg-white px-5 py-5 text-sm leading-relaxed text-stone-600">
            @item.Answer
        </div>
    }
</article>
            }
</div>

<div class="mt-10 rounded-2xl border border-[#FCD1DB]/60 bg-[#FFF0F3]/35 px-6 py-5 sm:flex sm:items-center sm:justify-between">
    <div>
        <p class="text-sm font-semibold text-stone-800">
            ¿No encontraste la respuesta que necesitabas?
        </p>

        <p class="mt-1 text-xs text-stone-500">
            Nuestro equipo puede orientarte sobre pedidos, entregas o tu cuenta.
        </p>
    </div>

    <button @onclick='() => Navigator.NavigateTo("/contact")'
            class="mt-4 rounded-xl bg-stone-950 px-5 py-3 text-[10px] font-bold uppercase tracking-[0.14em] text-white transition hover:bg-[#C7346A] cursor-pointer sm:mt-0">
        Contactar soporte
    </button>
</div>
</section>
</div>

@code {
    private int _openedFaqIndex = -1;

    private class FaqItem
    {
        public string Question { get; set; } = string.Empty;
        public string Answer { get; set; } = string.Empty;
    }

    private readonly List<FaqItem> _faqs = new()
    {
        new()
        {
            Question = "¿Cómo puedo revisar el estado de mi pedido?",
            Answer = "Ingresa a Mi cuenta, abre la sección Mis pedidos y selecciona el pedido que deseas consultar. Podrás revisar el detalle de compra, el estado registrado y la información de seguimiento disponible."
        },
        new()
        {
            Question = "¿Cuánto demora la entrega de un pedido?",
            Answer = "El tiempo de entrega depende de la zona de envío y del estado de preparación del pedido. Cuando el envío haya sido registrado, podrás revisar la fecha estimada desde el detalle de tu pedido."
        },
        new()
        {
            Question = "¿Cómo actualizo mi dirección de entrega?",
            Answer = "Desde Mi cuenta, en Mis direcciones, puedes registrar nuevas direcciones, editar las existentes, elegir una dirección principal o eliminar las que ya no utilizarás."
        },
        new()
        {
            Question = "¿Cómo aplico un código de descuento?",
            Answer = "Cuando existan campañas activas, podrás ingresar el código durante el checkout. Antes de confirmar tu pedido, se mostrará si el cupón cumple las condiciones de vigencia, monto mínimo y disponibilidad."
        },
        new()
        {
            Question = "¿Los productos mostrados están disponibles?",
            Answer = "La disponibilidad se actualiza según el stock registrado. En la tienda puedes usar el filtro de productos con stock para ver únicamente alternativas disponibles."
        },
        new()
        {
            Question = "¿Cómo guardo productos para revisarlos después?",
            Answer = "Puedes usar el ícono de favoritos en cada producto. Los productos guardados aparecerán en Mi cuenta, dentro de la sección Mis favoritos."
        },
        new()
        {
            Question = "¿Cómo contacto a Lumina Beauty?",
            Answer = "Puedes escribir a ayuda@luminabeauty.com o comunicarte al (+51) 993 579 975 durante el horario de atención indicado en el footer."
        },
        new()
        {
            Question = "¿Puedo modificar un pedido después de confirmarlo?",
            Answer = "La modificación depende del estado operativo del pedido. Si necesitas ayuda, revisa primero el detalle del pedido y comunícate con soporte para evaluar las alternativas disponibles."
        }
    };

    private void ToggleFaq(int index)
    {
        _openedFaqIndex = _openedFaqIndex == index ? -1 : index;
    }
}