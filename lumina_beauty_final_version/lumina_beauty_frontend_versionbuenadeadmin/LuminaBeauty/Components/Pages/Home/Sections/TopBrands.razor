@inject ProductService ProductCache
@inject NavigationManager Navigator

<section class="py-10 border-y border-stone-200/60 overflow-hidden">
    <div class="flex items-end justify-between mb-6">
        <div>
            <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#c5a880]">
                Confianza y calidad
            </span>

            <h2 class="mt-2 font-serif text-2xl md:text-3xl text-stone-900">
                Marcas destacadas
            </h2>
        </div>
    </div>

    <div class="brand-marquee">
        <div class="brand-track">
            @foreach (var b in ProductCache.GetBrands())
            {
                <article class="brand-card">
                    <p>@b.Name</p>
                    <div></div>
                </article>
            }

            @foreach (var b in ProductCache.GetBrands())
            {
                <article class="brand-card">
                    <p>@b.Name</p>
                    <div></div>
                </article>
            }
        </div>
    </div>
</section>
