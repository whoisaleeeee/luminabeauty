@inject WishlistService Wishlist
@inject CartService Cart
@inject LayoutStateService LayoutState
@inject ToastService Toast
@inject LanguageService LangService
@inject NavigationManager Navigator
@implements IDisposable

<div class="group relative flex flex-col justify-between overflow-hidden bg-white/80 backdrop-blur-md rounded-3xl border border-stone-200/60 transition-all duration-500 hover:shadow-xl hover:shadow-pink-100/60 hover:-translate-y-1.5 h-full"
     id="product-card-@Product.Id">
    
    <div class="absolute top-4 left-4 z-10 flex flex-col gap-1.5">
        @if (!string.IsNullOrEmpty(Product.Discount))
        {
            <span class="px-3 py-1 font-sans text-[11px] font-bold tracking-wider text-white uppercase bg-[#FF76A5] rounded-xl shadow-sm">
                @Product.Discount
            </span>
        }
    </div>

    <div class="absolute top-4 right-4 z-10 flex flex-col gap-2 opacity-100 md:opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-x-2 group-hover:translate-x-0">
        <button @onclick="ToggleWishlist"
                class="p-2.5 rounded-full transition-all duration-300 shadow-sm hover:shadow cursor-pointer @(Wishlist.IsInWishlist(Product.Id) ? "bg-[#FF76A5] text-white" : "bg-white/90 hover:bg-[#FFF0F3] text-gray-500 hover:text-[#FF76A5]")"
                title="Añadir a deseos">
            <span class="text-xs">❤️</span>
        </button>

        <button @onclick="OpenQuickView"
                class="p-2.5 rounded-full bg-white/90 hover:bg-[#FFF0F3] text-gray-500 hover:text-[#FF76A5] transition-all duration-300 shadow-sm hover:shadow cursor-pointer"
                title="Vista rápida">
            <span class="text-xs">👁️</span>
        </button>
    </div>

    <div class="relative h-64 w-full bg-gradient-to-b from-[#FFF0F3]/30 to-transparent flex items-center justify-center p-6 overflow-hidden select-none cursor-pointer"
         @onclick="NavigateToDetail">
        <img src="@Product.Image"
             alt="@Product.Name"
             class="w-full h-full max-h-48 object-contain drop-shadow-md transition-transform duration-1000 group-hover:scale-105"
             referrerpolicy="no-referrer" />
        <div class="absolute bottom-0 inset-x-0 h-12 bg-gradient-to-t from-white to-transparent opacity-60 pointer-events-none" />
    </div>

    <div class="p-5 flex flex-col flex-1 justify-between text-left bg-white">
        <div>
            <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] font-bold tracking-widest text-[#c5a880] uppercase">
                    @Product.Brand
                </span>
                <span class="text-[10px] px-2.5 py-0.5 rounded-full bg-[#FFF0F3] text-[#C7346A] font-bold transform scale-95 origin-right">
                    @Product.Category
                </span>
            </div>

            <h3 @onclick="NavigateToDetail"
                class="text-stone-800 font-sans text-sm font-semibold leading-snug group-hover:text-[#FF76A5] transition-colors line-clamp-2 h-11 mb-2 cursor-pointer">
                @Product.Name
            </h3>

            <div class="flex items-center gap-1.5 mb-4">
                <div class="flex text-amber-400 gap-0.5">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var s = i;
                        <span class="text-xs">
                            <span class="@(s <= Math.Round(Product.Rating) ? "text-amber-400" : "text-gray-200")">★</span>
                        </span>
                    }
                </div>
                <span class="text-[11px] font-bold text-stone-600">@Product.Rating</span>
                <span class="text-[10px] text-stone-400">(@Product.ReviewsCount)</span>
            </div>
        </div>

        <div class="flex items-center justify-between pt-3 border-t border-stone-100">
            <div class="flex flex-col">
                @if (Product.OriginalPrice != null && Product.OriginalPrice > Product.Price)
                {
                    <span class="text-[11px] text-stone-400 line-through mb-0.5">
                        S/ @Product.OriginalPrice.Value.ToString("0.00")
                    </span>
                }
                <span class="text-base font-bold text-stone-900 font-mono">
                    S/ @Product.Price.ToString("0.00")
                </span>
            </div>

            <button @onclick="AddToCart"
                    class="w-10 h-10 rounded-xl border transition-all duration-300 flex items-center justify-center cursor-pointer shadow-sm @(_added ? "bg-green-600 border-green-600 text-white shadow-md shadow-green-100" : "bg-white hover:bg-[#FF76A5] border-stone-200 hover:border-[#FF76A5] text-stone-700 hover:text-white")"
                    title="Añadir directo">
                @if (_added)
                {
                    <span class="text-sm">✓</span>
                }
                else
                {
                    <span class="text-sm">🛒</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public Product Product { get; set; } = new();

    private bool _added;

    protected override void OnInitialized()
    {
        Wishlist.OnChange += StateHasChanged;
    }

    private async Task ToggleWishlist()
    {
        await Wishlist.ToggleWishlistAsync(Product.Id);
        var msg = Wishlist.IsInWishlist(Product.Id)
            ? (LangService.CurrentLanguage == "es" ? "Guardado en favoritos" : "Saved to wishlist")
            : (LangService.CurrentLanguage == "es" ? "Removido de favoritos" : "Removed from wishlist");
        
        Toast.ShowToast(msg);
    }

    private void OpenQuickView()
    {
        LayoutState.SetQuickViewProduct(Product);
    }

    private void NavigateToDetail()
    {
        Navigator.NavigateTo($"/product/{Product.Id}");
    }

    private async Task AddToCart()
    {
        await Cart.AddToCartAsync(Product, 1);
        _added = true;
        Toast.ShowToast(LangService.CurrentLanguage == "es" ? $"Agregado a la bolsa: {Product.Name}" : $"Added to bag: {Product.Name}");
        
        await Task.Delay(1800);
        _added = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        Wishlist.OnChange -= StateHasChanged;
    }
}