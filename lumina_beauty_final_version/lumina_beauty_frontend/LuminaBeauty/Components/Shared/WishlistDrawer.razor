@inject LayoutStateService LayoutState
@inject WishlistService Wishlist
@inject CartService Cart
@inject ProductService ProductCache
@inject LanguageService LangService
@inject ToastService Toast
@implements IDisposable

@if (LayoutState.IsWishlistDrawerOpen)
{
    <div class="fixed inset-0 z-50 flex justify-end bg-black/60 backdrop-blur-sm animate-in fade-in duration-300">
        <div class="absolute inset-0 -z-10" @onclick="CloseDrawer" />

        <div class="w-full max-w-md h-full bg-white/95 backdrop-blur-md shadow-2xl flex flex-col justify-between overflow-hidden animate-in slide-in-from-right duration-300">
            
            <!-- Drawer Header -->
            <div class="p-5 border-b border-stone-100 flex items-center justify-between bg-[#FFF0F3]/50">
              <div class="flex items-center gap-2 select-none">
                <h2 class="font-serif text-xl font-medium text-stone-900">
                  @(LangService.CurrentLanguage == "es" ? "Lista de Deseos" : "My Wishlist")
                </h2>
                <span class="bg-[#FFF0F3] text-[#C7346A] border border-[#FCD1DB] font-bold text-xs px-2 py-0.5 rounded-full font-mono">
                  @Wishlist.GetWishlist().Count
                </span>
              </div>

              <button @onclick="CloseDrawer"
                      class="p-2 hover:bg-stone-100 text-stone-400 hover:text-stone-700 rounded-full transition-colors cursor-pointer">
                <span class="text-md font-bold">✕</span>
              </button>
            </div>

            <!-- List content zone -->
            <div class="flex-1 overflow-y-auto p-5">
              @if (Wishlist.GetWishlist().Count == 0)
              {
                <div class="h-full flex flex-col items-center justify-center text-center select-none">
                  <div class="text-4xl mb-4 opacity-75 animate-pulse">✨</div>
                  <h3 class="font-serif text-lg font-medium text-stone-900 mb-2">
                    @(LangService.CurrentLanguage == "es" ? "Tu lista está vacía" : "Your list is empty")
                  </h3>
                  <p class="text-xs text-stone-400 max-w-xs mb-4">
                    @(LangService.CurrentLanguage == "es"
                      ? "Guarda tus productos favoritos para comprarlos después."
                      : "Save your favorite items to purchase them later.")
                  </p>
                </div>
              }
              else
              {
                <div class="space-y-4">
                  @foreach (var id in Wishlist.GetWishlist())
                  {
                    var prod = ProductCache.GetProductById(id);
                    if (prod != null)
                    {
                      <div class="flex gap-3 bg-white p-3 rounded-xl border border-stone-100 hover:border-[#FF76A5]/30 transition-all text-left">
                        <img src="@prod.Image" alt="@prod.Name" class="w-16 h-16 object-contain rounded-lg bg-stone-50 p-1 border pointer-events-none" referrerpolicy="no-referrer" />

                        <div class="flex-1 flex flex-col justify-between font-medium">
                          <div>
                            <div class="flex justify-between items-start">
                              <h4 class="text-xs font-semibold text-stone-800 line-clamp-1 pr-1.5">
                                @prod.Name
                              </h4>
                              <button @onclick="() => RemoveFromWishlist(prod.Id)"
                                      class="text-stone-400 hover:text-red-500 transition-colors cursor-pointer" title="Remover">
                                <span class="text-xs">🗑️</span>
                              </button>
                            </div>
                            <span class="text-[10px] text-stone-400 font-bold uppercase select-none">
                              @prod.Brand
                            </span>
                          </div>

                          <div class="flex justify-between items-center mt-1">
                            <span class="text-xs font-bold text-stone-950 font-mono">
                              S/ @prod.Price.ToString("0.00")
                            </span>
                            <button @onclick="() => MoveToBag(prod)"
                                    class="text-[10px] font-bold text-white bg-stone-900 hover:bg-[#FF76A5] px-3.5 py-1.5 rounded-lg transition select-none cursor-pointer">
                              @(LangService.CurrentLanguage == "es" ? "Agregar" : "Add")
                            </button>
                          </div>
                        </div>
                      </div>
                    }
                  }
                </div>
              }
            </div>

            <!-- Bottom CTA -->
            <div class="p-5 border-t border-stone-100 bg-stone-50/50 select-none">
              <button @onclick="CloseDrawer"
                      class="w-full bg-[#FF76A5] hover:bg-[#E6558A] py-3 rounded-xl font-bold uppercase tracking-wider text-xs text-white transition-all text-center cursor-pointer">
                @(LangService.CurrentLanguage == "es" ? "Volver a la tienda" : "Back to shop")
              </button>
            </div>

        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        LayoutState.OnChange += StateHasChanged;
        Wishlist.OnChange += StateHasChanged;
        LangService.OnChange += StateHasChanged;
    }

    private void CloseDrawer()
    {
        LayoutState.SetWishlistDrawerOpen(false);
    }

    private async Task RemoveFromWishlist(string productId)
    {
        await Wishlist.ToggleWishlistAsync(productId);
        Toast.ShowToast(LangService.CurrentLanguage == "es" ? "Removido de favoritos" : "Removed from wishlist");
    }

    private async Task MoveToBag(Product prod)
    {
        await Cart.AddToCartAsync(prod, 1);
        await Wishlist.ToggleWishlistAsync(prod.Id);
        Toast.ShowToast(LangService.CurrentLanguage == "es" ? $"Agregado a la bolsa: {prod.Name}" : $"Added to bag: {prod.Name}");
    }

    public void Dispose()
    {
        LayoutState.OnChange -= StateHasChanged;
        Wishlist.OnChange -= StateHasChanged;
        LangService.OnChange -= StateHasChanged;
    }
}
