@inherits LayoutComponentBase

@using LuminaBeauty.Services

@inject AuthService Auth
@inject NavigationManager Navigation

@if (_verificandoSesion)
{
    <div class="min-vh-100 d-flex align-items-center justify-content-center">
        <div class="text-center">
            <div class="spinner-border" style="color: #b87991;" role="status"></div>
            <p class="mt-3 text-muted mb-0">Verificando sesión...</p>
        </div>
    </div>
}
else if (Auth.IsAdmin)
{
    <div class="admin-shell admin-shell-ready">

        <aside class="admin-sidebar">

            <div class="admin-logo-section">
                <div class="admin-brand-button">
                    <span class="admin-brand-lumina">Lumina</span><span>Beauty</span>
                    <span class="admin-brand-dot"></span>
                </div>

                <span class="admin-brand-subtitle">Portal Administrativo</span>
            </div>

            <div class="admin-navigation-group">
                <div class="admin-menu-label">GESTIÓN</div>

                <nav class="admin-nav">
                    <NavLink href="/admin/catalogo" class="admin-nav-link">
                        <span class="admin-nav-icon">
                            <i class="bi bi-grid-1x2"></i>
                        </span>
                        <span>Catálogo</span>
                    </NavLink>

                    <NavLink href="/admin/inventario" class="admin-nav-link">
                        <span class="admin-nav-icon">
                            <i class="bi bi-box-seam"></i>
                        </span>
                        <span>Inventario</span>
                    </NavLink>

                    <NavLink href="/admin/pedidos" class="admin-nav-link">
                        <span class="admin-nav-icon">
                            <i class="bi bi-bag-check"></i>
                        </span>
                        <span>Pedidos</span>
                    </NavLink>

                    <NavLink href="/admin/reclamos" class="admin-nav-link">
                        <span class="admin-nav-icon">
                            <i class="bi bi-chat-square-text"></i>
                        </span>
                        <span>Reclamos</span>
                    </NavLink>

                    <NavLink href="/admin/valoraciones" class="admin-nav-link">
                        <span class="admin-nav-icon">
                            <i class="bi bi-star"></i>
                        </span>
                        <span>Valoraciones</span>
                    </NavLink>

                    <NavLink href="/admin/reportes" class="admin-nav-link">
                        <span class="admin-nav-icon">
                            <i class="bi bi-bar-chart-line"></i>
                        </span>
                        <span>Reportes</span>
                    </NavLink>
                </nav>
            </div>

            <div class="admin-navigation-group admin-navigation-group-system">
                <div class="admin-menu-label">SISTEMA</div>

                <nav class="admin-nav">
                    <NavLink href="/admin/configuracion" class="admin-nav-link">
                        <span class="admin-nav-icon">
                            <i class="bi bi-gear"></i>
                        </span>
                        <span>Configuración</span>
                    </NavLink>

                    <NavLink href="/admin/perfil" class="admin-nav-link">
                        <span class="admin-nav-icon">
                            <i class="bi bi-person-circle"></i>
                        </span>
                        <span>Mi perfil</span>
                    </NavLink>
                </nav>
            </div>

            <div class="admin-sidebar-footer">
                <button type="button"
                        class="admin-help-button"
                        onclick="window.location.href='/admin/ayuda'">
                    <i class="bi bi-question-circle"></i>
                    <span>Centro de ayuda</span>
                </button>

                <button type="button"
                        class="admin-logout-button"
                        @onclick="CerrarSesionAsync">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Cerrar sesión</span>
                </button>
            </div>

        </aside>

        <main class="admin-main">
            @Body
        </main>

    </div>
}

@code {
    private bool _verificandoSesion = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Auth.InitializeAsync();

        _verificandoSesion = false;

        if (!Auth.IsAdmin)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        StateHasChanged();
    }

    private async Task CerrarSesionAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/login", true);
    }
}