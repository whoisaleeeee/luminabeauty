@using Microsoft.AspNetCore.Components.Web

@inject LanguageService LangService
@inject LayoutStateService LayoutState
@inject CartService Cart
@inject WishlistService Wishlist
@inject AuthService Auth
@inject NavigationManager ListNavigate
@inject HeaderSearchAppService HeaderSearch
@inject ProductService ProductCache
@implements IDisposable

<header class="border-b border-[#F7E4EA] bg-white/85 backdrop-blur-xl">
    <div class="mx-auto flex h-[92px] max-w-[1440px] items-center gap-8 px-6 lg:px-8">
        
        <!-- Logo and search -->
        <div class="flex min-w-0 flex-1 items-center gap-7">
            <button @onclick="GoHome" class="font-serif text-2xl lg:text-3xl font-light tracking-tight text-stone-900 flex items-center gap-1.5 focus:outline-none shrink-0 cursor-pointer">
                <span class="text-[#FF76A5] font-bold">Lumina</span>Beauty
                <span class="w-1.5 h-1.5 bg-[#FF76A5] rounded-full" />
            </button>

            <!-- Search bar -->
            <div class="relative ml-5 hidden w-full max-w-[25rem] lg:flex">
                <input type="text"
                       value="@LayoutState.SearchQuery"
                       @oninput="OnSearchInputAsync"
                       @onkeydown="HandleSearchKeyDown"
                       @onfocus="OpenSearchResults"
                       placeholder="Busca productos, marcas o categorías"
                       class="w-full rounded-full border border-stone-200 bg-stone-50 py-3 pl-10 pr-10 text-xs text-stone-700 outline-none transition duration-300 placeholder:text-stone-400 hover:border-stone-300 focus:border-[#C7346A] focus:bg-white"/>

                <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-stone-400">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <circle cx="11" cy="11" r="6.5" />
                        <path d="m16 16 4 4" />
                    </svg>
                </span>

                @if (!string.IsNullOrWhiteSpace(LayoutState.SearchQuery))
                {
                    <button @onclick="ClearSearch"
                            class="absolute right-3 top-2 text-[10px] font-bold uppercase tracking-wider text-stone-400 transition hover:text-[#C7346A] cursor-pointer">
                        ×
                    </button>
                }

                @if (HeaderSearch.IsOpen)
                {
                    <div class="absolute left-0 right-0 top-[calc(100%+0.6rem)] z-50 overflow-hidden rounded-2xl border border-stone-100 bg-white shadow-xl">
                        @if (HeaderSearch.Results.Count == 0)
                        {
                            <div class="p-5 text-center">
                                <p class="text-xs font-bold text-stone-700">
                                    No encontramos productos.
                                </p>

                                <p class="mt-1 text-[10px] text-stone-400">
                                    Prueba con otro nombre, marca o categoría.
                                </p>
                            </div>
                        }
                        else
                        {
                            <div class="border-b border-stone-100 px-4 py-3">
                                <p class="text-[9px] font-black uppercase tracking-widest text-stone-400">
                                    Resultados sugeridos
                                </p>
                            </div>

                            <div class="max-h-[340px] overflow-y-auto p-2">
                                @foreach (var product in HeaderSearch.Results)
                                {
                                    <button @onclick="() => OpenProduct(product.Id)"
                                            class="flex w-full items-center gap-3 rounded-xl p-2.5 text-left transition hover:bg-[#FFF0F3] cursor-pointer">
                                        <div class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-stone-50">
                                            <img src="@product.Image"
                                                 alt="@product.Name"
                                                 class="h-full w-full object-contain p-1"
                                                 referrerpolicy="no-referrer" />
                                        </div>

                                        <div class="min-w-0 flex-1">
                                            <p class="truncate text-[10px] font-black uppercase tracking-wider text-[#C7346A]">
                                                @product.Brand
                                            </p>

                                            <p class="mt-0.5 truncate text-xs font-bold text-stone-800">
                                                @product.Name
                                            </p>

                                            <p class="mt-1 text-[11px] font-bold text-stone-600">
                                                S/ @product.Price.ToString("0.00")
                                            </p>
                                        </div>
                                    </button>
                                }
                            </div>

                            <button @onclick="OpenShopSearch"
                                    class="flex w-full items-center justify-center gap-2 border-t border-stone-100 px-4 py-3 text-[10px] font-black uppercase tracking-wider text-[#C7346A] transition hover:bg-[#FFF0F3] cursor-pointer">
                                Ver todos los resultados
                                <span>→</span>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Navegación principal del header.
             Se usan enlaces HTML reales para que la navegación funcione con un solo clic,
             incluso antes de que Blazor termine de activar los eventos interactivos.
             IsActive() aplica el estilo rosa al enlace de la página actual. -->
        <nav class="hidden shrink-0 items-center gap-7 text-[11px] font-bold uppercase tracking-[0.14em] text-stone-600 lg:flex">
            <a href="/"
               class="relative py-2 transition-all duration-300 hover:text-[#FF76A5] @(IsActive("/") ? "text-[#FF76A5] font-extrabold" : "")">
                @LangService.Translate("inicio")
            </a>

            <a href="/shop"
               class="relative py-2 transition-all duration-300 hover:text-[#FF76A5] @(IsActive("/shop") ? "text-[#FF76A5] font-extrabold" : "")">
                @(LangService.CurrentLanguage == "es" ? "Tienda" : "Shop")
            </a>

            <a href="/contact"
               class="relative py-2 transition-all duration-300 hover:text-[#FF76A5] @(IsActive("/contact") ? "text-[#FF76A5] font-extrabold" : "")">
                @LangService.Translate("contacto")
            </a>
        </nav>


        <!-- Right Side Account/Wishlist/Cart control links -->
        <div class="ml-1 flex shrink-0 items-center gap-2.5">
            
            <!-- User Button -->
            <button @onclick="NavigateToProfile"
                    class="flex h-11 w-11 items-center justify-center rounded-full border transition cursor-pointer
                             @(IsAccountPage()
                         ? "border-[#FCD1DB] bg-[#FFF0F3] text-[#C7346A] shadow-sm"
                         : "border-stone-200 bg-white text-stone-600 hover:border-[#FCD1DB] hover:bg-[#FFF0F3] hover:text-[#C7346A]")"
                    title="Mi Cuenta"
                    id="profile-button">
                <svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M20 21a8 8 0 0 0-16 0" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
            </button>

            <!-- Wishlist Button -->
            <button @onclick="OpenWishlist"
                    class="flex h-11 w-11 items-center justify-center rounded-full border transition cursor-pointer
                @(LayoutState.IsWishlistDrawerOpen
                         ? "border-[#FCD1DB] bg-[#FFF0F3] text-[#C7346A] shadow-sm"
                         : "border-stone-200 bg-white text-stone-600 hover:border-[#FCD1DB] hover:bg-[#FFF0F3] hover:text-[#C7346A]")">
                <svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 1 0-7.8 7.8L12 21l8.9-8.6a5.5 5.5 0 0 0-.1-7.8Z" />
                </svg>

                @if (Wishlist.GetWishlist().Count > 0)
                {
                    <span class="absolute -right-1 -top-1 flex h-4 w-4 items-center justify-center rounded-full bg-stone-900 text-[8px] font-bold text-white">
                        @Wishlist.GetWishlist().Count
                    </span>
                }
            </button>

            <!-- Cart drawer trigger button -->
            <button @onclick="OpenCart"
                    class="flex h-11 items-center gap-2 rounded-full border border-stone-200 bg-white px-4 text-stone-700 transition hover:border-[#FCD1DB] hover:bg-[#FFF0F3] hover:text-[#C7346A] cursor-pointer">
                <div class="relative">
                    <svg class="h-[17px] w-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M6 8h12l-1 12H7L6 8Z" />
                        <path d="M9 8a3 3 0 0 1 6 0" />
                    </svg>

                    @if (Cart.GetCount() > 0)
                    {
                        <span class="absolute -right-2 -top-2 flex h-4 w-4 items-center justify-center rounded-full bg-[#C7346A] text-[8px] font-bold text-white">
                            @Cart.GetCount()
                        </span>
                    }
                </div>

                <span class="hidden text-[10px] font-bold uppercase tracking-wider sm:inline-block">
                    S/ @Cart.GetSubtotal().ToString("0.00")
                </span>
            </button>
        </div>
    </div>
</header>

@code {
    
    protected override void OnInitialized()
    {
        LangService.OnChange += StateHasChanged;
        LayoutState.OnChange += StateHasChanged;
        Cart.OnChange += StateHasChanged;
        Wishlist.OnChange += StateHasChanged;
        Auth.OnChange += StateHasChanged;
        ListNavigate.LocationChanged += OnLocationChanged;
    }

    private async Task OnSearchInputAsync(ChangeEventArgs e)
    {
        string query = e.Value?.ToString() ?? string.Empty;

        LayoutState.SetSearchQuery(query);

        await HeaderSearch.SearchAsync(query);
    }

    private async Task OpenSearchResults()
    {
        if (!string.IsNullOrWhiteSpace(LayoutState.SearchQuery))
        {
            await HeaderSearch.SearchAsync(LayoutState.SearchQuery);
        }
    }

    private void ClearSearch()
    {
        LayoutState.SetSearchQuery(string.Empty);
        HeaderSearch.Clear();
    }

    private void OpenProduct(string productId)
    {
        HeaderSearch.Close();
        ListNavigate.NavigateTo($"/product/{productId}");
    }

    private void OpenShopSearch()
    {
        HeaderSearch.Close();

        string query = Uri.EscapeDataString(LayoutState.SearchQuery);

        ListNavigate.NavigateTo($"/shop?search={query}");
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" &&
            !string.IsNullOrWhiteSpace(LayoutState.SearchQuery))
        {
            OpenShopSearch();
        }

        if (e.Key == "Escape")
        {
            HeaderSearch.Close();
        }
    }

    private void GoHome()
    {
        LayoutState.SetSearchQuery(string.Empty);
        ListNavigate.NavigateTo("/");
    }

    private void NavigateTo(string path)
    {
        ListNavigate.NavigateTo(path);
    }

    private void NavigateToProfile()
    {
        if (Auth.IsLoggedIn)
        {
            ListNavigate.NavigateTo("/profile");
        }
        else
        {
            ListNavigate.NavigateTo("/login");
        }
    }

    private void OpenCart() => LayoutState.SetCartDrawerOpen(true);
    private void OpenWishlist() => LayoutState.SetWishlistDrawerOpen(true);

    private bool IsActive(string path)
    {
        string currentPath = new Uri(ListNavigate.Uri).AbsolutePath.TrimEnd('/');
        string targetPath = path.TrimEnd('/');

        if (string.IsNullOrEmpty(currentPath))
        {
            currentPath = "/";
        }

        if (string.IsNullOrEmpty(targetPath))
        {
            targetPath = "/";
        }

        return string.Equals(
            currentPath,
            targetPath,
            StringComparison.OrdinalIgnoreCase);
    }

    private bool IsAccountPage()
    {
        string currentPath = new Uri(ListNavigate.Uri).AbsolutePath.TrimEnd('/');

        return currentPath.Equals("/profile", StringComparison.OrdinalIgnoreCase)
            || currentPath.Equals("/login", StringComparison.OrdinalIgnoreCase)
            || currentPath.Equals("/signup", StringComparison.OrdinalIgnoreCase);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        LangService.OnChange -= StateHasChanged;
        LayoutState.OnChange -= StateHasChanged;
        Cart.OnChange -= StateHasChanged;
        Wishlist.OnChange -= StateHasChanged;
        Auth.OnChange -= StateHasChanged;
        ListNavigate.LocationChanged -= OnLocationChanged;
    }
}
