@inject LanguageService LangService
@inject LayoutStateService LayoutState
@inject CartService Cart
@inject WishlistService Wishlist
@inject AuthService Auth
@inject NavigationManager ListNavigate
@implements IDisposable

<header id="main-header" class="w-full bg-white border-b border-stone-100/80 shadow-[0_1px_3px_0_rgba(0,0,0,0.03),0_1px_2px_0_rgba(0,0,0,0.02)] sticky top-0 z-40 select-none">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-5 flex items-center justify-between gap-6">
        
        <!-- Logo and search -->
        <div class="flex items-center gap-6 flex-1 min-w-0">
            <button @onclick="GoHome" class="font-serif text-2xl lg:text-3xl font-light tracking-tight text-stone-900 flex items-center gap-1.5 focus:outline-none shrink-0 cursor-pointer">
                <span class="text-[#FF76A5] font-bold">Lumina</span>Beauty
                <span class="w-1.5 h-1.5 bg-[#FF76A5] rounded-full" />
            </button>

            <!-- Search bar -->
            <div class="hidden lg:flex flex-1 min-w-[360px] max-w-xl relative">
                <input type="text"
                       value="@LayoutState.SearchQuery"
                       @oninput="OnSearchInput"
                       placeholder="@LangService.Translate("searchPlaceholder")"
                       class="w-full bg-[#faf6f7] border border-stone-200/50 hover:border-[#FF76A5]/40 focus:border-[#FF76A5] focus:bg-white text-xs px-10 py-3 rounded-full transition-all duration-300 outline-none" />
                <span class="absolute left-3.5 top-3.5 w-4 h-4 text-stone-400 pointer-events-none">🔍</span>
                @if (!string.IsNullOrEmpty(LayoutState.SearchQuery))
                {
                    <button @onclick="ClearSearch" class="absolute right-3.5 top-3.5 text-stone-400 hover:text-stone-700 font-bold text-xs cursor-pointer">
                        Limpiar
                    </button>
                }
            </div>
        </div>

        <!-- Middle navigation links -->
        <nav class="hidden md:flex items-center gap-8 text-xs font-bold uppercase tracking-widest text-[#78716C] shrink-0">
            <button @onclick="GoHome" class="hover:text-[#FF76A5] transition-all duration-300 cursor-pointer @(IsActive("/") ? "text-[#FF76A5] font-extrabold" : "")">
                @LangService.Translate("inicio")
            </button>

            <button @onclick='() => NavigateTo("/categories")' class="hover:text-[#FF76A5] transition-all duration-300 cursor-pointer @(IsActive("/categories") ? "text-[#FF76A5] font-extrabold" : "")">
                @(LangService.CurrentLanguage == "es" ? "Tienda" : "Shop")
            </button>

            <button @onclick='() => NavigateTo("/contact")' class="hover:text-[#FF76A5] transition-all duration-300 cursor-pointer @(IsActive("/contact") ? "text-[#FF76A5] font-extrabold" : "")">
                @LangService.Translate("contacto")
            </button>
        </nav>

        <!-- Right Side Account/Wishlist/Cart control links -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
            
            <!-- User Button -->
            <button @onclick="NavigateToProfile"
                    class="p-2.5 rounded-full bg-white hover:bg-[#FFF0F3] text-stone-600 hover:text-[#FF76A5] transition border border-stone-100 shadow-5xs focus:outline-none focus:ring-1 focus:ring-[#FF76A5] cursor-pointer"
                    title="Mi Cuenta" id="profile-button">
                <span>👤</span>
            </button>

            <!-- Wishlist Button -->
            <button @onclick="OpenWishlist"
                    class="relative p-2.5 rounded-full bg-white hover:bg-[#FFF0F3] text-stone-600 hover:text-[#FF76A5] transition border border-stone-100 shadow-5xs cursor-pointer">
                <span class="@(Wishlist.GetWishlist().Count > 0 ? "text-[#FF76A5]" : "")">❤️</span>
                @if (Wishlist.GetWishlist().Count > 0)
                {
                    <span class="absolute -top-1 -right-1 w-4 h-4 bg-[#FF76A5] text-white text-[9px] font-bold rounded-full flex items-center justify-center">
                        @Wishlist.GetWishlist().Count
                    </span>
                }
            </button>

            <!-- Cart drawer trigger button -->
            <button @onclick="OpenCart"
                    class="p-2.5 rounded-full bg-[#FFF0F3] hover:bg-[#FFE3EC] text-[#C7346A] transition-colors flex items-center gap-2 pr-3.5 shadow-5xs border border-[#FFE3E8]/50 cursor-pointer">
                <div class="relative">
                    <span>🛍️</span>
                    @if (Cart.GetCount() > 0)
                    {
                        <span class="absolute -top-2 -right-2.5 w-4 h-4 bg-stone-900 border border-white text-white text-[9px] font-bold rounded-full flex items-center justify-center">
                            @Cart.GetCount()
                        </span>
                    }
                </div>

                <span class="text-[10px] font-bold uppercase tracking-widest hidden sm:inline-block">
                    S/ @Cart.GetSubtotal().ToString("0.00")
                </span>
            </button>
        </div>
    </div>
</header>

@code {
    protected override void OnInitialized()
    {
        LangService.OnChange += StateHasChanged;
        LayoutState.OnChange += StateHasChanged;
        Cart.OnChange += StateHasChanged;
        Wishlist.OnChange += StateHasChanged;
        Auth.OnChange += StateHasChanged;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? string.Empty;
        LayoutState.SetSearchQuery(val);
    }

    private void ClearSearch()
    {
        LayoutState.SetSearchQuery(string.Empty);
    }

    private void GoHome()
    {
        LayoutState.SetSearchQuery(string.Empty);
        ListNavigate.NavigateTo("/");
    }

    private void NavigateTo(string path)
    {
        ListNavigate.NavigateTo(path);
    }

    private void NavigateToProfile()
    {
        if (Auth.IsLoggedIn)
        {
            ListNavigate.NavigateTo("/profile");
        }
        else
        {
            ListNavigate.NavigateTo("/login");
        }
    }

    private void OpenCart() => LayoutState.SetCartDrawerOpen(true);
    private void OpenWishlist() => LayoutState.SetWishlistDrawerOpen(true);

    private bool IsActive(string relativePath)
    {
        var localPath = ListNavigate.ToBaseRelativePath(ListNavigate.Uri);
        if (relativePath == "/")
        {
            return string.IsNullOrEmpty(localPath);
        }
        return localPath.Split('?')[0].StartsWith(relativePath.TrimStart('/'));
    }

    public void Dispose()
    {
        LangService.OnChange -= StateHasChanged;
        LayoutState.OnChange -= StateHasChanged;
        Cart.OnChange -= StateHasChanged;
        Wishlist.OnChange -= StateHasChanged;
        Auth.OnChange -= StateHasChanged;
    }
}
