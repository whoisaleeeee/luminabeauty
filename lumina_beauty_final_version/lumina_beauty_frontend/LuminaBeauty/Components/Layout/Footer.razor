@inject LayoutStateService LayoutState
@inject AuthService Auth
@inject NavigationManager Navigator

<footer id="footer-workspace"
        class="mt-20 border-t border-stone-200 bg-white px-4 pb-8 pt-12 text-stone-600 sm:px-6">

    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-10 text-left sm:grid-cols-2 lg:grid-cols-12 lg:gap-12">

        <div class="lg:col-span-4">
            <button @onclick='() => Navigator.NavigateTo("/")'
                    class="font-serif text-xl font-semibold tracking-tight text-stone-700 transition hover:text-stone-900 cursor-pointer sm:text-2xl">
                Lumina Beauty<span class="text-stone-400">·</span>
            </button>

            <p class="mt-5 max-w-xs text-xs leading-relaxed text-stone-500">
                Belleza seleccionada para acompañar tus rituales diarios con calma, intención y estilo.
            </p>

            <div class="mt-6 border-l-2 border-stone-300 pl-4">
                <p class="text-[10px] font-black uppercase tracking-[0.16em] text-stone-500">
                    Atención al cliente
                </p>

                <a href="mailto:ayuda@luminabeauty.com"
                   class="mt-2 block text-xs font-semibold text-stone-700 transition hover:text-[#C7346A]">
                    ayuda@luminabeauty.com
                </a>

                <a href="tel:+51958392491"
                   class="mt-2 block text-xs font-semibold text-stone-700 transition hover:text-[#C7346A]">
                    +51 958 392 491
                </a>
            </div>
        </div>

        <div class="lg:col-span-2">
            <h3 class="text-[10px] font-black uppercase tracking-[0.16em] text-stone-700">
                Mi cuenta
            </h3>

            <ul class="mt-5 space-y-3 text-xs font-medium">
                <li>
                    <button @onclick="GoToAccount"
                            class="transition hover:text-[#C7346A] cursor-pointer">
                        Mi cuenta
                    </button>
                </li>

                <li>
                    <button @onclick="OpenCart"
                            class="transition hover:text-[#C7346A] cursor-pointer">
                        Carrito
                    </button>
                </li>

                <li>
                    <button @onclick="OpenWishlist"
                            class="transition hover:text-[#C7346A] cursor-pointer">
                        Lista de deseos
                    </button>
                </li>

                <li>
                    <button @onclick='() => Navigator.NavigateTo("/shop")'
                            class="transition hover:text-[#C7346A] cursor-pointer">
                        Tienda
                    </button>
                </li>
            </ul>
        </div>

        <div class="lg:col-span-2">
            <h3 class="text-[10px] font-black uppercase tracking-[0.16em] text-stone-700">
                Información
            </h3>

            <ul class="mt-5 space-y-3 text-xs font-medium">
                <li>
                    <button @onclick='() => Navigator.NavigateTo("/about")'
                            class="transition hover:text-[#C7346A] cursor-pointer">
                        Sobre Lumina
                    </button>
                </li>

                <li>
                    <button @onclick='() => Navigator.NavigateTo("/contact")'
                            class="transition hover:text-[#C7346A] cursor-pointer">
                        Contacto
                    </button>
                </li>

                <li>
                    <button @onclick='() => Navigator.NavigateTo("/faq")'
                            class="transition hover:text-[#C7346A] cursor-pointer">
                        Preguntas frecuentes
                    </button>
                </li>
            </ul>
        </div>

        <div class="lg:col-span-2">
            <h3 class="text-[10px] font-black uppercase tracking-[0.16em] text-stone-700">
                Legal
            </h3>

            <ul class="mt-5 space-y-3 text-xs font-medium">
                <li>
                    <button @onclick='() => Navigator.NavigateTo("/privacy")'
                            class="transition hover:text-[#C7346A] cursor-pointer">
                        Política de privacidad
                    </button>
                </li>

                <li>
                    <button @onclick='() => Navigator.NavigateTo("/terms")'
                            class="transition hover:text-[#C7346A] cursor-pointer">
                        Términos de uso
                    </button>
                </li>
            </ul>
        </div>

        <div class="lg:col-span-2">
            <h3 class="text-[10px] font-black uppercase tracking-[0.16em] text-stone-700">
                Ubicación
            </h3>

            <a href="https://www.google.com/maps/search/?api=1&query=Av.+Circunvalaci%C3%B3n+El+Golf+423,+Surco,+Lima,+Per%C3%BA"
               target="_blank"
               rel="noopener noreferrer"
               class="mt-5 block text-xs leading-relaxed text-stone-500 transition hover:text-[#C7346A]">
                Av. Circunvalación El Golf 423, Surco<br />
                Lima, Perú
            </a>

            <p class="mt-4 text-[10px] leading-relaxed text-stone-400">
                Horario de atención:<br />
                Lunes a sábado, 9:00 a.m. – 8:00 p.m.
            </p>
        </div>
    </div>

    <div class="mx-auto mt-12 max-w-7xl border-t border-stone-100 pt-6 text-center">
        <p class="text-[10px] font-medium tracking-wide text-stone-400">
            © 2026 Lumina Beauty. Todos los derechos reservados.
        </p>
    </div>
</footer>

@code {
    private void OpenCart()
    {
        LayoutState.SetCartDrawerOpen(true);
    }

    private void OpenWishlist()
    {
        LayoutState.SetWishlistDrawerOpen(true);
    }

    private void GoToAccount()
    {
        Navigator.NavigateTo(Auth.IsLoggedIn ? "/profile" : "/login");
    }
}