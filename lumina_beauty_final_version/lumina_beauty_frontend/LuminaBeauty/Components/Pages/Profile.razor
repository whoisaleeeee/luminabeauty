@page "/profile"
@inject LanguageService LangService
@inject AuthService Auth
@inject WishlistService Wishlist
@inject ProductService ProductCache
@inject ToastService Toast
@inject NavigationManager Navigator
@implements IDisposable

<PageTitle>Mi Cuenta VIP | Lumina Beauty</PageTitle>

<div class="max-w-6xl mx-auto px-1 sm:px-4 py-6 text-left">
    
    <nav class="text-xs font-semibold text-stone-400 mb-8 flex items-center gap-2 select-none">
        <span class="hover:text-[#FF76A5] cursor-pointer transition" @onclick='() => NavigateTo("/")'>
            Inicio
        </span>
        <span class="text-stone-300">/</span>
        <span class="text-stone-600 font-bold">Perfil</span>
    </nav>

    @if (!Auth.IsLoggedIn)
    {
        <div class="bg-white/75 backdrop-blur-md border border-[#FCD1DB]/50 rounded-[32px] p-10 text-center max-w-md mx-auto shadow-xl space-y-6">
            <div class="w-14 h-14 bg-[#FFF0F3] text-[#FF76A5] border border-[#FCD1DB]/50 rounded-full flex items-center justify-center mx-auto text-xl font-bold select-none">
                <span>🔒</span>
            </div>
            <div class="space-y-1 select-none">
                <h2 class="font-serif text-2xl font-bold text-stone-900 leading-tight">Acceso Exclusivo VIP</h2>
                <p class="text-[11px] text-stone-500 font-bold max-w-xs mx-auto leading-relaxed">
                    Inicia sesión para poder visualizar tus pedidos de lujo, configurar tu dirección de despacho y administrar tu lista de deseos personalizada.
                </p>
            </div>
            <button @onclick='() => NavigateTo("/login")'
                    class="w-full bg-[#FF76A5] hover:bg-[#C7346A] tracking-wider font-bold text-xs uppercase text-white py-3.5 rounded-xl transition duration-300 shadow cursor-pointer select-none">
                Ingresar / Crear Cuenta
            </button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
            <div class="lg:col-span-4 space-y-6">
          
                <div class="bg-white rounded-[2rem] border border-stone-100 p-6 shadow-xs relative text-center">
            
                    <div class="relative w-24 h-24 mx-auto mb-4">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=400"
                             alt="Lumina VIP Member"
                             class="w-24 h-24 rounded-full object-cover border-2 border-[#FCD1DB] p-0.5" />
                        <div class="absolute bottom-0 right-1 w-6 h-6 bg-white border border-stone-100 rounded-full flex items-center justify-center shadow-xs text-[10px] select-none">
                            ✨
                        </div>
                    </div>

                    <h2 class="font-serif text-2xl font-semibold text-stone-900">
                        @_profileName
                    </h2>
                    <p class="text-[10px] uppercase font-bold tracking-widest text-stone-400 mt-1 mb-6 select-none">
                        MIEMBRO LUMINA VIP
                    </p>

                    <div class="space-y-3 text-left max-w-xs mx-auto px-2 text-stone-500 text-xs font-medium border-t border-stone-50 pt-5 pb-6">
                        <div class="flex items-center gap-3">
                            <span class="text-[#C7346A] text-sm select-none">✉</span>
                            <span class="truncate">@_profileEmail</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-[#C7346A] text-sm select-none">📞</span>
                            <span>@_profilePhone</span>
                        </div>
                    </div>

                    <div class="flex items-center gap-2 mt-2 select-none">
                        <button @onclick='() => SetActiveTab("detalles")'
                                class="flex-1 bg-white hover:bg-stone-50 border border-stone-200 text-stone-700 text-[10px] font-bold uppercase tracking-wider py-3 px-4 rounded-xl transition flex items-center justify-center gap-2 cursor-pointer shadow-2xs">
                            <span>✏️</span> EDITAR PERFIL
                        </button>
              
                        <button @onclick="LogOff"
                                class="w-12 bg-stone-900 hover:bg-red-600 text-white py-3 rounded-xl transition flex items-center justify-center cursor-pointer shadow-2xs"
                                title="Cerrar Sesión">
                            <span>↳</span>
                        </button>
                    </div>
                </div>

                <div class="bg-white/40 border border-stone-100/70 p-2.5 rounded-2xl space-y-1 select-none">
                    @foreach (var tab in _profileTabs)
                    {
                        var tCode = tab.Key;
                        var tLabel = tab.Value;
                        var isActive = _activeTab == tCode;
                        <button @onclick="() => SetActiveTab(tCode)"
                                class="w-full text-left px-4 py-3 rounded-xl text-xs font-semibold tracking-wide transition flex items-center justify-between cursor-pointer @(isActive ? "bg-[#FFF0F3] text-[#C7346A] shadow-xs border-l-2 border-[#FF76A5]" : "text-stone-600 hover:bg-white")">
                            <span>@tLabel</span>
                            @if (isActive)
                            {
                                <span>➔</span>
                            }
                        </button>
                    }
                </div>

                <div class="bg-white rounded-[2rem] border border-stone-100 p-6 shadow-xs text-left space-y-5 select-none">
            
                    <div class="flex items-center gap-2.5">
                        <div class="w-7 h-7 bg-[#FFF0F3] text-[#FF76A5] rounded-xl flex items-center justify-center text-xs">
                            ⚙️
                        </div>
                        <h3 class="font-serif text-sm font-bold text-stone-800">Ajustes de Cuenta</h3>
                    </div>

                   
                    <div class="space-y-2">
                        <label class="text-[9px] font-black uppercase text-stone-400 tracking-wider block">Preferencia de Idioma</label>
                        <div class="grid grid-cols-2 gap-2">
                            <button class="bg-[#FFF0F3] text-[#C7346A] border border-[#FF76A5]/25 text-[11px] font-bold py-2 rounded-xl flex items-center justify-center gap-1.5 cursor-pointer">
                                🌐 Español
                            </button>
                            <button class="bg-white hover:bg-stone-50 border border-stone-200 text-stone-500 text-[11px] font-bold py-2 rounded-xl flex items-center justify-center gap-1.5 cursor-pointer">
                                🌐 English
                            </button>
                        </div>
                    </div>

                   
                    <div class="space-y-2.5 pt-1">
                        <label class="text-[9px] font-black uppercase text-stone-400 tracking-wider block">Preferencias de Notificación</label>
                        <div class="space-y-2 text-[11px] font-bold text-stone-600">
                            <label class="flex items-center gap-2.5 cursor-pointer">
                                <input type="checkbox" checked class="accent-[#FF76A5] h-3.5 w-3.5 rounded" />
                                <span>Ofertas y Promociones Exclusivas</span>
                            </label>
                            <label class="flex items-center gap-2.5 cursor-pointer">
                                <input type="checkbox" checked class="accent-[#FF76A5] h-3.5 w-3.5 rounded" />
                                <span>Consejos de Skincare Semanales</span>
                            </label>
                            <label class="flex items-center gap-2.5 cursor-pointer">
                                <input type="checkbox" checked class="accent-[#FF76A5] h-3.5 w-3.5 rounded" />
                                <span>Estado de mis Órdenes y Entregas</span>
                            </label>
                        </div>
                    </div>

                  
                    <div class="pt-2">
                        <button @onclick="TriggerPasswordReset"
                                class="w-full bg-[#FFF0F3] hover:bg-[#FF76A5]/20 text-[#C7346A] text-[10px] font-bold uppercase tracking-wider py-3 rounded-xl transition flex items-center justify-center gap-2 cursor-pointer">
                            🔒 Cambiar Contraseña
                        </button>
                    </div>

                </div>

            </div>

            
            <div class="lg:col-span-8 bg-white/70 backdrop-blur-md rounded-3xl border border-stone-100 p-6 sm:p-8 shadow-md">
                @if (_activeTab == "detalles")
                {
                    
                    <div class="space-y-6 animate-in fade-in duration-300 text-left">
                        <h3 class="font-serif text-lg font-bold text-stone-900 border-b border-stone-100 pb-3 uppercase text-xs tracking-widest text-[#C7346A] select-none">
                            Configuración Personal de Belleza
                        </h3>

                        <form @onsubmit="SaveDetails" @onsubmit:preventDefault class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div class="space-y-1">
                                <label class="text-[10px] font-black uppercase text-stone-400 tracking-wider select-none">Nombre completo</label>
                                <input type="text" required placeholder="Alexandra Arrobas..." @bind="_profileName"
                                       class="w-full bg-[#faf6f7]/60 hover:bg-white focus:bg-white border border-stone-200 focus:border-[#FF76A5] text-xs font-bold rounded-xl px-3.5 py-2.5 transition" />
                            </div>

                            <div class="space-y-1">
                                <label class="text-[10px] font-black uppercase text-stone-400 tracking-wider select-none">Email registrado</label>
                                <input type="email" required placeholder="alexandra@mail..." @bind="_profileEmail"
                                       class="w-full bg-[#faf6f7]/60 hover:bg-white focus:bg-white border border-stone-200 focus:border-[#FF76A5] text-xs font-bold rounded-xl px-3.5 py-2.5 transition" />
                            </div>

                            <div class="space-y-1">
                                <label class="text-[10px] font-black uppercase text-stone-400 tracking-wider select-none">Celular de contacto</label>
                                <input type="tel" placeholder="954 391..." @bind="_profilePhone"
                                       class="w-full bg-[#faf6f7]/60 hover:bg-white focus:bg-white border border-stone-200 focus:border-[#FF76A5] text-xs font-bold rounded-xl px-3.5 py-2.5 transition" />
                            </div>

                            <div class="space-y-1">
                                <label class="text-[10px] font-black uppercase text-stone-400 tracking-wider select-none">Dirección habitual</label>
                                <input type="text" placeholder="Av. Primavera..." @bind="_profileAddress"
                                       class="w-full bg-[#faf6f7]/60 hover:bg-white focus:bg-white border border-stone-200 focus:border-[#FF76A5] text-xs font-bold rounded-xl px-3.5 py-2.5 transition" />
                            </div>

                            <button type="submit"
                                    class="sm:col-span-2 w-fit bg-stone-950 hover:bg-[#C7346A] tracking-wider uppercase font-bold text-[10px] text-white px-7 py-3 rounded-xl transition shadow-xs cursor-pointer select-none">
                                Guardar Cambios
                            </button>
                        </form>
                    </div>
                }
                else if (_activeTab == "pedidos")
                {
                    
                    <div class="space-y-6 animate-in fade-in duration-300 text-left">
                        <h3 class="font-serif text-lg font-bold text-stone-900 border-b border-stone-100 pb-3 uppercase text-xs tracking-widest text-[#C7346A] select-none">
                            Historial de Pedidos de Lujo
                        </h3>

                        <div class="border border-[#FCD1DB]/50 rounded-2xl overflow-hidden p-5 space-y-5 bg-[#faf6f7]/20">
                   
                            <div class="flex flex-wrap justify-between items-center bg-white p-3 rounded-xl border border-stone-100 select-none text-[11px] font-bold text-stone-500 font-mono gap-2">
                                <p>Pedido: <strong class="text-stone-900">#LUM-8924</strong></p>
                                <p>Fecha: <strong class="text-stone-900">29/05/2026</strong></p>
                                <p>Total: <strong class="text-[#C7346A]">S/ 399.00</strong></p>
                                <p>Estado: <span class="bg-amber-100 text-amber-800 px-2.5 py-0.5 rounded-full uppercase text-[9px] font-bold">En Tránsito</span></p>
                            </div>

                            <div class="py-4 select-none">
                                <div class="grid grid-cols-3 relative text-center">
                                    <div class="absolute top-2.5 left-1/6 right-1/6 h-0.5 bg-stone-200 -z-10" />
                                    <div class="absolute top-2.5 left-1/6 w-1/3 h-0.5 bg-pink-500 -z-10 animate-pulse" />

                                    <div class="flex flex-col items-center">
                                        <div class="w-6 h-6 rounded-full bg-[#FF76A5] text-white flex items-center justify-center font-bold text-[9px]">
                                            ✓
                                        </div>
                                        <span class="text-[9px] font-black uppercase text-stone-800 tracking-wider mt-2 block">Preparado</span>
                                        <span class="text-[8px] text-stone-400 font-mono">11:32 AM</span>
                                    </div>

                                    <div class="flex flex-col items-center">
                                        <div class="w-6 h-6 rounded-full bg-[#FF76A5] text-white flex items-center justify-center font-bold text-[9px]">
                                            ✓
                                        </div>
                                        <span class="text-[9px] font-black uppercase text-[#C7346A] tracking-wider mt-2 block">En Tránsito</span>
                                        <span class="text-[8px] text-stone-400 font-mono">En ruta, Miraflores</span>
                                    </div>

                                    <div class="flex flex-col items-center opacity-40">
                                        <div class="w-6 h-6 rounded-full bg-stone-200 text-stone-600 flex items-center justify-center font-bold text-[9px]">
                                            3
                                        </div>
                                        <span class="text-[9px] font-black uppercase text-stone-800 tracking-wider mt-2 block">Entregado</span>
                                        <span class="text-[8px] text-stone-400 font-mono">Pendiente</span>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                }
                else if (_activeTab == "favoritos")
                {
                    <div class="space-y-6 animate-in fade-in duration-300 text-left">
                        <h3 class="font-serif text-lg font-bold text-stone-900 border-b border-stone-100 pb-3 uppercase text-xs tracking-widest text-[#C7346A] select-none">
                            Marcadores de Belleza Guardados (@Wishlist.GetWishlist().Count)
                        </h3>

                        @if (Wishlist.GetWishlist().Count == 0)
                        {
                            <div class="py-12 text-center select-none bg-stone-50 rounded-2xl border border-dashed border-stone-200">
                                <p class="text-xs text-stone-400 font-bold mb-4">No tienes productos de culto guardados</p>
                                <button @onclick='() => NavigateTo("/")'
                                        class="px-5 py-2.5 bg-[#FF76A5] hover:bg-[#C7346A] font-bold text-[10px] uppercase tracking-wider text-white rounded-xl transition cursor-pointer">
                                    Ver Catálogo
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                                @foreach (var id in Wishlist.GetWishlist())
                                {
                                    var p = ProductCache.GetProductById(id);
                                    if (p != null)
                                    {
                                        <div class="bg-white p-3.5 rounded-xl border border-stone-150 hover:border-[#FF76A5]/25 transition flex flex-col justify-between block hover:shadow-xs">
                                            <div @onclick='() => NavigateTo($"/product/{p.Id}")'
                                                 class="aspect-square bg-stone-50/70 p-2 rounded-lg flex items-center justify-center overflow-hidden mb-3.5 cursor-pointer">
                                                <img src="@p.Image" alt="@p.Name" class="max-h-20 object-contain pointer-events-none" referrerpolicy="no-referrer" />
                                            </div>
                                            <div class="text-left font-medium">
                                                <span class="text-[8px] font-black uppercase tracking-wider text-[#c5a880] block">@p.Brand</span>
                                                <h4 @onclick='() => NavigateTo($"/product/{p.Id}")'
                                                    class="text-[11px] font-bold text-stone-800 line-clamp-1 hover:text-[#C7346A] cursor-pointer transition">
                                                    @p.Name
                                                </h4>
                                                <span class="text-xs font-bold text-[#C7346A] font-mono block mt-1.5">S/ @p.Price.ToString("0.00")</span>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>

        </div>
    }

</div>

@code {
    private string _activeTab = "detalles";

    private readonly Dictionary<string, string> _profileTabs = new()
    {
        ["detalles"] = "Detalles de Perfil",
        ["pedidos"] = "Detalles de Pedidos",
        ["favoritos"] = "Mis Favoritos"
    };

    private string _profileName = "Alexandra Arrobas";
    private string _profileEmail = "alexandra.arrobas@pucp.edu.pe";
    private string _profilePhone = "+51 987 654 321";
    private string _profileAddress = "Av. Circunvalación El Golf 423, Santiago de Surco";

    protected override void OnInitialized()
    {
        LangService.OnChange += StateHasChanged;
        Wishlist.OnChange += StateHasChanged;
    }

    private void NavigateTo(string path) => Navigator.NavigateTo(path);

    private void SetActiveTab(string code) => _activeTab = code;

    private void SaveDetails()
    {
        Toast.ShowToast("¡Cambios de perfil registrados con éxito!");
    }

    private void TriggerPasswordReset()
    {
        Toast.ShowToast("¡Enlace de restauración enviado a tu correo!");
    }

    private async Task LogOff()
    {
        await Auth.LogoutAsync();
        Toast.ShowToast("Sesión VIP cerrada correctamente");
        Navigator.NavigateTo("/");
    }

    public void Dispose()
    {
        LangService.OnChange -= StateHasChanged;
        Wishlist.OnChange -= StateHasChanged;
    }
}