@page "/checkout"
@using LuminaBeauty.Servicios.Modelo
@using LuminaBeauty.Servicios.REST
@inject LanguageService LangService
@inject CartService Cart
@inject ToastService Toast
@inject NavigationManager Navigator
@inject AuthService Auth
@inject CheckoutAppService CheckoutService
@inject CuponAppService CuponApp
@inject DireccionRestService DireccionService
@implements IDisposable

<PageTitle>Pago y envío | Lumina Beauty</PageTitle>

<div class="max-w-7xl mx-auto px-1 sm:px-4 py-6 text-left">
    <nav class="mb-8 flex items-center gap-2 text-xs font-semibold text-stone-400 select-none">
        <span class="cursor-pointer transition hover:text-[#C7346A]"
              @onclick='() => Navigator.NavigateTo("/")'>
            Inicio
        </span>

        <span class="text-stone-300">/</span>

        <span class="cursor-pointer transition hover:text-[#C7346A]"
              @onclick='() => Navigator.NavigateTo("/cart")'>
            Carrito de compras
        </span>

        <span class="text-stone-300">/</span>

        <span class="font-bold text-stone-600">
            Pago y envío
        </span>
    </nav>

    @if (_isOrderComplete)
    {
        <div class="max-w-2xl mx-auto space-y-6 rounded-[32px] border border-[#FCD1DB]/50 bg-white/70 p-8 text-center shadow-2xl backdrop-blur-md sm:p-14">
            <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full border border-green-200/50 bg-green-50 text-3xl font-bold text-[#FF76A5]">
                ✓
            </div>

            <div class="space-y-2">
                <span class="rounded-full bg-[#FFF0F3] px-3.5 py-1.5 text-[10px] font-black uppercase tracking-widest text-[#C7346A]">
                    Pago procesado exitosamente
                </span>

                <h1 class="pt-3 font-serif text-3xl font-semibold leading-tight text-stone-900 sm:text-4xl">
                    Tu pedido fue registrado
                </h1>

                <p class="mx-auto max-w-md pt-1 text-xs font-medium leading-relaxed text-stone-500">
                    Hemos registrado tu orden
                    <strong class="font-mono text-stone-800">@_codigoPedidoGenerado</strong>.
                </p>
            </div>

            <div class="mx-auto max-w-md space-y-1.5 rounded-2xl border border-[#FFE3E8]/70 bg-[#FFF0F3]/40 p-5 text-left text-xs font-semibold text-stone-700">
                <p class="mb-1 border-b border-stone-100 pb-1.5 text-[9px] font-bold uppercase tracking-widest text-[#C7346A]">
                    Resumen de envío
                </p>

                <p>
                    <span class="block text-[10px] font-bold uppercase text-stone-400">Destinatario:</span>
                    @_fullName
                </p>

                <p>
                    <span class="block text-[10px] font-bold uppercase text-stone-400">Dirección:</span>
                    @_address, @_district, @_city
                </p>

                <p>
                    <span class="block text-[10px] font-bold uppercase text-stone-400">Contacto:</span>
                    @_phone
                </p>

                <p>
                    <span class="block text-[10px] font-bold uppercase text-stone-400">Método de pago:</span>
                    @GetPaymentLabel()
                </p>
            </div>

            <div class="pt-2">
                <button @onclick='() => Navigator.NavigateTo("/shop")'
                        class="cursor-pointer rounded-xl bg-stone-950 px-8 py-3.5 text-xs font-semibold uppercase tracking-widest text-white transition hover:bg-[#FF76A5]">
                    Volver a la tienda
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="border-b border-stone-100 pb-6">
            <h1 class="mt-2 font-serif text-2xl font-semibold text-stone-800 sm:text-xl">
                Pago y envío
            </h1>

            <p class="mt-2 text-xs leading-relaxed text-stone-500">
                Confirma tus datos de entrega y selecciona el método de pago para finalizar tu compra.
            </p>
        </div>

        <div class="mt-5 grid grid-cols-1 items-start gap-8 lg:grid-cols-12">
            <div class="space-y-6 lg:col-span-8">
                <form @onsubmit="PlaceOrder"
                      @onsubmit:preventDefault
                      class="space-y-6">

                    <section class="space-y-6 rounded-3xl border border-stone-100 bg-white/80 p-6 text-left shadow-xs backdrop-blur-md sm:p-8">
                        <div class="border-b border-stone-100 pb-3">
                            <h2 class="text-xs font-semibold uppercase tracking-widest text-[#C7346A]">
                                1. Datos de despacho
                            </h2>
                        </div>

                        <div class="grid grid-cols-1 gap-5 pt-1 sm:grid-cols-2">
                            <div class="space-y-1">
                                <label class="text-[10px] font-black uppercase tracking-wider text-stone-400">
                                    Nombre de contacto
                                </label>

                                <input type="text"
                                       required
                                       placeholder="Nombre completo..."
                                       @bind="_fullName"
                                       class="w-full rounded-xl border border-stone-200 bg-[#faf6f7]/60 px-3.5 py-2.5 text-xs font-semibold text-stone-700 transition hover:bg-white focus:border-[#FF76A5] focus:bg-white focus:outline-none" />
                            </div>

                            <div class="space-y-1">
                                <label class="text-[10px] font-black uppercase tracking-wider text-stone-400">
                                    Celular
                                </label>

                                <input type="tel"
                                       required
                                       placeholder="999 999 999..."
                                       @bind="_phone"
                                       class="w-full rounded-xl border border-stone-200 bg-[#faf6f7]/60 px-3.5 py-2.5 text-xs font-semibold text-stone-700 transition hover:bg-white focus:border-[#FF76A5] focus:bg-white focus:outline-none" />
                            </div>

                            <div class="col-span-1 space-y-3 sm:col-span-2">
                                <div class="flex items-center justify-between gap-4">
                                    <label class="text-[10px] font-black uppercase tracking-wider text-stone-400">
                                        Dirección de entrega
                                    </label>

                                    @if (_direcciones.Count > 0 && !_usarOtraDireccion)
                                    {
                                        <button type="button"
                                                @onclick="UsarOtraDireccion"
                                                class="cursor-pointer text-[10px] font-semibold text-[#C7346A] transition hover:text-stone-800">
                                            Agregar nueva dirección
                                        </button>
                                    }
                                </div>

                                @if (!_usarOtraDireccion && _direcciones.Count > 0)
                                {
                                    <div class="space-y-3">
                                        @foreach (var direccion in _direcciones)
                                        {
                                            var isSelected = _direccionSeleccionadaId == direccion.IdDireccion;
                                            var isPrincipal = Auth.CurrentClient?.DireccionPrincipal?.IdDireccion == direccion.IdDireccion;

                                            <button type="button"
                                                    @onclick="() => SeleccionarDireccion(direccion)"
                                                    class="w-full cursor-pointer rounded-2xl border p-4 text-left transition @(isSelected
                                                                                                            ? "border-[#FF76A5] bg-[#FFF0F3]/55"
                                                                                                            : "border-stone-200 bg-white hover:border-[#FCD1DB]")">

                                                <div class="flex items-start justify-between gap-4">
                                                    <div>
                                                        <p class="text-xs font-semibold text-stone-800">
                                                            @direccion.DireccionTexto
                                                        </p>

                                                        <p class="mt-1 text-[11px] leading-relaxed text-stone-500">
                                                            @direccion.Ciudad

                                                            @if (!string.IsNullOrWhiteSpace(direccion.Referencia))
                                                            {
                                                                <span> · @direccion.Referencia</span>
                                                            }

                                                            @if (!string.IsNullOrWhiteSpace(direccion.CodigoPostal))
                                                            {
                                                                <span> · @direccion.CodigoPostal</span>
                                                            }
                                                        </p>
                                                    </div>

                                                    @if (isPrincipal)
                                                    {
                                                        <span class="shrink-0 rounded-full bg-stone-100 px-2.5 py-1 text-[9px] font-semibold uppercase tracking-wide text-stone-500">
                                                            Principal
                                                        </span>
                                                    }
                                                </div>
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="rounded-2xl border border-[#FCD1DB]/60 bg-[#FFF0F3]/25 p-4">
                                        <div class="mb-4 flex items-center justify-between gap-4">
                                            <div>
                                                <p class="text-xs font-semibold text-stone-800">
                                                    Nueva dirección para este pedido
                                                </p>

                                                <p class="mt-1 text-[11px] leading-relaxed text-stone-500">
                                                    Esta dirección se usará solo para esta compra y no modificará tus direcciones guardadas.
                                                </p>
                                            </div>

                                            @if (_direcciones.Count > 0)
                                            {
                                                <button type="button"
                                                        @onclick="VolverADireccionesGuardadas"
                                                        class="cursor-pointer text-[10px] font-semibold text-[#C7346A] transition hover:text-stone-800">
                                                    Ver direcciones guardadas
                                                </button>
                                            }
                                        </div>

                                        <div class="space-y-4">
                                            <div class="space-y-1">
                                                <label class="text-[10px] font-black uppercase tracking-wider text-stone-400">
                                                    Dirección
                                                </label>

                                                <input type="text"
                                                       required
                                                       placeholder="Av. Primavera 1234, Dpto 402..."
                                                       @bind="_address"
                                                       class="w-full rounded-xl border border-stone-200 bg-white px-3.5 py-2.5 text-xs font-semibold text-stone-700 transition focus:border-[#FF76A5] focus:outline-none" />
                                            </div>

                                            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                                                <div class="space-y-1">
                                                    <label class="text-[10px] font-black uppercase tracking-wider text-stone-400">
                                                        Ciudad o región
                                                    </label>

                                                    <input type="text"
                                                           required
                                                           placeholder="Lima..."
                                                           @bind="_city"
                                                           class="w-full rounded-xl border border-stone-200 bg-white px-3.5 py-2.5 text-xs font-semibold text-stone-700 transition focus:border-[#FF76A5] focus:outline-none" />
                                                </div>

                                                <div class="space-y-1">
                                                    <label class="text-[10px] font-black uppercase tracking-wider text-stone-400">
                                                        Distrito o referencia
                                                    </label>

                                                    <input type="text"
                                                           required
                                                           placeholder="San Miguel..."
                                                           @bind="_district"
                                                           class="w-full rounded-xl border border-stone-200 bg-white px-3.5 py-2.5 text-xs font-semibold text-stone-700 transition focus:border-[#FF76A5] focus:outline-none" />
                                                </div>

                                                <div class="space-y-1">
                                                    <label class="text-[10px] font-black uppercase tracking-wider text-stone-400">
                                                        Código postal
                                                    </label>

                                                    <input type="text"
                                                           placeholder="15088..."
                                                           @bind="_zip"
                                                           class="w-full rounded-xl border border-stone-200 bg-white px-3.5 py-2.5 text-xs font-semibold text-stone-700 transition focus:border-[#FF76A5] focus:outline-none" />
                                                </div>
                                            </div>
                                        </div>

                                        <label class="mt-5 flex cursor-pointer items-start gap-3 rounded-xl border border-stone-200 bg-white px-4 py-3">
                                            <input type="checkbox"
                                                   @bind="_guardarNuevaDireccion"
                                                   class="mt-0.5 h-4 w-4 accent-[#C7346A]" />

                                            <span>
                                                <span class="block text-xs font-semibold text-stone-700">
                                                    Guardar esta dirección en mi perfil
                                                </span>

                                                <span class="mt-1 block text-[11px] leading-relaxed text-stone-500">
                                                    Podrás usarla nuevamente en futuras compras desde Mi cuenta.
                                                </span>
                                            </span>
                                        </label>

                                    </div>
                                }
                            </div>
                        </div>
                    </section>

                    <section class="space-y-6 rounded-3xl border border-stone-100 bg-white/80 p-6 text-left shadow-xs backdrop-blur-md sm:p-8">
                        <div class="border-b border-stone-100 pb-3">
                            <h2 class="text-xs font-semibold uppercase tracking-widest text-[#C7346A]">
                                2. Método de pago
                            </h2>
                        </div>

                        <div class="grid grid-cols-3 gap-3">
                            @foreach (var opt in _paymentMethodsList)
                            {
                                var isActive = _paymentMethod == opt.Code;

                                <button type="button"
                                        @onclick="() => SelectPaymentMethod(opt.Code)"
                                        class="flex cursor-pointer flex-col items-center justify-center gap-1.5 rounded-xl border px-1 py-3 text-xs font-semibold uppercase transition @(isActive
                                                                                    ? "border-[#FF76A5] bg-[#FFF0F3] text-[#C7346A]"
                                                                                    : "border-stone-200 bg-stone-50 text-stone-500 hover:text-stone-800")">
                                    <span class="text-sm">@opt.Icon</span>
                                    <span>@opt.Label</span>
                                </button>
                            }
                        </div>

                        @if (_paymentMethod == "card")
                        {
                            <div class="grid grid-cols-4 gap-4 pt-2">
                                <div class="col-span-4 space-y-1">
                                    <label class="text-[10px] font-black uppercase tracking-wider text-stone-400">
                                        Número de tarjeta
                                    </label>

                                    <input type="text"
                                           required
                                           placeholder="XXXX XXXX XXXX XXXX..."
                                           @bind="_cardNumber"
                                           class="w-full rounded-xl border border-stone-200 bg-[#faf6f7]/60 px-3.5 py-2.5 text-xs font-semibold text-stone-700 transition hover:bg-white focus:border-[#FF76A5] focus:bg-white focus:outline-none" />
                                </div>

                                <div class="col-span-2 space-y-1">
                                    <label class="text-[10px] font-black uppercase tracking-wider text-stone-400">
                                        Vencimiento
                                    </label>

                                    <input type="text"
                                           required
                                           placeholder="MM/AA..."
                                           @bind="_cardExpiry"
                                           class="w-full rounded-xl border border-stone-200 bg-[#faf6f7]/60 px-3.5 py-2.5 text-xs font-semibold text-stone-700 transition hover:bg-white focus:border-[#FF76A5] focus:bg-white focus:outline-none" />
                                </div>

                                <div class="col-span-2 space-y-1">
                                    <label class="text-[10px] font-black uppercase tracking-wider text-stone-400">
                                        CVV
                                    </label>

                                    <input type="password"
                                           required
                                           maxlength="3"
                                           placeholder="123..."
                                           @bind="_cardCvv"
                                           class="w-full rounded-xl border border-stone-200 bg-[#faf6f7]/60 px-3.5 py-2.5 text-xs font-semibold text-stone-700 transition hover:bg-white focus:border-[#FF76A5] focus:bg-white focus:outline-none" />
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="rounded-xl border border-[#FCD1DB]/40 bg-[#FFF0F3]/40 p-4 text-xs font-semibold leading-relaxed text-stone-700">
                                El pago será validado de acuerdo con el método seleccionado antes de procesar el pedido.
                            </div>
                        }
                    </section>

                    <button type="submit"
                            disabled="@_procesandoPedido"
                            class="w-full rounded-xl bg-[#FF76A5] py-4 text-xs font-semibold uppercase tracking-widest text-white shadow-md transition hover:bg-[#ff5f96] disabled:cursor-not-allowed disabled:opacity-60">
                        @(_procesandoPedido ? "Procesando pedido..." : "Confirmar pedido")
                    </button>
                </form>
            </div>

            <aside class="sticky top-24 select-none lg:col-span-4">
                <div class="relative overflow-hidden rounded-3xl border border-[#FCD1DB]/50 bg-white/80 p-6 text-left text-stone-800 shadow-md backdrop-blur-md">
                    <div class="absolute inset-x-0 top-0 h-1 bg-[#FF76A5]"></div>

                    <h2 class="mb-4 border-b border-stone-100 pb-3 text-xs font-semibold uppercase tracking-widest text-[#C7346A]">
                        Resumen de compra
                    </h2>

                    <div class="mb-4 max-h-56 space-y-3.5 overflow-y-auto border-b border-stone-100/60 pb-4 pr-1">
                        @foreach (var item in Cart.GetItems())
                        {
                            <div class="flex items-center gap-3.5 text-xs text-stone-900">
                                <img src="@item.Product.Image"
                                     alt="@item.Product.Name"
                                     class="h-11 w-11 rounded-lg border border-stone-200/55 bg-stone-50 object-contain p-0.5"
                                     referrerpolicy="no-referrer" />

                                <div class="min-w-0 flex-1 font-medium">
                                    <p class="truncate font-semibold text-stone-900">
                                        @item.Product.Name
                                    </p>

                                    <p class="text-[10px] font-semibold uppercase tracking-wider text-stone-400">
                                        @item.Product.Brand x @item.Quantity
                                    </p>
                                </div>

                                <span class="font-mono font-semibold text-stone-900">
                                    S/ @((item.Product.Price * item.Quantity).ToString("0.00"))
                                </span>
                            </div>
                        }
                    </div>

                    <div class="space-y-3 text-xs font-semibold text-stone-500">
                        <div class="flex items-center justify-between text-stone-600">
                            <span>Subtotal:</span>
                            <span class="font-mono font-semibold text-stone-900">
                                S/ @Cart.GetSubtotal().ToString("0.00")
                            </span>
                        </div>

                        <div class="flex items-center justify-between">
                            <span>Envío:</span>
                            <span class="@(GetShippingCost() == 0 ? "font-mono font-semibold text-green-600" : "font-mono font-semibold text-stone-900")">
                                @(GetShippingCost() == 0 ? "Gratis" : $"S/ {GetShippingCost():0.00}")
                            </span>
                        </div>

                        @if (_cuponAplicado != null)
                        {
                            <div class="flex items-center justify-between text-[#C7346A]">
                                <span>Descuento:</span>

                                <span class="font-mono font-semibold">
                                    -S/ @GetDiscountAmount().ToString("0.00")
                                </span>
                            </div>
                        }

                        <div class="mt-2 flex items-center justify-between border-t border-stone-150 pt-3.5 text-sm font-semibold text-stone-900">
                            <span>Importe total:</span>
                            <span class="font-mono text-base font-semibold text-[#C7346A]">
                                S/ @GetOrderTotal().ToString("0.00")
                            </span>
                        </div>

                        <div class="border-t border-stone-100 pt-4">
                            @if (_cuponAplicado == null)
                            {
                                <form @onsubmit="AplicarCuponAsync"
                                      @onsubmit:preventDefault
                                      class="flex gap-2">

                                    <input type="text"
                                           placeholder="Código de cupón"
                                           @bind="_codigoCupon"
                                           class="min-w-0 flex-1 rounded-xl border border-stone-200 bg-white px-3 py-2.5 text-xs font-medium text-stone-700 outline-none transition placeholder:text-stone-400 focus:border-[#FF76A5]" />

                                    <button type="submit"
                                            disabled="@_validandoCupon"
                                            class="cursor-pointer rounded-xl bg-stone-900 px-4 py-2.5 text-[10px] font-semibold uppercase tracking-wide text-white transition hover:bg-[#C7346A] disabled:cursor-not-allowed disabled:opacity-60">
                                        @(_validandoCupon ? "Validando..." : "Aplicar")
                                    </button>
                                </form>

                                @if (!string.IsNullOrWhiteSpace(_mensajeCupon))
                                {
                                    <p class="mt-2 text-[10px] font-medium text-[#C7346A]">
                                        @_mensajeCupon
                                    </p>
                                }
                            }
                            else
                            {
                                <div class="rounded-xl border border-[#FCD1DB]/60 bg-[#FFF8FA] px-3.5 py-3">
                                    <div class="flex items-start justify-between gap-3">
                                        <div>
                                            <p class="text-xs font-semibold text-stone-800">
                                                Cupón @_cuponAplicado.Codigo aplicado
                                            </p>

                                            <p class="mt-1 text-[10px] text-stone-500">
                                                @GetCouponDescription()
                                            </p>
                                        </div>

                                        <button type="button"
                                                @onclick="QuitarCupon"
                                                class="cursor-pointer text-[10px] font-semibold text-[#C7346A] transition hover:text-stone-800">
                                            Quitar
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                    </div>
                </div>
            </aside>
        </div>
    }
</div>

@code {
    private string _fullName = string.Empty;
    private string _phone = string.Empty;
    private string _address = string.Empty;
    private string _city = string.Empty;
    private string _district = string.Empty;
    private string _zip = string.Empty;

    private List<Direccion> _direcciones = new();
    private int? _direccionSeleccionadaId;
    private bool _usarOtraDireccion;
    private bool _guardarNuevaDireccion;

    private bool _procesandoPedido;
    private string _paymentMethod = "card";
    private string _cardNumber = string.Empty;
    private string _cardExpiry = string.Empty;
    private string _cardCvv = string.Empty;

    private bool _isOrderComplete;
    private string _codigoPedidoGenerado = string.Empty;

    private string _codigoCupon = string.Empty;
    private string _mensajeCupon = string.Empty;
    private Cupon? _cuponAplicado;
    private bool _validandoCupon;

    private class PaymentMethodOption
    {
        public string Code { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
    }

    private readonly List<PaymentMethodOption> _paymentMethodsList = new()
    {
        new() { Code = "card", Label = "Tarjeta", Icon = "💳" },
        new() { Code = "plin", Label = "Plin", Icon = "📲" },
        new() { Code = "yape", Label = "Yape", Icon = "⚡" }
    };

    protected override async Task OnInitializedAsync()
    {
        LangService.OnChange += StateHasChanged;
        Cart.OnChange += OnCartChanged;

        _cuponAplicado = Cart.GetAppliedCoupon();

        if (Auth.CurrentClient == null || Auth.CurrentClient.Id <= 0)
        {
            Navigator.NavigateTo("/login");
            return;
        }

        _fullName = $"{Auth.CurrentClient.Nombre} {Auth.CurrentClient.Apellido}".Trim();
        _phone = Auth.CurrentClient.Telefono ?? string.Empty;

        _direcciones = await DireccionService.ListarPorClienteAsync(Auth.CurrentClient.Id);

        var idDireccionPrincipal = Auth.CurrentClient.DireccionPrincipal?.IdDireccion ?? 0;

        var direccionPrincipal = _direcciones.FirstOrDefault(
            direccion => direccion.IdDireccion == idDireccionPrincipal)
            ?? _direcciones.FirstOrDefault();

        if (direccionPrincipal != null)
        {
            SeleccionarDireccion(direccionPrincipal);
        }
        else
        {
            _usarOtraDireccion = true;
        }
    }

    private void OnCartChanged()
    {
        _cuponAplicado = Cart.GetAppliedCoupon();
        StateHasChanged();
    }

    private void SeleccionarDireccion(Direccion direccion)
    {
        _direccionSeleccionadaId = direccion.IdDireccion;
        _usarOtraDireccion = false;
        _guardarNuevaDireccion = false;

        _address = direccion.DireccionTexto ?? string.Empty;
        _city = direccion.Ciudad ?? string.Empty;
        _district = direccion.Referencia ?? string.Empty;
        _zip = direccion.CodigoPostal ?? string.Empty;
    }

    private void UsarOtraDireccion()
    {
        _direccionSeleccionadaId = null;
        _usarOtraDireccion = true;
        _guardarNuevaDireccion = false;

        _address = string.Empty;
        _city = string.Empty;
        _district = string.Empty;
        _zip = string.Empty;
    }

    private void VolverADireccionesGuardadas()
    {
        var direccionSeleccionada = _direcciones.FirstOrDefault(
            direccion => direccion.IdDireccion == _direccionSeleccionadaId)
            ?? _direcciones.FirstOrDefault(
                direccion => direccion.IdDireccion == Auth.CurrentClient?.DireccionPrincipal?.IdDireccion)
            ?? _direcciones.FirstOrDefault();

        if (direccionSeleccionada != null)
        {
            SeleccionarDireccion(direccionSeleccionada);
        }
    }

    private void SelectPaymentMethod(string method)
    {
        _paymentMethod = method;
    }

    private decimal GetShippingCost()
    {
        return Cart.GetSubtotal() >= 199m ? 0m : 15m;
    }

    private string GetPaymentLabel()
    {
        return _paymentMethodsList
            .FirstOrDefault(method => method.Code == _paymentMethod)
            ?.Label
            ?? "No especificado";
    }

    private async Task AplicarCuponAsync()
    {
        if (_validandoCupon)
        {
            return;
        }

        var codigo = _codigoCupon.Trim();

        if (string.IsNullOrWhiteSpace(codigo))
        {
            _mensajeCupon = "Ingresa un código de cupón.";
            return;
        }

        _validandoCupon = true;
        _mensajeCupon = string.Empty;

        try
        {
            var cupon = await CuponApp.AplicarAsync(codigo);

            if (cupon == null || cupon.IdCupon <= 0)
            {
                await Cart.RemoveAppliedCouponAsync();
                _cuponAplicado = null;
                _mensajeCupon = "El cupón no es válido o ya no está vigente.";
                return;
            }

            await Cart.SetAppliedCouponAsync(cupon);

            _cuponAplicado = Cart.GetAppliedCoupon();
            _codigoCupon = cupon.Codigo;
            _mensajeCupon = "Cupón aplicado correctamente.";
        }
        catch
        {
            await Cart.RemoveAppliedCouponAsync();
            _cuponAplicado = null;
            _mensajeCupon = "No se pudo validar el cupón.";
        }
        finally
        {
            _validandoCupon = false;
        }
    }

    private async Task QuitarCupon()
    {
        _codigoCupon = string.Empty;
        _mensajeCupon = string.Empty;

        await Cart.RemoveAppliedCouponAsync();

        _cuponAplicado = null;
    }

    private decimal GetDiscountAmount()
    {
        return _cuponAplicado == null
            ? 0m
            : CuponApp.CalcularDescuento(
                _cuponAplicado,
                Cart.GetSubtotal());
    }

    private decimal GetOrderTotal()
    {
        return Math.Max(
            0m,
            Cart.GetSubtotal() + GetShippingCost() - GetDiscountAmount());
    }

    private string GetCouponDescription()
    {
        if (_cuponAplicado == null)
        {
            return string.Empty;
        }

        return _cuponAplicado.TipoDescuento.Equals(
            "PORCENTAJE",
            StringComparison.OrdinalIgnoreCase)
            ? $"{_cuponAplicado.ValorDescuento:0}% de descuento"
            : $"S/ {_cuponAplicado.ValorDescuento:0.00} de descuento";
    }

    private async Task PlaceOrder()
    {
        if (_procesandoPedido)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_fullName) ||
            string.IsNullOrWhiteSpace(_phone) ||
            string.IsNullOrWhiteSpace(_address) ||
            string.IsNullOrWhiteSpace(_city) ||
            string.IsNullOrWhiteSpace(_district))
        {
            Toast.ShowToast("Completa los datos de despacho antes de continuar.");
            return;
        }

        if (_paymentMethod == "card" &&
            (string.IsNullOrWhiteSpace(_cardNumber) ||
             string.IsNullOrWhiteSpace(_cardExpiry) ||
             string.IsNullOrWhiteSpace(_cardCvv)))
        {
            Toast.ShowToast("Completa los datos de tarjeta para continuar.");
            return;
        }

        if (!Auth.IsLoggedIn || Auth.CurrentClient == null || Auth.CurrentClient.Id <= 0)
        {
            Toast.ShowToast("Debes iniciar sesión antes de confirmar tu pedido.");
            Navigator.NavigateTo("/login");
            return;
        }

        _procesandoPedido = true;

        try
        {
            var datosDespacho = new DatosDespacho
            {
                NombreContacto = _fullName,
                Telefono = _phone,
                Direccion = _address,
                Ciudad = _city,
                Referencia = _district,
                CodigoPostal = _zip,
                Pais = "Peru"
            };

            var resultado = await CheckoutService.ProcesarPedidoAsync(
                Auth.CurrentClient,
                Cart.GetItems(),
                datosDespacho,
                _cuponAplicado);

            if (!resultado.Exitoso)
            {
                Toast.ShowToast(resultado.Mensaje);
                return;
            }

            _codigoPedidoGenerado = resultado.CodigoPedido;
            _isOrderComplete = true;

            Toast.ShowToast(resultado.Mensaje);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al confirmar pedido:");
            Console.WriteLine(ex.Message);

            Toast.ShowToast("Ocurrió un error al registrar el pedido.");
        }
        finally
        {
            _procesandoPedido = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        LangService.OnChange -= StateHasChanged;
        Cart.OnChange -= OnCartChanged;
    }
}