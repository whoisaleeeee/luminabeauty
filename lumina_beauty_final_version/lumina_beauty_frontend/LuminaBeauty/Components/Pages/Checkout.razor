@page "/checkout"
@inject LanguageService LangService
@inject CartService Cart
@inject CarroAppService CarroService
@inject ToastService Toast
@inject NavigationManager Navigator
@implements IDisposable

<PageTitle>Pagar Orden | Lumina Beauty</PageTitle>

<div class="max-w-7xl mx-auto px-1 sm:px-4 py-6 text-left">
    
    <!-- Breadcrumb Row -->
    <nav class="text-xs font-semibold text-stone-400 mb-8 flex items-center gap-2 select-none">
        <span class="hover:text-[#FF76A5] transition cursor-pointer" @onclick='() => NavigateTo("/")'>
          Inicio
        </span>
        <span class="text-stone-300">/</span>
        <span class="hover:text-[#FF76A5] transition cursor-pointer" @onclick='() => NavigateTo("/cart")'>
          Carrito de compras
        </span>
        <span class="text-stone-300">/</span>
        <span class="text-stone-600 font-bold">Checkout</span>
    </nav>

    @if (_isOrderComplete)
    {
       <!-- SPECTACULAR ORDER COMPLETE SCREEN -->
       <div class="bg-white/70 backdrop-blur-md rounded-[32px] border border-[#FCD1DB]/50 p-8 sm:p-14 text-center max-w-2xl mx-auto shadow-2xl space-y-6 animate-in zoom-in-95 duration-500">
         <div class="w-20 h-20 bg-green-50 rounded-full border border-green-200/50 flex items-center justify-center mx-auto text-[#FF76A5] text-3xl font-bold select-none animate-bounce">
           <span>✓</span>
         </div>

         <div class="space-y-2">
           <span class="text-[10px] font-black uppercase tracking-widest text-[#C7346A] bg-[#FFF0F3] px-3.5 py-1.5 rounded-full select-none">
             ¡PAGO PROCESADO EXITOSAMENTE!
           </span>
           <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-stone-900 pt-3 leading-tight">
             Tu ritual está en camino
           </h1>
           <p class="text-xs font-medium text-stone-500 max-w-md mx-auto leading-relaxed pt-1">
             Hemos registrado tu orden <strong class="font-mono text-stone-800">#LUM-@_generatedOrderNo</strong> de forma satisfactoria. Recibirás un correo electrónico de confirmación con los detalles de seguimiento en vivo en breves minutos.
           </p>
         </div>

         <!-- Delivery Address summary Card -->
         <div class="bg-[#FFF0F3]/40 border border-[#FFE3E8]/70 p-5 rounded-2xl max-w-md mx-auto text-left text-xs font-semibold space-y-1.5 font-sans select-none text-stone-700">
           <p class="font-bold text-stone-900 border-b border-stone-100 pb-1.5 uppercase text-[9px] tracking-widest text-[#C7346A] mb-1">
             Resumen del Envío
           </p>
           <p><span class="text-stone-400 font-bold text-[10px] uppercase block">Destinatario:</span> @_fullName</p>
           <p><span class="text-stone-400 font-bold text-[10px] uppercase block">Dirección:</span> @_address, @_district, @_city</p>
           <p><span class="text-stone-400 font-bold text-[10px] uppercase block">Contacto:</span> @_phone</p>
           <p><span class="text-stone-400 font-bold text-[10px] uppercase block">Método de Pago:</span> <span class="capitalize">@_paymentMethod</span></p>
         </div>

         <div class="pt-2 select-none">
           <button @onclick='() => NavigateTo("/")'
                   class="px-8 py-3.5 bg-stone-950 hover:bg-[#FF76A5] text-white font-bold text-xs uppercase tracking-widest rounded-xl transition duration-300 shadow cursor-pointer">
             Volver a la Tienda
           </button>
         </div>
       </div>
    }
    else
    {
       <h1 class="font-serif text-3xl font-medium tracking-tight text-stone-900 mb-8 select-none">
          Checkout de Belleza
       </h1>

       <!-- MAIN CHECKOUT STREAM -->
       <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
         
         <!-- Left Shipping Form & Payments methods (8 cols) -->
         <div class="lg:col-span-8 space-y-6">
           <form @onsubmit="PlaceOrder" class="space-y-6">
             
             <!-- SHIPPING CARD -->
             <div class="bg-white/80 backdrop-blur-md rounded-3xl border border-stone-100 p-6 sm:p-8 space-y-6 shadow-xs text-left">
               <h3 class="font-serif text-lg font-bold text-stone-900 border-b border-stone-100 pb-3 uppercase text-xs tracking-widest text-[#C7346A] select-none">
                 1. Datos de Despacho
               </h3>

               <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 pt-1">
                 
                 <div class="space-y-1">
                   <label class="text-[10px] font-black uppercase text-stone-400 tracking-wider select-none">Nombre de contacto</label>
                   <input type="text" required placeholder="Alexandra Arrobas..." @bind="_fullName"
                          class="w-full bg-[#faf6f7]/60 hover:bg-white focus:bg-white border border-stone-200 focus:border-[#FF76A5] text-xs font-bold rounded-xl px-3.5 py-2.5 transition" />
                 </div>

                 <div class="space-y-1">
                   <label class="text-[10px] font-black uppercase text-stone-400 tracking-wider select-none">Celular</label>
                   <input type="tel" required placeholder="999 999 999..." @bind="_phone"
                          class="w-full bg-[#faf6f7]/60 hover:bg-white focus:bg-white border border-stone-200 focus:border-[#FF76A5] text-xs font-bold rounded-xl px-3.5 py-2.5 transition" />
                 </div>

                 <div class="col-span-1 sm:col-span-2 space-y-1">
                   <label class="text-[10px] font-black uppercase text-stone-400 tracking-wider select-none">Dirección de entrega</label>
                   <input type="text" required placeholder="Av. Primavera 1234, Dpto 402, San Borja..." @bind="_address"
                          class="w-full bg-[#faf6f7]/60 hover:bg-white focus:bg-white border border-stone-200 focus:border-[#FF76A5] text-xs font-bold rounded-xl px-3.5 py-2.5 transition" />
                 </div>

                 <div class="grid grid-cols-3 col-span-1 sm:col-span-2 gap-4">
                   <div class="col-span-1 space-y-1">
                     <label class="text-[10px] font-black uppercase text-stone-400 tracking-wider select-none">Ciudad / Región</label>
                     <input type="text" required placeholder="Lima..." @bind="_city"
                            class="w-full bg-[#faf6f7]/60 hover:bg-white focus:bg-white border border-stone-200 focus:border-[#FF76A5] text-xs font-bold rounded-xl px-3.5 py-2.5 transition" />
                   </div>

                   <div class="col-span-1 space-y-1">
                     <label class="text-[10px] font-black uppercase text-stone-400 tracking-wider select-none">Distrito</label>
                     <input type="text" required placeholder="La Molina..." @bind="_district"
                            class="w-full bg-[#faf6f7]/60 hover:bg-white focus:bg-white border border-stone-200 focus:border-[#FF76A5] text-xs font-bold rounded-xl px-3.5 py-2.5 transition" />
                   </div>

                   <div class="col-span-1 space-y-1">
                     <label class="text-[10px] font-black uppercase text-stone-400 tracking-wider select-none">Código Postal</label>
                     <input type="text" placeholder="15024..." @bind="_zip"
                            class="w-full bg-[#faf6f7]/60 hover:bg-white focus:bg-white border border-stone-200 focus:border-[#FF76A5] text-xs font-bold rounded-xl px-3.5 py-2.5 transition" />
                   </div>
                 </div>

               </div>
             </div>

             <!-- PAYMENTS TABS CARD -->
             <div class="bg-white/80 backdrop-blur-md rounded-3xl border border-stone-100 p-6 sm:p-8 space-y-6 shadow-xs text-left">
               <h3 class="font-serif text-lg font-bold text-stone-900 border-b border-stone-100 pb-3 uppercase text-xs tracking-widest text-[#C7346A] select-none">
                 2. Método de Pago de Prestigio
               </h3>

               <!-- Tabs head picker -->
               <div class="grid grid-cols-3 gap-3 select-none">
                 @foreach (var opt in _paymentMethodsList)
                 {
                   var currentOpt = opt.Code;
                   var isActive = _paymentMethod == currentOpt;
                   <button type="button" @onclick="() => SelectPaymentMethod(currentOpt)"
                           class="py-3 px-1 rounded-xl border text-xs font-bold uppercase transition flex flex-col items-center justify-center gap-1.5 cursor-pointer @(isActive ? "bg-[#FFF0F3] text-[#C7346A] border-[#FF76A5]" : "bg-stone-50 text-stone-500 border-stone-200 hover:text-stone-800")">
                     <span class="text-sm">@opt.Icon</span>
                     <span>@opt.Label</span>
                   </button>
                 }
               </div>

               <!-- Active tab billing inputs details -->
               <div class="pt-2">
                 @if (_paymentMethod == "card")
                 {
                   <!-- Credit Card Fields -->
                   <div class="grid grid-cols-4 gap-4 animate-in fade-in duration-300">
                     <div class="col-span-4 space-y-1">
                       <label class="text-[10px] font-black uppercase text-stone-400 tracking-wider">Número de tarjeta de crédito</label>
                       <input type="text" required placeholder="XXXX XXXX XXXX XXXX..." @bind="_cardNumber"
                              class="w-full bg-[#faf6f7]/60 hover:bg-white focus:bg-white border border-stone-200 focus:border-[#FF76A5] text-xs font-bold rounded-xl px-3.5 py-2.5 transition" />
                     </div>
                     <div class="col-span-2 space-y-1">
                       <label class="text-[10px] font-black uppercase text-stone-400 tracking-wider">Vencimiento</label>
                       <input type="text" required placeholder="MM/AA..." @bind="_cardExpiry"
                              class="w-full bg-[#faf6f7]/60 hover:bg-white focus:bg-white border border-stone-200 focus:border-[#FF76A5] text-xs font-bold rounded-xl px-3.5 py-2.5 transition" />
                     </div>
                     <div class="col-span-2 space-y-1">
                       <label class="text-[10px] font-black uppercase text-stone-400 tracking-wider">CVV</label>
                       <input type="password" required maxlength="3" placeholder="123..." @bind="_cardCvv"
                              class="w-full bg-[#faf6f7]/60 hover:bg-white focus:bg-white border border-stone-200 focus:border-[#FF76A5] text-xs font-bold rounded-xl px-3.5 py-2.5 transition" />
                     </div>
                   </div>
                 }
                 else if (_paymentMethod == "plin" || _paymentMethod == "yape")
                 {
                   <!-- Plin / Yape text prompt -->
                   <div class="bg-[#FFF0F3]/40 border border-[#FCD1DB]/40 p-4 rounded-xl text-left text-xs font-semibold text-stone-700 leading-relaxed font-sans select-none">
                     <p class="font-bold text-[#C7346A] mb-1">📲 Depósito Rápido Directo</p>
                     <span>Realiza el abono móvil al número <strong>958-392-491</strong> de Lumina Beauty S.A.C. Luego, completa tu compra y validaremos la aprobación al instante.</span>
                   </div>
                 }
               </div>

             </div>

             <!-- SUBMIT MAIN BUTTON -->
             <button type="submit"
                     class="w-full bg-[#FF76A5] hover:bg-[#C7346A] active:scale-98 text-white font-bold text-xs tracking-widest uppercase py-4 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 block text-center cursor-pointer select-none">
               ✓ Confirmar y Pagar Orden
             </button>

           </form>
         </div>

         <!-- Right Order Summary billing details block (4 cols) -->
         <div class="lg:col-span-4 sticky top-24 select-none">
           <div class="bg-white/80 backdrop-blur-md rounded-3xl border border-[#FCD1DB]/50 p-6 shadow-md relative overflow-hidden text-stone-800 text-left">
             <div class="absolute top-0 inset-x-0 h-1 bg-[#FF76A5]" />

             <h3 class="font-serif text-lg font-bold text-stone-900 border-b border-stone-100 pb-3 mb-4 uppercase text-xs tracking-widest text-[#C7346A]">
               Resumen de Compra
             </h3>

             <!-- Products miniatures scroll table -->
             <div class="space-y-3.5 max-h-56 overflow-y-auto pr-1 pb-4 mb-4 border-b border-stone-100/60">
               @foreach (var item in Cart.GetItems())
               {
                 <div class="flex items-center gap-3.5 text-xs text-stone-900">
                   <img src="@item.Product.Image" alt="@item.Product.Name" class="w-11 h-11 object-contain rounded-lg border border-stone-200/55 p-0.5 bg-stone-50" referrerpolicy="no-referrer" />
                   <div class="flex-1 min-w-0 font-medium">
                     <p class="font-bold text-stone-900 truncate">@item.Product.Name</p>
                     <p class="text-[10px] text-stone-400 font-bold uppercase tracking-wider">
                       @item.Product.Brand x @item.Quantity
                     </p>
                   </div>
                   <span class="font-bold font-mono text-stone-900">
                     S/ @((item.Product.Price * item.Quantity).ToString("0.00"))
                   </span>
                 </div>
               }
             </div>

             <!-- Calc lists -->
             <div class="space-y-3 text-xs font-semibold text-stone-500 font-sans">
               <div class="flex justify-between items-center text-stone-600">
                 <span>Subtotal:</span>
                 <span class="font-extrabold font-mono text-stone-900">S/ @Cart.GetSubtotal().ToString("0.00")</span>
               </div>
               
               <div class="flex justify-between items-center">
                 <span>Envío:</span>
                 <span class="@(GetShippingCost() == 0 ? "text-green-600 font-bold font-mono" : "text-stone-900 font-bold font-mono")">
                     @(GetShippingCost() == 0 ? "Gratis" : $"S/ {GetShippingCost().ToString("0.00")}")
                 </span>
               </div>

               <div class="border-t border-stone-150 pt-3.5 mt-2 flex justify-between items-center text-sm font-bold text-stone-900">
                 <span>Importe total:</span>
                 <span class="text-base font-extrabold text-[#C7346A] font-mono">
                   S/ @((Cart.GetSubtotal() + GetShippingCost()).ToString("0.00"))
                 </span>
               </div>
             </div>

           </div>
         </div>

       </div>
    }

</div>

@code {
    // Delivery info states
    private string _fullName = string.Empty;
    private string _phone = string.Empty;
    private string _address = string.Empty;
    private string _city = string.Empty;
    private string _district = string.Empty;
    private string _zip = string.Empty;

    // Payment Tab State
    private string _paymentMethod = "card";

    // Card specifics
    private string _cardNumber = string.Empty;
    private string _cardExpiry = string.Empty;
    private string _cardCvv = string.Empty;

    private bool _isOrderComplete;
    private int _generatedOrderNo;

    private class PaymentMethodOption
    {
        public string Code { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
    }

    private readonly List<PaymentMethodOption> _paymentMethodsList = new()
    {
        new PaymentMethodOption { Code = "card", Label = "Tarjeta", Icon = "💳" },
        new PaymentMethodOption { Code = "plin", Label = "Plin", Icon = "📲" },
        new PaymentMethodOption { Code = "yape", Label = "Yape", Icon = "⚡" }
    };

    protected override void OnInitialized()
    {
        LangService.OnChange += StateHasChanged;
        Cart.OnChange += StateHasChanged;
    }

    private void NavigateTo(string path) => Navigator.NavigateTo(path);

    private void SelectPaymentMethod(string m) => _paymentMethod = m;

    private decimal GetShippingCost() => (Cart.GetSubtotal() >= 199m) ? 0m : 15m;

    private async Task PlaceOrder()
    {
        if (string.IsNullOrEmpty(_fullName) || string.IsNullOrEmpty(_phone) || string.IsNullOrEmpty(_address))
        {
            Toast.ShowToast("Por favor completa los campos obligatorios de entrega");
            return;
        }

        if (_paymentMethod == "card" && (string.IsNullOrEmpty(_cardNumber) || string.IsNullOrEmpty(_cardExpiry)))
        {
            Toast.ShowToast("Completa los datos de tarjeta de crédito para validar la transacción");
            return;
        }

        // Descontar stock en el backend para cada producto del carrito
        var items = Cart.GetItems();
        foreach (var item in items)
        {
            var descontado = await CarroService.DescontarStockAsync(item.Product.Id, item.Quantity);
            if (!descontado)
            {
                // Log pero no bloquear la compra — el backend puede estar offline en desarrollo
                Console.WriteLine($"Advertencia: No se pudo descontar stock de {item.Product.Name}");
            }
        }

        // Successfully generate simulated order inside user histories
        _generatedOrderNo = new Random().Next(1001, 9999);
        _isOrderComplete = true;

        Toast.ShowToast(LangService.CurrentLanguage == "es" ? "🎉 ¡Compra procesada de forma estelar!" : "Order dispatched successfully!");

        // Flush active shopping cart
        await Cart.ClearCartAsync();
    }

    public void Dispose()
    {
        LangService.OnChange -= StateHasChanged;
        Cart.OnChange -= StateHasChanged;
    }
}
