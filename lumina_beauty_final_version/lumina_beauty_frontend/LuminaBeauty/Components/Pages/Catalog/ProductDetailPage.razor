@page "/product/{id}"
@using LuminaBeauty.Models
@inject ProductService ProductCache
@inject ValoracionAppService ValoracionApp
@inject CartService Cart
@inject WishlistService Wishlist
@inject LanguageService LangService
@inject ToastService Toast
@inject LayoutStateService LayoutState
@inject NavigationManager Navigator
@implements IDisposable

<PageTitle>@(_product?.Name ?? "Detalle de Producto") | Lumina Beauty</PageTitle>

@if (_product == null)
{
    <div class="py-20 text-center select-none">
        <h2 class="mb-2 font-serif text-2xl text-stone-900">
            Producto no encontrado
        </h2>

        <p class="mb-8 text-xs text-stone-500">
            El producto que buscas no existe o ha sido retirado.
        </p>

        <button @onclick="GoBack"
                class="rounded-xl bg-stone-950 px-6 py-2.5 text-xs font-bold uppercase text-white transition hover:bg-[#FF76A5]">
            Volver a la tienda
        </button>
    </div>
}
else
{
    <div class="space-y-8 text-left">

        <nav class="mb-10 flex flex-wrap items-center gap-1.5 text-[11px] font-semibold uppercase tracking-widest text-stone-400 sm:text-xs select-none">
            <button @onclick="GoBack"
                    class="cursor-pointer transition hover:text-[#FF76A5]">
                Inicio
            </button>

            <span>/</span>

            <button @onclick="GoToCategory"
                    class="cursor-pointer transition hover:text-[#FF76A5]">
                @_product.Category
            </button>

            <span>/</span>

            <span class="max-w-[220px] truncate font-bold text-[#FF76A5]">
                @_product.Name
            </span>
        </nav>

        <section class="relative grid grid-cols-1 gap-8 overflow-hidden rounded-[32px] border border-white/60 bg-white/35 p-6 shadow-2xl backdrop-blur-xl sm:p-10 lg:grid-cols-12 lg:gap-14">

            <div class="pointer-events-none absolute left-1/2 top-1/2 h-[350px] w-[350px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#FF76A5]/10 blur-3xl"></div>

            <!-- Miniaturas reales -->
            <div class="order-2 flex items-center justify-center gap-3 overflow-x-auto pb-3 select-none lg:order-1 lg:col-span-2 lg:flex-col lg:overflow-x-visible lg:pb-0">

                @for (int i = 0; i < _galleryImages.Count; i++)
                {
                    var index = i;
                    var image = _galleryImages[index];

                    <button @onclick="() => _detailThumb = index"
                            aria-label="Ver imagen @(index + 1) del producto"
                            class="relative h-16 w-16 shrink-0 overflow-hidden rounded-xl border-2 bg-white p-1 transition-all duration-300 sm:h-20 sm:w-20 @(_detailThumb == index
                                                            ? "scale-105 border-[#FF76A5] shadow-md"
                                                            : "border-white/80 hover:border-stone-300")">

                <img src="@image"
                     alt="@($"{_product.Name} - imagen {index + 1}")"
                     class="h-full w-full object-contain"
                     referrerpolicy="no-referrer" />
            </button>
        }
    </div>

    <!-- Imagen principal -->
    <div class="relative order-1 flex min-h-[300px] max-w-full flex-col items-center justify-center rounded-2xl sm:min-h-[460px] lg:order-2 lg:col-span-5">

        <div class="absolute inset-0 -z-10 rounded-3xl border border-white/50 bg-white/20 p-5 shadow-lg transition-all duration-500"></div>

        <img src="@CurrentGalleryImage"
             alt="@_product.Name"
             class="pointer-events-none w-auto max-h-[320px] select-none object-contain drop-shadow-2xl transition-transform duration-700 hover:scale-105 sm:max-h-[440px] md:max-h-[480px]"
             referrerpolicy="no-referrer" />

        @if (!string.IsNullOrWhiteSpace(_product.DiscountBadge) || !string.IsNullOrWhiteSpace(_product.Discount))
        {
            <span class="absolute left-4 top-4 rounded-full border border-white/35 bg-[#FF76A5] px-3 py-1 text-xs font-black text-white shadow-lg select-none">
                @(_product.DiscountBadge ?? _product.Discount) de descuento
            </span>
        }
    </div>

    <!-- Información y compra -->
    <div class="order-3 flex flex-col justify-between space-y-6 lg:col-span-5">

        <div class="space-y-4">
            <div class="space-y-2">
                <span class="inline-flex rounded-md border border-[#FCD1DB]/50 bg-[#FFF0F3] px-2.5 py-1 text-xs font-black uppercase tracking-widest text-[#FF76A5] select-none">
                    @_product.Brand
                </span>

                <h1 class="pt-2 font-serif text-3xl font-medium leading-tight text-stone-900 sm:text-4xl">
                    @_product.Name
                </h1>
            </div>

            <div class="flex flex-wrap items-center gap-3 select-none">

                <div class="flex items-center text-amber-400">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <span class="@(i <= Math.Round(_product.Rating) ? "text-amber-400" : "text-stone-200")">
                            ★
                        </span>
                    }
                </div>

                <span class="text-xs font-semibold text-stone-500">
                    (@_product.ReviewsCount opiniones)
                </span>

                <span class="text-stone-300">|</span>

                <span class="inline-flex items-center gap-1.5 text-xs font-extrabold text-emerald-600">
                    <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                    Disponible
                </span>
            </div>

            <div class="py-2 select-none">
                <span class="font-serif text-3xl font-extrabold tracking-wider text-[#C7346A] sm:text-4xl">
                    S/ @_product.Price.ToString("0.00")
                </span>

                @if (_product.OriginalPrice != null && _product.OriginalPrice > _product.Price)
                {
                    <span class="ml-3 text-sm text-stone-400 line-through">
                        S/ @_product.OriginalPrice.Value.ToString("0.00")
                    </span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_product.Description))
            {
                <p class="max-w-md text-xs font-medium leading-relaxed text-stone-600">
                    @_product.Description
                </p>
            }
        </div>

        <div class="space-y-4 border-t border-[#FCD1DB]/30 pt-4">

            <div class="flex flex-col items-stretch gap-3 select-none sm:flex-row sm:items-center">

                <div class="flex w-full items-center justify-between rounded-xl border border-stone-200 bg-white/90 px-2 py-1.5 sm:w-32">
                    <button @onclick="() => ChangeQty(-1)"
                            disabled="@(_detailQty <= 1)"
                            aria-label="Reducir cantidad"
                            class="cursor-pointer p-1 text-stone-500 transition hover:text-[#C7346A] disabled:opacity-30">
                        −
                    </button>

                    <span class="w-8 text-center font-mono text-sm font-extrabold text-stone-900">
                        @_detailQty
                    </span>

                    <button @onclick="() => ChangeQty(1)"
                            aria-label="Aumentar cantidad"
                            class="cursor-pointer p-1 text-stone-500 transition hover:text-[#C7346A]">
                        +
                    </button>
                </div>

                <button @onclick="BuyNow"
                        class="flex flex-1 cursor-pointer items-center justify-center gap-2 rounded-xl bg-[#E99AB3] px-8 py-3.5 text-sm font-bold uppercase tracking-wider text-[#9C3155] shadow-lg transition duration-300 hover:bg-[#E889A6] active:scale-95">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         class="h-4 w-4"
                         aria-hidden="true">
                        <path d="M3 7h18l-1 13H4L3 7Z" />
                        <path d="M8 7a4 4 0 0 1 8 0" />
                    </svg>

                    <span>Añadir</span>
                </button>

                @{
                    var isFavorite = Wishlist.IsInWishlist(_product.Id);
                }

                <button type="button"
                        @onclick="ToggleWishlist"
                        aria-label="@(isFavorite ? "Quitar de favoritos" : "Guardar en favoritos")"
                        aria-pressed="@isFavorite"
                        title="@(isFavorite ? "Quitar de favoritos" : "Guardar en favoritos")"
                        class="flex h-12 w-12 cursor-pointer items-center justify-center rounded-xl border transition duration-200 active:scale-95 @(isFavorite
                                                            ? "border-[#FF76A5] bg-[#FFF0F3] text-[#C7346A] shadow-[0_6px_14px_rgba(199,52,106,0.14)]"
                                                            : "border-stone-200 bg-white text-stone-400 hover:border-[#F6D7E0] hover:bg-[#FFF8FA] hover:text-[#C7346A]")">

                    <svg viewBox="0 0 24 24"
                         fill="@(isFavorite ? "currentColor" : "none")"
                         stroke="currentColor"
                         stroke-width="1.8"
                         class="h-5 w-5 transition-transform duration-200 @(isFavorite ? "scale-105" : "")"
                         aria-hidden="true">
                        <path d="M20.8 4.6a5.4 5.4 0 0 0-7.6 0L12 5.8l-1.2-1.2a5.4 5.4 0 0 0-7.6 7.6L12 21l8.8-8.8a5.4 5.4 0 0 0 0-7.6Z" />
                    </svg>
                </button>
            </div>

            <div class="flex items-center gap-4 rounded-2xl border border-stone-100 bg-white/80 p-4 select-none">

                <div class="rounded-xl border border-[#FFE3E8]/80 bg-[#FFF0F3] p-3 text-[#C7346A]">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         class="h-5 w-5"
                         aria-hidden="true">
                        <path d="M3 7h11v9H3z" />
                        <path d="M14 10h3l4 4v2h-7z" />
                        <path d="M7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" />
                        <path d="M18 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" />
                    </svg>
                </div>

                <div class="text-stone-800">
                    <h4 class="text-xs font-extrabold uppercase tracking-wider text-stone-900">
                        Envío gratuito
                    </h4>

                    <p class="text-[10px] font-bold text-stone-500">
                        Para compras mayores a S/ 199.
                    </p>
                </div>
            </div>

            <button @onclick="GoBack"
                    class="flex w-fit cursor-pointer items-center gap-1.5 text-xs font-bold text-stone-400 transition hover:text-[#FF76A5]">
                ← Volver a la tienda
            </button>
        </div>
    </div>
</section>

<section class="rounded-2xl border border-white/50 bg-white/20 p-6 text-left backdrop-blur-md sm:p-8">

    <div class="flex flex-wrap items-start justify-between gap-4 border-b border-stone-100 pb-4">
        <div>
            <h3 class="text-sm font-extrabold uppercase tracking-widest text-[#C7346A] select-none">
                Opiniones de clientes
            </h3>

            <p class="mt-1 text-[11px] text-stone-500">
                Valoraciones publicadas por clientes de Lumina Beauty.
            </p>
        </div>

        <span class="rounded-full border border-[#FCD1DB] bg-[#FFF0F3] px-3 py-1.5 text-[9px] font-black uppercase tracking-wider text-[#C7346A]">
            @_product.ReviewsCount opiniones
        </span>
    </div>

    @if (_isLoadingReviews)
    {
        <p class="py-10 text-center text-xs font-bold text-stone-400">
            Cargando opiniones...
        </p>
    }
    else if (_reviews.Count == 0)
    {
        <div class="mt-6 rounded-2xl border border-dashed border-[#FCD1DB] bg-[#FFF0F3]/35 p-8 text-center">
            <p class="text-xs font-bold text-stone-700">
                Aún no hay opiniones publicadas para este producto.
            </p>

            <p class="mt-1 text-[11px] text-stone-500">
                Las valoraciones aprobadas aparecerán aquí.
            </p>
        </div>
    }
    else
    {
        <div class="mt-6 space-y-3">
            @foreach (var review in _reviews)
            {
                <article class="rounded-2xl border border-stone-100 bg-white/65 p-5">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div>
                            <p class="text-xs font-bold text-stone-800">
                                Cliente Lumina
                            </p>

                            <div class="mt-2 flex items-center gap-0.5 text-xs text-amber-400">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span class="@(i <= review.Calificacion ? "text-amber-400" : "text-stone-200")">
                                        ★
                                    </span>
                                }
                            </div>
                        </div>

                        @if (review.FechaCreacion.HasValue)
                        {
                            <span class="text-[10px] font-medium text-stone-400">
                                @review.FechaCreacion.Value.ToString("dd/MM/yyyy")
                            </span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(review.Comentario))
                    {
                        <p class="mt-4 text-xs leading-relaxed text-stone-600">
                            “@review.Comentario”
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(review.RespuestaTienda))
                    {
                        <div class="mt-4 rounded-xl border border-[#FCD1DB]/60 bg-[#FFF0F3]/45 p-4">
                            <p class="text-[9px] font-black uppercase tracking-widest text-[#C7346A]">
                                Respuesta de Lumina Beauty
                            </p>

                            <p class="mt-2 text-[11px] leading-relaxed text-stone-600">
                                @review.RespuestaTienda
                            </p>
                        </div>
                    }
                </article>
            }
        </div>
    }
</section>

@if (_related.Count > 0)
{
    <section class="mt-16 space-y-8">
        <div class="flex items-center gap-3 text-left select-none">
            <span class="inline-block h-6 w-1 rounded-full bg-[#FF76A5] shadow-sm"></span>

            <h2 class="font-serif text-lg font-black uppercase tracking-wider text-[#C7346A]">
                Secretos similares
            </h2>
        </div>

        <div class="grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-4">
            @foreach (var relatedProduct in _related)
            {
                <ProductCard Product="@relatedProduct" />
            }
        </div>
    </section>
}
</div>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private Product? _product;
    private List<Product> _related = new();
    private List<string> _galleryImages = new();

    private int _detailThumb;
    private int _detailQty = 1;

    private List<Valoracion> _reviews = new();
    private bool _isLoadingReviews;

    private string CurrentGalleryImage =>
        _galleryImages.ElementAtOrDefault(_detailThumb)
        ?? _product?.Image
        ?? string.Empty;

    protected override void OnInitialized()
    {
        LangService.OnChange += StateHasChanged;
        Wishlist.OnChange += StateHasChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await ProductCache.EnsureLoadedAsync();

        _product = ProductCache.GetProductById(Id);
        _detailThumb = 0;
        _detailQty = 1;
        _reviews = new();
        _related = new();
        _galleryImages = GetProductImages();

        if (_product != null)
        {
            await CargarValoracionesAsync(_product.IdProducto);

            _related = ProductCache.GetAllProducts()
                .Where(product =>
                    product.Id != _product.Id &&
                    product.Category == _product.Category)
                .Take(4)
                .ToList();
        }
    }

    private List<string> GetProductImages()
    {
        if (_product == null || string.IsNullOrWhiteSpace(_product.Image))
        {
            return new();
        }

        var imagePath = _product.Image;
        var extension = Path.GetExtension(imagePath);

        if (string.IsNullOrWhiteSpace(extension))
        {
            return new List<string> { imagePath };
        }

        var basePath = imagePath[..^extension.Length];

        return new List<string>
        {
            imagePath,
            $"{basePath}-2{extension}",
            $"{basePath}-3{extension}"
        };
    }

    private void GoBack()
    {
        Navigator.NavigateTo("/shop");
    }

    private void GoToCategory()
    {
        if (_product != null)
        {
            Navigator.NavigateTo(
                $"/shop?category={Uri.EscapeDataString(_product.Category)}"
            );
        }
    }

    private void ChangeQty(int amount)
    {
        _detailQty = Math.Max(1, _detailQty + amount);
    }

    private async Task BuyNow()
    {
        if (_product == null)
        {
            return;
        }

        await Cart.AddToCartAsync(_product, _detailQty);

        Toast.ShowToast(
            LangService.CurrentLanguage == "es"
                ? $"Agregado a la bolsa: {_product.Name}"
                : $"Added to bag: {_product.Name}"
        );

        LayoutState.SetCartDrawerOpen(true);
    }

    private async Task ToggleWishlist()
    {
        if (_product == null)
        {
            return;
        }

        await Wishlist.ToggleWishlistAsync(_product.Id);

        var isSaved = Wishlist.IsInWishlist(_product.Id);

        Toast.ShowToast(
            isSaved
                ? "Guardado en favoritos"
                : "Removido de favoritos"
        );

        StateHasChanged();
    }

    private async Task CargarValoracionesAsync(int idProducto)
    {
        try
        {
            _isLoadingReviews = true;

            _reviews = await ValoracionApp
                .ListarPublicadasPorProductoAsync(idProducto);
        }
        catch
        {
            _reviews = new();
        }
        finally
        {
            _isLoadingReviews = false;
        }
    }

    public void Dispose()
    {
        LangService.OnChange -= StateHasChanged;
        Wishlist.OnChange -= StateHasChanged;
    }
} 