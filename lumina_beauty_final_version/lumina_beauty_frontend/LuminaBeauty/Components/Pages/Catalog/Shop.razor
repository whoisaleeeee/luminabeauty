@page "/shop"
@inject ShopAppService ShopApp
@inject LanguageService LangService
@inject NavigationManager Navigator
@using Microsoft.AspNetCore.Components
@implements IDisposable

<PageTitle>Tienda | Lumina Beauty</PageTitle>

<div class="shop-page mx-auto w-full max-w-[1380px] px-4 py-6 text-left sm:px-6 lg:px-8">

    <nav class="mb-4 flex items-center gap-2 text-xs font-semibold text-stone-400 select-none">
        <span class="cursor-pointer transition hover:text-[#C7346A]"
              @onclick='() => Navigator.NavigateTo("/")'>
            Inicio
        </span>

        <span class="text-stone-300">/</span>

        <span class="font-bold text-stone-600">
            Tienda
        </span>
    </nav>

    @if (!ShopApp.State.IsReady)
    {
        <div class="rounded-3xl border border-[#FCD1DB]/50 bg-white/75 p-12 text-center shadow-sm">
            <p class="text-sm font-semibold text-stone-500">
                Cargando catálogo...
            </p>
        </div>
    }
    else
    {
        var products = ShopApp.GetVisibleProducts();
        var pagedProducts = ShopApp.GetPagedProducts();
        var totalPages = ShopApp.GetTotalPages();

        <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[228px_minmax(0,1fr)]">

            <aside class="shop-sidebar">
                <div class="space-y-5 rounded-3xl border border-stone-200/80 bg-white/80 p-4 shadow-[0_12px_30px_rgba(194,104,137,0.06)] backdrop-blur-md lg:sticky lg:top-20">

                    <div>
                        <div class="mb-3 flex items-center justify-between">
                            <p class="text-[10px] font-black uppercase tracking-[0.18em] text-stone-800">
                                Categorías
                            </p>

                            <span class="rounded-full border border-[#F8D7E1] bg-[#FFF7F9] px-2 py-1 text-[9px] font-black text-[#C7346A]">
                                @ShopApp.State.AllProducts.Count
                            </span>
                        </div>

                        <div class="space-y-1">
                            <button @onclick="() => ShopApp.SelectCategory(null)"
                                    class="group flex w-full cursor-pointer items-center justify-between rounded-xl px-3 py-2.5 text-left text-sm font-semibold transition @(string.IsNullOrWhiteSpace(ShopApp.State.ActiveCategory)
                                                                                                                                                    ? "bg-[#FFF0F3] text-[#C7346A]"
                                                                                                                                                    : "text-stone-600 hover:bg-stone-50 hover:text-[#C7346A]")">

                                <span>Todos los productos</span>

                                <span class="text-[10px] font-bold text-stone-400">
                                    @ShopApp.State.AllProducts.Count
                                </span>
                            </button>

                            @foreach (var category in ShopApp.State.Categories)
                            {
                                var isActive = ShopApp.State.ActiveCategory?.Equals(
                                    category.Name,
                                    StringComparison.OrdinalIgnoreCase
                                ) == true;

                                <button @onclick="() => ShopApp.SelectCategory(category.Name)"
                                        class="group flex w-full cursor-pointer items-center justify-between rounded-xl px-3 py-2.5 text-left text-sm font-semibold transition @(isActive
                                                                                                                                                                    ? "bg-[#FFF0F3] text-[#C7346A]"
                                                                                                                                                                    : "text-stone-600 hover:bg-stone-50 hover:text-[#C7346A]")">

                                    <span class="truncate">
                                        @category.Name
                                    </span>

                                    <span class="ml-3 shrink-0 text-[10px] font-bold text-stone-400">
                                        @category.ProductCount
                                    </span>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="border-t border-stone-100 pt-5">
                        <div class="mb-5 flex items-center justify-between">
                            <p class="text-[10px] font-black uppercase tracking-[0.18em] text-stone-800">
                                Filtros
                            </p>

                            <button @onclick="ShopApp.ResetFilters"
                                    disabled="@(!HasActiveFilters)"
                                    class="cursor-pointer text-[10px] font-black uppercase tracking-wider text-[#C7346A] transition hover:text-[#9E2B55] disabled:cursor-default disabled:opacity-35">
                                Limpiar
                            </button>
                        </div>

                        <div class="space-y-5">

                            @if (ShopApp.State.AvailableBrands.Count > 0)
                            {
                                <div class="space-y-3">
                                    <p class="text-[10px] font-black uppercase tracking-[0.16em] text-stone-400">
                                        Marca
                                    </p>

                                    <div class="max-h-40 space-y-2 overflow-y-auto pr-1">
                                        @foreach (var brand in ShopApp.State.AvailableBrands)
                                        {
                                            var isSelected = ShopApp.State.SelectedBrands.Contains(brand);

                                            <label class="flex cursor-pointer items-center gap-2.5 rounded-lg px-1 py-0.5 text-[13px] font-medium text-stone-700 transition hover:bg-[#FFF9FA]">
                                                <input type="checkbox"
                                                       checked="@isSelected"
                                                       @onchange="@(() => ShopApp.ToggleBrand(brand))"
                                                       class="h-4 w-4 cursor-pointer rounded border-stone-300 accent-[#FF76A5]" />

                                                <span>@brand</span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            }

                            @if (ShopApp.State.MaximumPrice > 0)
                            {
                                <div class="space-y-3">
                                    <div class="flex items-center justify-between">
                                        <p class="text-[10px] font-black uppercase tracking-[0.16em] text-stone-400">
                                            Precio máximo
                                        </p>

                                        <span class="text-sm font-bold text-stone-800">
                                            S/ @ShopApp.State.SelectedMaximumPrice.ToString("0.00")
                                        </span>
                                    </div>

                                    <input type="range"
                                           min="0"
                                           max="@ShopApp.State.MaximumPrice"
                                           step="1"
                                           @bind="ShopApp.State.SelectedMaximumPrice"
                                           @bind:event="oninput"
                                           class="w-full cursor-pointer accent-[#FF76A5] [accent-color:#FF76A5]" />
                                </div>
                            }

                            <div class="space-y-3">
                                <p class="text-[10px] font-black uppercase tracking-[0.16em] text-stone-400">
                                    Valoración mínima
                                </p>

                                @foreach (var rating in new[] { 4.5, 4.0, 3.5 })
                                {
                                    var currentRating = rating;
                                    var isSelected = ShopApp.State.MinimumRating == currentRating;

                                    <button @onclick="() => ShopApp.ToggleMinimumRating(currentRating)"
                                            class="flex w-full cursor-pointer items-center gap-2 rounded-xl px-3 py-2.5 text-left text-sm font-semibold transition @(isSelected
                                                                                                                                                                                    ? "bg-[#FFF0F3] text-[#C7346A]"
                                                                                                                                                                                    : "text-stone-600 hover:bg-stone-50")">

                                        <span class="tracking-[0.08em] text-[#D88C2C]">★★★★★</span>
                                        <span>@currentRating.ToString("0.0")+ </span>
                                    </button>
                                }
                            </div>

                            <label class="flex cursor-pointer items-center gap-2.5 text-sm font-semibold text-stone-700">
                                <input type="checkbox"
                                       @bind="ShopApp.State.OnlyInStock"
                                       class="h-4 w-4 cursor-pointer rounded border-stone-300 accent-[#FF76A5]" />

                                <span>Solo productos con stock</span>
                            </label>
                        </div>
                    </div>
                </div>
            </aside>

            <section class="space-y-3">

                <div class="flex flex-col gap-4 rounded-3xl border border-stone-200/80 bg-white/80 px-5 py-4 shadow-[0_10px_26px_rgba(194,104,137,0.05)] backdrop-blur-md sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-[0.16em] text-[#C7346A]">
                            @GetCatalogEyebrow()
                        </p>
                        <p class="mt-1 text-sm font-bold text-stone-900">
                            @products.Count producto@(products.Count == 1 ? "" : "s") encontrado@(products.Count == 1 ? "" : "s")
                        </p>
                        <p class="mt-1 text-[11px] text-stone-500">
                            Explora productos seleccionados para acompañar tu rutina.
                        </p>
                    </div>

                    <div class="flex w-full items-center justify-between rounded-xl border border-stone-200 bg-[#FFFDFD] px-3.5 py-2.5 sm:w-auto sm:justify-start">
                        <span class="mr-2 text-[9px] font-black uppercase tracking-[0.14em] text-stone-400">
                            Ordenar por
                        </span>

                        <select @bind="ShopApp.State.SortBy"
                                class="min-w-0 cursor-pointer border-0 bg-transparent py-0.5 pr-7 text-[13px] font-bold text-stone-700 outline-none focus:ring-0">
                            <option value="relevance">Relevancia</option>
                            <option value="best_sellers">Más vendidos</option>
                            <option value="rating">Mejor valorados</option>
                            <option value="price_asc">Menor precio</option>
                            <option value="price_desc">Mayor precio</option>
                        </select>
                    </div>
                </div>

                @if (products.Count == 0)
                {
                    <div class="rounded-3xl border border-dashed border-[#FCD1DB] bg-[#FFF0F3]/35 p-12 text-center">
                        <p class="text-base font-bold text-stone-700">
                            No hay productos con los filtros seleccionados.
                        </p>

                        <p class="mt-2 text-sm text-stone-500">
                            Ajusta los filtros para explorar más productos.
                        </p>

                        <button @onclick="ShopApp.ResetFilters"
                                class="mt-5 cursor-pointer rounded-xl bg-stone-950 px-5 py-3 text-[11px] font-bold uppercase tracking-wider text-white transition hover:bg-[#C7346A]">
                            Restaurar filtros
                        </button>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3">
                        @foreach (var product in pagedProducts)
                        {
                            <ProductCard Product="@product" />
                        }
                    </div>

                    @if (totalPages > 1)
                    {
                        <div class="flex flex-wrap items-center justify-center gap-2 pt-5">
                            <button @onclick="() => ShopApp.GoToPage(ShopApp.State.CurrentPage - 1)"
                                    disabled="@(ShopApp.State.CurrentPage == 1)"
                                    class="cursor-pointer rounded-xl border border-stone-200 bg-white px-4 py-2.5 text-[11px] font-bold uppercase tracking-wider text-stone-600 transition hover:border-[#FCD1DB] hover:bg-[#FFF0F3] hover:text-[#C7346A] disabled:cursor-not-allowed disabled:opacity-40">
                                Anterior
                            </button>

                            @for (int page = 1; page <= totalPages; page++)
                            {
                                var currentPage = page;
                                var isCurrent = ShopApp.State.CurrentPage == currentPage;

                                <button @onclick="() => ShopApp.GoToPage(currentPage)"
                                        class="h-10 min-w-10 cursor-pointer rounded-xl px-3 text-xs font-bold transition @(isCurrent
                                                                                                                                                                    ? "bg-stone-950 text-white"
                                                                                                                                                                    : "border border-stone-200 bg-white text-stone-600 hover:border-[#FCD1DB] hover:bg-[#FFF0F3] hover:text-[#C7346A]")">
                            @currentPage
                        </button>
                    }

                    <button @onclick="() => ShopApp.GoToPage(ShopApp.State.CurrentPage + 1)"
                            disabled="@(ShopApp.State.CurrentPage == totalPages)"
                            class="cursor-pointer rounded-xl border border-stone-200 bg-white px-4 py-2.5 text-[11px] font-bold uppercase tracking-wider text-stone-600 transition hover:border-[#FCD1DB] hover:bg-[#FFF0F3] hover:text-[#C7346A] disabled:cursor-not-allowed disabled:opacity-40">
                        Siguiente
                    </button>
                </div>
            }
        }
    </section>
</div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "category")]
    public string? CategoryFromUrl { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortFromUrl { get; set; }

    private bool _catalogInitialized;

    protected override void OnInitialized()
    {
        LangService.OnChange += StateHasChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_catalogInitialized)
        {
            await ShopApp.InitializeAsync();
            _catalogInitialized = true;
        }

        if (string.IsNullOrWhiteSpace(CategoryFromUrl))
        {
            ShopApp.SelectCategory(null);
        }
        else
        {
            var matchingCategory = ShopApp.State.Categories.FirstOrDefault(category =>
                category.Name.Equals(
                    CategoryFromUrl,
                    StringComparison.OrdinalIgnoreCase));

            ShopApp.SelectCategory(matchingCategory?.Name);
        }

        ShopApp.State.SortBy = SortFromUrl?.Equals(
            "mas-vendidos",
            StringComparison.OrdinalIgnoreCase) == true
                ? "best_sellers"
                : "relevance";
    }

    private bool HasActiveFilters =>
        ShopApp.State.SelectedBrands.Count > 0 ||
        ShopApp.State.MinimumRating.HasValue ||
        ShopApp.State.OnlyInStock ||
        ShopApp.State.SelectedMaximumPrice < ShopApp.State.MaximumPrice;

    private string GetCatalogEyebrow()
    {
        if (ShopApp.State.SortBy == "best_sellers")
        {
            return "Más vendidos";
        }

        return string.IsNullOrWhiteSpace(ShopApp.State.ActiveCategory)
            ? "Todo el catálogo"
            : ShopApp.State.ActiveCategory;
    }

    public void Dispose()
    {
        LangService.OnChange -= StateHasChanged;
    }
}