@page "/signup"
@inject LanguageService LangService
@inject AuthService Auth
@inject ClienteAppService ClienteService
@inject ToastService Toast
@inject NavigationManager Navigator
@implements IDisposable

<PageTitle>Crear Cuenta | Lumina Beauty</PageTitle>

<div id="signup-workspace" class="space-y-8 text-left">

    <!-- Breadcrumbs -->
    <div id="signup-breadcrumbs"
         class="text-left text-[11px] sm:text-xs font-semibold text-stone-400 uppercase tracking-widest mb-10 flex flex-wrap items-center gap-1.5 leading-none select-none">
        <span class="hover:text-[#FF76A5] cursor-pointer transition" @onclick='() => NavigateTo("/")'>
            @LangService.Translate("inicio")
        </span>
        <span>/</span>
        <span class="text-[#FF76A5] font-bold">@LangService.Translate("ingresar")</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 bg-white/35 backdrop-blur-xl border border-white/60 rounded-[32px] p-6 sm:p-10 shadow-2xl relative overflow-hidden">

        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] h-[350px] bg-[#FF76A5]/10 rounded-full filter blur-3xl pointer-events-none"></div>

        <!-- Columna izquierda -->
        <div class="lg:col-span-7 rounded-[24px] overflow-hidden relative min-h-[350px] sm:min-h-[500px] flex flex-col justify-between p-8 sm:p-12 text-left bg-gradient-to-br from-[#EAF7FA] to-[#FFF0F3] border border-white/50 shadow-inner group select-none">

            <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_120%,#FF76A5/15,transparent_50%)]"></div>
            <div class="absolute top-1/4 right-8 w-16 h-16 rounded-full bg-white/20 backdrop-blur-md border border-white/40 shadow-lg -rotate-12 group-hover:rotate-12 transition duration-700"></div>
            <div class="absolute bottom-1/4 left-10 w-24 h-24 rounded-[2rem] bg-pink-100/30 backdrop-blur-sm border border-white/30 shadow-md rotate-45 group-hover:scale-105 transition duration-700 pointer-events-none"></div>

            <div class="relative z-10">
                <span class="text-[10px] font-black tracking-[0.25em] text-[#C7346A] uppercase bg-[#FFF0F3] border border-[#FFE3E8]/80 py-1.5 px-3.5 rounded-full select-none inline-block">
                    @LangService.Translate("sculturaTitle")
                </span>
            </div>

            <div class="relative z-10 w-full flex items-center justify-center my-6">
                <div class="relative max-w-[280px] w-full">
                    <div class="absolute -inset-4 bg-white/20 backdrop-blur-md rounded-[2.5rem] border border-white/50 shadow-xl -rotate-3 scale-105 group-hover:rotate-1 group-hover:scale-110 transition duration-700"></div>
                    <div class="absolute inset-0 bg-gradient-to-tr from-[#FF76A5]/25 to-transparent rounded-[2rem] blur-xl opacity-80"></div>

                    <div class="relative bg-white/60 backdrop-blur-md rounded-[2rem] border border-white/90 p-3 shadow-xl overflow-hidden aspect-square flex items-center justify-center">
                        <img src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=700&q=80"
                             alt="Lumina Beauty"
                             class="w-full h-full object-cover rounded-[1.5rem] shadow-inner transition duration-500 hover:scale-105 pointer-events-none" />
                        <div class="absolute inset-0 bg-gradient-to-tr from-white/30 via-transparent to-white/10 pointer-events-none"></div>
                    </div>
                </div>
            </div>

            <div class="relative z-10 space-y-2.5 mt-4">
                <h2 class="font-display font-medium text-2xl sm:text-3xl text-stone-900 tracking-tight leading-tight uppercase">
                    @LangService.Translate("heroHeading")
                </h2>
                <p class="text-xs font-semibold text-stone-500 leading-relaxed max-w-sm">
                    @LangService.Translate("heroSubheading")
                </p>
            </div>
        </div>

        <!-- Columna derecha -->
        <div class="lg:col-span-5 flex flex-col justify-center text-left py-4 relative z-10">

            <div class="bg-white/60 backdrop-blur-md hover:bg-white/75 border border-white/80 rounded-[28px] p-6 sm:p-10 shadow-xl transition duration-500">

                <div class="space-y-1.5 select-none mb-8">
                    <h2 class="text-2xl sm:text-3xl font-display font-medium text-stone-900 leading-tight">
                        @LangService.Translate("signupTitle")
                    </h2>

                    <p class="text-xs font-bold text-stone-400 uppercase tracking-widest flex items-center gap-2">
                        <span class="w-1.5 h-1.5 bg-[#FF76A5] rounded-full"></span>
                        <span>@LangService.Translate("signupSubtitle")</span>
                    </p>
                </div>

                <!-- Formulario -->
                <form @onsubmit="HandleSignupSubmit" @onsubmit:preventDefault class="space-y-5">

                    <!-- Nombres -->
                    <div>
                        <label class="block text-[11px] font-black text-stone-400 uppercase tracking-widest mb-2">
                            Nombres <span class="text-[#FF76A5]">*</span>
                        </label>
                        <div class="relative border-b border-stone-200/90 focus-within:border-[#FF76A5] transition-all duration-300">
                            <input type="text"
                                   required
                                   @bind="_nombre"
                                   placeholder="Ej. Jesús"
                                   class="w-full bg-transparent text-sm text-stone-800 font-bold focus:outline-none placeholder-stone-300 py-2" />
                        </div>
                    </div>

                    <!-- Apellidos -->
                    <div>
                        <label class="block text-[11px] font-black text-stone-400 uppercase tracking-widest mb-2">
                            Apellidos <span class="text-[#FF76A5]">*</span>
                        </label>
                        <div class="relative border-b border-stone-200/90 focus-within:border-[#FF76A5] transition-all duration-300">
                            <input type="text"
                                   required
                                   @bind="_apellido"
                                   placeholder="Ej. Brancacho"
                                   class="w-full bg-transparent text-sm text-stone-800 font-bold focus:outline-none placeholder-stone-300 py-2" />
                        </div>
                    </div>

                    <!-- DNI -->
                    <div>
                        <label class="block text-[11px] font-black text-stone-400 uppercase tracking-widest mb-2">
                            DNI <span class="text-[#FF76A5]">*</span>
                        </label>
                        <div class="relative border-b border-stone-200/90 focus-within:border-[#FF76A5] transition-all duration-300">
                            <input type="text"
                                   required
                                   maxlength="8"
                                   inputmode="numeric"
                                   @bind="_dni"
                                   placeholder="Ej. 12345678"
                                   class="w-full bg-transparent text-sm text-stone-800 font-bold focus:outline-none placeholder-stone-300 py-2" />
                        </div>
                    </div>

                    <!-- Correo -->
                    <div>
                        <label class="block text-[11px] font-black text-stone-400 uppercase tracking-widest mb-2">
                            Correo electrónico <span class="text-[#FF76A5]">*</span>
                        </label>
                        <div class="relative border-b border-stone-200/90 focus-within:border-[#FF76A5] transition-all duration-300">
                            <input type="email"
                                   required
                                   @bind="_email"
                                   placeholder="Ingresa tu correo electrónico"
                                   class="w-full bg-transparent text-sm text-stone-800 font-bold focus:outline-none placeholder-stone-300 py-2" />
                        </div>
                    </div>

                    <!-- Contraseña -->
                    <div>
                        <label class="block text-[11px] font-black text-stone-400 uppercase tracking-widest mb-2">
                            Contraseña <span class="text-[#FF76A5]">*</span>
                        </label>
                        <div class="relative border-b border-stone-200/90 focus-within:border-[#FF76A5] transition-all duration-300">
                            <input type="password"
                                   required
                                   @bind="_password"
                                   placeholder="Crea una contraseña"
                                   class="w-full bg-transparent text-sm text-stone-800 font-bold focus:outline-none placeholder-stone-300 py-2" />
                        </div>
                    </div>

                    <!-- Confirmar contraseña -->
                    <div>
                        <label class="block text-[11px] font-black text-stone-400 uppercase tracking-widest mb-2">
                            Confirmar contraseña <span class="text-[#FF76A5]">*</span>
                        </label>
                        <div class="relative border-b border-stone-200/90 focus-within:border-[#FF76A5] transition-all duration-300">
                            <input type="password"
                                   required
                                   @bind="_confirmPassword"
                                   placeholder="Repite tu contraseña"
                                   class="w-full bg-transparent text-sm text-stone-800 font-bold focus:outline-none placeholder-stone-300 py-2" />
                        </div>
                    </div>

                    <!-- Botón -->
                    <button type="submit"
                            disabled="@_isLoading"
                            class="w-full bg-[#FFA8BA] hover:bg-[#ff9bb0] active:scale-[0.98] text-stone-900 font-black text-xs tracking-widest uppercase py-4 rounded-xl shadow-sm hover:shadow-md transition duration-300 select-none cursor-pointer mt-6 block text-center disabled:opacity-60 disabled:cursor-not-allowed">
                        @(_isLoading
                            ? (LangService.CurrentLanguage == "es" ? "Registrando..." : "Registering...")
                            : LangService.Translate("signupBtn"))
                    </button>

                </form>

                <!-- Separador -->
                <div class="relative flex py-6 items-center select-none">
                    <div class="grow border-t border-stone-200/70"></div>
                    <span class="shrink mx-3 text-[10px] font-extrabold uppercase tracking-widest text-stone-400">
                        @LangService.Translate("socialLogin")
                    </span>
                    <div class="grow border-t border-stone-200/70"></div>
                </div>

                <!-- Google -->
                <button type="button"
                        @onclick="HandleGoogleSignup"
                        class="w-full flex items-center justify-center gap-2 py-3 px-4 bg-white hover:bg-[#FFF0F3] border border-stone-200 hover:border-[#FFE3E8] rounded-xl text-stone-700 text-xs font-semibold transition shadow-sm cursor-pointer select-none">
                    <span>🌐</span>
                    <span>Sign up with Google</span>
                </button>

                <!-- Login -->
                <div class="border-t border-stone-100/80 pt-5 mt-6 text-center select-none">
                    <p class="text-xs font-semibold text-stone-500">
                        <span>@(LangService.CurrentLanguage == "es" ? "Ya tengo una cuenta" : "Already have an account?")</span>

                        <button type="button"
                                @onclick="NavigateToLogin"
                                class="text-[#FF76A5] hover:text-[#C7346A] font-black hover:underline transition ml-1.5 cursor-pointer">
                            @(LangService.CurrentLanguage == "es" ? "Ingresar" : "Sign In")
                        </button>
                    </p>
                </div>

            </div>
        </div>

    </div>
</div>

@code {
    private string _nombre = string.Empty;
    private string _apellido = string.Empty;
    private string _dni = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _isLoading = false;

    protected override void OnInitialized()
    {
        LangService.OnChange += StateHasChanged;
    }

    private void NavigateTo(string path)
    {
        Navigator.NavigateTo(path);
    }

    private async Task HandleSignupSubmit()
    {
        if (string.IsNullOrWhiteSpace(_nombre))
        {
            Toast.ShowToast("El campo nombres es obligatorio.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_apellido))
        {
            Toast.ShowToast("El campo apellidos es obligatorio.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_dni))
        {
            Toast.ShowToast("El DNI es obligatorio.");
            return;
        }

        if (_dni.Trim().Length != 8 || !_dni.Trim().All(char.IsDigit))
        {
            Toast.ShowToast("El DNI debe tener 8 dígitos numéricos.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_email))
        {
            Toast.ShowToast("El correo electrónico es obligatorio.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_password))
        {
            Toast.ShowToast("La contraseña es obligatoria.");
            return;
        }

        if (_password != _confirmPassword)
        {
            Toast.ShowToast(LangService.CurrentLanguage == "es"
                ? "Las contraseñas no coinciden."
                : "Passwords do not match.");
            return;
        }

        _isLoading = true;
        StateHasChanged();

        try
        {
            var resultado = await ClienteService.RegistrarClienteAsync(
                _nombre.Trim(),
                _apellido.Trim(),
                _dni.Trim(),
                _email.Trim(),
                _password
            );

            if (resultado != null &&
    await Auth.RegistrarEIniciarSesionAsync(resultado))
{
    Toast.ShowToast(LangService.Translate("signupToastSuccess"));
    Navigator.NavigateTo("/profile");
    return;
}
            else
            {
                Toast.ShowToast(LangService.CurrentLanguage == "es"
                    ? "Error al registrar. Verifica los datos o revisa el backend."
                    : "Registration failed. Please check your data or backend.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error en SignUp:");
            Console.WriteLine(ex.Message);

            Toast.ShowToast(LangService.CurrentLanguage == "es"
                ? "Ocurrió un error inesperado al registrar."
                : "An unexpected error occurred while registering.");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleGoogleSignup()
    {
        Toast.ShowToast(LangService.CurrentLanguage == "es"
            ? "Registrando con Google..."
            : "Signing up using Google...");

        await Task.Delay(1100);
        await Auth.LoginAsync();

        Toast.ShowToast(LangService.Translate("signupToastSuccess"));
        Navigator.NavigateTo("/profile");
    }

    private void NavigateToLogin()
    {
        Navigator.NavigateTo("/login");

        Toast.ShowToast(LangService.CurrentLanguage == "es"
            ? "Ingresa tus credenciales de belleza"
            : "Enter your beauty credentials");
    }

    public void Dispose()
    {
        LangService.OnChange -= StateHasChanged;
    }
}