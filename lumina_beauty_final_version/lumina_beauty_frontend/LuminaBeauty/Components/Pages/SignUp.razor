@page "/signup"
@inject LanguageService LangService
@inject AuthService Auth
@inject ClienteAppService ClienteService
@inject ToastService Toast
@inject NavigationManager Navigator
@implements IDisposable

<PageTitle>Crear Cuenta | Lumina Beauty</PageTitle>

<div class="mx-auto flex min-h-[calc(100vh-13rem)] max-w-6xl items-center justify-center px-4 py-10 sm:px-6">

    <section class="w-full max-w-2xl rounded-[2rem] border border-stone-200/70 bg-white/85 p-7 shadow-xl shadow-stone-200/40 backdrop-blur-md sm:p-9">

        <div class="border-b border-stone-100 pb-6">
            <h1 class="mt-2 font-serif text-xl font-semibold text-stone-800 sm:text-xl">
                Crea tu cuenta
            </h1>

            <p class="mt-2 text-xs leading-relaxed text-stone-500">
                Registra tus datos para comenzar tu experiencia Lumina.
            </p>
        </div>

        <form @onsubmit="HandleSignupSubmit"
              @onsubmit:preventDefault
              class="mt-7 grid grid-cols-1 gap-5 sm:grid-cols-2">

            <div class="space-y-2">
                <label class="text-[10px] font-black uppercase tracking-widest text-stone-500">
                    Nombres
                </label>

                <input type="text"
                       required
                       autocomplete="given-name"
                       @bind="_nombre"
                       placeholder="Tus nombres"
                       class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-xs font-semibold text-stone-800 outline-none transition placeholder:text-stone-400 focus:border-[#C7346A] focus:bg-white" />
            </div>

            <div class="space-y-2">
                <label class="text-[10px] font-black uppercase tracking-widest text-stone-500">
                    Apellidos
                </label>

                <input type="text"
                       required
                       autocomplete="family-name"
                       @bind="_apellido"
                       placeholder="Tus apellidos"
                       class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-xs font-semibold text-stone-800 outline-none transition placeholder:text-stone-400 focus:border-[#C7346A] focus:bg-white" />
            </div>

            <div class="space-y-2">
                <label class="text-[10px] font-black uppercase tracking-widest text-stone-500">
                    DNI
                </label>

                <input type="text"
                       required
                       maxlength="8"
                       inputmode="numeric"
                       autocomplete="off"
                       @bind="_dni"
                       placeholder="12345678"
                       class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-xs font-semibold text-stone-800 outline-none transition placeholder:text-stone-400 focus:border-[#C7346A] focus:bg-white" />
            </div>

            <div class="space-y-2">
                <label class="text-[10px] font-black uppercase tracking-widest text-stone-500">
                    Correo electrónico
                </label>

                <input type="email"
                       required
                       autocomplete="email"
                       @bind="_email"
                       placeholder="correo@ejemplo.com"
                       class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-xs font-semibold text-stone-800 outline-none transition placeholder:text-stone-400 focus:border-[#C7346A] focus:bg-white" />
            </div>

            <div class="space-y-2">
                <label class="text-[10px] font-black uppercase tracking-widest text-stone-500">
                    Contraseña
                </label>

                <input type="password"
                       required
                       autocomplete="new-password"
                       @bind="_password"
                       placeholder="Crea una contraseña"
                       class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-xs font-semibold text-stone-800 outline-none transition placeholder:text-stone-400 focus:border-[#C7346A] focus:bg-white" />
            </div>

            <div class="space-y-2">
                <label class="text-[10px] font-black uppercase tracking-widest text-stone-500">
                    Confirmar contraseña
                </label>

                <input type="password"
                       required
                       autocomplete="new-password"
                       @bind="_confirmPassword"
                       placeholder="Repite tu contraseña"
                       class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-xs font-semibold text-stone-800 outline-none transition placeholder:text-stone-400 focus:border-[#C7346A] focus:bg-white" />
            </div>

            <div class="pt-5 sm:col-span-2">
                <button type="submit"
                        disabled="@_isLoading"
                        class="flex w-full items-center justify-center rounded-xl bg-stone-950 px-5 py-3.5 text-[10px] font-bold uppercase tracking-[0.14em] text-white transition hover:bg-[#C7346A] cursor-pointer disabled:cursor-not-allowed disabled:opacity-60">
                    @(_isLoading ? "Creando cuenta..." : "Crear cuenta")
                </button>
            </div>
        </form>

        <div class="mt-7 border-t border-stone-100 pt-6 text-center">
            <p class="text-xs font-medium text-stone-500">
                ¿Ya tienes una cuenta?
            </p>

            <button type="button"
                    @onclick="NavigateToLogin"
                    class="mt-2 text-[10px] font-black uppercase tracking-widest text-[#C7346A] transition hover:text-[#FF76A5] hover:underline cursor-pointer">
                Ingresar
            </button>
        </div>
    </section>
</div>

@code {
    private string _nombre = string.Empty;
    private string _apellido = string.Empty;
    private string _dni = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _isLoading = false;

    protected override void OnInitialized()
    {
        LangService.OnChange += StateHasChanged;
    }

    private void NavigateTo(string path)
    {
        Navigator.NavigateTo(path);
    }

    private async Task HandleSignupSubmit()
    {
        if (string.IsNullOrWhiteSpace(_nombre))
        {
            Toast.ShowToast("El campo nombres es obligatorio.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_apellido))
        {
            Toast.ShowToast("El campo apellidos es obligatorio.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_dni))
        {
            Toast.ShowToast("El DNI es obligatorio.");
            return;
        }

        if (_dni.Trim().Length != 8 || !_dni.Trim().All(char.IsDigit))
        {
            Toast.ShowToast("El DNI debe tener 8 dígitos numéricos.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_email))
        {
            Toast.ShowToast("El correo electrónico es obligatorio.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_password))
        {
            Toast.ShowToast("La contraseña es obligatoria.");
            return;
        }

        if (_password != _confirmPassword)
        {
            Toast.ShowToast(LangService.CurrentLanguage == "es"
                ? "Las contraseñas no coinciden."
                : "Passwords do not match.");
            return;
        }

        _isLoading = true;
        StateHasChanged();

        try
        {
            var resultado = await ClienteService.RegistrarClienteAsync(
                _nombre.Trim(),
                _apellido.Trim(),
                _dni.Trim(),
                _email.Trim(),
                _password
            );

            if (resultado != null &&
    await Auth.RegistrarEIniciarSesionAsync(resultado))
{
    Toast.ShowToast(LangService.Translate("signupToastSuccess"));
    Navigator.NavigateTo("/profile");
    return;
}
            else
            {
                Toast.ShowToast(LangService.CurrentLanguage == "es"
                    ? "Error al registrar. Verifica los datos o revisa el backend."
                    : "Registration failed. Please check your data or backend.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error en SignUp:");
            Console.WriteLine(ex.Message);

            Toast.ShowToast(LangService.CurrentLanguage == "es"
                ? "Ocurrió un error inesperado al registrar."
                : "An unexpected error occurred while registering.");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void NavigateToLogin()
    {
        Navigator.NavigateTo("/login");

        Toast.ShowToast(LangService.CurrentLanguage == "es"
            ? "Ingresa tus credenciales de belleza"
            : "Enter your beauty credentials");
    }

    public void Dispose()
    {
        LangService.OnChange -= StateHasChanged;
    }
}