@page "/admin/reportes"
@layout AdminLayout

@using LuminaBeauty.Models
@using LuminaBeauty.Services
@using LuminaBeauty.Servicios.REST
@using LuminaBeauty.Services.Admin

@inject PedidoRestService PedidoRestService
@inject ProductoRestService ProductoRestService
@inject ClienteRestService ClienteRestService
@inject AuthService Auth
@inject NavigationManager Navigation
@inject ReporteJasperService ReporteJasperService
@inject IJSRuntime JS

<div class="admin-page">
    <!-- Header Superior Estándar -->
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded-4 shadow-sm">
        <h3 class="fw-bold m-0 text-dark px-2" style="font-size: 1.6rem; color: #6a3849 !important;">Reportes</h3>
        
        <div class="d-flex align-items-center gap-3">
            <div class="input-group" style="width: 280px;">
                <span class="input-group-text bg-light border-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control bg-light border-0 small" placeholder="Buscar reportes o métricas..." style="font-size: 0.9rem;">
            </div>
            <button class="btn btn-link text-secondary position-relative p-1">
                <i class="bi bi-bell fs-5"></i>
            </button>
            <button class="btn btn-link text-secondary p-1"><i class="bi bi-envelope fs-5"></i></button>
            <div class="position-relative">
                <div class="d-flex align-items-center gap-2 border-start ps-3" style="border-color: #f0e6e8 !important; cursor: pointer;" @onclick="ToggleProfileDropdown">
                    <div class="text-end d-none d-md-block">
                        <h6 class="m-0 fw-bold text-dark text-uppercase" style="font-size: 0.85rem;">@(Auth.CurrentEmployee?.Nombre ?? "Admin") @(Auth.CurrentEmployee?.Apellido ?? "")</h6>
                        <small class="text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px; color: #d9557b;">@(Auth.CurrentEmployee?.Rol ?? "ADMINISTRADOR")</small>
                    </div>
                    <div class="rounded-circle shadow-sm d-flex align-items-center justify-content-center"
                         style="width: 38px; height: 38px; background: #f8dfe7; color: #7d3f54; border: 2px solid #fbf2f4;">
                        <i class="bi bi-person-fill" style="font-size: 1rem;"></i>
                    </div>
                </div>

                @if (showProfileDropdown)
                {
                    <div class="position-absolute bg-white shadow rounded-4 mt-3" style="right: 0; min-width: 250px; z-index: 1050; border: 1px solid #f7eff1;">
                        <div class="p-3 border-bottom d-flex align-items-center gap-3" style="border-color: #f7eff1 !important;">
                            <div class="rounded-circle shadow-sm d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="width: 42px; height: 42px; background: #f8dfe7; color: #7d3f54; border: 2px solid #fbf2f4;">
                                <i class="bi bi-person-fill" style="font-size: 1.1rem;"></i>
                            </div>
                            <div class="overflow-hidden">
                                <h6 class="m-0 fw-bold text-dark text-truncate" style="font-size: 0.9rem;">@(Auth.CurrentEmployee?.Nombre ?? "Admin")</h6>
                                <small class="text-muted text-truncate d-block" style="font-size: 0.75rem;">@(Auth.CurrentEmployee?.Correo ?? "admin@luminabeauty.com")</small>
                            </div>
                        </div>
                        <div class="py-2">
                            <NavLink href="Perfil" class="dropdown-item d-flex align-items-center gap-2 px-3 py-2 text-secondary" style="font-size: 0.85rem; transition: 0.2s;">
                                <i class="bi bi-person fs-5"></i> Ver Perfil
                            </NavLink>
                            <div class="dropdown-divider my-2" style="border-color: #f7eff1;"></div>
                            <NavLink href="#" class="dropdown-item d-flex align-items-center gap-2 px-3 py-2 text-danger" style="font-size: 0.85rem; transition: 0.2s;">
                                <i class="bi bi-box-arrow-right fs-5"></i> Cerrar Sesión
                            </NavLink>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Subheader Reportes -->
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1" style="font-size: 0.8rem; font-weight: 500;">
                    <li class="breadcrumb-item"><a href="#" class="text-muted text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page" style="color: #834a5d;">Reportes</li>
                </ol>
            </nav>
            <h2 class="fw-black m-0" style="color: #2d2d2d; font-size: 2rem;">Reportes y Métricas</h2>
        </div>
        <div class="d-flex gap-2">
            <button class="btn bg-white border border-danger text-danger px-3 py-2 rounded-3 shadow-sm d-flex align-items-center gap-2 fw-medium" style="font-size: 0.9rem;" @onclick="GenerarReporteAsync" disabled="@generandoReporte">
                <i class="bi @(generandoReporte ? "bi-hourglass-split" : "bi-file-earmark-pdf")"></i> PDF
            </button>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label text-muted small fw-bold text-uppercase" style="font-size: 0.75rem;">Desde</label>
                <input type="date"
                       class="form-control border-1 text-secondary"
                       disabled="@(!ReporteSeleccionadoRequiereFechas)"
                       @bind-value="fechaDesde"
                       @bind-value:event="onchange" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label text-muted small fw-bold text-uppercase" style="font-size: 0.75rem;">Hasta</label>
                <input type="date"
                       class="form-control border-1 text-secondary"
                       disabled="@(!ReporteSeleccionadoRequiereFechas)"
                       @bind-value="fechaHasta"
                       @bind-value:event="onchange"
                       min="@fechaDesde.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label text-muted small fw-bold text-uppercase" style="font-size: 0.75rem;">Tipo de Reporte</label>
                <select class="form-select border-1 text-secondary"
                        @bind="codigoReporteSeleccionado">
                    @foreach (var reporte in reportesDisponibles)
                    {
                        <option value="@reporte.Codigo">@reporte.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <button class="btn w-100 text-white rounded-3 shadow-sm fw-medium d-flex justify-content-center align-items-center gap-2"
                        style="background-color: #f1aeb5; padding: 0.55rem; color: #834a5d !important;"
                        disabled="@generandoReporte"
                        @onclick="GenerarReporteAsync">
                    <i class="bi @(generandoReporte ? "bi-hourglass-split" : "bi-bar-chart-steps")"></i>
                    @(generandoReporte ? "Generando..." : "Generar Reporte")
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensajeReporte))
    {
        <div class="alert alert-warning border-0 rounded-3 mt-3 mb-4 py-2 small">
            @mensajeReporte
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show mt-3 mb-4">
            @mensaje
            <button type="button" class="btn-close" @onclick="LimpiarMensaje"></button>
        </div>
    }

    @if (cargando)
    {
        <div class="text-center py-5 text-muted">
            Cargando métricas...
        </div>
    }
    else
    {
        <!-- KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border border-light shadow-sm rounded-4 p-4 bg-white h-100 position-relative overflow-hidden">
                    <i class="bi bi-cash-stack position-absolute text-light opacity-50" style="font-size: 5rem; top: -10px; right: -10px;"></i>
                    <small class="text-muted fw-bold d-block mb-1" style="font-size: 0.8rem;">Ventas totales</small>
                    <h2 class="fw-black m-0 mb-3" style="font-size: 2.2rem; color: #2d2d2d; line-height: 1;">S/ @IngresosRegistrados.ToString("N2")</h2>
                    <small class="fw-semibold text-success d-flex align-items-center gap-1" style="font-size: 0.8rem;"><i class="bi bi-graph-up-arrow"></i> +12.5% vs mes ant.</small>
                </div>
            </div>
            
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border border-light shadow-sm rounded-4 p-4 bg-white h-100 position-relative overflow-hidden">
                    <i class="bi bi-cart3 position-absolute text-light opacity-50" style="font-size: 5rem; top: -10px; right: -10px;"></i>
                    <small class="text-muted fw-bold d-block mb-1" style="font-size: 0.8rem;">Pedidos activos</small>
                    <h2 class="fw-black m-0 mb-3" style="font-size: 2.2rem; color: #2d2d2d; line-height: 1;">@PedidosActivos.Count</h2>
                    <small class="fw-semibold text-success d-flex align-items-center gap-1" style="font-size: 0.8rem;"><i class="bi bi-graph-up-arrow"></i> +5.2% vs mes ant.</small>
                </div>
            </div>
            
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border border-light shadow-sm rounded-4 p-4 bg-white h-100 position-relative overflow-hidden">
                    <i class="bi bi-ticket-detailed position-absolute text-light opacity-50" style="font-size: 5rem; top: -10px; right: -10px;"></i>
                    <small class="text-muted fw-bold d-block mb-1" style="font-size: 0.8rem;">Ticket promedio</small>
                    <h2 class="fw-black m-0 mb-3" style="font-size: 2.2rem; color: #2d2d2d; line-height: 1;">S/ @TicketPromedio.ToString("N2")</h2>
                    <small class="fw-semibold text-secondary d-flex align-items-center gap-1" style="font-size: 0.8rem;"><i class="bi bi-dash"></i> Estable</small>
                </div>
            </div>
            
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border border-light shadow-sm rounded-4 p-4 bg-white h-100 position-relative overflow-hidden">
                    <i class="bi bi-person-plus position-absolute text-light opacity-50" style="font-size: 5rem; top: -10px; right: -10px;"></i>
                    <small class="text-muted fw-bold d-block mb-1" style="font-size: 0.8rem;">Clientes activos</small>
                    <h2 class="fw-black m-0 mb-3" style="font-size: 2.2rem; color: #2d2d2d; line-height: 1;">@TotalClientes</h2>
                    <small class="fw-semibold text-success d-flex align-items-center gap-1" style="font-size: 0.8rem;"><i class="bi bi-graph-up-arrow"></i> +22.1% vs mes ant.</small>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="row g-4 mb-4">
            
            <!-- Pseudo Chart: Ventas por categoría -->
            <div class="col-12 col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div>
                            <h5 class="fw-bold m-0 text-dark">Ventas por categoría</h5>
                            <small class="text-muted">Distribución de ingresos mensual</small>
                        </div>
                        <button class="btn btn-sm text-secondary bg-transparent border-0"><i class="bi bi-three-dots-vertical fs-5"></i></button>
                    </div>
                    
                    <!-- CSS Bar Chart Simulation -->
                    <div class="d-flex align-items-end justify-content-around mt-auto pt-4" style="height: 200px;">
                        @if (ventasPorCategoria != null && ventasPorCategoria.Any())
                        {
                            @foreach (var cat in ventasPorCategoria.Take(5))
                            {
                                <div class="d-flex flex-column align-items-center gap-2" style="width: 15%; height: 100%;">
                                    <div class="w-100 rounded-top-2 mt-auto chart-bar" 
                                         style="height: @(cat.Porcentaje.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%; background-color: @cat.Color; transition: all 0.3s; cursor: pointer;"
                                         title="S/ @cat.Total.ToString("N2")"></div>
                                    <small class="text-muted text-truncate w-100 text-center" style="font-size: 0.7rem;" title="@cat.Nombre">@cat.Nombre</small>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4 w-100 text-muted fst-italic">No hay ventas registradas</div>
                        }
                    </div>
                </div>
            </div>

            <!-- Horizontal Bars: Top Marcas -->
            <div class="col-12 col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div>
                            <h5 class="fw-bold m-0 text-dark">Top marcas por ventas</h5>
                            <small class="text-muted">Marcas con mayor rotación</small>
                        </div>
                        <i class="bi bi-graph-up text-secondary fs-5"></i>
                    </div>

                    <div class="d-flex flex-column justify-content-between flex-grow-1">
                        @if (ventasPorMarca != null && ventasPorMarca.Any())
                        {
                            @foreach (var brand in ventasPorMarca.Take(5))
                            {
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="fw-medium text-dark text-truncate" style="font-size: 0.85rem; max-width: 70%;" title="@brand.Nombre">@brand.Nombre</span>
                                        <span class="fw-bold text-muted" style="font-size: 0.85rem;">S/ @brand.Total.ToString("N2")</span>
                                    </div>
                                    <div class="progress rounded-pill" style="height: 6px; background-color: #f0e6e8;">
                                        <div class="progress-bar" role="progressbar" style="width: @(brand.Porcentaje.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%; background-color: @brand.Color;"></div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4 w-100 text-muted fst-italic">No hay ventas registradas</div>
                        }
                    </div>
                </div>
            </div>

        </div>

        <!-- Tabla: Detalle de Ventas Recientes -->
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
            <div class="d-flex justify-content-between align-items-center p-4 border-bottom" style="border-color: #f7eff1 !important;">
                <h5 class="fw-bold m-0 text-dark">Detalle de Ventas Recientes</h5>
                <NavLink href="/admin/pedidos" class="text-decoration-none fw-medium" style="color: #834a5d; font-size: 0.9rem;">Ver todo</NavLink>
            </div>

            <div class="table-responsive">
                <table class="table align-middle table-hover m-0">
                    <thead style="background-color: #fbf8f9; color: #6c757d; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        <tr>
                            <th class="py-3 px-4 border-bottom-0">ID Transacción</th>
                            <th class="py-3 border-bottom-0">Cliente</th>
                            <th class="py-3 border-bottom-0">Monto</th>
                            <th class="py-3 border-bottom-0">Estado</th>
                            <th class="py-3 px-4 border-bottom-0 text-end">Acción</th>
                        </tr>
                    </thead>
                    <tbody style="font-size: 0.85rem; color: #4f4f4f;">
                        @if (PedidosRecientes != null && PedidosRecientes.Any())
                        {
                            @foreach (var p in PedidosRecientes)
                            {
                                <tr class="border-bottom" style="border-color: #f7eff1 !important;">
                                    <td class="py-3 px-4 font-monospace text-muted">
                                        @(string.IsNullOrWhiteSpace(p.CodigoPedido) ? $"#ORD-{p.IdPedido}" : p.CodigoPedido)
                                    </td>
                                    <td class="fw-medium text-dark">@(p.Cliente != null ? $"{p.Cliente.Nombre} {p.Cliente.Apellido}" : "Sin Cliente")</td>
                                    <td class="fw-bold text-dark">S/ @p.Total.ToString("N2")</td>
                                    <td>
                                        <span class="badge rounded-pill fw-medium" style="background-color: @GetEstadoBgColor(p.Estado); color: @GetEstadoColor(p.Estado); padding: 0.4em 0.8em;">
                                            @FormatoEstado(p.Estado)
                                        </span>
                                    </td>
                                    <td class="py-3 px-4 text-end">
                                        <NavLink href="/admin/pedidos" class="btn btn-sm btn-light text-secondary rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;"><i class="bi bi-eye"></i></NavLink>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted fst-italic">No hay ventas registradas</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    .chart-bar:hover {
        opacity: 0.8;
        transform: scaleY(1.02);
        transform-origin: bottom;
    }
</style>

@code {
    private bool showProfileDropdown = false;
    private string codigoReporteSeleccionado = "ventas-consolidadas";
    private IReadOnlyList<ReporteJasperOption> reportesDisponibles = Array.Empty<ReporteJasperOption>();
    
    private void ToggleProfileDropdown()
    {
        showProfileDropdown = !showProfileDropdown;
    }

    private ReporteJasperOption? ReporteSeleccionado =>
        reportesDisponibles.FirstOrDefault(r => r.Codigo == codigoReporteSeleccionado);

    private bool ReporteSeleccionadoRequiereFechas =>
        ReporteSeleccionado?.RequiereFechas ?? true;

    private DateTime _fechaDesde = new DateTime(2026, 06, 01);
    private DateTime fechaDesde
    {
        get => _fechaDesde;
        set
        {
            _fechaDesde = value;
            if (fechaHasta < _fechaDesde)
            {
                fechaHasta = _fechaDesde;
            }
        }
    }

    private DateTime _fechaHasta = DateTime.Today;
    private DateTime fechaHasta
    {
        get => _fechaHasta;
        set
        {
            if (value >= fechaDesde)
            {
                _fechaHasta = value;
            }
        }
    }

    private List<Pedido> Pedidos = new();
    private List<Producto> Productos = new();
    private List<CategoriaProducto> Categorias = new();
    private List<Marca> Marcas = new();

    private bool cargando = true;
    private string mensaje = string.Empty;
    private bool esError;

    private List<CategoriaVenta> ventasPorCategoria = new();
    private List<MarcaVenta> ventasPorMarca = new();

    private bool generandoReporte = false;
    private string mensajeReporte = "";

    public class CategoriaVenta
    {
        public string Nombre { get; set; } = "";
        public decimal Total { get; set; }
        public double Porcentaje { get; set; }
        public string Color { get; set; } = "";
    }

    public class MarcaVenta
    {
        public string Nombre { get; set; } = "";
        public decimal Total { get; set; }
        public double Porcentaje { get; set; }
        public string Color { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAdmin)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        reportesDisponibles = ReporteJasperService.ObtenerReportes();
        codigoReporteSeleccionado = reportesDisponibles.FirstOrDefault()?.Codigo ?? codigoReporteSeleccionado;

        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        cargando = true;
        mensaje = string.Empty;
        esError = false;

        try
        {
            var pedidosRes = await PedidoRestService.ListarPedidosAsync();
            Pedidos = pedidosRes ?? new List<Pedido>();

            // Enriquecer clientes (el backend no incluye nombre/apellido en /listar)
            var cacheClientes = new Dictionary<int, Cliente>();
            foreach (var pedido in Pedidos)
            {
                if (pedido.Cliente == null || pedido.Cliente.Id <= 0) continue;
                if (!string.IsNullOrWhiteSpace(pedido.Cliente.Nombre)) continue;

                int idCliente = pedido.Cliente.Id;
                if (!cacheClientes.ContainsKey(idCliente))
                {
                    var c = await ClienteRestService.BuscarClienteAsync(idCliente);
                    if (c != null) cacheClientes[idCliente] = c;
                }
                if (cacheClientes.TryGetValue(idCliente, out var cc))
                {
                    pedido.Cliente.Nombre = cc.Nombre;
                    pedido.Cliente.Apellido = cc.Apellido;
                    pedido.Cliente.Correo = cc.Correo;
                }
            }
            
            var productosRes = await ProductoRestService.ListarProductosTodosAsync();
            Productos = productosRes ?? new List<Producto>();
            
            var categoriasRes = await ProductoRestService.ListarCategoriasAsync();
            Categorias = categoriasRes ?? new List<CategoriaProducto>();
            
            var marcasRes = await ProductoRestService.ListarMarcasAsync();
            Marcas = marcasRes ?? new List<Marca>();

            foreach (var prod in Productos)
            {
                if (prod.Categoria != null)
                {
                    var cat = Categorias.FirstOrDefault(c => c.IdCategoria == prod.Categoria.IdCategoria);
                    if (cat != null) prod.Categoria.Nombre = cat.Nombre;
                }
                if (prod.Marca != null)
                {
                    var m = Marcas.FirstOrDefault(brand => brand.IdMarca == prod.Marca.IdMarca);
                    if (m != null) prod.Marca.Nombre = m.Nombre;
                }
            }

            var salesByCategoryDict = new Dictionary<string, decimal>();
            foreach (var p in PedidosActivos)
            {
                if (p.Detalles == null) continue;
                foreach (var d in p.Detalles)
                {
                    var prod = Productos.FirstOrDefault(pr => pr.Sku == d.SkuProducto);
                    var catName = prod?.Categoria?.Nombre ?? "Sin Categoría";
                    var subtotal = d.Cantidad * d.PrecioUnitario;
                    if (salesByCategoryDict.ContainsKey(catName))
                        salesByCategoryDict[catName] += subtotal;
                    else
                        salesByCategoryDict[catName] = subtotal;
                }
            }

            var salesByBrandDict = new Dictionary<string, decimal>();
            foreach (var p in PedidosActivos)
            {
                if (p.Detalles == null) continue;
                foreach (var d in p.Detalles)
                {
                    var prod = Productos.FirstOrDefault(pr => pr.Sku == d.SkuProducto);
                    var brandName = prod?.Marca?.Nombre ?? "Sin Marca";
                    var subtotal = d.Cantidad * d.PrecioUnitario;
                    if (salesByBrandDict.ContainsKey(brandName))
                        salesByBrandDict[brandName] += subtotal;
                    else
                        salesByBrandDict[brandName] = subtotal;
                }
            }

            string[] barColors = { "#834a5d", "#d9557b", "#f1aeb5", "#f8d7da", "#e2e3e5" };
            var listCats = salesByCategoryDict
                .OrderByDescending(kvp => kvp.Value)
                .Select((kvp, index) => new CategoriaVenta
                {
                    Nombre = kvp.Key,
                    Total = kvp.Value,
                    Color = barColors[index % barColors.Length]
                })
                .ToList();

            decimal maxCatTotal = listCats.Any() ? listCats.Max(c => c.Total) : 1;
            if (maxCatTotal == 0) maxCatTotal = 1;
            foreach (var c in listCats)
            {
                c.Porcentaje = (double)(c.Total / maxCatTotal) * 85.0; 
                if (c.Porcentaje < 10) c.Porcentaje = 10; 
            }
            ventasPorCategoria = listCats;

            string[] brandColors = { "#6a3849", "#834a5d", "#c98c9f", "#d9acb9", "#e5cacc" };
            var listBrands = salesByBrandDict
                .OrderByDescending(kvp => kvp.Value)
                .Select((kvp, index) => new MarcaVenta
                {
                    Nombre = kvp.Key,
                    Total = kvp.Value,
                    Color = brandColors[index % brandColors.Length]
                })
                .ToList();

            decimal maxBrandTotal = listBrands.Any() ? listBrands.Max(b => b.Total) : 1;
            if (maxBrandTotal == 0) maxBrandTotal = 1;
            foreach (var b in listBrands)
            {
                b.Porcentaje = (double)(b.Total / maxBrandTotal) * 90.0; 
                if (b.Porcentaje < 10) b.Porcentaje = 10;
            }
            ventasPorMarca = listBrands;
        }
        catch (Exception ex)
        {
            mensaje = $"No se pudieron cargar las métricas: {ex.Message}";
            esError = true;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GenerarReporteAsync()
    {
        mensajeReporte = "";

        if (ReporteSeleccionado == null)
        {
            mensajeReporte = "Seleccione un reporte valido.";
            return;
        }

        if (ReporteSeleccionado.RequiereFechas && fechaHasta < fechaDesde)
        {
            mensajeReporte = "La fecha hasta no puede ser menor que la fecha desde.";
            return;
        }

        try
        {
            generandoReporte = true;
            string url = ReporteJasperService.ConstruirUrlGeneracion(
                codigoReporteSeleccionado,
                ReporteSeleccionado.RequiereFechas ? fechaDesde : null,
                ReporteSeleccionado.RequiereFechas ? fechaHasta : null
            );
            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex)
        {
            mensajeReporte = $"No se pudo generar el reporte: {ex.Message}";
        }
        finally
        {
            generandoReporte = false;
        }
    }

    private List<Pedido> PedidosActivos =>
        Pedidos.Where(pedido => !string.Equals(pedido.Estado, "CANCELADO", StringComparison.OrdinalIgnoreCase)).ToList();

    private decimal IngresosRegistrados =>
        PedidosActivos.Sum(pedido => pedido.Total);

    private decimal TicketPromedio =>
        PedidosActivos.Count == 0 ? 0 : PedidosActivos.Sum(pedido => pedido.Total) / PedidosActivos.Count;

    private int TotalClientes =>
        PedidosActivos.Where(p => p.Cliente != null).Select(p => p.Cliente!.Id).Distinct().Count();

    private List<Pedido> PedidosRecientes =>
        Pedidos.OrderByDescending(pedido => pedido.IdPedido).Take(6).ToList();

