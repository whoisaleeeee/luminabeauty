@page "/admin/valoraciones"
@layout AdminLayout

@using LuminaBeauty.Models
@using LuminaBeauty.Services.AppServices

@inject AdminValoracionesAppService AdminValoraciones
@inject IJSRuntime JS

<PageTitle>Valoraciones | Lumina Beauty</PageTitle>

<div class="admin-page">

    <TopHeader Title="Valoraciones" SearchPlaceholder="Buscar valoraciones..." />

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <small class="text-muted fw-semibold">Total valoraciones</small>

                <h2 class="fw-bold mb-0 mt-2">
                    @AdminValoraciones.Valoraciones.Count
                </h2>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100"
                 style="background-color: #fffaf0;">
                <small class="fw-semibold" style="color: #9b6d11;">
                    Pendientes
                </small>

                <h2 class="fw-bold mb-0 mt-2" style="color: #9b6d11;">
                    @AdminValoraciones.Valoraciones.Count(v =>
                        AdminValoracionesAppService.NormalizarEstado(v.Estado) == "PENDIENTE")
                </h2>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100"
                 style="background-color: #f2fbf6;">
                <small class="fw-semibold" style="color: #2e7d5a;">
                    Publicadas
                </small>

                <h2 class="fw-bold mb-0 mt-2" style="color: #2e7d5a;">
                    @AdminValoraciones.Valoraciones.Count(v =>
                        AdminValoracionesAppService.NormalizarEstado(v.Estado) == "PUBLICADA")
                </h2>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100"
                 style="background-color: #fff5f6;">
                <small class="fw-semibold" style="color: #b02a37;">
                    Rechazadas
                </small>

                <h2 class="fw-bold mb-0 mt-2" style="color: #b02a37;">
                    @AdminValoraciones.Valoraciones.Count(v =>
                        AdminValoracionesAppService.NormalizarEstado(v.Estado) == "RECHAZADA")
                </h2>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4">

        <div class="d-flex flex-wrap gap-2 mb-4 pb-4 border-bottom">
            @foreach (var filtro in _filtros)
            {
                var activo = AdminValoraciones.FiltroActual == filtro.Key;

                <button type="button"
                        @onclick="() => CambiarFiltro(filtro.Key)"
                        class="btn rounded-pill px-4 py-2 fw-semibold"
                        style="font-size: 0.78rem; @(activo
                                                                                                ? "background-color: #6a3849; color: white;"
                                                                                                : "background-color: #fff; color: #6b6266; border: 1px solid #eadde1;")">
                    @filtro.Value
                </button>
            }
        </div>

        @if (AdminValoraciones.Cargando)
        {
            <div class="py-5 text-center text-muted">
                <div class="spinner-border mb-3"
                     style="color: #b87991;"
                     role="status">
                </div>

                <p class="mb-0 fw-semibold">
                    Cargando valoraciones...
                </p>
            </div>
        }
        else if (AdminValoraciones.ValoracionesFiltradas.Count == 0)
        {
            <div class="py-5 text-center">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                     style="width: 52px; height: 52px; background-color: #fff0f3; color: #c7346a;">
                    <i class="bi bi-star fs-5"></i>
                </div>

                <h5 class="fw-bold mb-2">
                    No hay valoraciones en esta categoría.
                </h5>

                <p class="text-muted mb-0">
                    Las valoraciones enviadas por clientes aparecerán aquí.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr style="font-size: 0.75rem;">
                            <th class="text-muted text-uppercase">Cliente</th>
                            <th class="text-muted text-uppercase">Producto</th>
                            <th class="text-muted text-uppercase">Calificación</th>
                            <th class="text-muted text-uppercase">Comentario</th>
                            <th class="text-muted text-uppercase">Estado</th>
                            <th class="text-muted text-uppercase text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var valoracion in AdminValoraciones.ValoracionesFiltradas)
                        {
                            var estado = AdminValoracionesAppService.NormalizarEstado(
                                valoracion.Estado);

                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">
                                        @AdminValoracionesAppService.ObtenerNombreCliente(valoracion)
                                    </div>

                                    <small class="text-muted">
                                        Cliente #@(valoracion.Cliente?.Id ?? 0)
                                    </small>
                                </td>

                                <td>
                                    <div class="fw-semibold text-dark">
                                        @(valoracion.Producto?.Nombre
                                            ?? "Producto no disponible")
                                    </div>
                                </td>

                                <td>
                                    <div style="color: #d69c28;">
                                        @for (int estrella = 1; estrella <= 5; estrella++)
                                        {
                                            <i class="bi @(estrella <= valoracion.Calificacion
                                                                                                                                                                                          ? "bi-star-fill"
                                                                                                                                                                                          : "bi-star")"></i>
                                    }
                                </div>

                                <small class="text-muted fw-semibold">
                                    @valoracion.Calificacion / 5
                                </small>
                            </td>

                            <td style="max-width: 270px;">
                                <span class="text-muted">
                                    @(string.IsNullOrWhiteSpace(valoracion.Comentario)
                                        ? "Sin comentario."
                                        : valoracion.Comentario)
                                </span>
                            </td>

                            <td>
                                @if (estado == "PUBLICADA")
                                {
                                    <span class="badge rounded-pill px-3 py-2"
                                          style="background-color: #dff4e8; color: #23734f;">
                                        PUBLICADA
                                    </span>
                                }
                                else if (estado == "RECHAZADA")
                                {
                                    <span class="badge rounded-pill px-3 py-2"
                                          style="background-color: #fde8eb; color: #b02a37;">
                                        RECHAZADA
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-3 py-2"
                                          style="background-color: #fff3d5; color: #966500;">
                                        PENDIENTE
                                    </span>
                                }
                            </td>

                            <td class="text-end">
                                @if (estado == "PENDIENTE")
                                {
                                    <div class="d-flex justify-content-end gap-2">
                                        <button type="button"
                                                @onclick="() => PublicarAsync(valoracion)"
                                                disabled="@AdminValoraciones.ProcesandoIds.Contains(valoracion.IdValoracion)"
                                                class="btn btn-sm rounded-3 px-3 text-white"
                                                style="background-color: #4e9d75;">
                                            <i class="bi bi-check-lg me-1"></i>
                                            Publicar
                                        </button>

                                        <button type="button"
                                                @onclick="() => RechazarAsync(valoracion)"
                                                disabled="@AdminValoraciones.ProcesandoIds.Contains(valoracion.IdValoracion)"
                                                class="btn btn-sm rounded-3 px-3"
                                                style="border: 1px solid #f0c9d0; color: #b02a37; background-color: #fff7f8;">
                                            <i class="bi bi-x-lg me-1"></i>
                                            Rechazar
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <small class="text-muted">
                                        Sin acciones pendientes
                                    </small>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
</div>

@code {
    private readonly Dictionary<string, string> _filtros = new()
    {
        ["todos"] = "Todas",
        ["pendiente"] = "Pendientes",
        ["publicada"] = "Publicadas",
        ["rechazada"] = "Rechazadas"
    };

    private List<ProductoValoradoResumen> ProductosMejorValorados =>
        AdminValoraciones.Valoraciones
            .Where(v => AdminValoracionesAppService.NormalizarEstado(v.Estado) == "PUBLICADA")
            .Where(v => v.Producto is not null &&
                        !string.IsNullOrWhiteSpace(v.Producto.Nombre))
            .GroupBy(v => new
            {
                v.Producto!.IdProducto,
                v.Producto.Nombre
            })
            .Select((grupo, indice) => new ProductoValoradoResumen(
                indice + 1,
                grupo.Key.Nombre!,
                grupo.Average(v => v.Calificacion),
                grupo.Count()
            ))
            .OrderByDescending(x => x.Promedio)
            .ThenByDescending(x => x.Cantidad)
            .Take(5)
            .ToList();

    protected override Task OnInitializedAsync()
    {
        return AdminValoraciones.CargarAsync();
    }

    private Task CargarValoracionesAsync()
    {
        return AdminValoraciones.CargarAsync();
    }

    private void CambiarFiltro(string filtro)
    {
        AdminValoraciones.CambiarFiltro(filtro);
    }

    private Task PublicarAsync(Valoracion valoracion)
    {
        return AdminValoraciones.PublicarAsync(valoracion);
    }

    private Task RechazarAsync(Valoracion valoracion)
    {
        return AdminValoraciones.RechazarAsync(valoracion);
    }

    private Task ExportarRankingPdfAsync()
    {
        return JS.InvokeVoidAsync("print").AsTask();
    }

    private record ProductoValoradoResumen(
        int Posicion,
        string Nombre,
        double Promedio,
        int Cantidad
    );
}