@page "/admin/configuracion"
@layout AdminLayout

@using LuminaBeauty.Services

@inject AuthService Auth
@inject NavigationManager Navigation

<div class="admin-page">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1" style="color: #6a3849;">Configuración</h2>
            <p class="text-muted mb-0">
                Parámetros generales del panel de administración.
            </p>
        </div>

        <button class="btn text-white px-4 py-2 rounded-3 shadow-sm"
                style="background-color: #6a3849;"
                @onclick="GuardarCambios">
            <i class="bi bi-check2-circle"></i>
            Guardar cambios
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show"
             role="alert">
            @mensaje

            <button type="button"
                    class="btn-close"
                    @onclick="LimpiarMensaje">
            </button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="border-bottom px-4 pt-3">
            <ul class="nav nav-underline gap-4">
                <li class="nav-item">
                    <button class="nav-link border-0 bg-transparent @(pestanaActiva == "general" ? "active" : "text-muted")"
                            @onclick='() => CambiarPestana(" general")'>
                        General
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link border-0 bg-transparent @(pestanaActiva == "pagos" ? "active" : "text-muted")"
                            @onclick='() => CambiarPestana(" pagos")'>
                        Métodos de pago
                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link border-0 bg-transparent @(pestanaActiva == "equipo" ? "active" : "text-muted")"
                            @onclick='() => CambiarPestana(" equipo")'>
                        Equipo
                    </button>
                </li>
            </ul>
        </div>

        <div class="p-4">

            @if (pestanaActiva == "general")
            {
                <div class="row g-4">
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Nombre de la tienda</label>

                        <input class="form-control"
                               @bind="nombreTienda" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Correo de contacto</label>

                        <input type="email"
                               class="form-control"
                               @bind="correoContacto" />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Mensaje de atención</label>

                        <textarea class="form-control"
                                  rows="4"
                                  @bind="mensajeAtencion">
                        </textarea>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="tiendaActiva"
                                   @bind="tiendaActiva" />

                            <label class="form-check-label" for="tiendaActiva">
                                La tienda está disponible para compras
                            </label>
                        </div>
                    </div>
                </div>
            }

            @if (pestanaActiva == "pagos")
            {
                <div class="row g-3">
                    @foreach (var metodo in metodosPago)
                    {
                        <div class="col-12 col-md-6">
                            <div class="border rounded-4 p-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@metodo.Nombre</div>
                                    <small class="text-muted">@metodo.Descripcion</small>
                                </div>

                                <div class="form-check form-switch">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           @bind="metodo.Activo" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (pestanaActiva == "equipo")
            {
                <div class="alert alert-light border mb-0">
                    <div class="fw-semibold mb-1">Gestión de equipo</div>

                    <div class="text-muted">
                        El registro, edición y desactivación de empleados se integrará
                        cuando se incorpore el servicio REST específico de empleados.
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string pestanaActiva = "general";

    private string nombreTienda = "Lumina Beauty";
    private string correoContacto = "contacto@luminabeauty.com";
    private string mensajeAtencion = "Atendemos consultas de lunes a sábado.";
    private bool tiendaActiva = true;

    private string mensaje = string.Empty;
    private bool esError;

    private List<MetodoPagoConfig> metodosPago = new()
    {
        new()
        {
            Nombre = "Mercado Pago",
            Descripcion = "Pagos con tarjetas y saldo digital.",
            Activo = true
        },
        new()
        {
            Nombre = "Yape",
            Descripcion = "Pagos mediante billetera digital.",
            Activo = true
        },
        new()
        {
            Nombre = "Transferencia bancaria",
            Descripcion = "Validación manual de pagos.",
            Activo = false
        }
    };

    protected override void OnInitialized()
    {
        if (!Auth.IsAdmin)
        {
            Navigation.NavigateTo("/login", true);
        }
    }

    private void CambiarPestana(string nuevaPestana)
    {
        pestanaActiva = nuevaPestana;
    }

    private void GuardarCambios()
    {
        mensaje = "Los cambios de configuración se guardaron correctamente.";
        esError = false;
    }

    private void LimpiarMensaje()
    {
        mensaje = string.Empty;
    }

    private class MetodoPagoConfig
    {
        public string Nombre { get; set; } = string.Empty;
        public string Descripcion { get; set; } = string.Empty;
        public bool Activo { get; set; }
    }
}