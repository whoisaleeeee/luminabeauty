@using Microsoft.AspNetCore.Components
@using LuminaBeauty.Models

@if (IsVisible)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-bottom-0 pb-0 px-4 pt-4">
                    <div>
                        <h4 class="modal-title fw-bold" style="color: #6a3849;">
                            Modificar producto
                        </h4>
                        <p class="text-muted small m-0">
                            Actualiza la información técnica y visual del producto.
                        </p>
                    </div>

                    <button type="button"
                            class="btn-close"
                            @onclick="Close"
                            aria-label="Cerrar">
                    </button>
                </div>

                <div class="modal-body px-4 py-4">
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                  style="width: 28px; height: 28px; background-color: #fcf0f4; color: #d9557b; font-size: 0.8rem;">
                                01
                            </span>
                            <h6 class="m-0 fw-semibold text-dark">Información básica</h6>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase"
                                       style="font-size: 0.7rem;">
                                    Nombre del producto
                                </label>

                                <input type="text"
                                       class="form-control bg-light"
                                       @bind="Product.Nombre" />
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label text-muted small fw-bold text-uppercase"
                                       style="font-size: 0.7rem;">
                                    Slug / Código
                                </label>

                                <input type="text"
                                       class="form-control bg-light"
                                       @bind="Product.Slug" />
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label text-muted small fw-bold text-uppercase"
                                       style="font-size: 0.7rem;">
                                    SKU
                                </label>

                                <input type="text"
                                       class="form-control bg-light"
                                       @bind="Product.Sku" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase"
                                       style="font-size: 0.7rem;">
                                    Marca
                                </label>

                                <select class="form-select bg-light"
                                        @bind="marcaId">
                                    <option value="0">Seleccionar marca...</option>

                                    @foreach (var marca in Marcas)
                                    {
                                        <option value="@marca.IdMarca">@marca.Nombre</option>
                                    }
                                </select>
                            </div>

                            <div class="col-6 col-md-3">
                                <label class="form-label text-muted small fw-bold text-uppercase"
                                       style="font-size: 0.7rem;">
                                    Precio
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text bg-light">S/</span>

                                    <input type="number"
                                           class="form-control bg-light"
                                           min="0"
                                           step="0.01"
                                           @bind="Product.Precio" />
                                </div>
                            </div>

                            <div class="col-6 col-md-3">
                                <label class="form-label text-muted small fw-bold text-uppercase"
                                       style="font-size: 0.7rem;">
                                    Stock
                                </label>

                                <input type="number"
                                       class="form-control bg-light"
                                       min="0"
                                       @bind="Product.Stock" />
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label text-muted small fw-bold text-uppercase"
                                   style="font-size: 0.7rem;">
                                Descripción
                            </label>

                            <input type="text"
                                   class="form-control bg-light"
                                   @bind="Product.Descripcion" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                  style="width: 28px; height: 28px; background-color: #fcf0f4; color: #d9557b; font-size: 0.8rem;">
                                02
                            </span>
                            <h6 class="m-0 fw-semibold text-dark">Categorización</h6>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase"
                                       style="font-size: 0.7rem;">
                                    Categoría
                                </label>

                                <select class="form-select bg-light"
                                        @bind="categoriaId">
                                    <option value="0">Seleccionar categoría...</option>

                                    @foreach (var categoria in Categorias)
                                    {
                                        <option value="@categoria.IdCategoria">
                                            @categoria.Nombre
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase"
                                       style="font-size: 0.7rem;">
                                    Tipo de piel
                                </label>

                                <select class="form-select bg-light"
                                        @bind="tipoPielSeleccionado">
                                    <option value="">Seleccionar tipo de piel...</option>

                                    @foreach (var tipo in TiposPiel)
                                    {
                                        <option value="@tipo">@tipo</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div>
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                  style="width: 28px; height: 28px; background-color: #fcf0f4; color: #d9557b; font-size: 0.8rem;">
                                03
                            </span>
                            <h6 class="m-0 fw-semibold text-dark">Imagen principal</h6>
                        </div>

                        <label class="form-label text-muted small fw-bold text-uppercase"
                               style="font-size: 0.7rem;">
                            Ruta de imagen
                        </label>

                        <input type="text"
                               class="form-control bg-light"
                               placeholder="/images/products/nombre-imagen.jpg"
                               @bind="Product.Imagen" />
                    </div>
                </div>

                <div class="modal-footer border-top-0 px-4 pb-4 pt-2">
                    <button type="button"
                            class="btn btn-light px-4 border rounded-3"
                            @onclick="Close">
                        Cancelar
                    </button>

                    <button type="button"
                            class="btn text-white px-4 d-flex align-items-center gap-2 rounded-3 shadow-sm"
                            style="background-color: #834a5d;"
                            @onclick="Save">
                        <i class="bi bi-save"></i>
                        Guardar cambios
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    [Parameter]
    public Producto Product { get; set; } = new();

    [Parameter]
    public EventCallback<Producto> OnProductUpdated { get; set; }

    [Parameter]
    public List<CategoriaProducto> Categorias { get; set; } = new();

    [Parameter]
    public List<Marca> Marcas { get; set; } = new();

    [Parameter]
    public List<string> TiposPiel { get; set; } = new();

    private int categoriaId;
    private int marcaId;
    private string tipoPielSeleccionado = string.Empty;

    protected override void OnParametersSet()
    {
        categoriaId = Product.Categoria?.IdCategoria ?? 0;
        marcaId = Product.Marca?.IdMarca ?? 0;
        tipoPielSeleccionado = Product.TipoPiel ?? string.Empty;
    }

    private async Task Close()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    private async Task Save()
    {
        if (categoriaId <= 0 || marcaId <= 0)
        {
            return;
        }

        Product.Categoria = new CategoriaProducto
        {
            IdCategoria = categoriaId
        };

        Product.Marca = new Marca
        {
            IdMarca = marcaId
        };

        Product.TipoPiel = tipoPielSeleccionado;

        await OnProductUpdated.InvokeAsync(Product);
        await Close();
    }
}