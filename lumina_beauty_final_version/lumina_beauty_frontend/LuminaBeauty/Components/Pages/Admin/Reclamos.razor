@page "/admin/reclamos"
@layout AdminLayout

@using LuminaBeauty.Models
@using LuminaBeauty.Services
@using LuminaBeauty.Servicios.REST

@inject ReclamoRestService ReclamoRestService
@inject ClienteRestService ClienteRestService
@inject AuthService Auth
@inject NavigationManager Navigation

<div class="admin-page">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 mt-2">
        <div>
            <h2 class="fw-bold mb-0" style="color: #6a3849;">
                Reclamos y Atención al Cliente
            </h2>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @mensaje

            <button type="button"
                    class="btn-close"
                    @onclick="ClearMessage">
            </button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 position-relative" style="border-left: 4px solid #b02a37 !important;">
                <i class="bi bi-exclamation-circle position-absolute" style="top: 1.5rem; right: 1.5rem; font-size: 1.2rem; color: #b02a37;"></i>
                <small class="text-muted fw-bold text-uppercase" style="font-size: 0.75rem;">Nuevos (Sin asignar)</small>
                <h2 class="fw-bold mt-2 mb-0 text-dark">
                    @ListaReclamos.Count(r => r.Estado == "ABIERTO")
                </h2>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 position-relative" style="border-left: 4px solid #fd7e14 !important;">
                <i class="bi bi-journal-text position-absolute" style="top: 1.5rem; right: 1.5rem; font-size: 1.2rem; color: #fd7e14;"></i>
                <small class="text-muted fw-bold text-uppercase" style="font-size: 0.75rem;">Asignados / En revisión</small>
                <h2 class="fw-bold mt-2 mb-0 text-dark">
                    @ListaReclamos.Count(r => r.Estado == "EN_PROCESO" || r.Estado == "EN_REVISION")
                </h2>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 position-relative" style="border-left: 4px solid #198754 !important;">
                <i class="bi bi-check-circle position-absolute" style="top: 1.5rem; right: 1.5rem; font-size: 1.2rem; color: #198754;"></i>
                <small class="text-muted fw-bold text-uppercase" style="font-size: 0.75rem;">Atendidos / Resueltos</small>
                <h2 class="fw-bold mt-2 mb-0 text-dark">
                    @ListaReclamos.Count(r => r.Estado == "RESUELTO" || r.Estado == "CERRADO")
                </h2>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="p-4 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-3">
            <h5 class="fw-bold mb-0 text-dark">Bandeja de Reclamos</h5>

            <div class="d-flex gap-3 align-items-center ms-auto flex-wrap">
                <div class="input-group shadow-sm" style="width: 250px;">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text"
                           class="form-control bg-white border-start-0 ps-0"
                           placeholder="Buscar..."
                           value="@FiltroBusqueda"
                           @oninput="OnFiltroBusquedaChanged" />
                </div>

                <select class="form-select bg-white shadow-sm" style="width: 200px;" @bind="FiltroEstado">
                    <option value="">Todos los Estados</option>
                    <option value="ABIERTO">Abierto</option>
                    <option value="EN_REVISION">En revisión</option>
                    <option value="EN_PROCESO">En proceso</option>
                    <option value="RESUELTO">Resuelto</option>
                    <option value="CERRADO">Cerrado</option>
                    <option value="RECHAZADO">Rechazado</option>
                </select>
            </div>
        </div>

        @if (cargando)
        {
            <div class="text-center py-5 text-muted">
                Cargando reclamos...
            </div>
        }
        else if (!ReclamosFiltrados.Any())
        {
            <div class="text-center py-5 text-muted">
                No se encontraron reclamos.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle table-hover m-0">
                    <thead class="text-uppercase" style="font-size: 0.8rem; border-bottom: 2px solid #000;">
                        <tr>
                            <th class="fw-bold py-3 text-muted ps-4">ID Reclamo</th>
                            <th class="fw-bold py-3 text-muted">Fecha</th>
                            <th class="fw-bold py-3 text-muted">Cliente / Pedido</th>
                            <th class="fw-bold py-3 text-muted">Motivo Principal</th>
                            <th class="fw-bold py-3 text-muted">Área Encargada</th>
                            <th class="fw-bold py-3 text-muted">Estado</th>
                            <th class="fw-bold py-3 text-muted text-end pe-4">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var reclamo in ReclamosFiltrados)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">
                                    #@reclamo.Codigo
                                </td>

                                <td class="text-muted fw-semibold" style="font-size: 0.85rem;">
                                    @(reclamo.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? "29/06/2026 09:11")
                                </td>

                                <td>
                                    <div class="fw-bold text-dark">
                                        @NombreCliente(reclamo.Cliente)
                                    </div>
                                    <small class="text-muted d-flex align-items-center gap-1">
                                        <i class="bi bi-box"></i>
                                        @if(reclamo.Pedido == null)
                                        {
                                            <em>Sin pedido</em>
                                        }
                                        else
                                        {
                                            @(string.IsNullOrWhiteSpace(reclamo.Pedido.CodigoPedido) ? $"LUM-{reclamo.Pedido.IdPedido}" : reclamo.Pedido.CodigoPedido)
                                        }
                                    </small>
                                </td>

                                <td class="fw-semibold text-dark">
                                    <span class="d-inline-block text-truncate" style="max-width: 200px;">
                                        @reclamo.Asunto
                                    </span>
                                </td>

                                <td class="text-muted fw-semibold">
                                    @if(string.IsNullOrWhiteSpace(reclamo.AreaAsignada))
                                    {
                                        <em class="text-muted">Sin asignar</em>
                                    }
                                    else
                                    {
                                        @if(reclamo.AreaAsignada == "Logística") {
                                            <span class="d-flex align-items-center gap-2"><i class="bi bi-building"></i> Logística</span>
                                        } else {
                                            @reclamo.AreaAsignada
                                        }
                                    }
                                </td>

                                <td>
                                    <span class="badge rounded-pill text-uppercase px-3 py-2"
                                          style="background-color: @(GetEstadoBgColor(reclamo.Estado))20; color: @GetEstadoBgColor(reclamo.Estado); font-size: 0.75rem;">
                                        @FormatoEstado(reclamo.Estado)
                                    </span>
                                </td>

                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-light border rounded-pill px-3 fw-semibold text-dark"
                                            @onclick="() => AbrirReclamo(reclamo)">
                                        Gestionar <i class="bi bi-arrow-right ms-1"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (ReclamoSeleccionado != null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.45);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-bottom-0 px-4 pt-4">
                    <div>
                        <h5 class="modal-title fw-bold" style="color: #6a3849;">
                            Gestión del reclamo @ReclamoSeleccionado.Codigo
                        </h5>

                        <p class="text-muted small mb-0">
                            @NombreCliente(ReclamoSeleccionado.Cliente)
                        </p>
                    </div>

                    <button type="button"
                            class="btn-close"
                            @onclick="CerrarReclamo">
                    </button>
                </div>

                <div class="modal-body px-4 py-3">
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <small class="text-muted text-uppercase fw-bold">
                                Tipo
                            </small>

                            <div class="fw-semibold mt-1">
                                @FormatoTipo(ReclamoSeleccionado.Tipo)
                            </div>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted text-uppercase fw-bold">
                                Prioridad
                            </small>

                            <div class="fw-semibold mt-1">
                                @ReclamoSeleccionado.Prioridad
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <small class="text-muted text-uppercase fw-bold">
                            Asunto
                        </small>

                        <div class="fw-semibold mt-1">
                            @ReclamoSeleccionado.Asunto
                        </div>
                    </div>

                    <div class="mb-4">
                        <small class="text-muted text-uppercase fw-bold">
                            Descripción
                        </small>

                        <p class="text-secondary mt-1 mb-0">
                            @ReclamoSeleccionado.Descripcion
                        </p>
                    </div>

                    <div class="border rounded-4 p-3 bg-light">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    Área encargada
                                </label>

                                <select class="form-select"
                                        @bind="areaTemporal"
                                        disabled="@EsFinal(ReclamoSeleccionado.Estado)">
                                    <option value="">Seleccionar área...</option>
                                    <option value="Logística">Logística</option>
                                    <option value="Ventas">Ventas</option>
                                    <option value="Almacén">Almacén</option>
                                    <option value="Soporte">Soporte</option>
                                </select>

                                <button class="btn btn-outline-secondary btn-sm mt-2"
                                        disabled="@string.IsNullOrWhiteSpace(areaTemporal)"
                                        @onclick="AsignarAreaAsync">
                                    Asignar área
                                </button>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    Estado
                                </label>

                                <select class="form-select"
                                        @bind="estadoTemporal">
                                    <option value="ABIERTO">Abierto</option>
                                    <option value="EN_REVISION">En revisión</option>
                                    <option value="EN_PROCESO">En proceso</option>
                                    <option value="RESUELTO">Resuelto</option>
                                    <option value="CERRADO">Cerrado</option>
                                    <option value="RECHAZADO">Rechazado</option>
                                </select>

                                <button class="btn btn-outline-secondary btn-sm mt-2"
                                        @onclick="CambiarEstadoAsync">
                                    Guardar estado
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top-0 px-4 pb-4">
                    <button type="button"
                            class="btn btn-light border"
                            @onclick="CerrarReclamo">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Reclamo> ListaReclamos = new();

    private Reclamo? ReclamoSeleccionado;

    private bool cargando = true;

    private string _filtroBusqueda = string.Empty;
    private string _filtroEstado = string.Empty;

    private string areaTemporal = string.Empty;
    private string estadoTemporal = string.Empty;

    private string mensaje = string.Empty;
    private bool esError;

    private string FiltroBusqueda
    {
        get => _filtroBusqueda;
        set => _filtroBusqueda = value;
    }

    private string FiltroEstado
    {
        get => _filtroEstado;
        set => _filtroEstado = value;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAdmin)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        await CargarReclamosAsync();
    }

    private async Task CargarReclamosAsync()
    {
        cargando = true;

        try
        {
            ListaReclamos = await ReclamoRestService.ListarReclamosAsync();

            // Mostrar la tabla inmediatamente sin esperar el enriquecimiento
            cargando = false;
            StateHasChanged();

            // Recoger IDs únicos de clientes que necesitan nombre
            var idsNecesarios = ListaReclamos
                .Where(r => r.Cliente != null && r.Cliente.Id > 0 && string.IsNullOrEmpty(r.Cliente.Nombre))
                .Select(r => r.Cliente!.Id)
                .Distinct()
                .ToList();

            if (idsNecesarios.Any())
            {
                // Fetch de todos los clientes EN PARALELO (no secuencial)
                var tareas = idsNecesarios.Select(id => ClienteRestService.BuscarClienteAsync(id));
                var resultados = await Task.WhenAll(tareas);

                var clientesCache = idsNecesarios
                    .Zip(resultados, (id, cli) => new { id, cli })
                    .Where(x => x.cli != null)
                    .ToDictionary(x => x.id, x => x.cli!);

                foreach (var reclamo in ListaReclamos)
                {
                    if (reclamo.Cliente != null
                        && reclamo.Cliente.Id > 0
                        && string.IsNullOrEmpty(reclamo.Cliente.Nombre)
                        && clientesCache.TryGetValue(reclamo.Cliente.Id, out var c))
                    {
                        reclamo.Cliente.Nombre = c.Nombre;
                        reclamo.Cliente.Apellido = c.Apellido;
                    }
                }

                // Re-render con los nombres de cliente ya cargados
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"No se pudieron cargar los reclamos: {ex.Message}", true);
            cargando = false;
        }
    }

    private IEnumerable<Reclamo> ReclamosFiltrados =>
        ListaReclamos
            .Where(reclamo =>
                string.IsNullOrWhiteSpace(FiltroBusqueda)
                || reclamo.Codigo.Contains(
                    FiltroBusqueda,
                    StringComparison.OrdinalIgnoreCase
                )
                || reclamo.Asunto.Contains(
                    FiltroBusqueda,
                    StringComparison.OrdinalIgnoreCase
                )
                || NombreCliente(reclamo.Cliente).Contains(
                    FiltroBusqueda,
                    StringComparison.OrdinalIgnoreCase
                ))
            .Where(reclamo =>
                string.IsNullOrWhiteSpace(FiltroEstado)
                || string.Equals(
                    reclamo.Estado,
                    FiltroEstado,
                    StringComparison.OrdinalIgnoreCase
                ));

    private void OnFiltroBusquedaChanged(ChangeEventArgs e)
    {
        FiltroBusqueda = e.Value?.ToString() ?? string.Empty;
    }

    private void AbrirReclamo(Reclamo reclamo)
    {
        ReclamoSeleccionado = reclamo;
        areaTemporal = reclamo.AreaAsignada;
        estadoTemporal = reclamo.Estado;
    }

    private void CerrarReclamo()
    {
        ReclamoSeleccionado = null;
        areaTemporal = string.Empty;
        estadoTemporal = string.Empty;
    }

    private async Task AsignarAreaAsync()
    {
        if (ReclamoSeleccionado == null
            || string.IsNullOrWhiteSpace(areaTemporal))
        {
            return;
        }

        Reclamo? actualizado = null;
        string areaAnterior = ReclamoSeleccionado.AreaAsignada;
        string estadoAnterior = ReclamoSeleccionado.Estado;

        try
        {
            // Workaround: El endpoint asignarArea da 404 en el GlassFish actual
            // Usamos actualizar() que sí funciona.
            ReclamoSeleccionado.AreaAsignada = areaTemporal;
            ReclamoSeleccionado.Estado = "EN_PROCESO";
            
            actualizado = await ReclamoRestService.ActualizarReclamoAsync(ReclamoSeleccionado);
        }
        catch
        {
            // silenciar errores de red
        }

        if (actualizado == null)
        {
            ReclamoSeleccionado.AreaAsignada = areaAnterior;
            ReclamoSeleccionado.Estado = estadoAnterior;
            ShowMessage("No se pudo asignar el área. El servidor no respondió.", true);
            return;
        }

        ReclamoSeleccionado.AreaAsignada = actualizado.AreaAsignada;
        ReclamoSeleccionado.Estado = actualizado.Estado;

        ShowMessage("Área asignada correctamente en la BD.", false);

        await CargarReclamosAsync();

        ReclamoSeleccionado = ListaReclamos.FirstOrDefault(
            reclamo => reclamo.IdReclamo == actualizado.IdReclamo
        );

        if (ReclamoSeleccionado != null)
        {
            areaTemporal = ReclamoSeleccionado.AreaAsignada;
            estadoTemporal = ReclamoSeleccionado.Estado;
        }
    }

    private async Task CambiarEstadoAsync()
    {
        if (ReclamoSeleccionado == null
            || string.IsNullOrWhiteSpace(estadoTemporal))
        {
            return;
        }

        Reclamo? actualizado = null;
        string estadoAnterior = ReclamoSeleccionado.Estado;

        try
        {
            // Workaround: El endpoint cambiarEstado da 404 en el GlassFish actual
            // Usamos actualizar() que sí funciona.
            ReclamoSeleccionado.Estado = estadoTemporal;
            actualizado = await ReclamoRestService.ActualizarReclamoAsync(ReclamoSeleccionado);
        }
        catch
        {
            // silenciar errores de red
        }

        if (actualizado == null)
        {
            ReclamoSeleccionado.Estado = estadoAnterior;
            ShowMessage("No se pudo actualizar el estado del reclamo. El servidor no respondió.", true);
            return;
        }

        ReclamoSeleccionado.Estado = actualizado.Estado;
        ReclamoSeleccionado.AreaAsignada = actualizado.AreaAsignada;

        ShowMessage("Estado del reclamo actualizado correctamente.", false);

        await CargarReclamosAsync();

        ReclamoSeleccionado = ListaReclamos.FirstOrDefault(
            reclamo => reclamo.IdReclamo == actualizado.IdReclamo
        );

        if (ReclamoSeleccionado != null)
        {
            areaTemporal = ReclamoSeleccionado.AreaAsignada;
            estadoTemporal = ReclamoSeleccionado.Estado;
        }
    }

    private void ShowMessage(string texto, bool error)
    {
        mensaje = texto;
        esError = error;
    }

    private void ClearMessage()
    {
        mensaje = string.Empty;
    }

    private static string NombreCliente(Cliente? cliente)
    {
        if (cliente == null)
        {
            return "Sin cliente";
        }

        return $"{cliente.Nombre} {cliente.Apellido}".Trim();
    }

    private static bool EsFinal(string estado)
    {
        return estado == "RESUELTO"
            || estado == "CERRADO"
            || estado == "RECHAZADO";
    }

    private static string FormatoEstado(string estado)
    {
        return estado switch
        {
            "ABIERTO" => "Abierto",
            "EN_REVISION" => "En revisión",
            "EN_PROCESO" => "En proceso",
            "RESUELTO" => "Resuelto",
            "CERRADO" => "Cerrado",
            "RECHAZADO" => "Rechazado",
            _ => estado
        };
    }

    private static string FormatoTipo(string tipo)
    {
        return tipo switch
        {
            "PRODUCTO_DANADO" => "Producto dañado",
            "PRODUCTO_INCORRECTO" => "Producto incorrecto",
            "FALTANTE" => "Producto faltante",
            "DEMORA_ENVIO" => "Demora de envío",
            "COBRO_INCORRECTO" => "Cobro incorrecto",
            "OTRO" => "Otro",
            _ => tipo
        };
    }

    private static string GetEstadoBgColor(string estado)
    {
        return estado switch
        {
            "ABIERTO" => "#f8d7da",
            "EN_REVISION" => "#fff3cd",
            "EN_PROCESO" => "#fff3cd",
            "RESUELTO" => "#d1e7dd",
            "CERRADO" => "#e2e3e5",
            "RECHAZADO" => "#e2e3e5",
            _ => "#f8f9fa"
        };
    }
}