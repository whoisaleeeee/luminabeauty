@page "/admin/inventario"
@layout AdminLayout

@using LuminaBeauty.Models
@using LuminaBeauty.Services
@using LuminaBeauty.Servicios.REST

@inject ProductoRestService ProductoRestService
@inject AuthService Auth
@inject NavigationManager Navigation

<div class="admin-page">

    <TopHeader Title="Inventario" SearchPlaceholder="Buscar en inventario..." />

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <p class="text-muted mb-0">
            Consulta el stock actual y registra reposiciones.
        </p>

        <button class="btn text-white px-4 py-2 rounded-3 shadow-sm"
                style="background-color: #6a3849;"
                @onclick="OpenRestockModal">
            <i class="bi bi-plus-lg"></i>
            Nueva entrada
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @mensaje
            <button class="btn-close" @onclick="ClearMessage"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <small class="text-muted fw-semibold">Unidades totales</small>
                <h2 class="fw-bold mt-2 mb-0">@UnidadesTotales</h2>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <small class="text-muted fw-semibold">Alertas de stock</small>
                <h2 class="fw-bold mt-2 mb-0" style="color: #b02a37;">@AlertasStock</h2>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <small class="text-muted fw-semibold">Valor de inventario</small>
                <h2 class="fw-bold mt-2 mb-0">S/ @ValorInventario.ToString("N2")</h2>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100"
                 style="background-color: #fdf5f5;">
                <small class="fw-semibold" style="color: #b02a37;">Sin stock</small>
                <h2 class="fw-bold mt-2 mb-0" style="color: #b02a37;">@SinStock</h2>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4">
        <div class="row g-3 mb-4 pb-4 border-bottom">
            <div class="col-12 col-md-5">
                <label class="form-label text-muted small fw-bold text-uppercase">
                    Producto
                </label>

                <input type="text"
                       class="form-control bg-light"
                       placeholder="Buscar por nombre o SKU..."
                       value="@FiltroProducto"
                       @oninput="OnFiltroProductoChanged" />
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label text-muted small fw-bold text-uppercase">
                    Estado de stock
                </label>

                <select class="form-select bg-light" @bind="FiltroStock">
                    <option value="todos">Todos</option>
                    <option value="sin-stock">Sin stock</option>
                    <option value="bajo-stock">Stock bajo</option>
                    <option value="disponible">Disponible</option>
                </select>
            </div>
        </div>

        @if (cargando)
        {
            <div class="text-center py-5 text-muted">
                Cargando inventario...
            </div>
        }
        else if (!ProductosFiltrados.Any())
        {
            <div class="text-center py-5 text-muted">
                No se encontraron productos.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Producto</th>
                            <th>Categoría</th>
                            <th>Precio</th>
                            <th>Stock</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int numeroFila = ((paginaActual - 1) * productosPorPagina) + 1;
                        }

                        @foreach (var producto in ProductosPaginados)
                        {
                            <tr>
                                <td>@numeroFila</td>

                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-3 overflow-hidden border"
                                             style="width: 48px; height: 48px; background-color: #f8f9fa;">
                                            @if (!string.IsNullOrWhiteSpace(producto.Imagen))
                                            {
                                                <img src="@producto.Imagen"
                                                     alt="@producto.Nombre"
                                                     class="w-100 h-100 object-fit-cover" />
                                            }
                                            else
                                            {
                                                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                                                    <i class="bi bi-image"></i>
                                                </div>
                                            }
                                        </div>

                                        <div>
                                            <div class="fw-semibold">@producto.Nombre</div>
                                            <small class="text-muted">@producto.Sku</small>
                                        </div>
                                    </div>
                                </td>

                                <td>@(producto.Categoria?.Nombre ?? "-")</td>
                                <td>S/ @producto.Precio.ToString("F2")</td>

                                <td>
                                    <span class="badge rounded-pill text-dark"
                                          style="background-color: @GetStockBgColor(producto.Stock);">
                                        @producto.Stock uds.
                                    </span>
                                </td>

                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary"
                                            title="Registrar reposición"
                                            @onclick="() => OpenRestockModal(producto)">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>
                                </td>
                            </tr>

                            numeroFila++;
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3">
                <small class="text-muted">
                    Mostrando @PrimeroVisible - @UltimoVisible de @TotalProductosFiltrados productos
                </small>

                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary"
                            disabled="@(paginaActual == 1)"
                            @onclick="PreviousPage">
                        <i class="bi bi-chevron-left"></i>
                    </button>

                    <span class="px-2 py-1 text-muted">
                        @paginaActual / @TotalPaginas
                    </span>

                    <button class="btn btn-sm btn-outline-secondary"
                            disabled="@(paginaActual >= TotalPaginas)"
                            @onclick="NextPage">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@if (showRestockModal)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg" style="max-width: 480px; margin: auto;">
                <div class="modal-header border-bottom-0 pb-0 px-4 pt-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 d-flex align-items-center justify-content-center"
                             style="width:44px;height:44px;background:#fde8ed;">
                            <i class="bi bi-box-arrow-in-down fs-5" style="color:#6a3849;"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold mb-0" style="color:#1a1a1a;font-size:1.05rem;">Registrar Entrada</h5>
                            <p class="text-muted mb-0" style="font-size:0.8rem;">Ingreso de stock al inventario.</p>
                        </div>
                    </div>
                    <button class="btn-close ms-auto"
                            @onclick="CloseRestockModal">
                    </button>
                </div>

                <div class="modal-body px-4 py-3">

                    <!-- Producto (buscador con texto) -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-uppercase" style="font-size:0.7rem;letter-spacing:.5px;color:#888;">Producto</label>
                        <div class="position-relative">
                            <i class="bi bi-search position-absolute" style="top:50%;left:12px;transform:translateY(-50%);color:#aaa;font-size:.85rem;"></i>
                            <input type="text"
                                   class="form-control ps-4"
                                   placeholder="Buscar por nombre o SKU..."
                                   value="@busquedaProducto"
                                   @oninput="OnBusquedaProductoChanged" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(busquedaProducto) && productoBusquedaResultados.Any())
                        {
                            <div class="border rounded-3 mt-1 shadow-sm" style="max-height:160px;overflow-y:auto;background:white;position:relative;z-index:9999;">
                                @foreach (var p in productoBusquedaResultados.Take(6))
                                {
                                    <div class="px-3 py-2 border-bottom cursor-pointer"
                                         style="font-size:0.85rem;cursor:pointer;"
                                         @onclick="() => SeleccionarProductoBusqueda(p)">
                                        <strong>@p.Nombre</strong>
                                        <span class="text-muted ms-1">(@p.Sku)</span>
                                    </div>
                                }
                            </div>
                        }
                        @if (ProductoSeleccionado != null)
                        {
                            <small class="text-muted" style="font-size:0.75rem;">Ej. @ProductoSeleccionado.Sku - @ProductoSeleccionado.Nombre</small>
                        }
                    </div>

                    <!-- Lote + Cantidad -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold text-uppercase" style="font-size:0.7rem;letter-spacing:.5px;color:#888;">Lote (Batch)</label>
                            <input type="text"
                                   class="form-control"
                                   placeholder="Ej. L-2026X"
                                   @bind="loteEntrada" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold text-uppercase" style="font-size:0.7rem;letter-spacing:.5px;color:#888;">Cantidad</label>
                            <input type="number"
                                   class="form-control"
                                   min="1"
                                   @bind="cantidadReposicion" />
                        </div>
                    </div>

                    <!-- Tipo de movimiento -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-uppercase" style="font-size:0.7rem;letter-spacing:.5px;color:#888;">Tipo de Movimiento</label>
                        <select class="form-select" @bind="tipoMovimiento">
                            <option value="ENTRADA">Entrada</option>
                            <option value="SALIDA">Salida</option>
                            <option value="AJUSTE">Ajuste</option>
                        </select>
                    </div>

                    <!-- Motivo -->
                    <div class="mb-2">
                        <label class="form-label fw-semibold text-uppercase" style="font-size:0.7rem;letter-spacing:.5px;color:#888;">Motivo de Entrada</label>
                        <input type="text"
                               class="form-control"
                               placeholder="Detalla el motivo del movimiento acá"
                               @bind="motivoEntrada" />
                    </div>

                </div>

                <div class="modal-footer border-top-0 px-4 pb-4">
                    <button class="btn btn-light border rounded-3"
                            @onclick="CloseRestockModal">
                        Cancelar
                    </button>

                    <button class="btn text-white rounded-3 d-flex align-items-center gap-2"
                            style="background-color: #6a3849;"
                            disabled="@guardandoRestock"
                            @onclick="SaveRestockAsync">
                        <i class="bi bi-check-circle"></i>
                        @(guardandoRestock ? "Guardando..." : "Confirmar Entrada")
                    </button>
                </div>
            </div>
        </div>
    </div>
}


@code {
    private List<Producto> Productos = new();

    private bool cargando = true;
    private bool showRestockModal;

    private int paginaActual = 1;
    private const int productosPorPagina = 8;

    private string _filtroProducto = string.Empty;
    private string FiltroProducto
    {
        get => _filtroProducto;
        set
        {
            _filtroProducto = value;
            paginaActual = 1;
        }
    }

    private string _filtroStock = "todos";
    private string FiltroStock
    {
        get => _filtroStock;
        set
        {
            _filtroStock = value;
            paginaActual = 1;
        }
    }

    private int productoSeleccionadoId;
    private int cantidadReposicion = 1;
    private string loteEntrada = string.Empty;
    private string tipoMovimiento = "ENTRADA";
    private string motivoEntrada = string.Empty;
    private string busquedaProducto = string.Empty;
    private bool guardandoRestock = false;

    private IEnumerable<Producto> productoBusquedaResultados =>
        string.IsNullOrWhiteSpace(busquedaProducto)
            ? Enumerable.Empty<Producto>()
            : Productos.Where(p =>
                p.Nombre.Contains(busquedaProducto, StringComparison.OrdinalIgnoreCase)
                || p.Sku.Contains(busquedaProducto, StringComparison.OrdinalIgnoreCase));

    private string mensaje = string.Empty;
    private bool esError;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAdmin)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        await CargarProductosAsync();
    }

    private async Task CargarProductosAsync()
    {
        cargando = true;

        try
        {
            Productos = await ProductoRestService.ListarProductosTodosAsync();
        }
        catch (Exception ex)
        {
            ShowMessage($"No se pudo cargar el inventario: {ex.Message}", true);
        }
        finally
        {
            cargando = false;
        }
    }

    private void OnFiltroProductoChanged(ChangeEventArgs e)
    {
        FiltroProducto = e.Value?.ToString() ?? string.Empty;
    }

    private IEnumerable<Producto> ProductosFiltrados =>
        Productos
            .Where(producto =>
                string.IsNullOrWhiteSpace(FiltroProducto)
                || producto.Nombre.Contains(
                    FiltroProducto,
                    StringComparison.OrdinalIgnoreCase
                )
                || producto.Sku.Contains(
                    FiltroProducto,
                    StringComparison.OrdinalIgnoreCase
                ))
            .Where(producto =>
                FiltroStock == "todos"
                || (FiltroStock == "sin-stock" && producto.Stock <= 0)
                || (FiltroStock == "bajo-stock"
                    && producto.Stock > 0
                    && producto.Stock <= 12)
                || (FiltroStock == "disponible" && producto.Stock > 12));

    private IEnumerable<Producto> ProductosPaginados =>
        ProductosFiltrados
            .Skip((paginaActual - 1) * productosPorPagina)
            .Take(productosPorPagina);

    private int TotalProductosFiltrados => ProductosFiltrados.Count();

    private int TotalPaginas =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                TotalProductosFiltrados / (double)productosPorPagina
            )
        );

    private int PrimeroVisible =>
        TotalProductosFiltrados == 0
            ? 0
            : ((paginaActual - 1) * productosPorPagina) + 1;

    private int UltimoVisible =>
        Math.Min(
            paginaActual * productosPorPagina,
            TotalProductosFiltrados
        );

    private int UnidadesTotales => Productos.Sum(producto => producto.Stock);

    private int AlertasStock =>
        Productos.Count(producto => producto.Stock <= 12);

    private int SinStock =>
        Productos.Count(producto => producto.Stock <= 0);

    private decimal ValorInventario =>
        Productos.Sum(producto => producto.Precio * producto.Stock);

    private Producto? ProductoSeleccionado =>
        Productos.FirstOrDefault(
            producto => producto.IdProducto == productoSeleccionadoId
        );

    private void OpenRestockModal()
    {
        productoSeleccionadoId = 0;
        cantidadReposicion = 1;
        busquedaProducto = string.Empty;
        loteEntrada = string.Empty;
        motivoEntrada = string.Empty;
        tipoMovimiento = "ENTRADA";
        showRestockModal = true;
    }

    private void OpenRestockModal(Producto producto)
    {
        productoSeleccionadoId = producto.IdProducto;
        busquedaProducto = $"{producto.Nombre} ({producto.Sku})";
        cantidadReposicion = 1;
        loteEntrada = string.Empty;
        motivoEntrada = string.Empty;
        tipoMovimiento = "ENTRADA";
        showRestockModal = true;
    }

    private void SeleccionarProductoBusqueda(Producto producto)
    {
        productoSeleccionadoId = producto.IdProducto;
        busquedaProducto = $"{producto.Nombre} ({producto.Sku})";
    }

    private void OnBusquedaProductoChanged(ChangeEventArgs e)
    {
        busquedaProducto = e.Value?.ToString() ?? string.Empty;
        // Si el texto no coincide exactamente con un producto seleccionado, limpiar selección
        var match = Productos.FirstOrDefault(p =>
            $"{p.Nombre} ({p.Sku})" == busquedaProducto);
        if (match == null) productoSeleccionadoId = 0;
    }

    private void CloseRestockModal()
    {
        showRestockModal = false;
        productoSeleccionadoId = 0;
        cantidadReposicion = 1;
    }

    private async Task SaveRestockAsync()
    {
        var producto = ProductoSeleccionado;

        if (producto == null || cantidadReposicion <= 0)
        {
            ShowMessage("Selecciona un producto e ingresa una cantidad válida.", true);
            return;
        }

        guardandoRestock = true;

        int delta = tipoMovimiento == "SALIDA" ? -cantidadReposicion : cantidadReposicion;
        producto.Stock += delta;

        var actualizado =
            await ProductoRestService.ActualizarProductoAsync(producto);

        guardandoRestock = false;

        if (actualizado == null)
        {
            producto.Stock -= delta;
            ShowMessage("No se pudo actualizar el stock.", true);
            return;
        }

        CloseRestockModal();
        ShowMessage($"{tipoMovimiento.ToLower().Replace("entrada","Entrada").Replace("salida","Salida").Replace("ajuste","Ajuste")} de inventario registrada correctamente.", false);

        await CargarProductosAsync();
    }

    private void PreviousPage()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
        }
    }

    private void NextPage()
    {
        if (paginaActual < TotalPaginas)
        {
            paginaActual++;
        }
    }

    private void ShowMessage(string texto, bool error)
    {
        mensaje = texto;
        esError = error;
    }

    private void ClearMessage()
    {
        mensaje = string.Empty;
    }

    private static string GetStockBgColor(int stock)
    {
        if (stock <= 0)
        {
            return "#f8d7da";
        }

        if (stock <= 12)
        {
            return "#fff3cd";
        }

        return "#d1e7dd";
    }
}