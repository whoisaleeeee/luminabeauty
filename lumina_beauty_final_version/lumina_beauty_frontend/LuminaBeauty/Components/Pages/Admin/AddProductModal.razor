@using LuminaBeauty.Models

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-bottom-0 pb-0 px-4 pt-4">
                    <div>
                        <h4 class="modal-title fw-bold" style="color: #6a3849;">Agregar nuevo producto</h4>
                        <p class="text-muted small m-0">Completa la información técnica y visual del producto.</p>
                    </div>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseModal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body px-4 py-4">

                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                  style="width: 28px; height: 28px; background-color: #fcf0f4; color: #d9557b; font-size: 0.8rem;">
                                01
                            </span>

                            <h6 class="m-0 fw-semibold text-dark">Información básica</h6>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase"
                                       style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                    Nombre del producto
                                </label>

                                <input type="text"
                                       class="form-control bg-light border-1"
                                       placeholder="Ej. Crema Hidratante de Rosas"
                                       @bind="NewProduct.Nombre" />
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label text-muted small fw-bold text-uppercase"
                                       style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                    Slug / Código
                                </label>

                                <input type="text"
                                       class="form-control bg-light border-1 font-monospace text-muted"
                                       placeholder="GLAM-CR-001"
                                       @bind="NewProduct.Slug" />
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label text-muted small fw-bold text-uppercase"
                                       style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                    SKU
                                </label>

                                <input type="text"
                                       class="form-control bg-light border-1 font-monospace text-muted"
                                       placeholder="1234567890"
                                       @bind="NewProduct.Sku" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase"
                                       style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                    Marca
                                </label>

                                <select class="form-select bg-light border-1 text-secondary"
                                        @bind="marcaId">
                                    <option value="0">Seleccionar marca...</option>

                                    @foreach (var marca in Marcas)
                                    {
                                        <option value="@marca.IdMarca">@marca.Nombre</option>
                                    }
                                </select>
                            </div>

                            <div class="col-6 col-md-3">
                                <label class="form-label text-muted small fw-bold text-uppercase"
                                       style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                    Precio de venta
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">S/</span>

                                    <input type="number"
                                           class="form-control bg-light border-start-0"
                                           placeholder="0.00"
                                           min="0"
                                           step="0.01"
                                           @bind="NewProduct.Precio" />
                                </div>
                            </div>

                            <div class="col-6 col-md-3">
                                <label class="form-label text-muted small fw-bold text-uppercase"
                                       style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                    Stock inicial
                                </label>

                                <input type="number"
                                       class="form-control bg-light border-1"
                                       min="0"
                                       @bind="NewProduct.Stock" />
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label text-muted small fw-bold text-uppercase"
                                   style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                Descripción del producto
                            </label>

                            <input type="text"
                                   class="form-control bg-light border-1"
                                   placeholder="Ej. Crema de manos en base a rosas"
                                   @bind="NewProduct.Descripcion" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                  style="width: 28px; height: 28px; background-color: #fcf0f4; color: #d9557b; font-size: 0.8rem;">
                                02
                            </span>

                            <h6 class="m-0 fw-semibold text-dark">Categorización</h6>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase"
                                       style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                    Categoría
                                </label>

                                <select class="form-select bg-light border-1 text-secondary"
                                        @bind="categoriaId">
                                    <option value="0">Seleccionar categoría...</option>

                                    @foreach (var categoria in Categorias)
                                    {
                                        <option value="@categoria.IdCategoria">@categoria.Nombre</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase"
                                       style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                    Tipo de piel
                                </label>

                                <select class="form-select bg-light border-1 text-secondary"
                                        @bind="tipoPielSeleccionado">
                                    <option value="">Seleccionar tipo de piel...</option>

                                    @foreach (var tipo in TiposPiel)
                                    {
                                        <option value="@tipo">@tipo</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="mb-2">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                  style="width: 28px; height: 28px; background-color: #fcf0f4; color: #d9557b; font-size: 0.8rem;">
                                03
                            </span>

                            <h6 class="m-0 fw-semibold text-dark">Imagen principal</h6>
                        </div>

                        <label class="form-label text-muted small fw-bold text-uppercase"
                               style="font-size: 0.7rem; letter-spacing: 0.5px;">
                            Ruta de imagen
                        </label>

                        <input type="text"
                               class="form-control bg-light border-1"
                               placeholder="/images/products/nombre-imagen.jpg"
                               @bind="NewProduct.Imagen" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger mt-2" role="alert">
                            @errorMessage
                        </div>
                    }
                </div>

                <div class="modal-footer border-top-0 px-4 pb-4 pt-2">
                    <button type="button"
                            class="btn btn-light px-4 border rounded-3"
                            @onclick="CloseModal">
                        Cancelar
                    </button>

                    <button type="button"
                            class="btn text-white px-4 d-flex align-items-center gap-2 rounded-3 shadow-sm"
                            style="background-color: #834a5d;"
                            @onclick="SaveProduct">
                        <i class="bi bi-save"></i>
                        Guardar producto
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    [Parameter]
    public EventCallback<Producto> OnProductAdded { get; set; }

    [Parameter]
    public List<CategoriaProducto> Categorias { get; set; } = new();

    [Parameter]
    public List<Marca> Marcas { get; set; } = new();

    [Parameter]
    public List<string> TiposPiel { get; set; } = new();

    private Producto NewProduct = new();
    private int categoriaId;
    private int marcaId;
    private string tipoPielSeleccionado = string.Empty;

    private async Task CloseModal()
    {
        ResetForm();

        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
    }

    private string errorMessage = string.Empty;
    private async Task SaveProduct()
    {
        errorMessage = string.Empty;
        if (string.IsNullOrWhiteSpace(NewProduct.Nombre)
            || categoriaId <= 0
            || marcaId <= 0)
        {
            errorMessage = "Por favor completa el nombre, categoría y marca del producto.";
            return;
        }

        if (string.IsNullOrWhiteSpace(NewProduct.Sku))
        {
            errorMessage = "El SKU del producto es obligatorio (ej: LB-FAC-001).";
            return;
        }

        // Auto-generar slug si está vacío
        if (string.IsNullOrWhiteSpace(NewProduct.Slug))
        {
            NewProduct.Slug = NewProduct.Nombre
                .ToLower()
                .Replace(" ", "-")
                .Replace("á","a").Replace("é","e").Replace("í","i")
                .Replace("ó","o").Replace("ú","u").Replace("ñ","n");
        }

        NewProduct.Categoria = new CategoriaProducto
        {
            IdCategoria = categoriaId
        };

        NewProduct.Marca = new Marca
        {
            IdMarca = marcaId
        };

        NewProduct.TipoPiel = string.IsNullOrWhiteSpace(tipoPielSeleccionado)
            ? "TODOS"
            : tipoPielSeleccionado.ToUpper();
        NewProduct.Estado = 1;

        await OnProductAdded.InvokeAsync(NewProduct);

        await CloseModal();
    }

    private void ResetForm()
    {
        NewProduct = new Producto();
        categoriaId = 0;
        marcaId = 0;
        tipoPielSeleccionado = string.Empty;
    }
}