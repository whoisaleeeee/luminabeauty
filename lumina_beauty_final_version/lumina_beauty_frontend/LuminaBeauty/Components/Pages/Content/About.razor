@page "/about"
@inject NavigationManager Navigator

<PageTitle>Sobre Lumina | Lumina Beauty</PageTitle>

<div class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12">

    <nav class="mb-6 flex items-center gap-2 text-xs font-semibold text-stone-400 select-none">
        <span class="cursor-pointer transition hover:text-[#C7346A]"
              @onclick='() => Navigator.NavigateTo("/")'>
            Inicio
        </span>
        <span class="text-stone-300">/</span>
        <span class="font-bold text-stone-600">Sobre Lumina</span>
    </nav>

    <section class="overflow-hidden rounded-[2rem] border border-stone-200/80 bg-white shadow-sm">

        <header class="border-b border-[#F6DDE5] bg-[#FFF7F9] px-6 py-8 sm:px-10 sm:py-10">
            <span class="inline-flex items-center gap-2 rounded-full border border-[#F5C8D6] bg-white px-3 py-1.5 text-[9px] font-black uppercase tracking-[0.16em] text-[#C7346A]">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 21s7-5.2 7-12A7 7 0 1 0 5 9c0 6.8 7 12 7 12Z"></path>
                    <circle cx="12" cy="9" r="2.5"></circle>
                </svg>
                Nuestra esencia
            </span>

            <div class="mt-4 grid gap-6 lg:grid-cols-[minmax(0,1fr)_240px] lg:items-end">
                <div>
                    <h1 class="font-serif text-3xl font-semibold tracking-tight text-stone-900 sm:text-4xl">
                        Belleza que acompaña tu esencia.
                    </h1>

                    <p class="mt-3 max-w-2xl text-xs leading-relaxed text-stone-500 sm:text-sm">
                        Lumina Beauty reúne cuidado personal y maquillaje gentil con tu piel, en una experiencia de compra clara, cercana y cuidadosamente seleccionada.
                    </p>
                </div>

                <div class="rounded-2xl border border-[#F5C8D6] bg-white p-4">
                    <p class="text-[9px] font-black uppercase tracking-[0.16em] text-[#C7346A]">
                        Lumina en una frase
                    </p>
                    <p class="mt-2 font-serif text-base font-semibold leading-snug text-stone-800">
                        Cuidado personal con una mirada suave, elegante y accesible.
                    </p>
                </div>
            </div>
        </header>

        <div class="px-6 py-8 sm:px-10 sm:py-10">

            <section class="grid gap-4 sm:grid-cols-3">
                <article class="rounded-2xl border border-stone-100 bg-white p-5 transition hover:-translate-y-0.5 hover:border-[#F3C7D5] hover:shadow-sm">
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#FFF0F3] text-[#C7346A]">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 3v18"></path>
                            <path d="M3 12h18"></path>
                        </svg>
                    </span>
                    <p class="mt-4 text-[10px] font-black uppercase tracking-[0.16em] text-[#C7346A]">Selección consciente</p>
                    <h2 class="mt-1 font-serif text-base font-semibold text-stone-900">Productos para tu rutina</h2>
                    <p class="mt-2 text-[11px] leading-relaxed text-stone-500">
                        Alternativas de skincare, maquillaje, cabello, fragancias y bienestar personal.
                    </p>
                </article>

                <article class="rounded-2xl border border-stone-100 bg-white p-5 transition hover:-translate-y-0.5 hover:border-[#F3C7D5] hover:shadow-sm">
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#FFF0F3] text-[#C7346A]">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 7h18"></path>
                            <path d="M5 7l1-3h12l1 3"></path>
                            <path d="M5 7v13h14V7"></path>
                            <path d="M9 11h6"></path>
                        </svg>
                    </span>
                    <p class="mt-4 text-[10px] font-black uppercase tracking-[0.16em] text-[#C7346A]">Compra clara</p>
                    <h2 class="mt-1 font-serif text-base font-semibold text-stone-900">Todo a tu alcance</h2>
                    <p class="mt-2 text-[11px] leading-relaxed text-stone-500">
                        Información visible, stock actualizado, favoritos y seguimiento de pedidos.
                    </p>
                </article>

                <article class="rounded-2xl border border-stone-100 bg-white p-5 transition hover:-translate-y-0.5 hover:border-[#F3C7D5] hover:shadow-sm">
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#FFF0F3] text-[#C7346A]">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="8" r="3.5"></circle>
                            <path d="M4.5 20a7.5 7.5 0 0 1 15 0"></path>
                        </svg>
                    </span>
                    <p class="mt-4 text-[10px] font-black uppercase tracking-[0.16em] text-[#C7346A]">Tu espacio Lumina</p>
                    <h2 class="mt-1 font-serif text-base font-semibold text-stone-900">Una cuenta contigo</h2>
                    <p class="mt-2 text-[11px] leading-relaxed text-stone-500">
                        Direcciones, pedidos, favoritos, reclamos y beneficios reunidos en un solo lugar.
                    </p>
                </article>
            </section>

            <section class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-[220px_minmax(0,1fr)]">
                <aside class="lg:sticky lg:top-6 lg:self-start">
                    <p class="text-[10px] font-black uppercase tracking-[0.18em] text-stone-400">
                        Conoce Lumina
                    </p>

                    <nav class="mt-3 space-y-1.5">
                        <a href="/about#propuesta"
                           class="block rounded-xl px-3 py-2.5 text-[11px] font-bold tracking-[0.01em] text-stone-600 transition hover:bg-[#FFF0F3] hover:text-[#C7346A]">
                            Nuestra propuesta
                        </a>
                        <a href="/about#seleccion"
                           class="block rounded-xl px-3 py-2.5 text-[11px] font-bold tracking-[0.01em] text-stone-600 transition hover:bg-[#FFF0F3] hover:text-[#C7346A]">
                            Selección de productos
                        </a>
                        <a href="/about#cuenta"
                           class="block rounded-xl px-3 py-2.5 text-[11px] font-bold tracking-[0.01em] text-stone-600 transition hover:bg-[#FFF0F3] hover:text-[#C7346A]">
                            Experiencia en tu cuenta
                        </a>
                    </nav>

                    <div class="mt-5 rounded-2xl border border-[#FCD1DB] bg-[#FFF7F9] p-4">
                        <p class="text-[10px] font-black uppercase tracking-[0.15em] text-[#C7346A]">
                            ¿Necesitas ayuda?
                        </p>
                        <p class="mt-1 text-[11px] leading-relaxed text-stone-500">
                            Encuentra orientación sobre productos, pedidos o tu cuenta.
                        </p>
                        <button type="button"
                                @onclick='() => Navigator.NavigateTo("/contact")'
                                class="mt-3 inline-flex items-center gap-1 text-[10px] font-black uppercase tracking-wider text-[#C7346A] transition hover:text-[#9E2B55]">
                            Ir a contacto
                            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M5 12h14"></path>
                                <path d="m13 6 6 6-6 6"></path>
                            </svg>
                        </button>
                    </div>
                </aside>

                <main class="max-w-3xl space-y-5 text-[13px] leading-7 text-stone-600 sm:text-[14px] sm:leading-8">

                    <section id="propuesta" class="scroll-mt-8 rounded-2xl border border-stone-100 bg-white p-5 sm:p-6">
                        <div class="flex gap-3">
                            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#FFF0F3] text-[#C7346A]">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 3v18"></path>
                                    <path d="M3 12h18"></path>
                                </svg>
                            </span>
                            <div>
                                <p class="text-[10px] font-black uppercase tracking-[0.20em] text-[#C7346A]">01</p>
                                <h2 class="mt-1 font-serif text-[1.02rem] font-semibold tracking-tight text-stone-900">
                                    Nuestra propuesta
                                </h2>
                            </div>
                        </div>

                        <p class="mt-4">
                            Lumina Beauty es una tienda de belleza enfocada en acompañar el cuidado personal con una experiencia premium, suave y cercana. Creemos en productos que se integren a tus rutinas y resalten tu bienestar, sin plantear la belleza como algo que se deba ocultar o corregir.
                        </p>

                        <p class="mt-3">
                            Nuestro catálogo reúne alternativas de cuidado facial, maquillaje, cuidado capilar, fragancias y bienestar personal para distintas preferencias y necesidades.
                        </p>
                    </section>

                    <section id="seleccion" class="scroll-mt-8 rounded-2xl border border-stone-100 bg-white p-5 sm:p-6">
                        <div class="flex gap-3">
                            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#FFF0F3] text-[#C7346A]">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M6 7h12l1 13H5L6 7Z"></path>
                                    <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
                                </svg>
                            </span>
                            <div>
                                <p class="text-[10px] font-black uppercase tracking-[0.20em] text-[#C7346A]">02</p>
                                <h2 class="mt-1 font-serif text-[1.02rem] font-semibold tracking-tight text-stone-900">
                                    Selección de productos
                                </h2>
                            </div>
                        </div>

                        <p class="mt-4">
                            Organizamos el catálogo por categoría, marca, precio, disponibilidad y valoraciones publicadas para que comparar opciones sea simple. Cada ficha busca mostrar la información esencial antes de que decidas agregar un producto a tu carrito.
                        </p>

                        <p class="mt-3">
                            La disponibilidad puede variar según el stock registrado. Cuando un producto deja de estar disponible, su estado se actualiza o puede retirarse temporalmente de la tienda.
                        </p>
                    </section>

                    <section id="cuenta" class="scroll-mt-8 rounded-2xl border border-stone-100 bg-white p-5 sm:p-6">
                        <div class="flex gap-3">
                            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#FFF0F3] text-[#C7346A]">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="8" r="3.5"></circle>
                                    <path d="M4.5 20a7.5 7.5 0 0 1 15 0"></path>
                                </svg>
                            </span>
                            <div>
                                <p class="text-[10px] font-black uppercase tracking-[0.20em] text-[#C7346A]">03</p>
                                <h2 class="mt-1 font-serif text-[1.02rem] font-semibold tracking-tight text-stone-900">
                                    Una experiencia centrada en tu cuenta
                                </h2>
                            </div>
                        </div>

                        <p class="mt-4">
                            Al crear una cuenta puedes registrar direcciones de entrega, revisar pedidos, consultar el estado de envío disponible, guardar productos en favoritos y acceder a tu saldo de puntos Lumina cuando corresponda.
                        </p>

                        <p class="mt-3">
                            También puedes actualizar tus datos de contacto desde Mi cuenta para mantener la información de entrega y comunicación al día.
                        </p>
                    </section>

                    <section class="rounded-2xl border border-[#FCD1DB] bg-[#FFF7F9] p-5 sm:p-6">
                        <div class="flex gap-3">
                            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-[#C7346A]">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                    <path d="m3 7 9 6 9-6"></path>
                                </svg>
                            </span>
                            <div>
                                <p class="text-[10px] font-black uppercase tracking-[0.20em] text-[#C7346A]">Atención Lumina</p>
                                <h2 class="mt-1 font-serif text-[1.02rem] font-semibold tracking-tight text-stone-900">
                                    Estamos para ayudarte
                                </h2>
                            </div>
                        </div>

                        <p class="mt-4">
                            Para consultas sobre productos, disponibilidad, pedidos, entregas o el uso de tu cuenta, visita nuestro Centro de ayuda. Podrás indicarnos el medio por el que prefieres recibir respuesta.
                        </p>

                        <button type="button"
                                @onclick='() => Navigator.NavigateTo("/contact")'
                                class="mt-4 inline-flex items-center gap-2 rounded-xl border border-[#F5C8D6] bg-white px-4 py-2.5 text-[11px] font-bold text-stone-700 transition hover:border-[#E7A9BE] hover:text-[#C7346A]">
                            Ir al Centro de ayuda
                            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M5 12h14"></path>
                                <path d="m13 6 6 6-6 6"></path>
                            </svg>
                        </button>
                    </section>
                </main>
            </section>
        </div>
    </section>
</div>
