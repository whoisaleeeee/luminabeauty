@page "/contact"
@inject LanguageService LangService
@inject ToastService Toast
@inject NavigationManager Navigator
@implements IDisposable

<PageTitle>Centro de ayuda | Lumina Beauty</PageTitle>

<div class="max-w-6xl mx-auto px-1 sm:px-4 py-6 text-left space-y-8">

    <nav class="mb-6 flex items-center gap-2 text-xs font-semibold text-stone-400 select-none">
        <span class="cursor-pointer transition hover:text-[#FF76A5]" @onclick='() => NavigateTo("/")'>
            Inicio
        </span>
        <span class="text-stone-300">/</span>
        <span class="font-bold text-stone-600">Centro de ayuda</span>
    </nav>

    <header class="mx-auto max-w-2xl space-y-3 pb-2 text-center select-none">
        <span class="inline-flex rounded-full border border-[#FF76A5]/25 bg-[#FFF0F3] px-3.5 py-1 text-[9px] font-black uppercase tracking-widest text-[#C7346A]">
            Centro de ayuda Lumina
        </span>

        <h1 class="pt-1 font-serif text-3xl font-semibold leading-tight tracking-tight text-stone-900 sm:text-4xl">
            ¿Cómo podemos ayudarte?
        </h1>

        <p class="mx-auto max-w-lg text-[11px] font-medium leading-relaxed text-stone-500 sm:text-xs">
            Resolvemos consultas generales sobre productos, pagos y atención. Para pedidos, reclamos o puntos, usa las opciones de tu perfil.
        </p>
    </header>

    <div class="grid grid-cols-1 items-start gap-8 pt-1 lg:grid-cols-12">

        <aside class="space-y-4 lg:col-span-5">
            <a href="tel:+51958392491"
               class="group flex gap-4 rounded-2xl border border-stone-200 bg-white/70 p-5 text-left shadow-xs transition hover:-translate-y-0.5 hover:border-[#F3C7D5] hover:bg-[#FFF9FA] hover:shadow-sm">
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#FFE3E8] bg-[#FFF0F3] text-[#C7346A]">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .8 2.9a2 2 0 0 1-.5 2.1L8.1 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.4 1.9.7 2.9.8A2 2 0 0 1 22 16.9Z"></path>
                    </svg>
                </span>
                <span class="min-w-0">
                    <span class="block text-[10px] font-black uppercase tracking-wider text-stone-900">Línea de atención telefónica</span>
                    <span class="mt-1 block text-xs font-semibold text-stone-800">+51 958 392 491</span>
                    <span class="mt-1 block text-[11px] text-stone-400">Lun - sáb: 9:00 AM - 8:00 PM</span>
                    <span class="mt-2 inline-flex items-center gap-1 text-[10px] font-black uppercase tracking-wider text-[#C7346A]">
                        Llamar ahora
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
                    </span>
                </span>
            </a>

            <a href="mailto:ayuda@luminabeauty.com"
               class="group flex gap-4 rounded-2xl border border-stone-200 bg-white/70 p-5 text-left shadow-xs transition hover:-translate-y-0.5 hover:border-[#F3C7D5] hover:bg-[#FFF9FA] hover:shadow-sm">
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#FFE3E8] bg-[#FFF0F3] text-[#C7346A]">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
                </span>
                <span class="min-w-0">
                    <span class="block text-[10px] font-black uppercase tracking-wider text-stone-900">Atención por correo</span>
                    <span class="mt-1 block text-xs font-semibold text-stone-800">ayuda@luminabeauty.com</span>
                    <span class="mt-1 block text-[11px] text-stone-400">Respuesta en máximo 24 horas hábiles</span>
                    <span class="mt-2 inline-flex items-center gap-1 text-[10px] font-black uppercase tracking-wider text-[#C7346A]">
                        Escribir correo
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
                    </span>
                </span>
            </a>

            <a href="https://www.google.com/maps/search/?api=1&query=Av.+Circunvalaci%C3%B3n+El+Golf+423,+Surco,+Lima,+Per%C3%BA"
               target="_blank" rel="noopener noreferrer"
               class="group flex gap-4 rounded-2xl border border-stone-200 bg-white/70 p-5 text-left shadow-xs transition hover:-translate-y-0.5 hover:border-[#F3C7D5] hover:bg-[#FFF9FA] hover:shadow-sm">
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[#FFE3E8] bg-[#FFF0F3] text-[#C7346A]">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s7-5.2 7-12A7 7 0 1 0 5 9c0 6.8 7 12 7 12Z"></path><circle cx="12" cy="9" r="2.5"></circle></svg>
                </span>
                <span class="min-w-0">
                    <span class="block text-[10px] font-black uppercase tracking-wider text-stone-900">Boutique concepto</span>
                    <span class="mt-1 block text-xs font-semibold text-stone-800">Av. Circunvalación El Golf 423, Surco</span>
                    <span class="mt-1 block text-[11px] text-stone-400">Lima, Perú</span>
                    <span class="mt-2 inline-flex items-center gap-1 text-[10px] font-black uppercase tracking-wider text-[#C7346A]">
                        Cómo llegar
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
                    </span>
                </span>
            </a>
        </aside>

        <section class="rounded-3xl border border-stone-200 bg-white/80 p-6 shadow-md sm:p-8 lg:col-span-7">
            <div class="mb-6 border-b border-stone-100 pb-4">
                <p class="text-[10px] font-black uppercase tracking-[0.18em] text-[#C7346A]">Formulario de contacto</p>
                <h2 class="mt-2 font-serif text-2xl font-semibold text-stone-900">Envíanos un mensaje</h2>
                <p class="mt-1 text-[11px] leading-relaxed text-stone-500">
                    La consulta se simula como un caso derivado a CRM Lumina y se asigna al área responsable.
                </p>
            </div>

            <div class="mb-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
                <button type="button" @onclick='() => Navigator.NavigateTo("/profile?tab=pedidos")'
                        class="group flex items-center gap-3 rounded-2xl border border-stone-200 bg-[#FFF9FA] p-4 text-left transition hover:border-[#F3C7D5] hover:bg-[#FFF0F3]">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-[#FFE3E8] bg-white text-[#C7346A]">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h18"></path><path d="M5 7l1-3h12l1 3"></path><path d="M5 7v13h14V7"></path><path d="M9 11h6"></path></svg>
                    </span>
                    <span>
                        <span class="block text-[10px] font-black uppercase tracking-wider text-stone-900">¿Consulta sobre un pedido?</span>
                        <span class="mt-1 block text-[11px] text-stone-500">Revisa tus compras y su seguimiento.</span>
                    </span>
                </button>

                <button type="button" @onclick='() => Navigator.NavigateTo("/profile?tab=reclamos")'
                        class="group flex items-center gap-3 rounded-2xl border border-stone-200 bg-[#FFF9FA] p-4 text-left transition hover:border-[#F3C7D5] hover:bg-[#FFF0F3]">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-[#FFE3E8] bg-white text-[#C7346A]">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4"></path><path d="M12 17h.01"></path><circle cx="12" cy="12" r="9"></circle></svg>
                    </span>
                    <span>
                        <span class="block text-[10px] font-black uppercase tracking-wider text-stone-900">¿Deseas registrar un reclamo?</span>
                        <span class="mt-1 block text-[11px] text-stone-500">Registra y consulta el estado de reclamos.</span>
                    </span>
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_generatedCaseCode))
            {
                <div class="mb-5 rounded-2xl border border-emerald-200 bg-emerald-50 p-4">
                    <div class="flex items-start gap-3">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 4 4L19 6"></path></svg>
                        </span>
                        <div>
                            <p class="text-[10px] font-black uppercase tracking-wider text-emerald-700">Caso derivado al CRM Lumina</p>
                            <p class="mt-1 text-xs font-bold text-stone-800">Código: @_generatedCaseCode</p>
                            <p class="mt-1 text-[11px] text-stone-500">
                                Estado inicial: ABIERTO · Área asignada: @_assignedArea
                            </p>
                            <p class="mt-1 text-[11px] text-stone-500">
                                Pronto nos comunicaremos contigo por @_responseChannelLabel.
                                Mantente atento(a) a @_responseDestination.
                            </p>
                        </div>
                    </div>
                </div>
            }

            <form @onsubmit="SubmitInquiryAsync" @onsubmit:preventDefault class="space-y-4 text-left">
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase tracking-wider text-stone-500">Nombres</label>
                        <input type="text" required autocomplete="given-name" @bind="_firstNames"
                               class="w-full rounded-xl border border-stone-200 bg-[#FAF6F7]/60 px-3.5 py-2.5 text-xs font-bold text-stone-800 outline-none transition hover:bg-white focus:border-[#FF76A5] focus:bg-white focus:ring-2 focus:ring-[#FCD1DB]/60" />
                    </div>
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase tracking-wider text-stone-500">Apellidos</label>
                        <input type="text" required autocomplete="family-name" @bind="_lastNames"
                               class="w-full rounded-xl border border-stone-200 bg-[#FAF6F7]/60 px-3.5 py-2.5 text-xs font-bold text-stone-800 outline-none transition hover:bg-white focus:border-[#FF76A5] focus:bg-white focus:ring-2 focus:ring-[#FCD1DB]/60" />
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase tracking-wider text-stone-500">Correo electrónico</label>
                        <input type="email" required autocomplete="email" placeholder="correo@ejemplo.com" @bind="_email"
                               class="w-full rounded-xl border border-stone-200 bg-[#FAF6F7]/60 px-3.5 py-2.5 text-xs font-bold text-stone-800 outline-none transition placeholder:text-stone-400 hover:bg-white focus:border-[#FF76A5] focus:bg-white focus:ring-2 focus:ring-[#FCD1DB]/60" />
                    </div>
                    <div class="space-y-1">
                        <label class="text-[10px] font-black uppercase tracking-wider text-stone-500">Número de contacto</label>
                        <input type="tel" required autocomplete="tel" inputmode="tel" placeholder="+51 999 999 999" @bind="_phone"
                               class="w-full rounded-xl border border-stone-200 bg-[#FAF6F7]/60 px-3.5 py-2.5 text-xs font-bold text-stone-800 outline-none transition placeholder:text-stone-400 hover:bg-white focus:border-[#FF76A5] focus:bg-white focus:ring-2 focus:ring-[#FCD1DB]/60" />
                    </div>
                </div>

                <div class="space-y-1">
                    <label class="text-[10px] font-black uppercase tracking-wider text-stone-500">
                        Medio de respuesta preferido
                    </label>

                    <select @bind="_preferredResponseChannel"
                            class="w-full cursor-pointer rounded-xl border border-stone-200 bg-[#FAF6F7]/60 px-3.5 py-2.5 text-xs font-bold text-stone-800 outline-none transition hover:bg-white focus:border-[#FF76A5] focus:bg-white focus:ring-2 focus:ring-[#FCD1DB]/60">
                        <option value="Correo">Correo electrónico</option>
                        <option value="WhatsApp">WhatsApp</option>
                    </select>

                    <p class="text-[10px] leading-relaxed text-stone-400">
                        Usaremos este medio para responder tu consulta.
                    </p>
                </div>

                <div class="space-y-1">
                    <label class="text-[10px] font-black uppercase tracking-wider text-stone-500">Tipo de consulta</label>
                    <select @bind="_inquiryType"
                            class="w-full cursor-pointer rounded-xl border border-stone-200 bg-[#FAF6F7]/60 px-3.5 py-2.5 text-xs font-bold text-stone-800 outline-none transition hover:bg-white focus:border-[#FF76A5] focus:bg-white focus:ring-2 focus:ring-[#FCD1DB]/60">
                        <option value="Producto">Producto o stock</option>
                        <option value="Pago">Pago o comprobante</option>
                        <option value="Otro">Otra consulta</option>
                    </select>
                </div>

                <div class="space-y-1">
                    <label class="text-[10px] font-black uppercase tracking-wider text-stone-500">Asunto</label>
                    <input type="text" required maxlength="160" placeholder="Resume tu consulta en una frase" @bind="_subject"
                           class="w-full rounded-xl border border-stone-200 bg-[#FAF6F7]/60 px-3.5 py-2.5 text-xs font-bold text-stone-800 outline-none transition placeholder:text-stone-400 hover:bg-white focus:border-[#FF76A5] focus:bg-white focus:ring-2 focus:ring-[#FCD1DB]/60" />
                </div>

                <div class="space-y-1">
                    <label class="text-[10px] font-black uppercase tracking-wider text-stone-500">Detalle del mensaje</label>
                    <textarea rows="5" required maxlength="2000"
                              placeholder="Describe lo ocurrido, qué necesitas y cualquier dato que nos ayude a revisarlo."
                              @bind="_message"
                              class="w-full resize-none rounded-xl border border-stone-200 bg-[#FAF6F7]/60 px-3.5 py-2.5 text-xs font-bold text-stone-800 outline-none transition placeholder:text-stone-400 hover:bg-white focus:border-[#FF76A5] focus:bg-white focus:ring-2 focus:ring-[#FCD1DB]/60"></textarea>
                </div>

                <div class="flex flex-col gap-3 border-t border-stone-100 pt-5 sm:flex-row sm:items-center sm:justify-between">
                    <p class="max-w-sm text-[10px] leading-relaxed text-stone-400">
                        Se generará un caso de atención con estado inicial ABIERTO y te responderemos por el canal elegido.
                    </p>

                    <button type="submit" disabled="@_isSubmitting"
                            class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#FF76A5] px-7 py-3.5 text-[10px] font-black uppercase tracking-wider text-white shadow-sm transition hover:bg-[#C7346A] hover:shadow-[0_8px_16px_rgba(199,52,106,0.18)] disabled:cursor-not-allowed disabled:opacity-70 sm:w-auto">
                        @if (_isSubmitting)
                        {
                            <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-2.64-6.36"></path></svg>
                            <span>Conectando con CRM...</span>
                        }
                        else
                        {
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path></svg>
                            <span>Enviar mensaje</span>
                        }
                    </button>
                </div>
            </form>
        </section>
    </div>
</div>

@code {
    private string _firstNames = string.Empty;
    private string _lastNames = string.Empty;
    private string _email = string.Empty;
    private string _phone = string.Empty;
    private string _preferredResponseChannel = "Correo";
    private string _responseChannelLabel = string.Empty;
    private string _responseDestination = string.Empty;
    private string _inquiryType = "Producto";
    private string _subject = string.Empty;
    private string _message = string.Empty;

    private bool _isSubmitting;
    private string _generatedCaseCode = string.Empty;
    private string _assignedArea = string.Empty;

    protected override void OnInitialized()
    {
        LangService.OnChange += StateHasChanged;
    }

    private void NavigateTo(string path) => Navigator.NavigateTo(path);

    private async Task SubmitInquiryAsync()
    {
        _isSubmitting = true;
        _generatedCaseCode = string.Empty;

        // Simulación de solicitud a CRM.
        // Sustituye esta espera por ContactoAppService.RegistrarCasoAsync(...) cuando exista integración real.
        await Task.Delay(1100);

        _generatedCaseCode = $"CAS-{DateTime.Now:yyMMddHHmmss}";
        _assignedArea = GetAssignedArea(_inquiryType);

        _responseChannelLabel = _preferredResponseChannel == "WhatsApp"
            ? "WhatsApp"
            : "correo electrónico";

        _responseDestination = _preferredResponseChannel == "WhatsApp"
            ? _phone
            : _email;

        _firstNames = string.Empty;
        _lastNames = string.Empty;
        _email = string.Empty;
        _phone = string.Empty;
        _preferredResponseChannel = "Correo";
        _inquiryType = "Producto";
        _subject = string.Empty;
        _message = string.Empty;
        _isSubmitting = false;

        Toast.ShowToast(
            $"Caso {_generatedCaseCode} registrado y derivado al CRM Lumina. " +
            $"Pronto nos comunicaremos contigo por {_responseChannelLabel}."
        );
    }

    private static string GetAssignedArea(string inquiryType)
    {
        return inquiryType switch
        {
            "Producto" => "CATÁLOGO",
            "Pago" => "FINANZAS",
            _ => "ATENCIÓN AL CLIENTE"
        };
    }

    public void Dispose()
    {
        LangService.OnChange -= StateHasChanged;
    }
}
