@page "/contact"
@inject LanguageService LangService
@inject ToastService Toast
@inject NavigationManager Navigator
@implements IDisposable

<PageTitle>Soporte al Cliente | Lumina Beauty</PageTitle>

<div class="max-w-6xl mx-auto px-1 sm:px-4 py-6 text-left space-y-8">
    
    <!-- Breadcrumb -->
    <nav class="text-xs font-semibold text-stone-400 mb-8 flex items-center gap-2 select-none">
        <span class="hover:text-[#FF76A5] cursor-pointer transition" @onclick='() => NavigateTo("/")'>
          Inicio
        </span>
        <span class="text-stone-300">/</span>
        <span class="text-stone-600 font-bold">Contacto</span>
    </nav>

    <!-- Luxury Title Header -->
    <div class="text-center max-w-xl mx-auto space-y-2 select-none pb-4">
        <span class="text-[9px] font-black uppercase tracking-widest text-[#C7346A] bg-[#FFF0F3] px-3.5 py-1 rounded-full border border-[#FF76A5]/25">
          CENTRO DE AYUDA LUMINA
        </span>
        <h1 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-stone-900 pt-2 leading-none">
          ¿Cómo podemos ayudarte?
        </h1>
        <p class="text-[11px] sm:text-xs text-stone-500 font-bold leading-relaxed pt-1.5">
          Nuestro equipo disponible para ti las 24 horas del día.
        </p>
    </div>

    <!-- Contact details column & message box split -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start pt-2">
      
      <!-- Left info boxes (5 cols) -->
      <div class="lg:col-span-5 space-y-4 select-none">
        
        <!-- Box 1 -->
        <div class="bg-white/70 backdrop-blur-md rounded-2xl border border-stone-150 p-5 shadow-xs flex gap-4 text-left">
          <div class="bg-[#FFF0F3] p-3 text-lg text-[#FF76A5] rounded-xl self-start border border-[#FFE3E8]">
            <span>📞</span>
          </div>
          <div class="space-y-0.5 text-stone-700">
                    <h4 class="text-xs uppercase font-bold text-stone-900">Línea de Atención Telefónica</h4>
            <p class="text-xs font-semibold text-stone-800">+51 958 392 491</p>
            <p class="text-[12px] text-stone-400">Lun - Sáb: 9:00 AM - 8:00 PM</p>
          </div>
        </div>

        <!-- Box 2 -->
        <div class="bg-white/70 backdrop-blur-md rounded-2xl border border-stone-150 p-5 shadow-xs flex gap-4 text-left">
          <div class="bg-[#FFF0F3] p-3 text-lg text-[#FF76A5] rounded-xl self-start border border-[#FFE3E8]">
            <span>📧</span>
          </div>
          <div class="space-y-0.5 text-stone-700">
                    <h4 class="text-xs uppercase font-bold text-stone-900">Atención de Consultas por Correo</h4>
                    <p class="text-xs font-semibold text-stone-800">ayuda@luminabeauty.com</p>
            <p class="text-[12px] text-stone-400">Respuesta garantizada en menos de 2 horas</p>
          </div>
        </div>

        <!-- Box 3 -->
        <div class="bg-white/70 backdrop-blur-md rounded-2xl border border-stone-150 p-5 shadow-xs flex gap-4 text-left">
          <div class="bg-[#FFF0F3] p-3 text-lg text-[#FF76A5] rounded-xl self-start border border-[#FFE3E8]">
            <span>📍</span>
          </div>
          <div class="space-y-0.5 text-stone-700">
                    <h4 class="text-xs uppercase font-bold text-stone-900">Nuestra Boutique Concepto</h4>
            <p class="text-xs font-semibold text-stone-800">Av. Circunvalación El Golf 423, Surco</p>
            <p class="text-[12px] text-stone-400">Lima, Perú</p>
          </div>
        </div>

      </div>

      <!-- Right message submission form (7 cols) -->
      <div class="lg:col-span-7 bg-white/75 backdrop-blur-md border border-stone-100 rounded-3xl p-6 sm:p-8 shadow-md">
        <h3 class="font-serif text-xl font-bold text-stone-900 border-b border-stone-100 pb-3 mb-5 uppercase text-xs tracking-widest text-[#C7346A] select-none text-left">
          Envíanos un Mensaje
        </h3>

        <form @onsubmit="SubmitInquiry" @onsubmit:preventDefault class="space-y-4 text-left">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label class="text-[10px] font-black uppercase text-stone-400 tracking-wider select-none">Nombre completo</label>
              <input type="text" required placeholder="" @bind="_name"
                     class="w-full bg-[#faf6f7]/60 hover:bg-white focus:bg-white border border-stone-200 focus:border-[#FF76A5] text-xs font-bold rounded-xl px-3.5 py-2.5 transition" />
            </div>
            <div class="space-y-1">
              <label class="text-[10px] font-black uppercase text-stone-400 tracking-wider select-none">Correo electrónico</label>
              <input type="email" required placeholder="ayuda@mail.com..." @bind="_email"
                     class="w-full bg-[#faf6f7]/60 hover:bg-white focus:bg-white border border-stone-200 focus:border-[#FF76A5] text-xs font-bold rounded-xl px-3.5 py-2.5 transition" />
            </div>
          </div>

          <div class="space-y-1">
            <label class="text-[10px] font-black uppercase text-stone-400 tracking-wider select-none">Asunto de consulta</label>
            <input type="text" required placeholder="Tracking de pedido, asesoría de piel, marcas asociadas..." @bind="_subject"
                   class="w-full bg-[#faf6f7]/60 hover:bg-white focus:bg-white border border-stone-200 focus:border-[#FF76A5] text-xs font-bold rounded-xl px-3.5 py-2.5 transition" />
          </div>

          <div class="space-y-1">
            <label class="text-[10px] font-black uppercase text-stone-400 tracking-wider select-none">Detalle del mensaje</label>
            <textarea rows="4" required placeholder="Describe paso a paso tus dudas o comentarios sobre el catálogo..." @bind="_message"
                      class="w-full bg-[#faf6f7]/60 hover:bg-white focus:bg-white border border-stone-200 focus:border-[#FF76A5] text-xs font-bold rounded-xl px-3.5 py-2.5 transition resize-none" />
          </div>

          <button type="submit"
                  class="w-fit bg-[#FF76A5] hover:bg-[#C7346A] tracking-wider font-bold text-[10px] uppercase text-white px-8 py-3.5 rounded-xl transition shadow-xs cursor-pointer select-none">
            Enviar Mensaje
          </button>
        </form>
      </div>

    </div>

</div>

@code {
    private string _name = string.Empty;
    private string _email = string.Empty;
    private string _subject = string.Empty;
    private string _message = string.Empty;

    private int _openedFaqIndex = -1;

    private class FaqItem
    {
        public string Question { get; set; } = string.Empty;
        public string Answer { get; set; } = string.Empty;
    }

    protected override void OnInitialized()
    {
        LangService.OnChange += StateHasChanged;
    }

    private void NavigateTo(string path) => Navigator.NavigateTo(path);

    private void ToggleFaq(int idx)
    {
        _openedFaqIndex = _openedFaqIndex == idx ? -1 : idx;
    }

    private void SubmitInquiry()
    {
        _name = string.Empty;
        _email = string.Empty;
        _subject = string.Empty;
        _message = string.Empty;

        Toast.ShowToast("🎉 ¡Mensaje enviado! Una consejera de Lumina te responderá en breves minutos.");
    }

    public void Dispose()
    {
        LangService.OnChange -= StateHasChanged;
    }
}
