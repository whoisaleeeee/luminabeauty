@page "/terms"
@inject NavigationManager Navigator

<PageTitle>Términos de uso | Lumina Beauty</PageTitle>

<div class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12">

    <nav class="mb-6 flex items-center gap-2 text-xs font-semibold text-stone-400 select-none">
        <span class="cursor-pointer transition hover:text-[#C7346A]"
              @onclick='() => Navigator.NavigateTo("/")'>
            Inicio
        </span>
        <span class="text-stone-300">/</span>
        <span class="font-bold text-stone-600">Términos de uso</span>
    </nav>

    <section class="overflow-hidden rounded-[2rem] border border-stone-200/80 bg-white shadow-sm">

        <header class="border-b border-[#F6DDE5] bg-[#FFF7F9] px-6 py-8 sm:px-10 sm:py-10">
            <span class="inline-flex items-center gap-2 rounded-full border border-[#F5C8D6] bg-white px-3 py-1.5 text-[9px] font-black uppercase tracking-[0.16em] text-[#C7346A]">
                <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 3h9l3 3v15H6z"></path>
                    <path d="M9 10h6M9 14h6"></path>
                </svg>
                Transparencia en tu compra
            </span>

            <div class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <h1 class="font-serif text-2xl font-semibold tracking-tight text-stone-900 sm:text-3xl">
                        Términos de uso
                    </h1>

                    <p class="mt-2 max-w-2xl text-xs leading-relaxed text-stone-500">
                        Condiciones generales aplicables al uso de Lumina Beauty y a la compra de productos mediante la plataforma.
                    </p>
                </div>

                <span class="w-fit rounded-full border border-stone-200 bg-white px-3 py-1.5 text-[9px] font-bold text-stone-500">
                    Última actualización: junio de 2026
                </span>
            </div>
        </header>

        <div class="grid grid-cols-1 gap-8 px-6 py-8 sm:px-10 sm:py-10 lg:grid-cols-[220px_minmax(0,1fr)]">

            <aside class="lg:sticky lg:top-6 lg:self-start">
                <p class="text-[10px] font-black uppercase tracking-[0.18em] text-stone-400">
                    En esta sección
                </p>

                <nav class="mt-3 space-y-1.5">
                    <a href="/terms#uso"
                       class="block rounded-xl px-3 py-2.5 text-[11px] font-bold tracking-[0.01em] text-stone-600 transition hover:bg-[#FFF0F3] hover:text-[#C7346A]">
                        Uso de la plataforma
                    </a>
                    <a href="/terms#cuenta"
                       class="block rounded-xl px-3 py-2.5 text-[11px] font-bold tracking-[0.01em] text-stone-600 transition hover:bg-[#FFF0F3] hover:text-[#C7346A]">
                        Cuenta de usuario
                    </a>
                    <a href="/terms#productos"
                       class="block rounded-xl px-3 py-2.5 text-[11px] font-bold tracking-[0.01em] text-stone-600 transition hover:bg-[#FFF0F3] hover:text-[#C7346A]">
                        Productos y precios
                    </a>
                    <a href="/terms#pedidos"
                       class="block rounded-xl px-3 py-2.5 text-[11px] font-bold tracking-[0.01em] text-stone-600 transition hover:bg-[#FFF0F3] hover:text-[#C7346A]">
                        Pedidos y validación
                    </a>
                    <a href="/terms#entregas"
                       class="block rounded-xl px-3 py-2.5 text-[11px] font-bold tracking-[0.01em] text-stone-600 transition hover:bg-[#FFF0F3] hover:text-[#C7346A]">
                        Entregas y seguimiento
                    </a>
                    <a href="/terms#beneficios"
                       class="block rounded-xl px-3 py-2.5 text-[11px] font-bold tracking-[0.01em] text-stone-600 transition hover:bg-[#FFF0F3] hover:text-[#C7346A]">
                        Cupones y beneficios
                    </a>
                </nav>

                <div class="mt-5 rounded-2xl border border-[#FCD1DB] bg-[#FFF7F9] p-4">
                    <p class="text-[10px] font-black uppercase tracking-[0.15em] text-[#C7346A]">
                        ¿Necesitas ayuda?
                    </p>

                    <p class="mt-1 text-[11px] leading-relaxed text-stone-500">
                        Para consultas de compras, pedidos o atención, revisa el centro de ayuda.
                    </p>

                    <button type="button"
                            @onclick='() => Navigator.NavigateTo("/contact")'
                            class="mt-3 inline-flex items-center gap-1 text-[10px] font-black uppercase tracking-wider text-[#C7346A] transition hover:text-[#9E2B55]">
                        Ir a contacto
                        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12h14"></path>
                            <path d="m13 6 6 6-6 6"></path>
                        </svg>
                    </button>
                </div>
            </aside>

            <main class="max-w-3xl space-y-5 text-[13px] leading-7 text-stone-600 sm:text-[14px] sm:leading-8">

                <section id="uso" class="scroll-mt-8 rounded-2xl border border-stone-100 bg-white p-5 sm:p-6">
                    <div class="flex gap-3">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#FFF0F3] text-[#C7346A]">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M6 3h9l3 3v15H6z"></path>
                                <path d="M9 10h6M9 14h6"></path>
                            </svg>
                        </span>
                        <div>
                            <p class="text-[10px] font-black uppercase tracking-[0.20em] text-[#C7346A]">01</p>
                            <h2 class="mt-1 font-serif text-[1.02rem] font-semibold tracking-tight text-stone-900">
                                Uso de la plataforma
                            </h2>
                        </div>
                    </div>

                    <p class="mt-4">
                        Al utilizar Lumina Beauty, el cliente acepta estos términos y se compromete a brindar información veraz, completa y actualizada durante el registro, la compra y la gestión de sus pedidos.
                    </p>

                    <p class="mt-3">
                        La plataforma está destinada a la consulta de productos, creación de cuentas, gestión de favoritos, realización de pedidos y revisión de información asociada a compras.
                    </p>
                </section>

                <section id="cuenta" class="scroll-mt-8 rounded-2xl border border-stone-100 bg-white p-5 sm:p-6">
                    <div class="flex gap-3">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#FFF0F3] text-[#C7346A]">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="8" r="3.5"></circle>
                                <path d="M4.5 20a7.5 7.5 0 0 1 15 0"></path>
                            </svg>
                        </span>
                        <div>
                            <p class="text-[10px] font-black uppercase tracking-[0.20em] text-[#C7346A]">02</p>
                            <h2 class="mt-1 font-serif text-[1.02rem] font-semibold tracking-tight text-stone-900">
                                Cuenta de usuario
                            </h2>
                        </div>
                    </div>

                    <p class="mt-4">
                        El usuario es responsable de mantener la confidencialidad de sus credenciales de acceso y de evitar compartir su contraseña con terceros. Las acciones realizadas desde una cuenta activa se considerarán vinculadas al titular, salvo aviso oportuno de un posible uso no autorizado.
                    </p>

                    <p class="mt-3">
                        Lumina Beauty podrá restringir o suspender el acceso a una cuenta cuando se detecten datos falsos, uso indebido de la plataforma, intentos de fraude o incumplimiento de estos términos.
                    </p>
                </section>

                <section id="productos" class="scroll-mt-8 rounded-2xl border border-stone-100 bg-white p-5 sm:p-6">
                    <div class="flex gap-3">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#FFF0F3] text-[#C7346A]">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M6 7h12l1 13H5L6 7Z"></path>
                                <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
                            </svg>
                        </span>
                        <div>
                            <p class="text-[10px] font-black uppercase tracking-[0.20em] text-[#C7346A]">03</p>
                            <h2 class="mt-1 font-serif text-[1.02rem] font-semibold tracking-tight text-stone-900">
                                Productos, precios y disponibilidad
                            </h2>
                        </div>
                    </div>

                    <p class="mt-4">
                        Los productos mostrados en la tienda están sujetos a disponibilidad de stock. Los precios, promociones, descuentos y condiciones aplicables pueden actualizarse antes de que el pedido sea confirmado.
                    </p>

                    <p class="mt-3">
                        Lumina Beauty procura mantener la información del catálogo actualizada, pero pueden presentarse variaciones en imágenes, empaques, descripciones o disponibilidad según las actualizaciones recibidas de marcas y proveedores.
                    </p>
                </section>

                <section id="pedidos" class="scroll-mt-8 rounded-2xl border border-stone-100 bg-white p-5 sm:p-6">
                    <div class="flex gap-3">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#FFF0F3] text-[#C7346A]">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M3 7h18"></path>
                                <path d="M5 7l1-3h12l1 3"></path>
                                <path d="M5 7v13h14V7"></path>
                                <path d="M9 11h6"></path>
                            </svg>
                        </span>
                        <div>
                            <p class="text-[10px] font-black uppercase tracking-[0.20em] text-[#C7346A]">04</p>
                            <h2 class="mt-1 font-serif text-[1.02rem] font-semibold tracking-tight text-stone-900">
                                Pedidos y validación
                            </h2>
                        </div>
                    </div>

                    <p class="mt-4">
                        Un pedido se considera registrado cuando el cliente completa el proceso de compra y recibe la confirmación correspondiente dentro de la plataforma. La aceptación final del pedido está sujeta a validación de stock, datos de contacto y condiciones operativas.
                    </p>

                    <p class="mt-3">
                        En caso de inconsistencias de información, falta de stock, errores de precio evidentes o imposibilidad de procesar el pedido, Lumina Beauty podrá comunicarse con el cliente para informar las alternativas disponibles.
                    </p>
                </section>

                <section id="entregas" class="scroll-mt-8 rounded-2xl border border-stone-100 bg-white p-5 sm:p-6">
                    <div class="flex gap-3">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#FFF0F3] text-[#C7346A]">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M3 7h11v9H3z"></path>
                                <path d="M14 10h3l3 3v3h-6z"></path>
                                <circle cx="7" cy="18" r="1.5"></circle>
                                <circle cx="17" cy="18" r="1.5"></circle>
                            </svg>
                        </span>
                        <div>
                            <p class="text-[10px] font-black uppercase tracking-[0.20em] text-[#C7346A]">05</p>
                            <h2 class="mt-1 font-serif text-[1.02rem] font-semibold tracking-tight text-stone-900">
                                Entregas y seguimiento
                            </h2>
                        </div>
                    </div>

                    <p class="mt-4">
                        La información de envío visible en Mi cuenta depende del estado registrado para cada pedido. Las fechas estimadas de entrega son referenciales y pueden variar por ubicación, disponibilidad, condiciones logísticas o incidencias externas.
                    </p>

                    <p class="mt-3">
                        El cliente debe registrar una dirección de entrega correcta y disponible. Lumina Beauty no se responsabiliza por retrasos derivados de datos incompletos, referencias insuficientes o ausencia del destinatario en la dirección registrada.
                    </p>
                </section>

                <section id="beneficios" class="scroll-mt-8 rounded-2xl border border-stone-100 bg-white p-5 sm:p-6">
                    <div class="flex gap-3">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#FFF0F3] text-[#C7346A]">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="m12 2 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5-5.8-3.1-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9L12 2Z"></path>
                            </svg>
                        </span>
                        <div>
                            <p class="text-[10px] font-black uppercase tracking-[0.20em] text-[#C7346A]">06</p>
                            <h2 class="mt-1 font-serif text-[1.02rem] font-semibold tracking-tight text-stone-900">
                                Cupones y beneficios
                            </h2>
                        </div>
                    </div>

                    <p class="mt-4">
                        Los cupones, descuentos y beneficios de fidelidad están sujetos a vigencia, disponibilidad, monto mínimo, productos participantes y demás condiciones indicadas durante el proceso de compra.
                    </p>

                    <p class="mt-3">
                        Lumina Beauty podrá invalidar beneficios aplicados de forma incorrecta, duplicada o contraria a las condiciones de una campaña.
                    </p>
                </section>

                <section class="rounded-2xl border border-[#FCD1DB] bg-[#FFF7F9] p-5 sm:p-6">
                    <div class="flex gap-3">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-[#C7346A]">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                <path d="m3 7 9 6 9-6"></path>
                            </svg>
                        </span>
                        <div>
                            <p class="text-[10px] font-black uppercase tracking-[0.20em] text-[#C7346A]">Atención y consultas</p>
                            <h2 class="mt-1 font-serif text-[1.02rem] font-semibold tracking-tight text-stone-900">
                                Estamos para ayudarte
                            </h2>
                        </div>
                    </div>

                    <p class="mt-4">
                        Para consultas relacionadas con productos, pedidos, entregas o tu cuenta, puedes comunicarte con nuestro equipo por correo:
                    </p>

                    <a href="mailto:ayuda@luminabeauty.com"
                       class="mt-3 inline-flex items-center gap-2 rounded-xl border border-[#F5C8D6] bg-white px-4 py-2.5 text-[11px] font-bold text-stone-700 transition hover:border-[#E7A9BE] hover:text-[#C7346A]">
                        ayuda@luminabeauty.com
                        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12h14"></path>
                            <path d="m13 6 6 6-6 6"></path>
                        </svg>
                    </a>
                </section>

                <section class="rounded-2xl border border-stone-200 bg-stone-50/70 p-5 sm:p-6">
                    <p class="text-[9px] font-black uppercase tracking-[0.16em] text-stone-500">
                        Modificaciones de los términos
                    </p>
                    <p class="mt-2 text-[12px] leading-relaxed text-stone-500">
                        Lumina Beauty puede actualizar estos términos cuando sea necesario para reflejar cambios en la plataforma, procesos de compra, servicios o disposiciones aplicables. La versión vigente permanecerá disponible en esta página.
                    </p>
                </section>
            </main>
        </div>
    </section>
</div>
