@page "/cart"
@inject LanguageService LangService
@inject CartService Cart
@inject ToastService Toast
@inject NavigationManager Navigator
@implements IDisposable

<PageTitle>Carrito | Lumina Beauty</PageTitle>

<div class="mx-auto w-full max-w-7xl px-4 py-7 text-left sm:px-6 lg:px-8">
    <nav class="mb-7 flex items-center gap-2 text-xs font-semibold text-stone-400 select-none">
        <button type="button"
                @onclick='() => NavigateTo("/")'
                class="cursor-pointer bg-transparent p-0 transition hover:text-[#C7346A]">
            @(LangService.CurrentLanguage == "es" ? "Inicio" : "Home")
        </button>

        <span class="text-stone-300">/</span>

        <span class="font-bold text-stone-600">
            @(LangService.CurrentLanguage == "es" ? "Carrito" : "Shopping cart")
        </span>
    </nav>

    <header class="mb-7 border-b border-[#F3E7EB] pb-6">
        <span class="text-[10px] font-black uppercase tracking-[0.18em] text-[#C7346A]">
            Tu selección
        </span>

        <div class="mt-2 flex flex-wrap items-end justify-between gap-3">
            <div>
                <h1 class="font-serif text-3xl font-semibold tracking-tight text-stone-900">
                    Tu carrito de belleza
                </h1>

                <p class="mt-2 text-sm text-stone-500">
                    Revisa tus productos antes de continuar al pago.
                </p>
            </div>

            <span class="rounded-full border border-[#F8D7E1] bg-[#FFF7F9] px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.12em] text-[#C7346A]">
                @Cart.GetCount() @(Cart.GetCount() == 1 ? "producto" : "productos")
            </span>
        </div>
    </header>

    @if (Cart.GetItems().Count == 0)
    {
        <div class="mx-auto max-w-lg rounded-3xl border border-[#FCD1DB]/60 bg-white/80 p-12 text-center shadow-[0_16px_40px_rgba(120,72,92,0.07)] backdrop-blur-md">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#FFF0F3] text-[#C7346A]">
                <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13 5.4 5M7 13l-1.3 2.5A1 1 0 0 0 7 17h10M9 21a1 1 0 1 0 0-2 1 1 0 0 0 0 2Zm9 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" />
                </svg>
            </div>

            <h2 class="mt-5 font-serif text-2xl font-semibold text-stone-900">
                @(LangService.CurrentLanguage == "es" ? "Tu carrito está vacío" : "Your cart is empty")
            </h2>

            <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-stone-500">
                @(LangService.CurrentLanguage == "es"
                    ? "Explora productos seleccionados para acompañar tu rutina de cuidado personal."
                    : "Explore carefully selected products for your personal-care routine.")
            </p>

            <button type="button"
                    @onclick='() => NavigateTo("/shop")'
                    class="mt-7 cursor-pointer rounded-xl bg-stone-900 px-7 py-3.5 text-[10px] font-black uppercase tracking-[0.14em] text-white transition hover:bg-[#C7346A]">
                @(LangService.CurrentLanguage == "es" ? "Explorar tienda" : "Explore shop")
            </button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 items-start gap-7 lg:grid-cols-[minmax(0,1fr)_380px]">
            <section class="space-y-4">
                <div class="hidden grid-cols-[minmax(0,1fr)_92px_140px_108px] items-center gap-5 rounded-2xl border border-[#F3E7EB] bg-white/55 px-6 py-4 text-[10px] font-black uppercase tracking-[0.12em] text-stone-400 sm:grid">
                    <span>Producto</span>
                    <span class="text-center">Precio</span>
                    <span class="text-center">Cantidad</span>
                    <span class="text-right">Subtotal</span>
                </div>

                <div class="space-y-3">
                    @foreach (var item in Cart.GetItems())
                    {
                        <article class="group grid grid-cols-1 gap-4 rounded-3xl border border-stone-200/80 bg-white/85 p-4 shadow-[0_7px_20px_rgba(120,72,92,0.035)] transition hover:border-[#EAB3C5] sm:grid-cols-[minmax(0,1fr)_92px_140px_108px] sm:items-center sm:gap-5 sm:p-5">
                            <div class="flex min-w-0 items-center gap-4">
                                <div class="relative shrink-0">
                                    <img src="@item.Product.Image"
                                         alt="@item.Product.Name"
                                         class="h-[82px] w-[82px] rounded-2xl border border-stone-200/80 bg-stone-50 object-contain p-1.5"
                                         referrerpolicy="no-referrer" />

                                    <button type="button"
                                            @onclick="() => RemoveItem(item.Product.Id)"
                                            title="@(LangService.CurrentLanguage == "es" ? "Quitar producto" : "Remove product")"
                                            aria-label="@(LangService.CurrentLanguage == "es" ? "Quitar producto" : "Remove product")"
                                            class="absolute -left-2 -top-2 flex h-7 w-7 cursor-pointer items-center justify-center rounded-full border border-stone-200 bg-white text-stone-400 shadow-sm transition hover:border-[#F4B5C7] hover:bg-[#FFF0F3] hover:text-[#C7346A]">
                                        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
                                            <path d="M3 6h18" />
                                            <path d="M8 6V4h8v2" />
                                            <path d="m19 6-1 14H6L5 6" />
                                            <path d="M10 11v5M14 11v5" />
                                        </svg>
                                    </button>
                                </div>

                                <div class="min-w-0">
                                    <span class="text-[10px] font-black uppercase tracking-[0.14em] text-[#C7346A]">
                                        @item.Product.Brand
                                    </span>

                                    <h2 class="mt-1 line-clamp-2 text-sm font-semibold leading-snug text-stone-900">
                                        @item.Product.Name
                                    </h2>

                                    <p class="mt-1 text-[11px] font-medium text-stone-400">
                                        @item.Product.Category
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-center justify-between gap-3 sm:block sm:text-center">
                                <span class="text-[10px] font-black uppercase tracking-[0.12em] text-stone-400 sm:hidden">
                                    Precio
                                </span>

                                <span class="font-mono text-sm font-semibold text-stone-800">
                                    S/ @item.Product.Price.ToString("0.00")
                                </span>
                            </div>

                            <div class="flex items-center justify-between gap-3 sm:justify-center">
                                <span class="text-[10px] font-black uppercase tracking-[0.12em] text-stone-400 sm:hidden">
                                    Cantidad
                                </span>

                                <div class="flex items-center rounded-xl border border-stone-200 bg-[#FFFDFD] p-1">
                                    <button type="button"
                                            @onclick="() => UpdateQty(item.Product.Id, item.Quantity - 1)"
                                            disabled="@(item.Quantity <= 1)"
                                            class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-sm text-stone-500 transition hover:bg-[#FFF0F3] hover:text-[#C7346A] disabled:cursor-not-allowed disabled:opacity-30">
                                        −
                                    </button>

                                    <span class="min-w-9 text-center font-mono text-sm font-semibold text-stone-800">
                                        @item.Quantity
                                    </span>

                                    <button type="button"
                                            @onclick="() => UpdateQty(item.Product.Id, item.Quantity + 1)"
                                            class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg text-sm text-stone-500 transition hover:bg-[#FFF0F3] hover:text-[#C7346A]">
                                        +
                                    </button>
                                </div>
                            </div>

                            <div class="flex items-center justify-between gap-3 border-t border-stone-100 pt-3 sm:block sm:border-0 sm:pt-0 sm:text-right">
                                <span class="text-[10px] font-black uppercase tracking-[0.12em] text-stone-400 sm:hidden">
                                    Subtotal
                                </span>

                                <span class="font-mono text-sm font-semibold text-[#C7346A]">
                                    S/ @((item.Product.Price * item.Quantity).ToString("0.00"))
                                </span>
                            </div>
                        </article>
                    }
                </div>

                <div class="pt-3">
                    <button type="button"
                            @onclick='() => NavigateTo("/shop")'
                            class="inline-flex cursor-pointer items-center gap-2 rounded-xl border border-stone-200 bg-white px-5 py-3 text-[10px] font-black uppercase tracking-[0.13em] text-stone-600 transition hover:border-[#EAB3C5] hover:bg-[#FFF7F9] hover:text-[#C7346A]">
                        <svg class="h-4 w-4"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2">
                            <path d="M19 12H5"></path>
                            <path d="m11 18-6-6 6-6"></path>
                        </svg>

                        Seguir comprando
                    </button>
                </div>
            </section>

            <aside class="h-fit self-start lg:sticky lg:top-24">
                <div class="h-fit overflow-hidden rounded-3xl border border-[#F1DCE3] bg-white/90 shadow-[0_14px_35px_rgba(120,72,92,0.10)]">
                    <div class="h-1 bg-[#FF76A5]"></div>

                    <div class="p-5 sm:p-6">
                        <div class="flex items-end justify-between border-b border-stone-100 pb-4">
                            <div>
                                <span class="text-[10px] font-black uppercase tracking-[0.16em] text-[#C7346A]">
                                    Resumen
                                </span>

                                <h2 class="mt-1 font-serif text-2xl font-semibold text-stone-900">
                                    Total de compra
                                </h2>
                            </div>
                        </div>

                        <div class="mt-5 space-y-2.5 text-sm text-stone-600">
                            <div class="flex items-center justify-between">
                                <span>Subtotal</span>
                                <span class="font-mono font-semibold text-stone-900">
                                    S/ @Cart.GetSubtotal().ToString("0.00")
                                </span>
                            </div>

                            <div class="flex items-center justify-between">
                                <span>Envío estimado</span>
                                <span class="font-mono font-semibold text-stone-900">
                                    @(GetShippingCost() == 0 ? (LangService.CurrentLanguage == "es" ? "Gratis" : "Free") : $"S/ {GetShippingCost():0.00}")
                                </span>
                            </div>

                            @if (_discountPercent > 0)
                            {
                                <div class="flex items-center justify-between text-[#C7346A]">
                                    <span>Descuento (@_discountPercent%)</span>
                                    <span class="font-mono font-semibold">
                                        -S/ @GetDiscountAmount().ToString("0.00")
                                    </span>
                                </div>
                            }

                            @if (!IsEligibleForFreeShipping() && Cart.GetSubtotal() > 0)
                            {
                                <p class="rounded-xl border border-[#F6D7E0] bg-[#FFF8FA] px-3.5 py-3 text-[11px] leading-relaxed text-stone-500">
                                    Agrega <strong class="font-mono font-semibold text-[#C7346A]">S/ @GetMissingForFreeShipping().ToString("0.00")</strong>
                                    para acceder a envío gratuito.
                                </p>
                            }

                            <div class="flex items-center justify-between border-t border-stone-200 pt-3.5 text-base font-semibold text-stone-900">
                                <span>Total estimado</span>
                                <span class="font-mono text-xl font-semibold text-[#C7346A]">
                                    S/ @GetTotal().ToString("0.00")
                                </span>
                            </div>
                        </div>

                        <div class="mt-4 border-t border-stone-100 pt-4">
                            <label class="mb-2 block text-[10px] font-black uppercase tracking-[0.14em] text-stone-400">
                                Código de cupón
                            </label>

                            @if (!string.IsNullOrEmpty(_couponAppliedCode))
                            {
                                <div class="flex items-center justify-between gap-3 rounded-xl border border-[#F5C7D5] bg-[#FFF8FA] px-3.5 py-3">
                                    <div>
                                        <p class="text-xs font-semibold text-stone-800">
                                            Cupón @_couponAppliedCode aplicado
                                        </p>
                                        <p class="mt-0.5 text-[10px] text-[#C7346A]">
                                            @_discountPercent% de descuento
                                        </p>
                                    </div>

                                    <button type="button"
                                            @onclick="RemoveCoupon"
                                            class="cursor-pointer text-[10px] font-black uppercase tracking-wide text-[#C7346A] transition hover:text-stone-900">
                                        Quitar
                                    </button>
                                </div>
                            }
                            else
                            {
                                <form @onsubmit="ApplyCoupon" @onsubmit:preventDefault class="flex gap-2">
                                    <input type="text"
                                           @bind="_couponInput"
                                           placeholder="Ej. BIENVENIDA10"
                                           class="min-w-0 flex-1 rounded-xl border border-stone-200 bg-[#FFFDFD] px-3.5 py-3 text-xs font-semibold text-stone-700 outline-none transition placeholder:text-stone-400 focus:border-[#FF76A5]" />

                                    <button type="submit"
                                            class="cursor-pointer rounded-xl bg-stone-900 px-4 py-3 text-[10px] font-black uppercase tracking-[0.1em] text-white transition hover:bg-[#C7346A]">
                                        Aplicar
                                    </button>
                                </form>

                                <button type="button"
                                        @onclick="ApplyDefaultCoupon"
                                        class="mt-2 cursor-pointer bg-transparent p-0 text-left text-[10px] font-bold text-[#C7346A] transition hover:text-stone-900">
                                    Aplicar cupón de demostración
                                </button>
                            }

                            @if (!string.IsNullOrEmpty(_couponError))
                            {
                                <p class="mt-2 text-[10px] font-semibold text-red-500">
                                    @_couponError
                                </p>
                            }
                        </div>

                        <button type="button"
                                @onclick='() => NavigateTo("/checkout")'
                                class="mt-5 w-full cursor-pointer rounded-xl bg-[#FF76A5] px-5 py-3.5 text-[10px] font-black uppercase tracking-[0.14em] text-white shadow-[0_8px_18px_rgba(199,52,106,0.16)] transition hover:bg-[#C7346A]">
                            Continuar al pago
                        </button>

                        <p class="mt-2.5 text-center text-[10px] leading-relaxed text-stone-400">
                            Confirmarás dirección y método de pago en el siguiente paso.
                        </p>
                    </div>
                </div>
            </aside>
        </div>
    }
</div>

@code {
    private string _couponInput = string.Empty;
    private int _discountPercent;
    private string _couponAppliedCode = string.Empty;
    private string _couponError = string.Empty;

    protected override void OnInitialized()
    {
        LangService.OnChange += StateHasChanged;
        Cart.OnChange += StateHasChanged;
    }

    private void NavigateTo(string path) => Navigator.NavigateTo(path);

    private async Task RemoveItem(string id)
    {
        await Cart.RemoveItemAsync(id);
        Toast.ShowToast(LangService.CurrentLanguage == "es" ? "Producto retirado" : "Product removed");
    }

    private async Task UpdateQty(string id, int qty)
    {
        await Cart.UpdateQuantityAsync(id, qty);
    }

    private bool IsEligibleForFreeShipping() => Cart.GetSubtotal() >= 199m;
    private decimal GetMissingForFreeShipping() => Math.Max(0m, 199m - Cart.GetSubtotal());
    private decimal GetShippingCost() => Cart.GetSubtotal() > 0 && !IsEligibleForFreeShipping() ? 15m : 0m;
    private decimal GetDiscountAmount() => Cart.GetSubtotal() * (_discountPercent / 100m);
    private decimal GetTotal() => Cart.GetSubtotal() - GetDiscountAmount() + GetShippingCost();

    private void ApplyCoupon()
    {
        var clean = _couponInput.Trim().ToUpperInvariant();

        if (clean == "MAMA50" || clean == "LUMINA50")
        {
            _discountPercent = 50;
            _couponAppliedCode = clean;
            _couponError = string.Empty;
            Toast.ShowToast(LangService.CurrentLanguage == "es" ? "Cupón de 50% aplicado." : "50% coupon applied.");
        }
        else if (clean == "BIENVENIDA10")
        {
            _discountPercent = 10;
            _couponAppliedCode = clean;
            _couponError = string.Empty;
            Toast.ShowToast(LangService.CurrentLanguage == "es" ? "Cupón de 10% aplicado." : "10% coupon applied.");
        }
        else
        {
            _couponError = LangService.CurrentLanguage == "es"
                ? "Código inválido. Prueba BIENVENIDA10 o MAMA50."
                : "Invalid code. Try BIENVENIDA10 or MAMA50.";

            _ = ClearCouponErrorDelay();
        }

        _couponInput = string.Empty;
    }

    private async Task ClearCouponErrorDelay()
    {
        await Task.Delay(3000);
        _couponError = string.Empty;
        StateHasChanged();
    }

    private void ApplyDefaultCoupon()
    {
        _discountPercent = 50;
        _couponAppliedCode = "MAMA50";
        _couponError = string.Empty;
        Toast.ShowToast(LangService.CurrentLanguage == "es" ? "Cupón MAMA50 aplicado." : "MAMA50 coupon applied.");
    }

    private void RemoveCoupon()
    {
        _discountPercent = 0;
        _couponAppliedCode = string.Empty;
        _couponError = string.Empty;
        Toast.ShowToast(LangService.CurrentLanguage == "es" ? "Cupón eliminado." : "Coupon removed.");
    }

    public void Dispose()
    {
        LangService.OnChange -= StateHasChanged;
        Cart.OnChange -= StateHasChanged;
    }
}
