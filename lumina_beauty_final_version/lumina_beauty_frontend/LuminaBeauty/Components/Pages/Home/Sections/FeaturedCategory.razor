@inject NavigationManager Navigator

<section class="relative overflow-hidden rounded-3xl border border-white/70 bg-white/35 shadow-[0_14px_45px_rgba(120,72,92,0.10)] backdrop-blur-xl">
    <div class="grid grid-cols-1 md:grid-cols-12">

        <div class="relative z-10 flex min-h-[245px] flex-col justify-center bg-white/35 p-8 text-left backdrop-blur-md md:col-span-5 md:min-h-[330px] md:p-10">
            <div class="absolute inset-0 bg-gradient-to-br from-white/30 via-white/15 to-transparent"></div>

            <div class="relative">
                <span class="text-[10px] font-semibold uppercase tracking-[0.16em] text-[#C7346A]">
                    Categoría destacada
                </span>

                <h2 class="mt-3 font-serif text-2xl font-semibold leading-tight text-stone-800 md:text-3xl">
                    Descubre lo último en
                    <span class="text-[#C7346A]">@_categoryName</span>
                </h2>

                <p class="mt-4 max-w-sm text-xs leading-relaxed text-stone-600">
                    @_description
                </p>

                <button @onclick="GoToCategory"
                        class="mt-6 w-fit cursor-pointer rounded-xl border border-white/50 bg-[#FF76A5]/90 px-6 py-3 text-[10px] font-semibold uppercase tracking-[0.12em] text-white shadow-sm backdrop-blur-md transition hover:bg-[#C7346A]">
                    Explorar categoría
                </button>
            </div>
        </div>

        <div class="relative h-[245px] overflow-hidden bg-[#F7EFF2] md:col-span-7 md:h-[330px]">
            <img src="@_imageUrl"
                 alt="@_categoryName"
                 class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 hover:scale-105" />

            <div class="absolute inset-0 bg-gradient-to-r from-[#FFF7F9]/25 via-transparent to-white/10"></div>
            <div class="absolute inset-0 bg-white/5 backdrop-blur-[0.5px]"></div>

            <div class="absolute bottom-5 right-5 rounded-2xl border border-white/40 bg-white/20 px-4 py-2 text-[9px] font-semibold uppercase tracking-[0.13em] text-white shadow-sm backdrop-blur-md">
                Skincare
            </div>
        </div>
    </div>
</section>

@code {
    private const string _categoryName = "skincare";

    private const string _description =
        "Rutinas inspiradas en Corea: limpiadores suaves, tónicos hidratantes, sérums concentrados y esenciales para cuidar tu piel.";

    private const string _imageUrl =
        "http://localhost:8080/LuminaBeauty-Servicios/images/categorias/kbeauty-destacada.jpg";

    private void GoToCategory()
    {
        string category = Uri.EscapeDataString(_categoryName);
        Navigator.NavigateTo($"/shop?category={category}");
    }
}