@using LuminaBeauty.Models
@inject ProductService ProductCache
@inject NavigationManager Navigator
@inject IJSRuntime JS
<section id="catalog" class="scroll-mt-24">
    <div class="mb-8 border-b border-stone-100 pb-5 select-none">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div>
                <span class="block text-[10px] font-bold uppercase tracking-[0.2em] text-[#C69A63]">
                    Favoritos de Lumina
                </span>

                <h2 class="mt-2 font-serif text-2xl font-medium leading-tight text-stone-900 sm:text-3xl">
                    Los más vendidos
                </h2>

                <p class="mt-2 max-w-2xl text-xs leading-relaxed text-stone-500 sm:text-sm">
                    Los esenciales que más han acompañado las rutinas de nuestra comunidad.
                </p>
            </div>

            <button @onclick="GoToBestSellers"
                    class="hidden cursor-pointer items-center gap-1 text-xs font-semibold uppercase tracking-[0.12em] text-[#C7346A] transition hover:text-stone-900 md:flex">
                Ver todos
                <span>→</span>
            </button>
        </div>
    </div>

    <div class="mb-7 flex flex-wrap gap-2 select-none">
        <button @onclick="ClearCategory"
                class="cursor-pointer rounded-full border px-6 py-3 text-[10px] font-semibold uppercase tracking-[0.14em] transition @(string.IsNullOrWhiteSpace(_selectedCategory)
                    ? "border-[#C7346A] bg-[#C7346A] text-white shadow-sm"
                    : "border-stone-200 bg-white text-stone-600 hover:border-[#F3C7D4] hover:text-[#C7346A]")">
            Ver todo
        </button>

        @foreach (var category in ProductCache.GetCategories())
        {
            var isSelected = _selectedCategory == category.Name;

            <button @onclick="() => SelectCategory(category.Name)"
                    class="cursor-pointer rounded-full border px-6 py-3 text-[10px] font-semibold uppercase tracking-[0.14em] transition @(isSelected
                        ? "border-[#C7346A] bg-[#C7346A] text-white shadow-sm"
                        : "border-stone-200 bg-white text-stone-600 hover:border-[#F3C7D4] hover:text-[#C7346A]")">
                @category.Name
            </button>
        }
    </div>

    @{
        var productsToShow = GetProductsToShow();
    }

    <div class="relative">
        <button type="button"
                @onclick="() => MoveBestSellersAsync(-1)"
                aria-label="Ver productos anteriores"
                class="absolute -left-5 top-1/2 z-20 hidden h-10 w-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-stone-200 bg-white text-2xl leading-none text-stone-500 shadow-sm transition hover:border-[#FCD1DB] hover:text-[#C7346A] lg:flex">
            ‹
        </button>

        <div id="bestSellersCarousel"
             class="grid grid-flow-col auto-cols-[minmax(260px,1fr)] gap-5 overflow-x-auto pb-3 snap-x snap-mandatory overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:auto-cols-[minmax(290px,1fr)] lg:auto-cols-[calc((100%-2.5rem)/3)]">

            @if (productsToShow.Count > 0)
            {
                @foreach (var product in productsToShow)
                {
                    <article class="snap-start rounded-3xl border border-stone-100 bg-white p-4 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-md">
                        <button type="button"
                                @onclick='() => Navigator.NavigateTo($"/product/{product.Id}")'
                                class="relative flex h-[220px] w-full cursor-pointer items-center justify-center overflow-hidden rounded-2xl bg-[#FFF7F9] p-5">

                            @if (product.OriginalPrice != null && product.OriginalPrice > product.Price)
                            {
                                <span class="absolute left-3 top-3 rounded-full bg-[#FFF0F3] px-2.5 py-1 text-[9px] font-semibold text-[#C7346A]">
                                    Oferta
                                </span>
                            }

                            <img src="@product.Image"
                                 alt="@product.Name"
                                 class="h-full w-full object-contain transition-transform duration-500 hover:scale-105" />
                        </button>

                        <div class="pt-4">
                            <div class="flex items-center justify-between gap-3">
                                <span class="text-[9px] font-semibold uppercase tracking-[0.15em] text-[#C69A63]">
                                    @product.Brand
                                </span>

                                <span class="rounded-full bg-[#FFF0F3] px-2.5 py-1 text-[9px] font-semibold text-[#C7346A]">
                                    @product.Category
                                </span>
                            </div>

                            <button type="button"
                                    @onclick='() => Navigator.NavigateTo($"/product/{product.Id}")'
                                    class="mt-3 min-h-[48px] cursor-pointer bg-transparent p-0 text-left text-sm font-semibold leading-snug text-stone-800 transition hover:text-[#C7346A] line-clamp-2">
                                @product.Name
                            </button>

                            <div class="mt-3 min-h-[22px]">
                                @if (product.ReviewsCount > 0)
                                {
                                    <div class="flex items-center gap-1.5">
                                        <span class="text-xs text-[#FF76A5]">★★★★★</span>
                                        <span class="text-[11px] font-semibold text-stone-600">
                                            @product.Rating.ToString("0.0")
                                        </span>
                                        <span class="text-[10px] text-stone-400">
                                            (@product.ReviewsCount)
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <span class="inline-block rounded-full bg-[#FFF0F3] px-2.5 py-1 text-[9px] font-semibold uppercase tracking-wide text-[#C7346A]">
                                        Nuevo
                                    </span>
                                }
                            </div>

                            <div class="mt-4 border-t border-stone-100 pt-4">
                                @if (product.OriginalPrice != null && product.OriginalPrice > product.Price)
                                {
                                    <span class="block text-[11px] text-stone-400 line-through">
                                        S/ @product.OriginalPrice.Value.ToString("0.00")
                                    </span>
                                }

                                <div class="mt-1 flex items-center justify-between gap-3">
                                    <span class="font-mono text-base font-semibold text-stone-900">
                                        S/ @product.Price.ToString("0.00")
                                    </span>

                                    <button type="button"
                                            @onclick='() => Navigator.NavigateTo($"/product/{product.Id}")'
                                            class="cursor-pointer rounded-xl bg-stone-900 px-4 py-2.5 text-[9px] font-bold uppercase tracking-[0.08em] text-white transition hover:bg-[#C7346A]">
                                        Ver producto
                                    </button>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="rounded-3xl border border-stone-100 bg-white/50 py-14 text-center">
                    <p class="text-sm font-medium text-stone-400">
                        No hay productos disponibles por el momento.
                    </p>
                </div>
            }
        </div>

        <button type="button"
                @onclick="() => MoveBestSellersAsync(1)"
                aria-label="Ver más productos"
                class="absolute -right-5 top-1/2 z-20 hidden h-10 w-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-stone-200 bg-white text-2xl leading-none text-stone-500 shadow-sm transition hover:border-[#FCD1DB] hover:text-[#C7346A] lg:flex">
            ›
        </button>
    </div>
</section>

@code {
    private string _selectedCategory = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await ProductCache.EnsureLoadedAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void SelectCategory(string category)
    {
        _selectedCategory = category;
    }

    private void ClearCategory()
    {
        _selectedCategory = string.Empty;
    }

    private void GoToBestSellers()
    {
        Navigator.NavigateTo("/shop?sort=bestsellers");
    }

    private List<Product> GetProductsToShow()
    {
        var products = ProductCache.GetAllProducts();

        if (!string.IsNullOrWhiteSpace(_selectedCategory))
        {
            products = products
                .Where(product => product.Category.Equals(
                    _selectedCategory,
                    StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        return products
            .OrderByDescending(product => product.ReviewsCount)
            .ThenByDescending(product => product.Rating)
            .ThenBy(product => product.Name)
            .Take(8)
            .ToList();
    }

    private async Task MoveBestSellersAsync(int direction)
    {
        await JS.InvokeVoidAsync(
            "luminaCarousel.move",
            "bestSellersCarousel",
            direction);
    }
}