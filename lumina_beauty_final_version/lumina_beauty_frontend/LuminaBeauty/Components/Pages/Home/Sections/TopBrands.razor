@inject ProductService ProductCache

<section class="py-10 overflow-hidden border-y border-stone-200/60">
    <div class="mb-6 flex items-end justify-between">
        <div>
            <span class="block text-[10px] font-bold uppercase tracking-[0.2em] text-[#C69A63]">
                Confianza y calidad
            </span>

            <h2 class="mt-2 font-serif text-2xl font-medium leading-tight text-stone-900 sm:text-3xl">
                Marcas destacadas
            </h2>
        </div>
    </div>

    @{
        var brands = ProductCache.GetBrands()
            .Where(brand => !string.IsNullOrWhiteSpace(brand.Logo))
            .ToList();
    }

    @if (brands.Count > 0)
    {
        <div class="brand-marquee">
            <div class="brand-track">
                @foreach (var brand in brands)
                {
                    <article class="brand-card">
                        <img src="@brand.Logo"
                             alt="@brand.Name"
                             class="brand-logo"
                             referrerpolicy="no-referrer" />
                    </article>
                }

                @foreach (var brand in brands)
                {
                    <article class="brand-card">
                        <img src="@brand.Logo"
                             alt="@brand.Name"
                             class="brand-logo"
                             referrerpolicy="no-referrer" />
                    </article>
                }
            </div>
        </div>
    }
</section>