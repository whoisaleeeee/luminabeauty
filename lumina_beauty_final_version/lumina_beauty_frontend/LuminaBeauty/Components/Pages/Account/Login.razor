@page "/login"
@inject AuthService Auth
@inject ToastService Toast
@inject NavigationManager Navigator

<PageTitle>Ingresar | Lumina Beauty</PageTitle>

<div class="mx-auto flex max-w-6xl items-center justify-center px-4 py-12 sm:px-6">

    <section class="w-full max-w-xl overflow-hidden rounded-[2rem] border border-white/80 bg-white/90 shadow-[0_20px_55px_rgba(199,52,106,0.10)] backdrop-blur-md">

        <div class="px-7 pb-7 pt-8 sm:px-10 sm:pb-8 sm:pt-9">

            <!-- Emblema decorativo -->
            <div class="flex items-center justify-center gap-3 text-[#F7A1B8]">
                <span class="text-sm">✦</span>

                <span class="flex h-14 w-14 items-center justify-center rounded-full bg-[#FFF0F3] font-serif text-3xl italic text-[#E98AA9]">
                    L
                </span>

                <span class="text-sm">✦</span>
            </div>

            <div class="mt-5 text-center">
                <h1 class="font-serif text-3xl font-semibold tracking-tight text-stone-900 sm:text-[2.15rem]">
                    Bienvenida de vuelta
                </h1>

                <p class="mt-3 text-xs leading-relaxed text-stone-500 sm:text-sm">
                    Ingresa con tus datos para continuar con tu experiencia Lumina.
                </p>
            </div>

            <!-- Divisor decorativo -->
            <div class="mt-7 flex items-center gap-3">
                <span class="h-px flex-1 bg-[#FCD1DB]"></span>
                <span class="text-base text-[#F7A1B8]">✦</span>
                <span class="h-px flex-1 bg-[#FCD1DB]"></span>
            </div>

            <form @onsubmit="HandleLoginSubmit"
                  @onsubmit:preventDefault
                  class="mt-7 space-y-5">

                <!-- Correo -->
                <div class="space-y-2">
                    <label class="text-xs font-bold text-stone-800">
                        Correo electrónico
                    </label>

                    <div class="relative">
                        <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-[#FF76A5]">
                            <svg class="h-4 w-4"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">
                                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                <path d="m3 7 9 6 9-6"></path>
                            </svg>
                        </span>

                        <input type="email"
                               required
                               autocomplete="email"
                               @bind="_email"
                               placeholder="correo@ejemplo.com"
                               class="w-full rounded-xl border border-[#F4D4DD] bg-white py-3 pl-11 pr-4 text-sm font-medium text-stone-800 outline-none transition placeholder:text-stone-400 focus:border-[#C7346A] focus:ring-2 focus:ring-[#FCD1DB]/60" />
                    </div>
                </div>

                <!-- Contraseña -->
                <div class="space-y-2">
                    <label class="text-xs font-bold text-stone-800">
                        Contraseña
                    </label>

                    <div class="relative">
                        <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-[#FF76A5]">
                            <svg class="h-4 w-4"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">
                                <rect x="5" y="10" width="14" height="10" rx="2"></rect>
                                <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                            </svg>
                        </span>

                        <input type="@(_showPassword ? "text" : "password")"
                               required
                               autocomplete="current-password"
                               @bind="_password"
                               placeholder="Ingresa tu contraseña"
                               class="w-full rounded-xl border border-[#F4D4DD] bg-white py-3 pl-11 pr-12 text-sm font-medium text-stone-800 outline-none transition placeholder:text-stone-400 focus:border-[#C7346A] focus:ring-2 focus:ring-[#FCD1DB]/60" />

                        <button type="button"
                                @onclick="TogglePassword"
                                class="absolute right-3 top-1/2 -translate-y-1/2 rounded-md p-1.5 text-stone-400 transition hover:bg-[#FFF0F3] hover:text-[#C7346A]"
                                title="@(_showPassword ? "Ocultar contraseña" : "Mostrar contraseña")">

                            @if (_showPassword)
                            {
                                <svg class="h-4 w-4"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">
                                    <path d="m3 3 18 18"></path>
                                    <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"></path>
                                    <path d="M9.9 4.2A10.8 10.8 0 0 1 12 4c5.2 0 8.7 4.3 9.7 8-.4 1.5-1.2 2.9-2.2 4"></path>
                                    <path d="M6.3 6.3C4.2 7.8 2.8 10.1 2.3 12c1 3.7 4.5 8 9.7 8 1.4 0 2.7-.3 3.8-.8"></path>
                                </svg>
                            }
                            else
                            {
                                <svg class="h-4 w-4"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">
                                    <path d="M2.3 12S5.8 4 12 4s9.7 8 9.7 8-3.5 8-9.7 8S2.3 12 2.3 12Z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            }
                        </button>
                    </div>

                    <div class="flex justify-end">
                        <button type="button"
                                @onclick="ShowPasswordRecoveryMessage"
                                class="text-[11px] font-semibold text-[#FF76A5] transition hover:text-[#C7346A] hover:underline">
                            ¿Olvidaste tu contraseña?
                        </button>
                    </div>
                </div>

                <!-- Iniciar sesión -->
                <button type="submit"
                        disabled="@_isSubmitting"
                        class="mt-2 flex w-full items-center justify-center rounded-xl bg-stone-950 px-5 py-4 text-[11px] font-bold uppercase tracking-[0.18em] text-white transition duration-200 hover:bg-[#C7346A] hover:shadow-lg hover:shadow-[#FCD1DB] disabled:cursor-not-allowed disabled:opacity-60">
                    @(_isSubmitting ? "Ingresando..." : "Ingresar")
                </button>

                <!-- Divisor social -->
                <div class="flex items-center gap-3 pt-1">
                    <span class="h-px flex-1 bg-[#FCE2E8]"></span>
                    <span class="text-xs text-stone-400">O continúa con</span>
                    <span class="h-px flex-1 bg-[#FCE2E8]"></span>
                </div>

                <!-- Login social -->
                <div class="grid grid-cols-2 gap-3">
                    <button type="button"
                            @onclick="ShowGoogleLoginMessage"
                            class="flex items-center justify-center gap-2 rounded-xl border border-[#F4D4DD] bg-white px-4 py-3 text-xs font-semibold text-stone-700 transition hover:bg-[#FFF7F9] hover:text-[#C7346A]">
                        <svg class="h-4 w-4" viewBox="0 0 24 24">
                            <path fill="#4285F4" d="M21.35 12.23c0-.72-.06-1.25-.2-1.8H12v3.42h5.37c-.11.85-.71 2.13-2.04 2.99l-.02.11 2.97 2.3.21.02c1.95-1.8 3.08-4.45 3.08-7.04Z" />
                            <path fill="#34A853" d="M12 21.75c2.63 0 4.84-.87 6.45-2.37l-3.07-2.38c-.82.57-1.92.97-3.38.97-2.58 0-4.77-1.7-5.55-4.05l-.1.01-3.09 2.39-.03.1A9.75 9.75 0 0 0 12 21.75Z" />
                            <path fill="#FBBC05" d="M6.45 13.92A5.87 5.87 0 0 1 6.13 12c0-.67.12-1.31.31-1.92l-.01-.13-3.13-2.43-.1.05A9.74 9.74 0 0 0 2.25 12c0 1.6.38 3.11.95 4.43l3.25-2.51Z" />
                            <path fill="#EA4335" d="M12 6.03c1.84 0 3.08.8 3.79 1.46l2.77-2.7C16.83 3.18 14.63 2.25 12 2.25A9.75 9.75 0 0 0 3.2 7.57l3.23 2.49C7.23 7.73 9.42 6.03 12 6.03Z" />
                        </svg>
                        Google
                    </button>

                    <button type="button"
                            @onclick="ShowAppleLoginMessage"
                            class="flex items-center justify-center gap-2 rounded-xl border border-[#F4D4DD] bg-white px-4 py-3 text-xs font-semibold text-stone-700 transition hover:bg-[#FFF7F9] hover:text-[#C7346A]">
                        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                            <path d="M17.1 12.6c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9-.7 0-1.8-.9-3-.9-1.6 0-3 .9-3.8 2.2-1.6 2.8-.4 6.9 1.1 9.1.7 1.1 1.6 2.3 2.8 2.2 1.1 0 1.6-.7 3-.7s1.8.7 3 .7c1.2 0 2-1.1 2.8-2.2.8-1.3 1.2-2.6 1.2-2.7-.1 0-2.2-.8-2.2-3.3ZM14.8 5.8c.6-.7 1-1.6.9-2.6-.9 0-2 .6-2.6 1.3-.6.6-1.1 1.6-.9 2.5 1 .1 2-.5 2.6-1.2Z"></path>
                        </svg>
                        Apple
                    </button>
                </div>
            </form>
        </div>

        <!-- Crear cuenta -->
        <div class="border-t border-[#FCE2E8] bg-[#FFF7F9] px-7 py-5 text-center sm:px-10">
            <p class="text-sm text-stone-500">
                ¿Aún no tienes una cuenta?
            </p>

            <button @onclick="NavigateToSignup"
                    class="mt-2 inline-flex items-center gap-1 text-[11px] font-black uppercase tracking-[0.16em] text-[#C7346A] transition hover:text-[#FF76A5]">
                Crear cuenta
                <span class="text-base leading-none">›</span>
            </button>
        </div>
    </section>
</div>

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;
    private bool _isSubmitting;
    private bool _showPassword;

    private void TogglePassword()
    {
        _showPassword = !_showPassword;
    }

    private async Task HandleLoginSubmit()
    {
        try
        {
            _isSubmitting = true;

            bool loggedIn = await Auth.LoginAsync(_email, _password);

            if (!loggedIn)
            {
                Toast.ShowToast("No se pudo iniciar sesión. Verifica tus credenciales.");
                return;
            }

            Toast.ShowToast("Sesión iniciada correctamente.");
            Navigator.NavigateTo("/profile");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void NavigateToSignup()
    {
        Navigator.NavigateTo("/signup");
    }

    private void ShowPasswordRecoveryMessage()
    {
        Toast.ShowToast("La recuperación de contraseña estará disponible próximamente.");
    }

    private void ShowGoogleLoginMessage()
    {
        Toast.ShowToast("El inicio de sesión con Google aún no está configurado.");
    }

    private void ShowAppleLoginMessage()
    {
        Toast.ShowToast("El inicio de sesión con Apple aún no está configurado.");
    }
}