@page "/login"
@inject AuthService Auth
@inject ToastService Toast
@inject NavigationManager Navigator

<PageTitle>Ingresar | Lumina Beauty</PageTitle>

<div class="mx-auto flex min-h-[calc(100vh-13rem)] max-w-6xl items-center justify-center px-4 py-10 sm:px-6">

    <section class="w-full max-w-md rounded-[2rem] border border-stone-200/70 bg-white/85 p-7 shadow-xl shadow-stone-200/40 backdrop-blur-md sm:p-9">

        <div class="mt-2 border-b border-stone-100 pb-6">
            <h1 class="mt-2 font-serif text-xl font-semibold text-stone-800">
                Bienvenida de vuelta
            </h1>

            <p class="mt-2 text-xs leading-relaxed text-stone-500">
                Ingresa con tus datos para continuar con tu experiencia Lumina.
            </p>
        </div>

        <form @onsubmit="HandleLoginSubmit"
              @onsubmit:preventDefault
              class="mt-7 space-y-5">

            <div class="space-y-2">
                <label class="text-[10px] font-black uppercase tracking-widest text-stone-500">
                    Correo electrónico
                </label>

                <input type="email"
                       required
                       autocomplete="email"
                       @bind="_email"
                       placeholder="correo@ejemplo.com"
                       class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-xs font-semibold text-stone-800 outline-none transition placeholder:text-stone-400 focus:border-[#C7346A] focus:bg-white" />
            </div>

            <div class="space-y-2">
                <label class="text-[10px] font-black uppercase tracking-widest text-stone-500">
                    Contraseña
                </label>

                <input type="password"
                       required
                       autocomplete="current-password"
                       @bind="_password"
                       placeholder="Ingresa tu contraseña"
                       class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-xs font-semibold text-stone-800 outline-none transition placeholder:text-stone-400 focus:border-[#C7346A] focus:bg-white" />
            </div>

            <div class="pt-5">
                <button type="submit"
                        disabled="@_isSubmitting"
                        class="flex w-full items-center justify-center rounded-xl bg-stone-950 px-5 py-3.5 text-[10px] font-bold uppercase tracking-[0.14em] text-white transition hover:bg-[#C7346A] cursor-pointer disabled:cursor-not-allowed disabled:opacity-60">
                    @(_isSubmitting ? "Ingresando..." : "Ingresar")
                </button>
            </div>
        </form>

        <div class="mt-7 border-t border-stone-100 pt-6 text-center">
            <p class="text-xs font-medium text-stone-500">
                ¿Aún no tienes una cuenta?
            </p>

            <button @onclick="NavigateToSignup"
                    class="mt-2 text-[10px] font-black uppercase tracking-widest text-[#C7346A] transition hover:text-[#FF76A5] hover:underline cursor-pointer">
                Crear cuenta
            </button>
        </div>
    </section>
</div>

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;
    private bool _isSubmitting;

    private async Task HandleLoginSubmit()
    {
        try
        {
            _isSubmitting = true;

            bool loggedIn = await Auth.LoginAsync(_email, _password);

            if (!loggedIn)
            {
                Toast.ShowToast(
                    "No se pudo iniciar sesión. Verifica tus credenciales."
                );
                return;
            }

            Toast.ShowToast("Sesión iniciada correctamente.");
            Navigator.NavigateTo("/profile");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void NavigateToSignup()
    {
        Navigator.NavigateTo("/signup");
    }
}