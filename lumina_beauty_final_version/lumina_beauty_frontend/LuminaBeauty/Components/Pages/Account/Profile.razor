@page "/profile"
@using Microsoft.AspNetCore.Components
@inject LanguageService LangService
@inject AuthService Auth
@inject WishlistService Wishlist
@inject ProductService ProductCache
@inject ToastService Toast
@inject NavigationManager Navigator
@inject ProfileAppService ProfileApp
@inject ClienteRestService ClienteRest
@implements IDisposable

<PageTitle>Mi Cuenta VIP | Lumina Beauty</PageTitle>

<div class="max-w-6xl mx-auto px-1 sm:px-4 py-6 text-left">

    <nav class="text-xs font-semibold text-stone-400 mb-8 flex items-center gap-2 select-none">
        <span class="hover:text-[#FF76A5] cursor-pointer transition" @onclick='() => NavigateTo("/")'>
            Inicio
        </span>
        <span class="text-stone-300">/</span>
        <span class="text-stone-600 font-bold">Perfil</span>
    </nav>

    @if (!Auth.IsLoggedIn)
    {
        <div class="bg-white/75 backdrop-blur-md border border-[#FCD1DB]/50 rounded-[32px] p-10 text-center max-w-md mx-auto shadow-xl space-y-6">
            <div class="w-14 h-14 bg-[#FFF0F3] text-[#FF76A5] border border-[#FCD1DB]/50 rounded-full flex items-center justify-center mx-auto text-xl font-bold select-none">
                <span>🔒</span>
            </div>

            <div class="space-y-1 select-none">
                <h2 class="font-serif text-2xl font-bold text-stone-900 leading-tight">
                    Acceso Exclusivo VIP
                </h2>

                <p class="text-[11px] text-stone-500 font-bold max-w-xs mx-auto leading-relaxed">
                    Inicia sesión para visualizar tu información, direcciones de entrega,
                    pedidos y lista de deseos.
                </p>
            </div>

            <button @onclick='() => NavigateTo("/login")'
                    class="w-full bg-[#FF76A5] hover:bg-[#C7346A] tracking-wider font-bold text-xs uppercase text-white py-3.5 rounded-xl transition duration-300 shadow cursor-pointer select-none">
                Ingresar / Crear Cuenta
            </button>
        </div>
    }
    else if (ProfileApp.State.IsLoadingProfile)
    {
        <div class="bg-white/75 backdrop-blur-md border border-[#FCD1DB]/50 rounded-[32px] p-10 text-center max-w-md mx-auto shadow-xl">
            <p class="text-sm text-stone-500 font-bold">
                Cargando información de tu perfil...
            </p>
        </div>
    }
    else
    {
        var nivelCliente = (ProfileApp.State.CurrentClient?.NivelCliente ?? "BRONCE")
            .Trim()
            .ToUpperInvariant();

        var (profileCardClass, profileBannerClass, profileAvatarClass,
             profileBadgeClass, profileIconClass, profilePointsClass,
             profileDividerClass, profileHoverClass) = nivelCliente switch
             {
                 "PLATINO" => (
                     "border-slate-200 shadow-[0_18px_42px_rgba(71,85,105,0.16)]",
                     "from-slate-100 via-white to-slate-200/70",
                     "border-slate-300 from-slate-50 to-slate-200 text-slate-700",
                     "border-slate-300 bg-slate-100 text-slate-700",
                     "bg-slate-100 text-slate-700",
                     "border-slate-200 bg-slate-50 text-slate-700",
                     "border-slate-200/70",
                     "hover:border-slate-300 hover:bg-slate-50 hover:text-slate-700 hover:shadow-[0_6px_16px_rgba(71,85,105,0.10)]"
                 ),
                 "ORO" => (
                     "border-[#F3DEC0] shadow-[0_18px_42px_rgba(180,125,45,0.16)]",
                     "from-[#FFF8E8] via-white to-[#FBE7BB]/70",
                     "border-[#F2CF8A] from-[#FFF9EA] to-[#F6D999] text-[#A6602D]",
                     "border-[#F2D49A] bg-[#FFF4D9] text-[#A6602D]",
                     "bg-[#FFF4D9] text-[#A6602D]",
                     "border-[#F2D49A] bg-[#FFF9EA] text-[#A6602D]",
                     "border-[#F3DEC0]/80",
                     "hover:border-[#F2D49A] hover:bg-[#FFF9EA] hover:text-[#A6602D] hover:shadow-[0_6px_16px_rgba(180,125,45,0.10)]"
                 ),
                 "PLATA" => (
                     "border-[#D9E0E8] shadow-[0_18px_42px_rgba(100,116,139,0.15)]",
                     "from-[#F4F6F8] via-white to-[#E7ECF1]/80",
                     "border-[#CBD5E1] from-[#F8FAFC] to-[#DCE3EA] text-[#52637A]",
                     "border-[#D5DDE6] bg-[#F2F5F8] text-[#52637A]",
                     "bg-[#F2F5F8] text-[#52637A]",
                     "border-[#D5DDE6] bg-[#F8FAFC] text-[#52637A]",
                     "border-[#DCE3EA]/80",
                     "hover:border-[#CBD5E1] hover:bg-[#F8FAFC] hover:text-[#52637A] hover:shadow-[0_6px_16px_rgba(100,116,139,0.10)]"
                 ),
                 _ => (
                     "border-[#EFC5D3] shadow-[0_18px_42px_rgba(199,52,106,0.14)]",
                     "from-[#FFF0F3] via-white to-[#FBE8EF]",
                     "border-[#FCD1DB] from-[#FFF7F9] to-[#F8C9D8] text-[#C7346A]",
                     "border-[#FCD1DB] bg-[#FFF0F3] text-[#C7346A]",
                     "bg-[#FFF0F3] text-[#C7346A]",
                     "border-[#FCD1DB] bg-[#FFF8FA] text-[#C7346A]",
                     "border-[#FCD1DB]/65",
                     "hover:border-[#F3C7D5] hover:bg-[#FFF3F6] hover:text-[#C7346A] hover:shadow-[0_6px_16px_rgba(199,52,106,0.08)]"
                 )
             };

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

            <div class="lg:col-span-4 space-y-6">

                <div class="relative overflow-hidden rounded-[2rem] border bg-white/85 p-5 text-center backdrop-blur-md @profileCardClass">

                    <div class="pointer-events-none absolute inset-x-0 top-0 h-24 bg-gradient-to-br @profileBannerClass"></div>

                    <div class="relative">
                        <div class="mx-auto mb-3 h-24 w-24">
                            <div class="flex h-24 w-24 items-center justify-center rounded-full border-2 bg-gradient-to-br font-serif text-2xl font-bold shadow-md select-none @profileAvatarClass">
                                @ProfileApp.ObtenerInicialesCliente()
                            </div>
                        </div>

                        <h2 class="font-serif text-[1.55rem] font-semibold leading-tight text-stone-900">
                            @($"{ProfileApp.State.ProfileFirstName} {ProfileApp.State.ProfileLastName}".Trim())
                        </h2>

                        <span class="mt-2 inline-flex items-center gap-1 rounded-full border px-3 py-1.5 text-[9px] font-black uppercase tracking-widest @profileBadgeClass">
                            ✦ Miembro @nivelCliente
                        </span>

                        <div class="mx-auto mt-3 max-w-xs space-y-2 border-y py-3 text-left text-xs font-medium text-stone-600 @profileDividerClass">
                            <div class="flex items-center gap-3">
                                <span class="flex h-8 w-8 items-center justify-center rounded-xl @profileIconClass">
                                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                        <path d="m3 7 9 6 9-6"></path>
                                    </svg>
                                </span>
                                <span class="min-w-0 truncate">@ProfileApp.State.ProfileEmail</span>
                            </div>

                            <div class="flex items-center gap-3">
                                <span class="flex h-8 w-8 items-center justify-center rounded-xl @profileIconClass">
                                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .8 2.9a2 2 0 0 1-.5 2.1L8.1 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.4 1.9.7 2.9.8A2 2 0 0 1 22 16.9Z"></path>
                                    </svg>
                                </span>
                                <span>@ProfileApp.State.ProfilePhone</span>
                            </div>
                        </div>

                        @if (ProfileApp.State.CurrentClient is not null)
                        {
                            <div class="mt-3 overflow-hidden rounded-2xl border text-left @profilePointsClass">
                                <div class="px-5 py-3.5">
                                    <p class="text-[8px] font-black uppercase tracking-widest">
                                        Puntos Lumina
                                    </p>

                                    <div class="mt-1 flex items-end justify-between gap-3">
                                        <p class="text-2xl font-bold text-stone-900">
                                            @(ProfileApp.State.CurrentClient.PuntosFidelidad)
                                        </p>

                                        <p class="pb-0.5 text-[9px] font-bold text-stone-400">
                                            Saldo disponible
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="mt-3 border-t pt-3 @profileDividerClass">
                            <button @onclick="LogOff"
                                    class="flex w-full items-center justify-center gap-2 rounded-xl border border-transparent bg-transparent px-4 py-3 text-[10px] font-black uppercase tracking-wider text-stone-400 transition-all duration-200 cursor-pointer @profileHoverClass">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M10 17l5-5-5-5"></path>
                                    <path d="M15 12H3"></path>
                                    <path d="M21 3v18"></path>
                                </svg>
                                Cerrar sesión
                            </button>

                            <p class="mt-2 text-center text-[9px] font-medium text-stone-400">
                                Saldrás de tu cuenta en este dispositivo.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div id="perfil-contenido"
                 class="lg:col-span-8 bg-white/70 backdrop-blur-md rounded-3xl border border-white/70 px-6 pt-6 pb-6 sm:px-8 sm:pt-8 sm:pb-8 shadow-md scroll-mt-6">

                <div class="mb-5 border-b border-stone-100 pb-4">
                    <div class="flex gap-2 overflow-x-auto pb-1 lg:overflow-visible lg:pb-0">
                        @foreach (var tab in _profileTabs)
                        {
                            var tCode = tab.Key;
                            var tLabel = tab.Value;
                            var isActive = ProfileApp.State.ActiveTab == tCode;

                            <button @onclick="() => SetActiveTabAsync(tCode)"
                                    class="flex shrink-0 items-center gap-2 rounded-full px-4 py-2.5 text-[10px] font-black uppercase tracking-wide transition cursor-pointer @(isActive
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ? "bg-[#D93470] text-white shadow-[0_8px_18px_rgba(217,52,112,0.22)]"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        : "border border-stone-200 bg-white text-stone-600 hover:border-[#FCD1DB] hover:bg-[#FFF0F3] hover:text-[#C7346A]")">

                                @if (tCode == "detalles")
                                {
                                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="8" r="3.5"></circle>
                                        <path d="M4.5 20a7.5 7.5 0 0 1 15 0"></path>
                                    </svg>
                                }
                                else if (tCode == "direcciones")
                                {
                                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M12 21s7-5.2 7-12A7 7 0 1 0 5 9c0 6.8 7 12 7 12Z"></path>
                                        <circle cx="12" cy="9" r="2.5"></circle>
                                    </svg>
                                }
                                else if (tCode == "pedidos")
                                {
                                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M6 7h12l1 13H5L6 7Z"></path>
                                        <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
                                    </svg>
                                }
                                else if (tCode == "reclamos")
                                {
                                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"></path>
                                        <path d="M8.5 8h7M8.5 12h7M8.5 16h4"></path>
                                    </svg>
                                }
                                else if (tCode == "favoritos")
                                {
                                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.9-8.6a5.5 5.5 0 0 0-.1-7.8Z"></path>
                                    </svg>
                                }
                                else if (tCode == "puntos")
                                {
                                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="m12 2 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5-5.8-3.1-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9L12 2Z"></path>
                                    </svg>
                                }

                                <span>@tLabel</span>
                            </button>
                        }
                    </div>
                </div>

                @if (ProfileApp.State.ActiveTab == "detalles")
                {
                    <div class="space-y-6 animate-in fade-in duration-300 text-left">
                        <div class="border-b border-stone-100 pb-4">
                            <p class="text-[9px] font-black uppercase tracking-[0.18em] text-[#C7346A]">
                                Mi cuenta Lumina
                            </p>

                            <h3 class="mt-2 font-serif text-xl font-semibold text-stone-900">
                                Configuración personal de belleza
                                <span class="ml-1 text-[#FF76A5]">✦</span>
                            </h3>

                            <p class="mt-1 text-[11px] text-stone-500">
                                Actualiza tus datos para personalizar tu experiencia Lumina.
                            </p>
                        </div>

                        <form @onsubmit="SaveDetailsAsync"
                              @onsubmit:preventDefault
                              class="grid grid-cols-1 sm:grid-cols-2 gap-5">

                            @* Nombres *@


                            <div class="space-y-1">
                                <label class="text-[10px] font-black uppercase tracking-wider text-stone-400 select-none">
                                    Nombres
                                </label>

                                <div class="relative">
                                    <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-[#FF76A5]">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="8" r="3.5"></circle>
                                            <path d="M4.5 20a7.5 7.5 0 0 1 15 0"></path>
                                        </svg>
                                    </span>

                                    <input type="text"
                                           required
                                           placeholder="Tus nombres"
                                           @bind="ProfileApp.State.ProfileFirstName"
                                           class="w-full rounded-xl border border-[#F4D4DD] bg-[#FFFDFE] py-2.5 pl-10 pr-3.5 text-xs font-bold text-stone-800 outline-none transition placeholder:text-stone-400 hover:bg-white focus:border-[#FF76A5] focus:bg-white focus:ring-2 focus:ring-[#FCD1DB]/60" />
                                </div>
                            </div>



                            @* -------------------------------- *@
                            @* APELLIDOS *@

                            <div class="space-y-1">
                                <label class="text-[10px] font-black uppercase tracking-wider text-stone-400 select-none">
                                    Apellidos
                                </label>

                                <div class="relative">
                                    <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-[#FF76A5]">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="8" r="3.5"></circle>
                                            <path d="M4.5 20a7.5 7.5 0 0 1 15 0"></path>
                                        </svg>
                                    </span>

                                    <input type="text"
                                           required
                                           placeholder="Tus apellidos"
                                           @bind="ProfileApp.State.ProfileLastName"
                                           class="w-full rounded-xl border border-[#F4D4DD] bg-[#FFFDFE] py-2.5 pl-10 pr-3.5 text-xs font-bold text-stone-800 outline-none transition placeholder:text-stone-400 hover:bg-white focus:border-[#FF76A5] focus:bg-white focus:ring-2 focus:ring-[#FCD1DB]/60" />
                                </div>
                            </div>



                            @* ------------------ *@
                            @* EMAIL *@

                            <div class="space-y-1">
                                <label class="text-[10px] font-black uppercase tracking-wider text-stone-400 select-none">
                                    Email registrado
                                </label>

                                <div class="relative">
                                    <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-[#FF76A5]">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                            <path d="m3 7 9 6 9-6"></path>
                                        </svg>
                                    </span>

                                    <input type="email"
                                           required
                                           placeholder="correo@ejemplo.com"
                                           @bind="ProfileApp.State.ProfileEmail"
                                           class="w-full rounded-xl border border-[#F4D4DD] bg-[#FFFDFE] py-2.5 pl-10 pr-3.5 text-xs font-bold text-stone-800 outline-none transition placeholder:text-stone-400 hover:bg-white focus:border-[#FF76A5] focus:bg-white focus:ring-2 focus:ring-[#FCD1DB]/60" />
                                </div>
                            </div>

                            <div class="space-y-1">
                                <label class="text-[10px] font-black uppercase tracking-wider text-stone-400 select-none">
                                    Celular de contacto
                                </label>

                                <div class="relative">
                                    <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-[#FF76A5]">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .8 2.9a2 2 0 0 1-.5 2.1L8.1 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.4 1.9.7 2.9.8A2 2 0 0 1 22 16.9Z"></path>
                                        </svg>
                                    </span>

                                    <input type="tel"
                                           placeholder="999 999 999"
                                           @bind="ProfileApp.State.ProfilePhone"
                                           class="w-full rounded-xl border border-[#F4D4DD] bg-[#FFFDFE] py-2.5 pl-10 pr-3.5 text-xs font-bold text-stone-800 outline-none transition placeholder:text-stone-400 hover:bg-white focus:border-[#FF76A5] focus:bg-white focus:ring-2 focus:ring-[#FCD1DB]/60" />
                                </div>
                            </div>

                            <div class="space-y-1">
                                <label class="text-[10px] font-black uppercase tracking-wider text-stone-400 select-none">
                                    Documento de identidad
                                </label>

                                <div class="relative">
                                    <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-stone-400">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                            <circle cx="8" cy="12" r="2"></circle>
                                            <path d="M12 10h5M12 14h5"></path>
                                        </svg>
                                    </span>

                                    <input type="text"
                                           value="@ProfileApp.State.CurrentClient?.Dni"
                                           readonly
                                           class="w-full cursor-not-allowed rounded-xl border border-stone-200 bg-stone-50 py-2.5 pl-10 pr-3.5 text-xs font-bold text-stone-400 opacity-80" />
                                </div>
                            </div>

                            <div class="sm:col-span-2 flex flex-col items-start gap-2 pt-1 sm:items-end">
                                <button type="submit"
                                        disabled="@ProfileApp.State.IsSavingProfile"
                                        class="flex min-w-[210px] items-center justify-center gap-2 rounded-xl bg-stone-950 px-6 py-3.5 text-[10px] font-bold uppercase tracking-wider text-white transition hover:bg-[#C7346A] hover:shadow-lg hover:shadow-[#FCD1DB] cursor-pointer disabled:cursor-not-allowed disabled:opacity-60">
                                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"></path>
                                        <path d="M17 21v-8H7v8"></path>
                                        <path d="M7 3v5h8"></path>
                                    </svg>

                                    @(ProfileApp.State.IsSavingProfile ? "Guardando..." : "Guardar cambios")
                                </button>

                                <p class="text-[10px] text-stone-400">
                                    Tus cambios se actualizarán en tu cuenta Lumina.
                                </p>
                            </div>
                        </form>

                        <div class="rounded-2xl border border-[#FCD1DB]/55 bg-[#FFF0F3]/35 p-5">
                            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                                <div class="flex gap-3">
                                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-[#C7346A] shadow-2xs">
                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                            <path d="m3 7 9 6 9-6"></path>
                                        </svg>
                                    </div>

                                    <div>
                                        <p class="text-[10px] font-black uppercase tracking-widest text-[#C7346A]">
                                            Comunicaciones Lumina
                                        </p>

                                        <h4 class="mt-1 text-sm font-bold text-stone-800">
                                            Novedades y beneficios
                                        </h4>

                                        <p class="mt-1 max-w-lg text-[11px] leading-relaxed text-stone-500">
                                            Próximamente podrás elegir si deseas recibir novedades,
                                            lanzamientos, beneficios de fidelidad y promociones por correo.
                                        </p>
                                    </div>
                                </div>

                                <span class="w-fit rounded-full border border-[#FCD1DB] bg-white px-3 py-1.5 text-[8px] font-black uppercase tracking-wider text-stone-400">
                                    Próximamente
                                </span>
                            </div>
                        </div>

                        <section class="rounded-2xl border border-red-200 bg-red-50/60 p-5">
                            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                                <div class="flex gap-3">
                                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-red-100 text-red-600">
                                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M12 9v4"></path>
                                            <path d="M12 17h.01"></path>
                                            <path d="M10.3 3.6 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 3.6a2 2 0 0 0-3.4 0Z"></path>
                                        </svg>
                                    </div>
                                    <div>
                                        <p class="text-[10px] font-black uppercase tracking-widest text-red-600">Zona de seguridad</p>
                                        <h4 class="mt-1 text-sm font-bold text-stone-900">Desactivar cuenta</h4>
                                        <p class="mt-1 max-w-lg text-[11px] leading-relaxed text-stone-500">
                                            Tu usuario quedará inactivo y se cerrará la sesión. Tus pedidos, pagos y reclamos se conservarán.
                                        </p>
                                    </div>
                                </div>
                                <button type="button"
                                        @onclick="OpenDeactivateAccountModal"
                                        class="shrink-0 rounded-xl border border-red-200 bg-white px-4 py-2.5 text-[10px] font-black uppercase tracking-wider text-red-600 transition-all duration-200 hover:!border-red-500 hover:!bg-red-500 hover:!text-white hover:shadow-[0_6px_14px_rgba(239,68,68,0.22)] cursor-pointer">
                                    Desactivar cuenta
                                </button>
                            </div>
                        </section>

                        @if (_isDeactivateAccountOpen)
                        {
                            <div class="fixed inset-0 z-50 flex items-center justify-center bg-stone-950/45 px-4 py-6 backdrop-blur-sm">
                                <div class="w-full max-w-md rounded-3xl border border-white/70 bg-white p-6 shadow-2xl sm:p-8">
                                    <div class="flex items-start gap-3">
                                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-red-100 text-red-600">
                                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M12 9v4"></path>
                                                <path d="M12 17h.01"></path>
                                                <path d="M10.3 3.6 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 3.6a2 2 0 0 0-3.4 0Z"></path>
                                            </svg>
                                        </div>
                                        <div>
                                            <h4 class="font-serif text-lg font-bold text-stone-900">¿Desactivar tu cuenta?</h4>
                                            <p class="mt-2 text-xs leading-relaxed text-stone-500">
                                                No podrás volver a iniciar sesión hasta que un administrador reactive tu usuario.
                                            </p>
                                        </div>
                                    </div>

                                    <div class="mt-5 space-y-1">
                                        <label class="text-[10px] font-black uppercase tracking-wider text-stone-400">
                                            Escribe DESACTIVAR para confirmar
                                        </label>
                                        <input type="text"
                                               @bind="_deactivationConfirmation"
                                               placeholder="DESACTIVAR"
                                               class="w-full rounded-xl border border-red-200 bg-red-50/40 px-3.5 py-2.5 text-xs font-bold text-stone-800 outline-none transition focus:border-red-400 focus:bg-white focus:ring-2 focus:ring-red-100" />
                                    </div>

                                    <div class="mt-6 flex justify-end gap-2">
                                        <button type="button"
                                                @onclick="CloseDeactivateAccountModal"
                                                disabled="@_isDeactivatingAccount"
                                                class="rounded-xl border border-stone-200 bg-white px-4 py-2.5 text-[10px] font-bold uppercase tracking-wider text-stone-500 transition hover:bg-stone-50 cursor-pointer disabled:opacity-60">
                                            Cancelar
                                        </button>
                                        <button type="button"
                                                @onclick="DeactivateAccountAsync"
                                                disabled="@(_isDeactivatingAccount || !CanDeactivateAccount)"
                                                class="rounded-xl bg-red-600 px-4 py-2.5 text-[10px] font-bold uppercase tracking-wider text-white transition hover:bg-red-700 cursor-pointer disabled:cursor-not-allowed disabled:opacity-50">
                                            @(_isDeactivatingAccount ? "Desactivando..." : "Desactivar cuenta")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (ProfileApp.State.ActiveTab == "direcciones")
                {
                    <div class="space-y-6 animate-in fade-in duration-300 text-left">

                        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-stone-100 pb-5">
                            <div>
                                <p class="text-[9px] font-black uppercase tracking-[0.18em] text-[#C7346A]">
                                    Mi cuenta Lumina
                                </p>

                                <h3 class="mt-2 font-serif text-xl font-semibold text-stone-900">
                                    Direcciones de entrega
                                </h3>

                                <p class="mt-1 text-[11px] text-stone-500">
                                    Gestiona las direcciones disponibles para tus pedidos.
                                </p>
                            </div>

                            <button @onclick="ProfileApp.AbrirNuevaDireccion"
                                    class="flex items-center gap-2 rounded-xl bg-stone-950 px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-white transition hover:bg-[#C7346A] hover:shadow-lg hover:shadow-[#FCD1DB] cursor-pointer">
                                <span class="text-base leading-none">+</span>
                                Nueva dirección
                            </button>
                        </div>

                        @if (ProfileApp.State.IsLoadingAddresses)
                        {
                            <p class="text-xs font-bold text-stone-400">
                                Cargando direcciones...
                            </p>
                        }
                        else if (ProfileApp.State.Addresses.Count == 0)
                        {
                            <div class="rounded-2xl border border-dashed border-[#FCD1DB] bg-[#FFF0F3]/40 p-8 text-center">
                                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-white text-[#C7346A] shadow-sm">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M12 21s7-5.2 7-12A7 7 0 1 0 5 9c0 6.8 7 12 7 12Z"></path>
                                        <circle cx="12" cy="9" r="2.5"></circle>
                                    </svg>
                                </div>

                                <p class="mt-4 text-xs font-bold text-stone-700">
                                    Aún no tienes direcciones registradas.
                                </p>

                                <p class="mt-1 text-[11px] text-stone-500">
                                    Agrega una dirección para utilizarla durante el checkout.
                                </p>

                                <button @onclick="ProfileApp.AbrirNuevaDireccion"
                                        class="mt-5 rounded-xl bg-[#FF76A5] px-5 py-2.5 text-[10px] font-bold uppercase tracking-wider text-white transition hover:bg-[#C7346A] cursor-pointer">
                                    Registrar dirección
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="grid grid-cols-1 gap-4">

                                @foreach (var address in ProfileApp.State.Addresses
                                    .OrderByDescending(ProfileApp.EsDireccionPrincipal))
                                {
                                    var isPrincipal = ProfileApp.EsDireccionPrincipal(address);

                                    <article class="rounded-2xl border p-5 font-sans transition @(isPrincipal
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   ? "border-[#FF9CBC] bg-[#FFF3F6] shadow-[0_10px_24px_rgba(199,52,106,0.08)]"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   : "border-stone-200 bg-white/85 hover:border-[#F3C7D5] hover:shadow-sm")">

                                        <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
                                            <div class="flex items-start gap-4">
                                                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full @(isPrincipal
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       ? "bg-[#FFE0E9] text-[#D93470]"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       : "bg-stone-100 text-stone-500")">

                                                    @if (isPrincipal)
                                                    {
                                                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                                                            <path d="m12 2 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5-5.8-3.1-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9L12 2Z"></path>
                                                        </svg>
                                                    }
                                                    else
                                                    {
                                                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M12 21s7-5.2 7-12A7 7 0 1 0 5 9c0 6.8 7 12 7 12Z"></path>
                                                            <circle cx="12" cy="9" r="2.5"></circle>
                                                        </svg>
                                                    }
                                                </div>

                                                <div class="space-y-1">
                                                    <div class="flex flex-wrap items-center gap-2">
                                                        <p class="text-[9px] font-black uppercase tracking-[0.16em] @(isPrincipal
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         ? "text-[#D93470]"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         : "text-stone-400")">
                                                            Dirección de entrega
                                                        </p>

                                                        @if (isPrincipal)
                                                        {
                                                            <span class="rounded-full border border-[#FFB3C8] bg-[#FFE0E9] px-2.5 py-1 text-[8px] font-black uppercase tracking-wider text-[#D93470]">
                                                                Principal
                                                            </span>
                                                        }
                                                    </div>

                                                    <h4 class="text-base font-bold leading-snug text-stone-900">
                                                        @address.DireccionTexto
                                                    </h4>

                                                    <p class="text-[11px] text-stone-500">
                                                        @address.Ciudad, @address.Pais
                                                        @if (!string.IsNullOrWhiteSpace(address.CodigoPostal))
                                                        {
                                                            <span> · @address.CodigoPostal</span>
                                                        }
                                                    </p>

                                                    @if (!string.IsNullOrWhiteSpace(address.Referencia))
                                                    {
                                                        <p class="text-[11px] text-stone-400">
                                                            Referencia: @address.Referencia
                                                        </p>
                                                    }

                                                    @if (!isPrincipal)
                                                    {
                                                        <button @onclick="() => MarkAsPrincipalAsync(address)"
                                                                disabled="@ProfileApp.State.IsSavingAddress"
                                                                class="mt-2 inline-flex items-center gap-1 text-[9px] font-black uppercase tracking-wider text-[#C7346A] transition hover:text-[#9E2B55] hover:underline cursor-pointer disabled:opacity-60">
                                                            <span aria-hidden="true">☆</span>
                                                            Marcar como principal
                                                        </button>
                                                    }
                                                </div>
                                            </div>

                                            <div class="flex shrink-0 flex-wrap gap-2 sm:flex-col sm:items-end">
                                                <button @onclick="() => ProfileApp.AbrirEdicionDireccion(address)"
                                                        class="flex h-10 w-32 items-center justify-center gap-2 rounded-xl border border-stone-200 bg-white px-3 text-[9px] font-black uppercase tracking-wider text-stone-600 transition-all duration-200 hover:-translate-y-0.5 hover:border-stone-300 hover:bg-stone-50 hover:shadow-[0_8px_16px_rgba(41,37,36,0.10)] cursor-pointer">
                                                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M12 20h9"></path>
                                                        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4L16.5 3.5Z"></path>
                                                    </svg>
                                                    Editar
                                                </button>

                                                <button @onclick="() => ProfileApp.PrepararEliminacionDireccion(address)"
                                                        class="flex h-10 w-32 items-center justify-center gap-2 rounded-xl border border-[#F8DDE5] bg-white px-3 text-[9px] font-black uppercase tracking-wider text-[#D889A5] transition-all duration-200 hover:-translate-y-0.5 hover:border-[#F2A9BF] hover:bg-[#FFF4F7] hover:text-[#C7346A] hover:shadow-[0_8px_16px_rgba(199,52,106,0.12)] cursor-pointer">
                                                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M3 6h18"></path>
                                                        <path d="M8 6V4h8v2"></path>
                                                        <path d="M19 6l-1 14H6L5 6"></path>
                                                        <path d="M10 11v5M14 11v5"></path>
                                                    </svg>
                                                    Eliminar
                                                </button>
                                            </div>
                                        </div>
                                    </article>
                                }
                            </div>
                        }



                        @if (ProfileApp.State.IsAddressEditorOpen)
                        {
                            <div class="fixed inset-0 z-50 flex items-center justify-center bg-stone-950/35 px-4 py-6 backdrop-blur-sm">
                                <div class="w-full max-w-xl rounded-3xl border border-white/70 bg-white p-6 shadow-2xl sm:p-8">

                                    <div class="mb-6 flex items-start justify-between gap-4">
                                        <div>
                                            <h4 class="font-serif text-lg font-bold text-stone-900">
                                                @(ProfileApp.State.EditingAddress.IdDireccion > 0 ? "Editar dirección" : "Nueva dirección")
                                            </h4>

                                            <p class="mt-1 text-[11px] text-stone-500">
                                                Completa los datos reales de entrega.
                                            </p>
                                        </div>

                                        <button @onclick="ProfileApp.CerrarEditorDireccion"
                                                type="button"
                                                class="h-8 w-8 rounded-full bg-stone-100 text-stone-500 hover:bg-stone-200 transition cursor-pointer">
                                            ×
                                        </button>
                                    </div>

                                    <form @onsubmit="SaveAddressAsync"
                                          @onsubmit:preventDefault
                                          class="grid grid-cols-1 gap-4 sm:grid-cols-2">

                                        <div class="space-y-1 sm:col-span-2">
                                            <label class="text-[10px] font-black uppercase text-stone-400 tracking-wider">
                                                Dirección
                                            </label>

                                            <input type="text"
                                                   required
                                                   @bind="ProfileApp.State.EditingAddress.DireccionTexto"
                                                   placeholder="Av., calle, número, departamento"
                                                   class="w-full bg-[#faf6f7]/60 border border-stone-200 focus:border-[#FF76A5] text-xs font-bold rounded-xl px-3.5 py-2.5 transition" />
                                        </div>

                                        <div class="space-y-1">
                                            <label class="text-[10px] font-black uppercase text-stone-400 tracking-wider">
                                                Ciudad
                                            </label>

                                            <input type="text"
                                                   required
                                                   @bind="ProfileApp.State.EditingAddress.Ciudad"
                                                   placeholder="Ciudad"
                                                   class="w-full bg-[#faf6f7]/60 border border-stone-200 focus:border-[#FF76A5] text-xs font-bold rounded-xl px-3.5 py-2.5 transition" />
                                        </div>

                                        <div class="space-y-1">
                                            <label class="text-[10px] font-black uppercase text-stone-400 tracking-wider">
                                                País
                                            </label>

                                            <input type="text"
                                                   @bind="ProfileApp.State.EditingAddress.Pais"
                                                   placeholder="Perú"
                                                   class="w-full bg-[#faf6f7]/60 border border-stone-200 focus:border-[#FF76A5] text-xs font-bold rounded-xl px-3.5 py-2.5 transition" />
                                        </div>

                                        <div class="space-y-1">
                                            <label class="text-[10px] font-black uppercase text-stone-400 tracking-wider">
                                                Código postal
                                            </label>

                                            <input type="text"
                                                   @bind="ProfileApp.State.EditingAddress.CodigoPostal"
                                                   placeholder="Opcional"
                                                   class="w-full bg-[#faf6f7]/60 border border-stone-200 focus:border-[#FF76A5] text-xs font-bold rounded-xl px-3.5 py-2.5 transition" />
                                        </div>

                                        <div class="space-y-1">
                                            <label class="text-[10px] font-black uppercase text-stone-400 tracking-wider">
                                                Referencia
                                            </label>

                                            <input type="text"
                                                   @bind="ProfileApp.State.EditingAddress.Referencia"
                                                   placeholder="Opcional"
                                                   class="w-full bg-[#faf6f7]/60 border border-stone-200 focus:border-[#FF76A5] text-xs font-bold rounded-xl px-3.5 py-2.5 transition" />
                                        </div>

                                        <div class="mt-3 flex justify-end gap-2 sm:col-span-2">
                                            <button type="button"
                                                    @onclick="ProfileApp.CerrarEditorDireccion"
                                                    class="border border-stone-200 bg-white px-4 py-2.5 rounded-xl text-[10px] font-bold uppercase tracking-wider text-stone-500 transition hover:bg-stone-50 cursor-pointer">
                                                Cancelar
                                            </button>

                                            <button type="submit"
                                                    disabled="@ProfileApp.State.IsSavingAddress"
                                                    class="bg-stone-950 hover:bg-[#C7346A] px-5 py-2.5 rounded-xl text-[10px] font-bold uppercase tracking-wider text-white transition cursor-pointer disabled:opacity-60">
                                                @(ProfileApp.State.IsSavingAddress ? "Guardando..." : "Guardar dirección")
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        }

                        @if (ProfileApp.State.AddressPendingDeletion is not null)
                        {
                            <div class="fixed inset-0 z-50 flex items-center justify-center bg-stone-950/35 px-4 py-6 backdrop-blur-sm">
                                <div class="w-full max-w-md rounded-3xl border border-white/70 bg-white p-6 shadow-2xl">
                                    <h4 class="font-serif text-lg font-bold text-stone-900">
                                        ¿Eliminar dirección?
                                    </h4>

                                    <p class="mt-2 text-xs leading-relaxed text-stone-500">
                                        Esta acción eliminará la dirección seleccionada.
                                        @if (ProfileApp.State.AddressPendingDeletion is not null &&
                                                ProfileApp.EsDireccionPrincipal(ProfileApp.State.AddressPendingDeletion))
                                        {
                                            <span class="font-bold text-[#C7346A]">
                                                También dejará de ser tu dirección principal.
                                            </span>
                                        }
                                    </p>

                                    <div class="mt-6 flex justify-end gap-2">
                                        <button @onclick="ProfileApp.CancelarEliminacionDireccion"
                                                class="border border-stone-200 bg-white px-4 py-2.5 rounded-xl text-[10px] font-bold uppercase tracking-wider text-stone-500 hover:bg-stone-50 transition cursor-pointer">
                                            Cancelar
                                        </button>

                                        <button @onclick="DeleteAddressAsync"
                                                disabled="@ProfileApp.State.IsDeletingAddress"
                                                class="bg-red-500 hover:bg-red-600 px-4 py-2.5 rounded-xl text-[10px] font-bold uppercase tracking-wider text-white transition cursor-pointer disabled:opacity-60">
                                            @(ProfileApp.State.IsDeletingAddress ? "Eliminando..." : "Eliminar")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (ProfileApp.State.ActiveTab == "pedidos")
                {
                    var filteredOrders = ProfileApp.State.Orders
                        .Where(IsOrderVisibleByFilter)
                        .OrderBy(GetOrderPriority)
                        .ThenByDescending(order => order.IdPedido)
                        .ToList();

                    <div class="space-y-6 animate-in fade-in duration-300 text-left">
                        <div class="grid grid-cols-1 gap-4 border-b border-stone-100 pb-5 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
                            <div>
                                <p class="text-[9px] font-black uppercase tracking-[0.18em] text-[#C7346A]">
                                    Mi cuenta Lumina
                                </p>

                                <h3 class="mt-2 font-serif text-xl font-semibold text-stone-900">
                                    Historial de pedidos
                                </h3>

                                <p class="mt-1 text-[11px] text-stone-500">
                                    Revisa el estado y total de tus pedidos registrados.
                                </p>
                            </div>

                            <button @onclick="LoadOrdersAsync"
                                    disabled="@ProfileApp.State.IsLoadingOrders"
                                    class="flex h-10 min-w-[132px] items-center justify-center justify-self-start gap-2 rounded-xl border border-stone-200 bg-white px-5 text-[9px] font-black uppercase tracking-wider text-stone-600 transition-all duration-200 hover:-translate-y-0.5 hover:border-[#E6A3B9] hover:bg-[#FFF5F8] hover:text-[#C7346A] hover:shadow-[0_8px_16px_rgba(199,52,106,0.12)] active:translate-y-0 active:scale-[0.97] active:bg-[#FFE5ED] active:shadow-none disabled:cursor-not-allowed disabled:opacity-60 cursor-pointer sm:justify-self-end">
                                <svg class="h-4 w-4 @(ProfileApp.State.IsLoadingOrders ? "animate-spin" : "")"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M20 11a8 8 0 1 1-2.34-5.66"></path>
                                    <path d="M20 4v6h-6"></path>
                                </svg>
                                @(ProfileApp.State.IsLoadingOrders ? "Actualizando..." : "Actualizar")
                            </button>
                        </div>

                        <div class="flex max-w-full gap-2 overflow-x-auto pb-1 sm:flex-wrap sm:overflow-visible">
                            @foreach (var filter in _orderFilters)
                            {
                                var isActiveFilter = _selectedOrderFilter == filter.Key;

                                <button type="button"
                                        @onclick="() => SetOrderFilter(filter.Key)"
                                        class="rounded-full border px-3.5 py-2 text-[9px] font-black uppercase tracking-wider transition-all duration-200 cursor-pointer @(isActiveFilter
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            ? "border-[#D93470] bg-[#D93470] text-white shadow-[0_6px_14px_rgba(217,52,112,0.18)]"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            : "border-stone-200 bg-white text-stone-500 hover:-translate-y-0.5 hover:border-[#F2A9BF] hover:bg-[#FFF5F8] hover:text-[#C7346A] hover:shadow-[0_5px_12px_rgba(199,52,106,0.08)] active:translate-y-0 active:scale-[0.97]")">
                                    @filter.Value
                                </button>
                            }
                        </div>

                        @if (ProfileApp.State.IsLoadingOrders)
                        {
                            <p class="text-xs font-bold text-stone-400">
                                Cargando pedidos...
                            </p>
                        }
                        else if (ProfileApp.State.Orders.Count == 0)
                        {
                            <div class="rounded-2xl border border-dashed border-stone-200 bg-stone-50/70 p-8 text-center">
                                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-white text-[#C7346A] shadow-sm">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M6 7h12l1 13H5L6 7Z"></path>
                                        <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
                                    </svg>
                                </div>

                                <p class="mt-4 text-xs font-bold text-stone-700">
                                    Aún no tienes pedidos registrados.
                                </p>

                                <p class="mt-1 text-[11px] text-stone-500">
                                    Cuando realices una compra, podrás revisar su estado desde aquí.
                                </p>

                                <button @onclick='() => NavigateTo("/")'
                                        class="mt-5 rounded-xl bg-[#FF76A5] px-5 py-2.5 text-[10px] font-bold uppercase tracking-wider text-white transition hover:bg-[#C7346A] cursor-pointer">
                                    Ver catálogo
                                </button>
                            </div>
                        }
                        else if (filteredOrders.Count == 0)
                        {
                            <div class="rounded-2xl border border-dashed border-[#FCD1DB] bg-[#FFF8FA] p-8 text-center">
                                <p class="text-xs font-bold text-stone-700">
                                    No hay pedidos en esta categoría.
                                </p>

                                <button type="button"
                                        @onclick='() => SetOrderFilter("todos")'
                                        class="mt-4 text-[10px] font-black uppercase tracking-wider text-[#C7346A] transition hover:text-[#9E2B55] hover:underline cursor-pointer">
                                    Ver todos los pedidos
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="space-y-4">
                                @foreach (var order in filteredOrders)
                                {
                                    var estadoNormalizado = NormalizeOrderStatus(order.Estado);
                                    var esCancelado = IsCanceledOrder(estadoNormalizado);
                                    var esDevuelto = IsReturnedOrder(estadoNormalizado);
                                    var esEntregado = IsDeliveredOrder(estadoNormalizado);
                                    var esPreparando = IsPreparingOrder(estadoNormalizado);
                                    var esDespachado = IsDispatchedOrder(estadoNormalizado);
                                    var esEnTransito = IsInTransitOrder(estadoNormalizado);
                                    var esVigente = IsActiveOrder(estadoNormalizado);

                                    var estadoClase = esCancelado
                                        ? "border-red-200 bg-red-50 text-red-600"
                                        : esDevuelto
                                            ? "border-slate-200 bg-slate-50 text-slate-600"
                                            : esPreparando
                                                ? "border-amber-200 bg-amber-50 text-amber-700"
                                                : esDespachado || esEnTransito
                                                    ? "border-sky-200 bg-sky-50 text-sky-700"
                                                    : esEntregado
                                                        ? "border-emerald-200 bg-emerald-50 text-emerald-700"
                                                    : "border-stone-200 bg-stone-50 text-stone-600";

                                    var iconoClase = esCancelado
                                        ? "bg-red-50 text-red-500"
                                        : esDevuelto
                                            ? "bg-slate-100 text-slate-500"
                                            : esPreparando
                                                ? "bg-amber-50 text-amber-600"
                                                : esDespachado || esEnTransito
                                                    ? "bg-sky-50 text-sky-600"
                                                    : esEntregado
                                                        ? "bg-emerald-50 text-emerald-600"
                                                    : "bg-stone-100 text-stone-500";

                                    <article class="rounded-2xl border border-stone-200 bg-white/85 p-5 transition hover:border-[#F3C7D5] hover:shadow-sm">
                                        <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
                                            <div class="flex min-w-0 items-start gap-4">
                                                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full @iconoClase">
                                                    @if (esCancelado)
                                                    {
                                                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                                            <circle cx="12" cy="12" r="8"></circle>
                                                            <path d="m9 9 6 6M15 9l-6 6"></path>
                                                        </svg>
                                                    }
                                                    else if (esDevuelto)
                                                    {
                                                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M7 8h10l1 11H6L7 8Z"></path>
                                                            <path d="M10 8V6a2 2 0 0 1 4 0v2"></path>
                                                            <path d="M16 13h4"></path>
                                                            <path d="m18 11 2 2-2 2"></path>
                                                        </svg>
                                                    }
                                                    else if (esEntregado)
                                                    {
                                                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <circle cx="12" cy="12" r="8"></circle>
                                                            <path d="m8.5 12 2.3 2.3 4.8-5"></path>
                                                        </svg>
                                                    }
                                                    else if (esDespachado || esEnTransito)
                                                    {
                                                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M3 7h11v9H3z"></path>
                                                            <path d="M14 10h3l3 3v3h-6z"></path>
                                                            <circle cx="7" cy="18" r="1.5"></circle>
                                                            <circle cx="17" cy="18" r="1.5"></circle>
                                                        </svg>
                                                    }
                                                    else if (esPreparando)
                                                    {
                                                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <circle cx="12" cy="12" r="8"></circle>
                                                            <path d="M12 8v4l2.5 1.5"></path>
                                                        </svg>
                                                    }
                                                    else
                                                    {
                                                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M6 7h12l1 13H5L6 7Z"></path>
                                                            <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
                                                        </svg>
                                                    }
                                                </div>

                                                <div class="min-w-0">
                                                    <p class="text-[9px] font-black uppercase tracking-[0.16em] text-stone-400">
                                                        Pedido
                                                    </p>

                                                    <p class="mt-1 truncate text-base font-bold leading-snug text-stone-900">
                                                        @(string.IsNullOrWhiteSpace(order.CodigoPedido)
                                                            ? $"Pedido #{order.IdPedido}"
                                                            : order.CodigoPedido)
                                                    </p>

                                                    <p class="mt-2 text-[11px] text-stone-500">
                                                        @(order.Detalles.Count == 1 ? "1 producto" : $"{order.Detalles.Count} productos")
                                                    </p>
                                                </div>
                                            </div>

                                            <div class="flex shrink-0 flex-col gap-3 sm:items-end">
                                                <div class="flex items-center gap-3">
                                                    <span class="rounded-full border px-3 py-1.5 text-[9px] font-black uppercase tracking-wider @estadoClase">
                                                        @order.Estado
                                                    </span>

                                                    <p class="text-base font-bold text-stone-900">
                                                        S/ @order.Total.ToString("0.00")
                                                    </p>
                                                </div>

                                                <button @onclick="() => OpenOrderDetailAsync(order)"
                                                        class="flex h-10 min-w-[178px] items-center justify-center gap-2 rounded-xl border border-[#FCD1DB] bg-[#FFF6F8] px-4 text-[9px] font-black uppercase tracking-wider text-[#C7346A] transition-all duration-200 hover:-translate-y-0.5 hover:border-[#F2A9BF] hover:bg-[#FFF0F3] hover:shadow-[0_8px_16px_rgba(199,52,106,0.10)] active:translate-y-0 active:scale-[0.97] active:bg-[#FFE5ED] active:shadow-none cursor-pointer">
                                                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M3 12h18"></path>
                                                        <path d="m13 6 6 6-6 6"></path>
                                                    </svg>
                                                    @(esCancelado || esDevuelto || esEntregado ? "Ver detalle" : "Ver seguimiento")
                                                </button>
                                            </div>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </div>
                }
                else if (ProfileApp.State.ActiveTab == "puntos")
                {
                    <div class="space-y-6 animate-in fade-in duration-300 text-left">
                        <div class="border-b border-stone-100 pb-5">
                            <p class="text-[9px] font-black uppercase tracking-[0.18em] text-[#C7346A]">
                                Mi cuenta Lumina
                            </p>

                            <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                                <div>
                                    <h3 class="font-serif text-xl font-semibold text-stone-900">
                                        Mis puntos Lumina
                                    </h3>

                                    <p class="mt-1 text-[11px] text-stone-500">
                                        Consulta tu saldo actual y el historial real de movimientos.
                                    </p>
                                </div>

                                <span class="w-fit rounded-full border border-[#D8DDE5] bg-[#F5F7FA] px-3 py-1.5 text-[9px] font-black uppercase tracking-wider text-slate-600">
                                    @ProfileApp.State.CurrentClient?.NivelCliente
                                </span>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                            <section class="rounded-2xl border border-[#FCD1DB]/60 bg-[#FFF0F3]/55 p-5">
                                <p class="text-[9px] font-black uppercase tracking-widest text-[#C7346A]">
                                    Saldo disponible
                                </p>

                                <p class="mt-2 font-serif text-3xl font-semibold text-stone-900">
                                    @(ProfileApp.State.CurrentClient?.PuntosFidelidad ?? 0)
                                </p>

                                <p class="mt-1 text-[11px] text-stone-500">
                                    Puntos Lumina acumulados.
                                </p>
                            </section>

                            <section class="rounded-2xl border border-[#D8DDE5] bg-[#F7F8FA] p-5">
                                <p class="text-[9px] font-black uppercase tracking-widest text-slate-500">
                                    Categoría actual
                                </p>

                                <p class="mt-2 font-serif text-3xl font-semibold text-slate-800">
                                    @ProfileApp.State.CurrentClient?.NivelCliente
                                </p>

                                <p class="mt-1 text-[11px] text-stone-500">
                                    Tu nivel se actualiza según tus puntos acumulados.
                                </p>
                            </section>
                        </div>

                        <section class="rounded-2xl border border-stone-200 bg-white/85 p-5">
                            <div class="border-b border-stone-100 pb-4">
                                <p class="text-[10px] font-black uppercase tracking-widest text-[#C7346A]">
                                    Historial de movimientos
                                </p>

                                <p class="mt-1 text-[11px] text-stone-500">
                                    Acumulaciones, canjes y ajustes registrados en tu cuenta.
                                </p>
                            </div>

                            @if (ProfileApp.State.IsLoadingPoints)
                            {
                                <p class="py-8 text-center text-xs font-bold text-stone-400">
                                    Cargando movimientos de puntos...
                                </p>
                            }
                            else if (ProfileApp.State.PointMovements.Count == 0)
                            {
                                <div class="mt-4 rounded-2xl border border-dashed border-[#FCD1DB] bg-[#FFF0F3]/35 p-8 text-center">
                                    <p class="text-xs font-bold text-stone-700">
                                        Aún no tienes movimientos de puntos registrados.
                                    </p>

                                    <p class="mt-1 text-[11px] text-stone-500">
                                        Tus acumulaciones y canjes aparecerán aquí cuando se registren.
                                    </p>
                                </div>
                            }
                            else
                            {
                                <div class="mt-4 space-y-3">
                                    @foreach (var movement in ProfileApp.State.PointMovements)
                                    {
                                        var isPositive = movement.Puntos >= 0;
                                        var movementTone = isPositive
                                            ? "border-emerald-100 bg-emerald-50/40"
                                            : "border-red-100 bg-red-50/40";

                                        var iconTone = isPositive
                                            ? "bg-emerald-100 text-emerald-700"
                                            : "bg-red-100 text-red-600";

                                        var pointsTone = isPositive
                                            ? "border-emerald-200 bg-emerald-50 text-emerald-700"
                                            : "border-red-200 bg-red-50 text-red-600";

                                        <article class="flex flex-col gap-3 rounded-2xl border p-4 @movementTone sm:flex-row sm:items-center sm:justify-between">
                                            <div class="flex min-w-0 items-start gap-3">
                                                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl @iconTone">
                                                    @if (isPositive)
                                                    {
                                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M12 5v14M5 12h14"></path>
                                                        </svg>
                                                    }
                                                    else
                                                    {
                                                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M5 12h14"></path>
                                                        </svg>
                                                    }
                                                </div>

                                                <div class="min-w-0">
                                                    <p class="text-xs font-bold text-stone-800">
                                                        @(string.IsNullOrWhiteSpace(movement.Motivo)
                                                            ? movement.TipoMovimiento
                                                            : movement.Motivo)
                                                    </p>

                                                    <p class="mt-1 text-[10px] font-medium uppercase tracking-wider text-stone-400">
                                                        @movement.TipoMovimiento
                                                        @if (movement.FechaCreacion.HasValue)
                                                        {
                                                            <span> · @movement.FechaCreacion.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                                        }
                                                    </p>

                                                    @if (movement.Pedido is not null && movement.Pedido.IdPedido > 0)
                                                    {
                                                        <p class="mt-1 text-[10px] text-stone-400">
                                                            Pedido relacionado:
                                                            @(string.IsNullOrWhiteSpace(movement.Pedido.CodigoPedido)
                                                                ? $"#{movement.Pedido.IdPedido}"
                                                                : movement.Pedido.CodigoPedido)
                                                        </p>
                                                    }
                                                </div>
                                            </div>

                                            <div class="flex shrink-0 items-center justify-between gap-3 sm:flex-col sm:items-end sm:gap-1">
                                                <span class="rounded-full border px-3 py-1.5 text-[10px] font-black @pointsTone">
                                                    @(isPositive ? "+" : "")@movement.Puntos pts
                                                </span>

                                                <p class="text-[10px] font-medium text-stone-400">
                                                    Saldo: @movement.SaldoPosterior puntos
                                                </p>
                                            </div>
                                        </article>
                                    }
                                </div>
                            }
                        </section>
                    </div>
                }
                else if (ProfileApp.State.ActiveTab == "reclamos")
                {
                    var filteredClaims = ProfileApp.State.Claims
                        .Where(IsClaimVisibleByFilter)
                        .OrderByDescending(claim => claim.FechaCreacion ?? DateTime.MinValue)
                        .ToList();

                    <div class="space-y-6 animate-in fade-in duration-300 text-left">
                        <div class="flex flex-col gap-4 border-b border-stone-100 pb-5 sm:flex-row sm:items-end sm:justify-between">
                            <div>
                                <p class="text-[9px] font-black uppercase tracking-[0.18em] text-[#C7346A]">
                                    Mi cuenta Lumina
                                </p>

                                <h3 class="mt-2 font-serif text-xl font-semibold text-stone-900">
                                    Mis reclamos
                                </h3>

                                <p class="mt-1 text-[11px] text-stone-500">
                                    Registra incidencias y revisa el estado de tus solicitudes.
                                </p>
                            </div>

                            <button type="button"
                                    @onclick="OpenClaimFormAsync"
                                    class="flex h-10 items-center justify-center gap-2 rounded-xl bg-stone-950 px-4 text-[10px] font-bold uppercase tracking-wider text-white transition hover:bg-[#C7346A] hover:shadow-lg hover:shadow-[#FCD1DB] cursor-pointer">
                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 5v14M5 12h14"></path>
                                </svg>
                                Registrar reclamo
                            </button>
                        </div>

                        <div class="flex max-w-full gap-2 overflow-x-auto pb-1 sm:flex-wrap sm:overflow-visible">
                            @foreach (var filter in _claimFilters)
                            {
                                var isActiveFilter = _selectedClaimFilter == filter.Key;

                                <button type="button"
                                        @onclick='() => SetClaimFilter(filter.Key)'
                                        class="shrink-0 rounded-full border px-3.5 py-2 text-[9px] font-black uppercase tracking-wider transition-all duration-200 cursor-pointer @(isActiveFilter
                                                                                                                                                                                                                                                                                                                                    ? "border-[#D93470] bg-[#D93470] text-white shadow-[0_6px_14px_rgba(217,52,112,0.18)]"
                                                                                                                                                                                                                                                                                                                                    : "border-stone-200 bg-white text-stone-500 hover:-translate-y-0.5 hover:border-[#F2A9BF] hover:bg-[#FFF5F8] hover:text-[#C7346A] hover:shadow-[0_5px_12px_rgba(199,52,106,0.08)]")">
                                    @filter.Value
                                </button>
                            }
                        </div>

                        @if (filteredClaims.Count == 0)
                        {
                            <div class="rounded-2xl border border-dashed border-[#FCD1DB] bg-[#FFF8FA] px-6 py-12 text-center">
                                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-white text-[#C7346A] shadow-sm">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"></path>
                                        <path d="M8.5 8h7M8.5 12h7"></path>
                                    </svg>
                                </div>

                                <p class="mt-4 text-xs font-bold text-stone-700">
                                    No tienes reclamos en esta categoría.
                                </p>

                                <button type="button"
                                        @onclick="OpenClaimFormAsync"
                                        class="mt-5 rounded-xl bg-[#FF76A5] px-5 py-2.5 text-[10px] font-bold uppercase tracking-wider text-white transition hover:bg-[#C7346A] cursor-pointer">
                                    Registrar reclamo
                                </button>
                            </div>
                        }
                        else
