    private async Task OpenClaimFormAsync()
    {
        // Mis Pedidos se carga al abrir su pestaña; por eso aquí se asegura
        // la carga antes de construir el selector del reclamo.
        if (ProfileApp.State.Orders.Count == 0)
        {
            var result = await ProfileApp.CargarPedidosAsync();

            if (!result.Success)
            {
                Toast.ShowToast(result.Message);
                return;
            }
        }

        _newClaimOrderCode = string.Empty;
        _newClaimType = "Producto dañado";
        _newClaimSubject = string.Empty;
        _newClaimDescription = string.Empty;
        _newClaimEvidenceNames.Clear();
        _isClaimFormOpen = true;
    }

    private void CloseClaimForm()
    {
        _isClaimFormOpen = false;
    }

    private void HandleEvidenceSelection(ChangeEventArgs args)
    {
        _newClaimEvidenceNames.Clear();

        if (args.Value is not null)
        {
            _newClaimEvidenceNames.Add("Evidencia seleccionada");
        }
    }

    private async Task SubmitClaimAsync()
    {
        if (string.IsNullOrWhiteSpace(_newClaimOrderCode))
        {
            Toast.ShowToast("Selecciona el pedido relacionado.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_newClaimSubject) ||
            string.IsNullOrWhiteSpace(_newClaimDescription))
        {
            Toast.ShowToast("Completa el asunto y el detalle del reclamo.");
            return;
        }

        var pedidoSeleccionado = ProfileApp.State.Orders.FirstOrDefault(order =>
            (string.IsNullOrWhiteSpace(order.CodigoPedido)
                ? $"Pedido #{order.IdPedido}"
                : order.CodigoPedido) == _newClaimOrderCode);

        if (pedidoSeleccionado is null)
        {
            Toast.ShowToast("No se encontró el pedido seleccionado.");
            return;
        }

        var result = await ProfileApp.RegistrarReclamoAsync(
            pedidoSeleccionado.IdPedido,
            _newClaimType,
            _newClaimSubject,
            _newClaimDescription);

        if (!result.Success)
        {
            Toast.ShowToast(result.Message);
            return;
        }

        _isClaimFormOpen = false;
        _newClaimEvidenceNames.Clear();
        Toast.ShowToast(result.Message);
    }

