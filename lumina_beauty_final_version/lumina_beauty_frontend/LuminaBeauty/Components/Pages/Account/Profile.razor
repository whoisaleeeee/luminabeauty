                                        </div>

                                        <div class="space-y-1 sm:col-span-2">
                                            <label class="text-[10px] font-black uppercase tracking-wider text-stone-400">
                                                Detalle del reclamo
                                            </label>
                                            <textarea @bind="_newClaimDescription"
                                                      required
                                                      rows="5"
                                                      maxlength="1000"
                                                      placeholder="Describe el problema con el mayor detalle posible."
                                                      class="w-full resize-none rounded-xl border border-stone-200 bg-white px-3.5 py-3 text-xs font-medium leading-relaxed text-stone-700 outline-none transition placeholder:text-stone-400 focus:border-[#FF76A5] focus:ring-2 focus:ring-[#FCD1DB]/60"></textarea>
                                        </div>

                                        <div class="sm:col-span-2">
                                            <label class="text-[10px] font-black uppercase tracking-wider text-stone-400">
