    private static string NormalizeOrderStatus(string? status)
    {
        return (status ?? string.Empty).Trim().ToUpperInvariant();
    }

    // Estados reales de envio: PREPARANDO, DESPACHADO, EN_TRANSITO,
    // ENTREGADO y DEVUELTO. CANCELADO se mantiene para pedidos cancelados.
    private static bool IsCanceledOrder(string estado)
    {
        return estado == "CANCELADO";
    }

    private static bool IsReturnedOrder(string estado)
    {
        return estado == "DEVUELTO";
    }

    private static bool IsDeliveredOrder(string estado)
    {
        return estado == "ENTREGADO";
    }

    private static bool IsPreparingOrder(string estado)
    {
        return estado == "PREPARANDO";
    }

    private static bool IsDispatchedOrder(string estado)
    {
        return estado == "DESPACHADO";
    }

    private static bool IsInTransitOrder(string estado)
    {
        return estado == "EN_TRANSITO";
    }

    private static bool IsActiveOrder(string estado)
    {
        return IsPreparingOrder(estado)
            || IsDispatchedOrder(estado)
            || IsInTransitOrder(estado);
    }

    private bool IsOrderVisibleByFilter(Pedido order)
    {
        var estado = NormalizeOrderStatus(order.Estado);

        return _selectedOrderFilter switch
        {
            "curso" => IsActiveOrder(estado),
            "entregados" => IsDeliveredOrder(estado),
            "devueltos" => IsReturnedOrder(estado),
            "cancelados" => IsCanceledOrder(estado),
            _ => true
        };
    }

    private static int GetOrderPriority(Pedido order)
    {
        var estado = NormalizeOrderStatus(order.Estado);

        if (IsPreparingOrder(estado)) return 0;
        if (IsDispatchedOrder(estado)) return 1;
        if (IsInTransitOrder(estado)) return 2;
        if (IsDeliveredOrder(estado)) return 3;
        if (IsReturnedOrder(estado)) return 4;
        if (IsCanceledOrder(estado)) return 5;

        return 6;
    }

