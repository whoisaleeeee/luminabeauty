                                            </label>

                                            <label class="mt-2 flex min-h-28 cursor-pointer flex-col items-center justify-center rounded-2xl border border-dashed border-[#F3C7D5] bg-[#FFF8FA] p-4 text-center transition hover:border-[#FF9CBC] hover:bg-[#FFF3F6]">
                                                <svg class="h-5 w-5 text-[#C7346A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                                    <circle cx="8" cy="10" r="1.5"></circle>
                                                    <path d="m3 16 5-5 4 4 3-3 6 6"></path>
                                                </svg>
                                                <span class="mt-2 text-[10px] font-black uppercase tracking-wider text-[#C7346A]">
                                                    Agregar fotos
                                                </span>
                                                <span class="mt-1 text-[10px] text-stone-400">
                                                    Puedes seleccionar una o varias imágenes.
                                                </span>
                                                <input type="file"
                                                       multiple
                                                       accept="image/*"
                                                       class="hidden"
                                                       @onchange="HandleEvidenceSelection" />
                                            </label>

                                            @if (_newClaimEvidenceNames.Count > 0)
                                            {
                                                <div class="mt-3 flex flex-wrap gap-2">
                                                    @foreach (var evidenceName in _newClaimEvidenceNames)
                                                    {
                                                        <span class="rounded-full border border-[#FCD1DB] bg-white px-3 py-1.5 text-[9px] font-bold text-stone-600">
                                                            @evidenceName
                                                        </span>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        <div class="mt-2 flex justify-end gap-2 sm:col-span-2">
                                            <button type="button"
                                                    @onclick="CloseClaimForm"
                                                    class="rounded-xl border border-stone-200 bg-white px-4 py-2.5 text-[10px] font-bold uppercase tracking-wider text-stone-500 transition hover:bg-stone-50 cursor-pointer">
                                                Cancelar
                                            </button>

                                            <button type="submit"
                                                    class="rounded-xl bg-stone-950 px-5 py-2.5 text-[10px] font-bold uppercase tracking-wider text-white transition hover:bg-[#C7346A] hover:shadow-lg hover:shadow-[#FCD1DB] cursor-pointer">
                                                Enviar reclamo
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        }

                        @if (_selectedClaim is not null)
                        {
                            var selectedClaimTone = GetClaimTone(_selectedClaim.Estado);

                            <div class="fixed inset-0 z-50 flex items-center justify-center bg-stone-950/40 px-4 py-6 backdrop-blur-sm">
                                <div class="max-h-[90vh] w-full max-w-xl overflow-y-auto rounded-3xl border border-white/70 bg-white p-6 shadow-2xl">
                                    <div class="flex items-start justify-between gap-4 border-b border-stone-100 pb-5">
                                        <div>
                                            <p class="text-[9px] font-black uppercase tracking-[0.18em] text-[#C7346A]">
                                                @_selectedClaim.Codigo
                                            </p>
                                            <h4 class="mt-2 font-serif text-xl font-semibold text-stone-900">
                                                @_selectedClaim.Asunto
                                            </h4>
                                        </div>

                                        <button type="button"
                                                @onclick="CloseClaimDetail"
                                                class="flex h-8 w-8 items-center justify-center rounded-full bg-stone-100 text-stone-500 transition hover:bg-stone-200 cursor-pointer">
                                            ×
                                        </button>
                                    </div>

                                    <div class="mt-5 space-y-4">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <span class="rounded-full border px-3 py-1.5 text-[9px] font-black uppercase tracking-wider @selectedClaimTone.Badge">
                                                @_selectedClaim.Estado
                                            </span>
                                            <span class="text-[10px] font-medium text-stone-400">
@_selectedClaim.Tipo · @(string.IsNullOrWhiteSpace(_selectedClaim.Pedido?.CodigoPedido)
    ? $"Pedido #{_selectedClaim.Pedido?.IdPedido}"
                                                                                                                                                                                                                                                                            : _selectedClaim.Pedido.CodigoPedido)
                                            </span>
                                        </div>

                                        <div class="rounded-2xl border border-stone-100 bg-stone-50/70 p-4">
                                            <p class="text-[10px] font-black uppercase tracking-wider text-stone-400">
                                                Detalle enviado
                                            </p>
                                            <p class="mt-2 text-xs leading-relaxed text-stone-600">
                                                @_selectedClaim.Descripcion
                                            </p>
                                        </div>

                                        <p class="text-[10px] text-stone-400">
                                            Registrado el @(_selectedClaim.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? "-").
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                else if (ProfileApp.State.ActiveTab == "favoritos")
                {
                    var favoriteProducts = Wishlist.GetWishlist()
                        .Select(id => ProductCache.GetProductById(id))
                        .Where(product => product is not null)
                        .Cast<object>()
                        .ToList();

                    var favoriteCategories = favoriteProducts
                        .Select(GetFavoriteCategory)
                        .Where(category => !string.IsNullOrWhiteSpace(category))
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .OrderBy(category => category)
                        .ToList();

                    var filteredFavoriteProducts = favoriteProducts
                        .Where(product => _selectedFavoriteCategory == "todos"
                            || GetFavoriteCategory(product).Equals(_selectedFavoriteCategory, StringComparison.OrdinalIgnoreCase))
                        .ToList();

                    <div class="space-y-6 animate-in fade-in duration-300 text-left">
                        <div class="border-b border-stone-100 pb-5">
                            <p class="text-[9px] font-black uppercase tracking-[0.18em] text-[#C7346A]">
                                Mi cuenta Lumina
                            </p>

                            <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                                <div>
                                    <h3 class="font-serif text-xl font-semibold text-stone-900">
                                        Mis favoritos
                                    </h3>

                                    <p class="mt-1 text-[11px] text-stone-500">
                                        Productos que guardaste para volver a encontrarlos.
                                    </p>
                                </div>

                                <span class="w-fit rounded-full border border-[#FCD1DB] bg-[#FFF6F8] px-3 py-1.5 text-[9px] font-black uppercase tracking-wider text-[#C7346A]">
                                    @favoriteProducts.Count producto(s)
                                </span>
                            </div>
                        </div>

                        @if (favoriteProducts.Count == 0)
                        {
                            <div class="rounded-2xl border border-dashed border-[#FCD1DB] bg-[#FFF8FA] px-6 py-12 text-center">
                                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-white text-[#C7346A] shadow-sm">
                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.9-8.6a5.5 5.5 0 0 0-.1-7.8Z"></path>
                                    </svg>
                                </div>

                                <p class="mt-4 text-xs font-bold text-stone-700">
                                    Aún no tienes favoritos guardados.
                                </p>

                                <p class="mt-1 text-[11px] text-stone-500">
                                    Guarda productos que quieras revisar o comprar después.
                                </p>

                                <button @onclick='() => NavigateTo("/")'
                                        class="mt-5 rounded-xl bg-[#FF76A5] px-5 py-2.5 text-[10px] font-bold uppercase tracking-wider text-white transition hover:bg-[#C7346A] cursor-pointer">
                                    Ver catálogo
                                </button>
                            </div>
                        }
                        else
                        {
                            @if (favoriteCategories.Count > 1)
                            {
                                <div class="flex max-w-full gap-2 overflow-x-auto pb-1 sm:flex-wrap sm:overflow-visible">
                                    <button type="button"
                                            @onclick='() => SetFavoriteCategory("todos")'
                                            class="shrink-0 rounded-full border px-3.5 py-2 text-[9px] font-black uppercase tracking-wider transition-all duration-200 cursor-pointer @(_selectedFavoriteCategory == "todos"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ? "border-[#D93470] bg-[#D93470] text-white shadow-[0_6px_14px_rgba(217,52,112,0.18)]"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                : "border-stone-200 bg-white text-stone-500 hover:-translate-y-0.5 hover:border-[#F2A9BF] hover:bg-[#FFF5F8] hover:text-[#C7346A] hover:shadow-[0_5px_12px_rgba(199,52,106,0.08)] active:translate-y-0 active:scale-[0.97]")">
                                        Todos
                                    </button>

                                    @foreach (var category in favoriteCategories)
                                    {
                                        var isFavoriteCategoryActive = _selectedFavoriteCategory.Equals(category, StringComparison.OrdinalIgnoreCase);

                                        <button type="button"
                                                @onclick='() => SetFavoriteCategory(category)'
                                                class="shrink-0 rounded-full border px-3.5 py-2 text-[9px] font-black uppercase tracking-wider transition-all duration-200 cursor-pointer @(isFavoriteCategoryActive
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    ? "border-[#D93470] bg-[#D93470] text-white shadow-[0_6px_14px_rgba(217,52,112,0.18)]"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    : "border-stone-200 bg-white text-stone-500 hover:-translate-y-0.5 hover:border-[#F2A9BF] hover:bg-[#FFF5F8] hover:text-[#C7346A] hover:shadow-[0_5px_12px_rgba(199,52,106,0.08)] active:translate-y-0 active:scale-[0.97]")">
                                            @category
                                        </button>
                                    }
                                </div>
                            }

                            @if (filteredFavoriteProducts.Count == 0)
                            {
                                <div class="rounded-2xl border border-dashed border-[#FCD1DB] bg-[#FFF8FA] p-8 text-center">
                                    <p class="text-xs font-bold text-stone-700">
                                        No tienes favoritos en esta categoría.
                                    </p>

                                    <button type="button"
                                            @onclick='() => SetFavoriteCategory("todos")'
                                            class="mt-4 text-[10px] font-black uppercase tracking-wider text-[#C7346A] transition hover:text-[#9E2B55] hover:underline cursor-pointer">
                                        Ver todos los favoritos
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                                    @foreach (dynamic p in filteredFavoriteProducts)
                                    {
                                        <article class="group relative flex min-h-[285px] flex-col overflow-hidden rounded-2xl border border-stone-200 bg-white p-3.5 transition-all duration-200 hover:-translate-y-0.5 hover:border-[#F2A9BF] hover:shadow-[0_12px_24px_rgba(199,52,106,0.10)]">
                                            <button type="button"
                                                    @onclick='async () => await RemoveFromFavorites(p.Id.ToString())'
                                                    class="absolute right-5 top-5 z-10 flex h-8 w-8 items-center justify-center rounded-full border border-[#F3C7D5] bg-[#FFF5F8] text-[#D93470] shadow-sm transition-all duration-200 hover:scale-105 hover:border-red-200 hover:bg-red-50 hover:text-red-500 hover:shadow-[0_6px_14px_rgba(239,68,68,0.14)] active:scale-95 cursor-pointer"
                                                    title="Quitar de favoritos"
                                                    aria-label="Quitar de favoritos">
                                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.7">
                                                    <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.9-8.6a5.5 5.5 0 0 0-.1-7.8Z"></path>
                                                </svg>
                                            </button>

                                            <button type="button"
                                                    @onclick='() => NavigateTo($"/product/{p.Id}")'
                                                    class="flex aspect-square items-center justify-center overflow-hidden rounded-xl bg-stone-50/70 p-5 cursor-pointer">
                                                <img src="@p.Image"
                                                     alt="@p.Name"
                                                     class="max-h-full max-w-full object-contain transition duration-300 group-hover:scale-105"
                                                     referrerpolicy="no-referrer" />
                                            </button>

                                            <div class="flex flex-1 flex-col pt-3">
                                                <div class="flex items-center justify-between gap-2">
                                                    <span class="truncate text-[8px] font-black uppercase tracking-wider text-[#B77943]">
                                                        @p.Brand
                                                    </span>

                                                    <span class="shrink-0 rounded-full bg-[#FFF4E8] px-2 py-1 text-[8px] font-bold text-[#A6602D]">
                                                        @GetFavoriteCategory(p)
                                                    </span>
                                                </div>

                                                <button type="button"
                                                        @onclick='() => NavigateTo($"/product/{p.Id}")'
                                                        class="mt-1.5 line-clamp-2 text-left text-xs font-bold leading-relaxed text-stone-800 transition hover:text-[#C7346A] cursor-pointer">
                                                    @p.Name
                                                </button>

                                                <p class="mt-auto pt-3 text-sm font-bold text-[#C7346A]">
                                                    S/ @p.Price.ToString("0.00")
                                                </p>
                                            </div>
                                        </article>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </div>

            @if (ProfileApp.State.IsOrderDetailOpen &&
                ProfileApp.State.SelectedOrder is not null)
            {
                var selectedOrder = ProfileApp.State.SelectedOrder;
                var shipment = ProfileApp.State.SelectedOrderShipment;
                var shipmentState = (shipment?.Estado ?? string.Empty).Trim().ToUpperInvariant();

                var shipmentIsCancelled = shipmentState.Contains("CANCEL");
                var shipmentIsProcessing = shipmentState.Contains("PROCES") || shipmentState.Contains("PREPAR");
                var shipmentIsDelivered = shipmentState.Contains("ENTREG");
                var shipmentIsMoving = shipmentState.Contains("PEND")
                    || shipmentState.Contains("ENVI")
                    || shipmentState.Contains("DESPACH")
                    || shipmentState.Contains("TRANSIT");

                var shipmentSectionClass = shipmentIsCancelled
                    ? "border-red-200 bg-red-50/55"
                    : shipmentIsProcessing
                        ? "border-amber-200 bg-amber-50/55"
                        : shipmentIsMoving || shipmentIsDelivered
                            ? "border-emerald-200 bg-emerald-50/45"
                            : "border-[#FCD1DB]/60 bg-[#FFF0F3]/35";

                var shipmentAccentClass = shipmentIsCancelled
                    ? "text-red-600"
                    : shipmentIsProcessing
                        ? "text-amber-700"
                        : shipmentIsMoving || shipmentIsDelivered
                            ? "text-emerald-700"
                            : "text-[#C7346A]";

                var shipmentBadgeClass = shipmentIsCancelled
                    ? "border-red-200 bg-red-50 text-red-600"
                    : shipmentIsProcessing
                        ? "border-amber-200 bg-amber-50 text-amber-700"
                        : shipmentIsMoving || shipmentIsDelivered
                            ? "border-emerald-200 bg-emerald-50 text-emerald-700"
                            : "border-[#FCD1DB] bg-[#FFF0F3] text-[#C7346A]";

                <div class="fixed inset-0 z-50 flex items-center justify-center bg-stone-950/40 px-4 py-6 backdrop-blur-sm">
                    <div class="max-h-[90vh] w-full max-w-3xl overflow-y-auto rounded-3xl border border-white/70 bg-white p-6 shadow-2xl sm:p-8">

                        <div class="flex items-start justify-between gap-4 border-b border-stone-100 pb-5">
                            <div>
                                <p class="text-[10px] font-black uppercase tracking-widest text-[#C7346A]">
                                    Pedido
                                </p>

                                <h3 class="mt-1 font-serif text-xl font-semibold text-stone-900">
                                    @(string.IsNullOrWhiteSpace(selectedOrder.CodigoPedido)
                                        ? $"Pedido #{selectedOrder.IdPedido}"
                                        : selectedOrder.CodigoPedido)
                                </h3>

                                <p class="mt-1 text-[11px] text-stone-500">
                                    Detalle de compra y estado de entrega.
                                </p>
                            </div>

                            <button @onclick="ProfileApp.CerrarDetallePedido"
                                    class="flex h-9 w-9 items-center justify-center rounded-full bg-stone-100 text-lg text-stone-500 transition hover:bg-stone-200 cursor-pointer"
                                    title="Cerrar">
                                ×
                            </button>
                        </div>

                        @if (ProfileApp.State.IsLoadingOrderDetail)
                        {
                            <p class="py-12 text-center text-xs font-bold text-stone-400">
                                Cargando detalle y seguimiento...
                            </p>
                        }
                        else
                        {
                            <div class="mt-6 space-y-6">
                                <section class="rounded-2xl border p-5 @shipmentSectionClass">
                                    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                                        <div class="min-w-0">
                                            <p class="text-[10px] font-black uppercase tracking-widest @shipmentAccentClass">
                                                Estado del envío
                                            </p>

                                            <p class="mt-2 inline-flex rounded-full border px-3 py-1.5 text-sm font-black uppercase tracking-wider @shipmentBadgeClass">
                                                @(shipment is null ? "Envío aún no registrado" : shipment.Estado)
                                            </p>
                                        </div>

                                        @if (shipment is not null &&
                                             !string.IsNullOrWhiteSpace(shipment.NumeroSeguimiento))
                                        {
                                            <div class="rounded-xl border border-white/80 bg-white/85 px-4 py-3 shadow-sm">
                                                <p class="text-[8px] font-black uppercase tracking-widest text-stone-400">
                                                    Código de seguimiento
                                                </p>

                                                <p class="mt-1 text-xs font-bold @shipmentAccentClass">
                                                    @shipment.NumeroSeguimiento
                                                </p>
                                            </div>
                                        }
                                    </div>

                                    @if (shipment is not null)
                                    {
                                        <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-3">
                                            <div class="rounded-xl border border-white/70 bg-white/85 p-3">
                                                <p class="text-[8px] font-black uppercase tracking-wider text-stone-400">Preparando</p>
                                                <p class="mt-1 text-[10px] font-bold @(shipmentIsProcessing ? shipmentAccentClass : "text-stone-700")">
                                                    @(shipmentIsProcessing ? "Estado actual" : "Registrado")
                                                </p>
                                            </div>

                                            <div class="rounded-xl border border-white/70 bg-white/85 p-3">
                                                <p class="text-[8px] font-black uppercase tracking-wider text-stone-400">En tránsito</p>
                                                <p class="mt-1 text-[10px] font-bold @(shipmentIsMoving || shipmentIsDelivered ? shipmentAccentClass : "text-stone-400")">
                                                    @if (shipment.FechaEnvio.HasValue)
                                                    {
                                                        @shipment.FechaEnvio.Value.ToString("dd/MM/yyyy HH:mm")
                                                    }
                                                    else
                                                    {
                                                        <span>Pendiente</span>
                                                    }
                                                </p>
                                            </div>

                                            <div class="rounded-xl border border-white/70 bg-white/85 p-3">
                                                <p class="text-[8px] font-black uppercase tracking-wider text-stone-400">Entrega</p>
                                                <p class="mt-1 text-[10px] font-bold @(shipmentIsDelivered ? shipmentAccentClass : "text-stone-400")">
                                                    @if (shipment.FechaEntregaReal.HasValue)
                                                    {
                                                        @shipment.FechaEntregaReal.Value.ToString("dd/MM/yyyy HH:mm")
                                                    }
                                                    else if (shipment.FechaEntregaEstimada.HasValue)
                                                    {
                                                        <span>Estimada: @shipment.FechaEntregaEstimada.Value.ToString("dd/MM/yyyy")</span>
                                                    }
                                                    else
                                                    {
                                                        <span>Pendiente</span>
                                                    }
                                                </p>
                                            </div>
                                        </div>

                                        <div class="mt-5 rounded-xl border border-white/80 bg-white/85 p-4 shadow-sm">
                                            <p class="text-[9px] font-black uppercase tracking-widest text-stone-400">Dirección de entrega</p>
                                            <p class="mt-2 text-xs font-semibold text-stone-800">@shipment.DireccionEnvio</p>
                                            <p class="mt-1 text-[11px] text-stone-500">
                                                @shipment.CiudadEnvio, @shipment.PaisEnvio
                                                @if (!string.IsNullOrWhiteSpace(shipment.CodigoPostalEnvio))
                                                {
                                                    <span> · @shipment.CodigoPostalEnvio</span>
                                                }
                                            </p>
                                            @if (!string.IsNullOrWhiteSpace(shipment.ReferenciaEnvio))
                                            {
                                                <p class="mt-1 text-[11px] text-stone-400">Referencia: @shipment.ReferenciaEnvio</p>
                                            }
                                        </div>
                                    }
                                </section>

                                <section>
                                    <div class="flex items-center justify-between border-b border-stone-100 pb-3">
                                        <h4 class="text-[10px] font-black uppercase tracking-widest text-[#C7346A]">Productos del pedido</h4>
                                        <span class="text-[10px] font-bold text-stone-400">@selectedOrder.Detalles.Count producto(s)</span>
                                    </div>

                                    <div class="mt-4 space-y-3">
                                        @foreach (var detail in selectedOrder.Detalles)
                                        {
                                            <div class="flex items-center justify-between gap-4 rounded-xl border border-stone-100 bg-stone-50/60 p-4">
                                                <div>
                                                    <p class="text-xs font-bold text-stone-800">
                                                        @(string.IsNullOrWhiteSpace(detail.NombreProducto)
                                                            ? detail.Producto?.Nombre ?? "Producto"
                                                            : detail.NombreProducto)
                                                    </p>
                                                    <p class="mt-1 text-[10px] text-stone-500">
                                                        Cantidad: @detail.Cantidad · S/ @detail.PrecioUnitario.ToString("0.00")
                                                    </p>
                                                </div>
                                                <p class="text-xs font-bold text-stone-900">S/ @detail.Subtotal.ToString("0.00")</p>
                                            </div>
                                        }
                                    </div>
                                </section>

                                <section class="rounded-2xl border border-stone-100 bg-stone-50/70 p-5">
                                    <div class="space-y-2 text-xs">
                                        <div class="flex justify-between text-stone-500">
                                            <span>Subtotal</span>
                                            <span>S/ @selectedOrder.SubtotalProductos.ToString("0.00")</span>
                                        </div>
                                        <div class="flex justify-between text-stone-500">
                                            <span>Envío</span>
                                            <span>S/ @selectedOrder.CostoEnvio.ToString("0.00")</span>
                                        </div>
                                        @if (selectedOrder.Descuento > 0)
                                        {
                                            <div class="flex justify-between text-[#C7346A]">
                                                <span>Descuento</span>
                                                <span>- S/ @selectedOrder.Descuento.ToString("0.00")</span>
                                            </div>
                                        }
                                        <div class="flex justify-between border-t border-stone-200 pt-3 text-sm font-bold text-stone-900">
                                            <span>Total pagado</span>
                                            <span>S/ @selectedOrder.Total.ToString("0.00")</span>
                                        </div>
                                    </div>
                                </section>
                            </div>
                        }
                    </div>
                </div>
            }

        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private bool _profileInitialized;

    private bool _isDeactivateAccountOpen;
    private bool _isDeactivatingAccount;
    private string _deactivationConfirmation = string.Empty;

    private bool CanDeactivateAccount =>
        string.Equals(
            _deactivationConfirmation?.Trim(),
            "DESACTIVAR",
            StringComparison.OrdinalIgnoreCase
        );


    private string _selectedFavoriteCategory = "todos";

    private void SetFavoriteCategory(string category)
    {
        _selectedFavoriteCategory = string.IsNullOrWhiteSpace(category)
            ? "todos"
            : category;
    }

    private async Task RemoveFromFavorites(string productId)
    {
        await Wishlist.ToggleWishlistAsync(productId);

        var remainingCategories = Wishlist.GetWishlist()
            .Select(id => ProductCache.GetProductById(id))
            .Where(product => product is not null)
            .Cast<object>()
            .Select(GetFavoriteCategory)
            .ToList();

        if (_selectedFavoriteCategory != "todos"
            && !remainingCategories.Any(category =>
                category.Equals(_selectedFavoriteCategory, StringComparison.OrdinalIgnoreCase)))
        {
            _selectedFavoriteCategory = "todos";
        }

        Toast.ShowToast("Producto eliminado de favoritos.");
    }

    private static string GetFavoriteCategory(object product)
    {
        var type = product.GetType();

        foreach (var propertyName in new[] { "Categoria", "Category", "NombreCategoria", "CategoryName" })
        {
            var property = type.GetProperty(propertyName);

            if (property?.GetValue(product) is not null)
            {
                var value = property.GetValue(product)?.ToString()?.Trim();

                if (!string.IsNullOrWhiteSpace(value))
                {
                    return value;
                }
            }
        }

        return "Otros";
    }

