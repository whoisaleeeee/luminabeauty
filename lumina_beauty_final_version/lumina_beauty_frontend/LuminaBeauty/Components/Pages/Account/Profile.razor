                                                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"></path>
                                                        <path d="M8.5 8h7M8.5 12h7M8.5 16h4"></path>
                                                    </svg>
                                                </div>

                                                <div class="min-w-0">
                                                    <div class="flex flex-wrap items-center gap-2">
                                                        <p class="text-[9px] font-black uppercase tracking-[0.16em] text-stone-400">
                                                            @claim.Codigo
                                                        </p>

                                                        <span class="rounded-full border px-2.5 py-1 text-[8px] font-black uppercase tracking-wider @claimTone.Badge">
                                                            @claim.Estado
                                                        </span>
                                                    </div>

                                                    <p class="mt-1 text-sm font-bold text-stone-900">
                                                        @claim.Asunto
                                                    </p>

                                                    <p class="mt-1 text-[11px] text-stone-500">
@claim.Tipo · @(string.IsNullOrWhiteSpace(claim.Pedido?.CodigoPedido)
    ? $"Pedido #{claim.Pedido?.IdPedido}"
                                                                                                                                                                                                                                                                                                                            : claim.Pedido.CodigoPedido) · @(claim.FechaCreacion?.ToString("dd/MM/yyyy") ?? "-")
                                                    </p>
                                                </div>
                                            </div>

                                            <button type="button"
                                                    @onclick='() => OpenClaimDetail(claim)'
                                                    class="flex h-10 min-w-[132px] items-center justify-center gap-2 rounded-xl border border-[#FCD1DB] bg-[#FFF6F8] px-4 text-[9px] font-black uppercase tracking-wider text-[#C7346A] transition-all duration-200 hover:-translate-y-0.5 hover:border-[#F2A9BF] hover:bg-[#FFF0F3] hover:shadow-[0_8px_16px_rgba(199,52,106,0.10)] cursor-pointer">
                                                Ver detalle
                                            </button>
                                        </div>
                                    </article>
                                }
                            </div>
                        }

                        @if (_isClaimFormOpen)
