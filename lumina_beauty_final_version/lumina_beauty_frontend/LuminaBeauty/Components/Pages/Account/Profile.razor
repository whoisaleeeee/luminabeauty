    protected override async Task OnInitializedAsync()
    {
        await ProductCache.EnsureLoadedAsync();

        LangService.OnChange += StateHasChanged;
        Wishlist.OnChange += StateHasChanged;
        Auth.OnChange += StateHasChanged;

        var result = await ProfileApp.InitializeAsync(Auth.CurrentClient);

        if (!result.Success)
        {
            Toast.ShowToast(result.Message);
            return;
        }

        _profileInitialized = true;
        await ApplyQueryTabAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_profileInitialized)
        {
            await ApplyQueryTabAsync();
        }
    }

    private async Task ApplyQueryTabAsync()
    {
        var requestedTab = Tab?.Trim().ToLowerInvariant();

        if (requestedTab is not ("pedidos" or "reclamos"))
        {
            return;
        }

        if (ProfileApp.State.ActiveTab == requestedTab)
        {
            return;
        }

        await ProfileApp.SetActiveTabAsync(requestedTab);
    }

