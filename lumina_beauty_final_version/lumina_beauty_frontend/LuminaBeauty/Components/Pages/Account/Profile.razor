    private void OpenDeactivateAccountModal()
    {
        _deactivationConfirmation = string.Empty;
        _isDeactivateAccountOpen = true;
    }

    private void CloseDeactivateAccountModal()
    {
        if (_isDeactivatingAccount)
        {
            return;
        }

        _deactivationConfirmation = string.Empty;
        _isDeactivateAccountOpen = false;
    }

    private async Task DeactivateAccountAsync()
    {
        if (!CanDeactivateAccount)
        {
            Toast.ShowToast("Escribe DESACTIVAR para confirmar.");
            return;
        }

        int idCliente = ProfileApp.State.CurrentClient?.Id ?? 0;

        if (idCliente <= 0)
        {
            Toast.ShowToast("No se encontró una cuenta válida.");
            return;
        }

        try
        {
            _isDeactivatingAccount = true;

            bool desactivada = await ClienteRest.DesactivarCuentaAsync(idCliente);

            if (!desactivada)
            {
                Toast.ShowToast("No se pudo desactivar la cuenta.");
                return;
            }

            await Auth.LogoutAsync();
            Toast.ShowToast("Tu cuenta fue desactivada correctamente.");
            Navigator.NavigateTo("/");
        }
        finally
        {
            _isDeactivatingAccount = false;
        }
    }

    private async Task LogOff()
    {
        await Auth.LogoutAsync();
        Toast.ShowToast("Sesión cerrada correctamente.");
        Navigator.NavigateTo("/");
    }

