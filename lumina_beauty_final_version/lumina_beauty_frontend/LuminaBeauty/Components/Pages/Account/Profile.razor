                                                <option value="">Selecciona un pedido</option>
                                                @foreach (var order in ProfileApp.State.Orders)
                                                {
                                                    <option value="@(string.IsNullOrWhiteSpace(order.CodigoPedido) ? $"Pedido #{order.IdPedido}" : order.CodigoPedido)">
                                                        @(string.IsNullOrWhiteSpace(order.CodigoPedido) ? $"Pedido #{order.IdPedido}" : order.CodigoPedido)
                                                    </option>
                                                }
                                            </select>
                                        </div>

                                        <div class="space-y-1">
                                            <label class="text-[10px] font-black uppercase tracking-wider text-stone-400">
