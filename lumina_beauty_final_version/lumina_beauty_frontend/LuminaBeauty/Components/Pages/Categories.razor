@page "/categories"
@inject LanguageService LangService
@inject ToastService Toast
@inject NavigationManager Navigator
@implements IDisposable

<PageTitle>Categorías | Lumina Beauty</PageTitle>

<div id="categories-workspace" class="max-w-6xl mx-auto w-full space-y-8 text-left">
    
    <!-- Breadcrumbs -->
    <div id="categories-breadcrumbs" class="text-left text-[11px] sm:text-xs font-semibold text-stone-400 uppercase tracking-widest mb-4 flex items-center gap-1.5 select-none">
        <span class="hover:text-[#FF76A5] cursor-pointer transition" @onclick="GoHome">
          Inicio
        </span>
        <span>/</span>
        <span class="text-[#FF76A5] font-bold">Categorías</span>
    </div>

    <!-- Luxury Header Section -->
    <div class="text-center max-w-xl mx-auto space-y-2 select-none pb-4">
        <span class="text-[9px] font-black uppercase tracking-widest text-[#C7346A] bg-[#FFF0F3] px-3.5 py-1 rounded-full border border-[#FF76A5]/20">
          COMPRAR POR CATEGORÍA
        </span>
        <h1 class="font-serif text-3xl sm:text-4xl font-light tracking-tight text-stone-950 pt-2">
          Colecciones Lumina
        </h1>
        <p class="text-[11px] sm:text-xs text-stone-500 font-bold tracking-wide">
          @(LangService.CurrentLanguage == "es" 
            ? "Fórmulas de prestigio elaboradas para revelar tu propia luz." 
            : "Prestige formulations crafted to unveil your inner radiance.")
        </p>
    </div>

    <!-- Categories Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 pt-2 select-none">
        @foreach (var cat in _categoryCards)
        {
          var name = LangService.CurrentLanguage == "es" ? cat.NameEs : cat.NameEn;
          <div @onclick="() => BrowseCategory(cat.OriginalName, name)"
               class="group relative overflow-hidden rounded-3xl border border-[#FCD1DB]/50 shadow-xs hover:shadow-xl hover:border-[#FF76A5]/50 transition-all duration-500 flex flex-col justify-end aspect-[4/5] bg-stone-50 cursor-pointer">
              
              <!-- Background image filler -->
              <img src="@cat.Image" alt="@name" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 pointer-events-none" />

              <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-stone-950/40 via-stone-950/15 to-transparent pointer-events-none" />

              <!-- Info panel overlay -->
              <div class="relative z-10 m-4 p-5 bg-white/70 backdrop-blur-md rounded-2xl border border-white/40 flex items-center justify-between group-hover:bg-white/85 group-hover:-translate-y-1 transition-all duration-300">
                <div class="space-y-0.5">
                  <h3 class="font-serif text-base sm:text-lg font-bold text-stone-950 tracking-tight group-hover:text-[#C7346A] transition-colors leading-tight">
                    @name
                  </h3>
                  <p class="text-[9px] font-black uppercase tracking-widest text-[#C7346A] font-sans">
                    @cat.Count @(LangService.CurrentLanguage == "es" ? "productos" : "products")
                  </p>
                </div>
                <div class="w-8 h-8 rounded-full bg-[#FFF0F3] text-[#C7346A] group-hover:bg-[#FF76A5] group-hover:text-white flex items-center justify-center transition-all duration-300 shrink-0 shadow-xs text-xs">
                  ➔
                </div>
              </div>
          </div>
        }
    </div>

</div>

@code {
    public class CategoryCardItem
    {
        public string Id { get; set; } = string.Empty;
        public string OriginalName { get; set; } = string.Empty;
        public string NameEs { get; set; } = string.Empty;
        public string NameEn { get; set; } = string.Empty;
        public int Count { get; set; }
        public string Image { get; set; } = string.Empty;
    }

    private readonly List<CategoryCardItem> _categoryCards = new()
    {
        new CategoryCardItem
        {
            Id = "skincare",
            OriginalName = "Skincare",
            NameEs = "Cuidado de la Piel",
            NameEn = "Skincare",
            Count = 124,
            Image = "https://images.unsplash.com/photo-1608248597481-496100c8c836?q=80&w=600&auto=format&fit=crop",
        },
        new CategoryCardItem
        {
            Id = "makeup",
            OriginalName = "Makeup",
            NameEs = "Maquillaje de Lujo",
            NameEn = "Makeup",
            Count = 98,
            Image = "https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?q=80&w=600&auto=format&fit=crop",
        },
        new CategoryCardItem
        {
            Id = "fragrances",
            OriginalName = "Fragrance",
            NameEs = "Perfumería de Autor",
            NameEn = "Fragrances",
            Count = 42,
            Image = "https://images.unsplash.com/photo-1547887537-6158d64c35b3?q=80&w=600&auto=format&fit=crop",
        },
        new CategoryCardItem
        {
            Id = "hair",
            OriginalName = "Hair",
            NameEs = "Cuidado Capilar",
            NameEn = "Hair Care",
            Count = 56,
            Image = "https://images.unsplash.com/photo-1535585209827-a15fcdbc4c2d?q=80&w=600&auto=format&fit=crop",
        },
        new CategoryCardItem
        {
            Id = "bath_body",
            OriginalName = "Bath & Body",
            NameEs = "Cuerpo y Baño",
            NameEn = "Body Care",
            Count = 37,
            Image = "https://images.unsplash.com/photo-1556228720-195a672e8a03?q=80&w=600&auto=format&fit=crop",
        },
        new CategoryCardItem
        {
            Id = "tools",
            OriginalName = "Tools & Brushes",
            NameEs = "Herramientas de Belleza",
