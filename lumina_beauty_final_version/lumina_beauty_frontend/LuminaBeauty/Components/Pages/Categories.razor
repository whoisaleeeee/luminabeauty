            Count = 25,
            Image = "https://images.unsplash.com/photo-1596462502278-27bfdc403348?q=80&w=600&auto=format&fit=crop",
        }
    };

    protected override void OnInitialized()
    {
        LangService.OnChange += StateHasChanged;
    }

    private void GoHome()
    {
        Navigator.NavigateTo("/");
    }

    private void BrowseCategory(string originalName, string label)
    {
        Navigator.NavigateTo($"/category/{Uri.EscapeDataString(originalName)}");
        Toast.ShowToast(LangService.CurrentLanguage == "es" ? $"Mostrando colección de {label}" : $"Showing catalog for {label}");
    }

    public void Dispose()
    {
        LangService.OnChange -= StateHasChanged;
    }
}
