@inject ProductService ProductCache
@inject NavigationManager Navigator

<section class="rounded-3xl border border-white/70 bg-white/35 p-6 shadow-[0_14px_45px_rgba(120,72,92,0.08)] backdrop-blur-xl md:p-8">
    <div class="mb-7 flex items-end justify-between border-b border-white/60 pb-5">
        <div>
            <span class="block text-[10px] font-semibold uppercase tracking-[0.18em] text-[#C7346A]">
                Recién llegados
            </span>

            <h2 class="mt-2 font-serif text-2xl font-semibold text-stone-800 md:text-3xl">
                Novedades
            </h2>

            <p class="mt-2 text-xs text-stone-500">
                Descubre los últimos esenciales incorporados a Lumina Beauty.
            </p>
        </div>

        <button type="button"
                @onclick='() => Navigator.NavigateTo("/shop")'
                class="hidden cursor-pointer items-center gap-1 text-xs font-semibold text-[#FF76A5] transition hover:text-[#C7346A] sm:flex">
            Ver tienda
            <span>→</span>
        </button>
    </div>

    @{
        var products = ProductCache.GetNewArrivals();
        var featured = products.FirstOrDefault();
        var secondaryProducts = products.Skip(1).Take(3).ToList();
    }

    @if (featured is not null)
    {
        <div class="grid grid-cols-1 gap-5 lg:grid-cols-12">
            <article class="relative overflow-hidden rounded-3xl border border-white/70 bg-gradient-to-br from-[#FFF6F8]/85 via-white/80 to-[#FBEFF3]/75 p-6 shadow-sm lg:col-span-5">
                <div class="absolute -right-12 -top-12 h-44 w-44 rounded-full bg-[#FFB7CA]/20 blur-3xl"></div>

                <div class="relative flex h-full flex-col">
                    <span class="w-fit rounded-full border border-[#FCD1DB] bg-white/50 px-3 py-1 text-[9px] font-semibold uppercase tracking-[0.13em] text-[#C7346A] backdrop-blur-sm">
                        Nueva incorporación
                    </span>

                    <button type="button"
                            @onclick='() => Navigator.NavigateTo($"/product/{featured.Id}")'
                            class="mt-5 flex h-[230px] cursor-pointer items-center justify-center overflow-hidden rounded-2xl bg-white/55 p-6">
                        <img src="@featured.Image"
                             alt="@featured.Name"
                             class="h-full w-full object-contain transition-transform duration-500 hover:scale-105" />
                    </button>

                    <div class="mt-5">
                        <span class="text-[9px] font-semibold uppercase tracking-[0.15em] text-[#c5a880]">
                            @featured.Brand
                        </span>

                        <button type="button"
                                @onclick='() => Navigator.NavigateTo($"/product/{featured.Id}")'
                                class="mt-2 block cursor-pointer bg-transparent p-0 text-left font-serif text-2xl font-semibold leading-tight text-stone-800 transition hover:text-[#C7346A]">
                            @featured.Name
                        </button>

                        <p class="mt-3 line-clamp-2 text-xs leading-relaxed text-stone-500">
                            @featured.Description
                        </p>

                        <div class="mt-5 flex items-center justify-between border-t border-white/80 pt-4">
                            <span class="font-mono text-lg font-semibold text-stone-900">
                                S/ @featured.Price.ToString("0.00")
                            </span>

                            <button type="button"
                                    @onclick='() => Navigator.NavigateTo($"/product/{featured.Id}")'
                                    class="cursor-pointer rounded-xl bg-stone-900 px-4 py-2.5 text-[9px] font-semibold uppercase tracking-[0.1em] text-white transition hover:bg-[#C7346A]">
                                Descubrir
                            </button>
                        </div>
                    </div>
                </div>
            </article>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-3 lg:col-span-7 lg:grid-cols-1">
                @foreach (var product in secondaryProducts)
                {
                    <article class="group flex min-h-[170px] gap-4 rounded-3xl border border-white/70 bg-white/45 p-4 shadow-sm backdrop-blur-sm transition hover:-translate-y-0.5 hover:bg-white/65 hover:shadow-md">
                        <button type="button"
                                @onclick='() => Navigator.NavigateTo($"/product/{product.Id}")'
                                class="flex h-28 w-28 shrink-0 cursor-pointer items-center justify-center overflow-hidden rounded-2xl bg-[#FFF7F9] p-3">
                            <img src="@product.Image"
                                 alt="@product.Name"
                                 class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105" />
                        </button>

                        <div class="flex min-w-0 flex-1 flex-col justify-between py-1">
                            <div>
                                <div class="flex items-center justify-between gap-2">
                                    <span class="text-[8px] font-semibold uppercase tracking-[0.14em] text-[#c5a880]">
                                        @product.Brand
                                    </span>

                                    <span class="rounded-full bg-[#FFF0F3] px-2 py-1 text-[8px] font-semibold text-[#C7346A]">
                                        Nuevo
                                    </span>
                                </div>

                                <button type="button"
                                        @onclick='() => Navigator.NavigateTo($"/product/{product.Id}")'
                                        class="mt-2 line-clamp-2 cursor-pointer bg-transparent p-0 text-left font-serif text-lg font-semibold leading-tight text-stone-800 transition hover:text-[#C7346A]">
                                    @product.Name
                                </button>

                                <p class="mt-2 line-clamp-1 text-[11px] text-stone-500">
                                    @product.Category
                                </p>
                            </div>

                            <div class="mt-3 flex items-center justify-between">
                                <span class="font-mono text-sm font-semibold text-stone-900">
                                    S/ @product.Price.ToString("0.00")
                                </span>

                                <button type="button"
                                        @onclick='() => Navigator.NavigateTo($"/product/{product.Id}")'
                                        class="cursor-pointer text-[9px] font-semibold uppercase tracking-[0.1em] text-[#C7346A] transition hover:text-stone-900">
                                    Ver →
                                </button>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </div>
    }
    else
    {
        <div class="rounded-3xl border border-white/70 bg-white/35 py-14 text-center">
            <p class="text-sm text-stone-400">
                Aún no hay novedades disponibles.
            </p>
        </div>
    }
</section>