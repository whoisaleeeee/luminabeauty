@using SoluLumina.Models
@using Microsoft.AspNetCore.Components

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }
    [Parameter] public Producto Product { get; set; } = new();
    [Parameter] public EventCallback<Producto> OnProductUpdated { get; set; }
    [Parameter] public List<CategoriaProducto> Categorias { get; set; } = new();
    [Parameter] public List<Marca> Marcas { get; set; } = new();
    [Parameter] public List<string> Tipo_piel { get; set; } = new();

    private Producto productToEdit = new();
    private int catId = 0;
    private int marcaId = 0;

    protected override void OnParametersSet()
    {
        if (Product != null)
        {
            productToEdit = new Producto
            {
                Id_producto = Product.Id_producto,

                Nombre = Product.Nombre,
                Slug = Product.Slug,
                Sku = Product.Sku,
                Precio = Product.Precio,
                Estado = 1,
                Descripcion = Product.Descripcion,
                Tipo_piel = Product.Tipo_piel?.ToUpper(),
                Categoria = Product.Categoria,
                Marca = Product.Marca
            };

            catId = productToEdit.Categoria?.Id_categoria ?? 0;
            marcaId = productToEdit.Marca?.Id_marca ?? 0;
        }
    }

    private void Close()
    {
        IsVisible = false;
        IsVisibleChanged.InvokeAsync(IsVisible);
    }

    private async Task Save()
    {
        if (catId != 0) productToEdit.Categoria = new CategoriaProducto { Id_categoria = catId };
        if (marcaId != 0) productToEdit.Marca = new Marca { Id_marca = marcaId };

        if (!string.IsNullOrEmpty(productToEdit.Tipo_piel))
        {
            productToEdit.Tipo_piel = productToEdit.Tipo_piel.ToUpper();
        }

        await OnProductUpdated.InvokeAsync(productToEdit);
        Close();
    }

    private string FormatearTexto(string texto)
    {
        if (string.IsNullOrEmpty(texto)) return texto;

        // Pone la primera letra en mayúscula y el resto en minúscula
        return char.ToUpper(texto[0]) + texto.Substring(1).ToLower();
    }
}

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-bottom-0 pb-0 px-4 pt-4">
                    <div>
                        <h4 class="modal-title fw-bold" style="color: #6a3849;">Modificar producto</h4>
                        <p class="text-muted small m-0">Modifica la información técnica y visual necesaria del producto.</p>
                    </div>
                    <button type="button" class="btn-close" @onclick="Close" aria-label="Close"></button>
                </div>
                <div class="modal-body px-4 py-4">
                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; background-color: #fcf0f4; color: #d9557b; font-size: 0.8rem;">01</span>
                            <h6 class="m-0 fw-semibold text-dark">Información Básica</h6>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Nombre del producto</label>
                                <input type="text" class="form-control bg-light border-1" @bind="productToEdit.Nombre" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label text-muted small fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Slug / Código</label>
                                <input type="text" class="form-control bg-light border-1" @bind="productToEdit.Slug" />
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label text-muted small fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">SKU</label>
                                <input type="text" class="form-control bg-light border-1" placeholder="1234567890" @bind="productToEdit.Sku" />
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Marca</label>
                                <select class="form-select bg-light border-1 text-secondary" @bind="marcaId" required>
                                    <option value="0" disabled selected hidden>Seleccionar marca...</option>

                                    @foreach (var m in Marcas)
                                    {
                                        <option value="@m.Id_marca">@m.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label text-muted small fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Precio Venta</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">S/</span>
                                    <input type="number" class="form-control bg-light border-start-0" placeholder="0.00" min="0.00" step="0.01" @bind="productToEdit.Precio" />
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-12">
                            <label class="form-label text-muted small fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Descripción del producto</label>
                            <input type="text" class="form-control bg-light border-1" @bind="productToEdit.Descripcion" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; background-color: #fcf0f4; color: #d9557b; font-size: 0.8rem;">02</span>
                            <h6 class="m-0 fw-semibold text-dark">Categorización</h6>
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Categoría</label>
                                <select class="form-select bg-light border-1 text-secondary" @bind="catId" required>
                                    <option disabled selected hidden>Seleccionar categoria...</option>
                                    @foreach (var c in Categorias)
                                    {
                                        <option value="@c.Id_categoria">@c.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label text-muted small fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Tipo de piel</label>
                                <label class="form-label text-muted small fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Tipo de piel</label>
                                <label class="form-label text-muted small fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Tipo de piel</label>
                                <select class="form-select bg-light border-1 text-secondary" @bind="productToEdit.Tipo_piel" required>
                                    <option value="" disabled hidden>Seleccionar tipo de piel...</option>
                                    @foreach (var t in Tipo_piel)
                                    {
                                        <option value="@(t.ToUpper())">@FormatearTexto(t)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="mb-2">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; background-color: #fcf0f4; color: #d9557b; font-size: 0.8rem;">03</span>
                            <h6 class="m-0 fw-semibold text-dark">Imágenes</h6>
                        </div>
                        <div class="d-flex gap-3">
                            <div class="flex-grow-1 border rounded-3 d-flex flex-column align-items-center justify-content-center py-4 bg-light" style="border-color: #e0e0e0 !important; border-style: dashed !important; border-width: 2px !important; cursor: pointer;">
                                <i class="bi bi-cloud-arrow-up fs-2 text-muted mb-2"></i>
                                <span class="text-secondary small fw-medium">Arrastra o haz clic para subir</span>
                                <span class="text-muted" style="font-size: 0.65rem;">(JPEG, PNG MÁX 2MB)</span>
                            </div>
                            <div class="rounded-3 overflow-hidden shadow-sm" style="width: 120px; height: 100px; flex-shrink: 0; background-color: #f0e6e8;">
                                <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?ixlib=rb-4.0.3&auto=format&fit=crop&w=300&q=80" alt="Preview" class="w-100 h-100 object-fit-cover" />
                            </div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer border-top-0 px-4 pb-4 pt-2">
                    <button type="button" class="btn btn-light px-4 border rounded-3" @onclick="Close">Cancelar</button>
                    <button type="button" class="btn text-white px-4 d-flex align-items-center gap-2 rounded-3 shadow-sm" style="background-color: #834a5d;" @onclick="Save">
                        <i class="bi bi-save"></i> Guardar producto
                    </button>
                </div>
            </div>
        </div>
    </div>
}