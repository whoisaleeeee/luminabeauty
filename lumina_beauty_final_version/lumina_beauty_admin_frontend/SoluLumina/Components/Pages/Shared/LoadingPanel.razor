@if (Visible)
{
    <div class="loading-panel">
        <div class="loading-box shadow-sm">
            <div class="spinner-border loading-spinner" role="status" aria-hidden="true"></div>
            <div>
                <div class="fw-bold text-dark">@Texto</div>
            </div>
        </div>
    </div>
}

<style>
    .loading-panel {
        position: fixed;
        inset: 0;
        z-index: 3000;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(252, 250, 251, 0.92);
        backdrop-filter: blur(2px);
    }

    .loading-box {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        min-width: 260px;
        padding: 1rem 1.25rem;
        border: 1px solid #f7eff1;
        border-radius: 1rem;
        background: #fff;
    }

    .loading-spinner {
        width: 1.8rem;
        height: 1.8rem;
        color: #d9557b;
    }
</style>

@code {
    [Parameter]
    public bool Visible { get; set; } = true;

    [Parameter]
    public string Texto { get; set; } = "Cargando...";
}
