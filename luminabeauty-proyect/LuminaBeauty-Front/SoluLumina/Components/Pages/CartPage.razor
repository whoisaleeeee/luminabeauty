@page "/cart"
@inject LanguageService LangService
@inject CartService Cart
@inject ToastService Toast
@inject NavigationManager Navigator
@implements IDisposable

<PageTitle>Carrito de Compras | Lumina Beauty</PageTitle>

<div class="max-w-7xl mx-auto px-1 sm:px-4 py-6 text-left">

  <!-- Breadcrumb Row -->
  <nav class="text-xs font-semibold text-stone-400 mb-8 flex items-center gap-2 select-none">
    <span class="hover:text-[#FF76A5] transition cursor-pointer" @onclick='() => NavigateTo("/")'>
    Inicio
  </span>
  <span class="text-stone-300">/</span>
  <span class="text-stone-600 font-bold">
    @(LangService.CurrentLanguage == "es" ? "Carrito de compras" : "Shopping cart")
  </span>
</nav>

<h1 class="font-serif text-3xl font-medium tracking-tight text-stone-900 mb-8">
  Tu Carrito de Belleza
</h1>

@if (Cart.GetItems().Count == 0)
{
  <!-- EMPTY STATE -->
  <div class="bg-white/70 backdrop-blur-md rounded-3xl border border-[#FCD1DB]/50 p-12 text-center max-w-lg mx-auto shadow-md">
    <div class="w-16 h-16 bg-[#FFF2F4] rounded-full flex items-center justify-center mx-auto mb-6 text-[#FF76A5] text-xl font-bold select-none">
      <span>🛍️</span>
    </div>
    <h2 class="font-serif text-2xl font-semibold text-stone-900 mb-2">
      @(LangService.CurrentLanguage == "es" ? "Tu carrito está vacío" : "Your cart is empty")
    </h2>
    <p class="text-xs text-stone-500 max-w-sm mx-auto mb-8 leading-relaxed">
      @(LangService.CurrentLanguage == "es"
      ? "Añade increíbles productos cosméticos coreanos y fórmulas de lujo para empezar a sentir una piel radiante."
      : "Add amazing Korean cosmetics and luxury formulas to start radiant skincare.")
    </p>
    <button @onclick='() => NavigateTo("/")'
    class="px-8 py-3.5 bg-stone-950 hover:bg-[#FF76A5] text-white font-bold text-xs uppercase tracking-widest rounded-xl transition duration-300 shadow cursor-pointer select-none">
    @(LangService.CurrentLanguage == "es" ? "Explorar Catálogo" : "Explore Collections")
  </button>
</div>
}
else
{
  <!-- ACTIVE TABLE LIST AND SUMMARY -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

    <!-- Left Products Listings Table -->
    <div class="lg:col-span-8 space-y-6">
      <!-- Desktop Table Headers -->
      <div class="hidden sm:grid grid-cols-12 gap-4 px-6 py-4 bg-white/40 backdrop-blur-md border border-[#FCD1DB]/30 rounded-2xl text-stone-500 font-extrabold uppercase tracking-wider text-[10px] select-none text-left">
        <div class="col-span-6">@(LangService.CurrentLanguage == "es" ? "Producto" : "Product")</div>
        <div class="col-span-2 text-center">@(LangService.CurrentLanguage == "es" ? "Precio" : "Price")</div>
        <div class="col-span-2 text-center">@(LangService.CurrentLanguage == "es" ? "Cantidad" : "Quantity")</div>
        <div class="col-span-2 text-right">@(LangService.CurrentLanguage == "es" ? "Subtotal" : "Subtotal")</div>
      </div>

      <!-- Products Rows list -->
      <div class="space-y-4">
        @foreach (var item in Cart.GetItems())
        {
          <div class="bg-white/80 backdrop-blur-md rounded-2xl border border-stone-100 hover:border-[#FF76A5]/20 p-4 sm:p-5 shadow-xs transition-all duration-300 relative flex flex-col sm:grid sm:grid-cols-12 sm:items-center sm:gap-4 gap-3 text-stone-900">

            <!-- Row deletion standard cross button -->
            <div class="absolute top-3 right-3 sm:static sm:col-span-1 flex items-center justify-center select-none z-10 sm:justify-start">
              <button @onclick="() => RemoveItem(item.Product.Id)"
              class="w-6 h-6 rounded-full bg-red-50 hover:bg-red-100 text-red-500 border border-red-200 flex items-center justify-center transition cursor-pointer"
              title="@(LangService.CurrentLanguage == "es" ? "Quitar artículo" : "Remove item")">
              <span class="text-[10px] font-bold">✕</span>
            </button>
          </div>

          <!-- Thumbnail & Brand metadata -->
          <div class="col-span-11 sm:col-span-5 flex items-center gap-3.5 pr-4 select-none text-left">
            <img src="@item.Product.Image" alt="@item.Product.Name" class="w-20 h-20 object-contain rounded-xl bg-stone-50 border border-stone-200/50 p-1 shrink-0" referrerpolicy="no-referrer" />
            <div class="min-w-0">
              <span class="text-[10px] text-[#C7346A] tracking-wider uppercase font-bold">
                @item.Product.Brand
              </span>
              <h3 class="text-xs font-bold text-stone-900 truncate pr-4">
                @item.Product.Name
              </h3>
              <p class="text-[10px] text-stone-400 font-semibold truncate capitalize">
                @item.Product.Category
              </p>
            </div>
          </div>

          <!-- Price cell -->
          <div class="col-span-6 sm:col-span-2 text-left sm:text-center text-xs font-bold font-mono">
            <span class="sm:hidden text-[10px] text-stone-400 font-extrabold block uppercase mb-0.5 select-none">Precio</span>
            S/ @item.Product.Price.ToString("0.00")
          </div>

          <!-- Double Arrow Quantity Picker block -->
          <div class="col-span-6 sm:col-span-2 flex items-center justify-start sm:justify-center">
            <div class="flex flex-col sm:items-center">
              <span class="sm:hidden text-[10px] text-stone-400 font-extrabold block uppercase mb-1 select-none">CANTIDAD</span>
              <div class="flex items-center justify-between gap-1 border border-stone-200 rounded-xl px-2.5 py-1.5 w-20 bg-[#faf6f7]/40 relative select-none">
                <span class="text-xs font-black font-mono text-stone-800 pr-1">
                  @FormatQty(item.Quantity)
                </span>
                <div class="flex flex-col text-stone-500 scale-90 border-l border-stone-200/50 pl-1.5 -mr-1">
                  <button @onclick="() => ChangeQuantity(item.Product.Id, item.Quantity + 1)"
                  class="hover:text-[#FF76A5] transition p-0 focus:outline-none cursor-pointer" title="Incrementar">
                  <span>▲</span>
                </button>
                <button @onclick="() => ChangeQuantity(item.Product.Id, item.Quantity - 1)"
                disabled="@(item.Quantity <= 1)"
                class="hover:text-[#FF76A5] hover:disabled:text-stone-300 disabled:opacity-30 transition p-0 focus:outline-none cursor-pointer" title="Decrementar">
                <span>▼</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Line Subtotal cell -->
      <div class="col-span-12 sm:col-span-2 text-right text-xs font-semibold font-mono text-[#C7346A] text-right">
        <span class="sm:hidden text-[10px] text-stone-400 font-extrabold text-left block uppercase mb-0.5 border-t border-dashed border-stone-100 pt-2 mt-1 select-none text-left">Subtotal</span>
        S/ @((item.Product.Price * item.Quantity).ToString("0.00"))
      </div>

    </div>
  }
</div>

<!-- Footer back action buttons -->
<div class="flex flex-wrap items-center justify-between gap-4 pt-4 select-none">
  <button @onclick='() => NavigateTo("/")'
  class="px-6 py-3 border border-stone-200 hover:border-[#FF76A5] hover:text-[#C7346A] hover:bg-white text-xs font-bold uppercase tracking-widest text-[#78716C] bg-white/50 backdrop-blur-md rounded-xl transition cursor-pointer">
  @(LangService.CurrentLanguage == "es" ? "Seguir comprando" : "Continue Shopping")
</button>

<button @onclick='() => Toast.ShowToast(LangService.CurrentLanguage == "es" ? "El carrito ya está al día" : "The cart is already up to date")'
class="px-6 py-3 border border-stone-200 hover:border-stone-900 text-xs font-bold uppercase tracking-widest text-stone-600 bg-white/50 backdrop-blur-md rounded-xl transition cursor-pointer">
@(LangService.CurrentLanguage == "es" ? "Actualizar carrito" : "Update Cart")
</button>
</div>
</div>

<!-- Right side Summary Form -->
<div class="lg:col-span-4 space-y-6">
  <div class="bg-white/80 backdrop-blur-md rounded-3xl border border-[#FCD1DB]/50 p-6 shadow-md relative overflow-hidden">
    <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-[#FF76A5] to-[#FFA8BA]" />

    <h3 class="font-serif text-xl font-bold text-stone-900 border-b border-stone-100 pb-3 mb-4 select-none text-left">
      Total
    </h3>

    <!-- Coupon block -->
    <div class="pb-4 mb-4 border-b border-stone-100/60 text-left">
      <span class="text-[10px] font-extrabold uppercase tracking-widest text-stone-400 block mb-2 select-none">
        @(LangService.CurrentLanguage == "es" ? "CÓDIGO DE CUPÓN" : "COUPON CODE")
      </span>
      @if (!string.IsNullOrEmpty(_couponAppliedCode))
      {
        <div class="bg-green-50/70 border border-green-200/50 rounded-xl p-3 flex justify-between items-center text-xs text-green-800 select-none">
          <div class="flex items-center gap-2">
            <span class="text-sm">🎁</span>
            <span class="text-[11px]">
              @(LangService.CurrentLanguage == "es" ? "Cupón" : "Coupon"){" "}
              <strong class="underline">@_couponAppliedCode</strong> (@_discountPercent% DCTO)
            </span>
          </div>
          <button @onclick="RemoveCoupon"
          class="text-[10px] font-bold text-red-500 hover:underline cursor-pointer">
          @(LangService.CurrentLanguage == "es" ? "Eliminar" : "Remove")
        </button>
      </div>
    }
    else
    {
      <form @onsubmit="ApplyCoupon" @onsubmit:preventDefault class="flex gap-2 select-none">
        <input type="text"
        @bind="_couponInput"
        placeholder="@(LangService.CurrentLanguage == "es" ? "e.g. MAMA50" : "e.g. MAMA50")"
        class="flex-1 bg-[#faf6f7]/80 hover:bg-white focus:bg-white border border-stone-200 focus:border-[#FF76A5] rounded-xl px-3 py-2 text-xs outline-none transition font-semibold" />
        <button type="submit"
        class="px-4 py-2 bg-[#FF76A5] hover:bg-[#C7346A] text-white hover:text-white rounded-xl text-xs font-bold uppercase tracking-widest transition duration-300 shadow-sm cursor-pointer">
        @(LangService.CurrentLanguage == "es" ? "Aplicar" : "Apply")
      </button>
    </form>
  }
  @if (string.IsNullOrEmpty(_couponAppliedCode))
  {
    <p @onclick="ApplyDefaultCoupon"
    class="text-[9px] text-[#C7346A] hover:underline cursor-pointer font-bold mt-2 text-left tracking-wide uppercase select-none">
    @(LangService.CurrentLanguage == "es" ? "💡 Clic para aplicar MAMA50 (50% Desc)" : "💡 Click to apply MAMA50 (50% Off)")
  </p>
}
@if (!string.IsNullOrEmpty(_couponError))
{
  <p class="text-[10px] text-red-500 mt-1.5 font-semibold text-left">@_couponError</p>
}
</div>

<!-- Calculations details -->
<div class="space-y-3.5 text-xs font-semibold text-stone-600 text-left font-sans">
  <div class="flex justify-between items-center">
    <span>Subtotal:</span>
    <span class="text-stone-950 font-bold font-mono">S/ @Cart.GetSubtotal().ToString("0.00")</span>
  </div>

  @if (_discountPercent > 0)
  {
    <div class="flex justify-between items-center text-green-600">
      <span>
        @(LangService.CurrentLanguage == "es" ? "Descuento" : "Discount") (@_discountPercent%):
      </span>
      <span class="font-bold font-mono">-S/ @GetDiscountAmount().ToString("0.00")</span>
    </div>
  }

  <div class="flex justify-between items-center">
    <span>@(LangService.CurrentLanguage == "es" ? "Envío:" : "Shipping:")</span>
    <span class="@(GetShippingCost() == 0 ? "text-green-600 font-bold font-mono" : "text-stone-950 font-bold font-mono")">
      @(GetShippingCost() == 0 ? (LangService.CurrentLanguage == "es" ? "Gratis" : "Free") : $"S/ {GetShippingCost().ToString("0.00")}")
    </span>
  </div>

  @if (!IsEligibleForFreeShipping() && Cart.GetSubtotal() > 0)
  {
    <div class="bg-[#FFF0F3]/40 border border-[#FCD1DB]/30 rounded-xl p-3 text-[10px] text-stone-500 font-medium tracking-normal leading-normal select-none">
      🎁 @(LangService.CurrentLanguage == "es" ? "Agrega" : "Add"){" "}
      <strong class="text-[#C7346A] font-bold font-mono">S/ @GetMissingForFreeShipping().ToString("0.00")</strong>{" "}
      @(LangService.CurrentLanguage == "es" ? "más para activar Envío Gratis." : "more to unlock Free Shipping.")
    </div>
  }

  <!-- Grand Total -->
  <div class="border-t border-stone-100 pt-4 mt-2.5 flex justify-between items-center text-sm font-bold text-stone-900">
    <span>Total:</span>
    <span class="text-lg font-bold font-mono text-[#C7346A]">
      S/ @GetTotal().ToString("0.00")
    </span>
  </div>
</div>

<!-- Checkout Action -->
<button @onclick='() => NavigateTo("/checkout")'
class="w-full mt-6 bg-[#FF76A5] hover:bg-[#C7346A] active:scale-98 text-white text-xs font-bold uppercase tracking-widest py-4 rounded-xl shadow-md hover:shadow-lg transition-all duration-300 block text-center cursor-pointer select-none">
@(LangService.CurrentLanguage == "es" ? "Procesar para pago" : "Proceed to Checkout")
</button>

</div>
</div>
</div>
}

</div>

@code {
  private string _couponInput = string.Empty;
  private int _discountPercent;
  private string _couponAppliedCode = string.Empty;
  private string _couponError = string.Empty;

  protected override void OnInitialized()
  {
    LangService.OnChange += StateHasChanged;
    Cart.OnChange += StateHasChanged;
  }

  private void NavigateTo(string path) => Navigator.NavigateTo(path);

  private string FormatQty(int qty) => qty < 10 ? $"0{qty}" : $"{qty}";

    private async Task RemoveItem(int id)
    {
        await Cart.RemoveItemAsync(id);
        Toast.ShowToast(LangService.CurrentLanguage == "es" ? "Producto retirado" : "Product removed");
    }

    private async Task ChangeQuantity(int id, int qty)
    {
        await Cart.UpdateQuantityAsync(id, qty);
    }

  // Math builders
  private bool IsEligibleForFreeShipping() => Cart.GetSubtotal() >= 199m;
  private decimal GetMissingForFreeShipping() => 199m - Cart.GetSubtotal();
  private decimal GetShippingCost() => (Cart.GetSubtotal() > 0 && !IsEligibleForFreeShipping()) ? 15m : 0m;
  private decimal GetDiscountAmount() => Cart.GetSubtotal() * (_discountPercent / 100m);
  private decimal GetTotal() => Cart.GetSubtotal() - GetDiscountAmount() + GetShippingCost();

  private void ApplyCoupon()
  {
    var clean = _couponInput.Trim().ToUpper();
    if (clean == "MAMA50" || clean == "LUMINA50")
    {
      _discountPercent = 50;
      _couponAppliedCode = clean;
      _couponError = string.Empty;
      Toast.ShowToast(LangService.CurrentLanguage == "es" ? "¡Cupón de 50% aplicado!" : "50% Coupon applied successfully!");
    }
    else if (clean == "BIENVENIDA10")
    {
      _discountPercent = 10;
      _couponAppliedCode = clean;
      _couponError = string.Empty;
      Toast.ShowToast(LangService.CurrentLanguage == "es" ? "¡Cupón de 10% aplicado!" : "10% Coupon applied successfully!");
    }
    else
    {
      _couponError = LangService.CurrentLanguage == "es" ? "Código inválido. Prueba MAMA50" : "Invalid code. Try MAMA50";
      _ = ClearCouponErrorDelay();
    }
    _couponInput = string.Empty;
  }

  private async Task ClearCouponErrorDelay()
  {
    await Task.Delay(3000);
    _couponError = string.Empty;
    StateHasChanged();
  }

  private void ApplyDefaultCoupon()
  {
    _discountPercent = 50;
    _couponAppliedCode = "MAMA50";
    _couponError = string.Empty;
    Toast.ShowToast(LangService.CurrentLanguage == "es" ? "¡Cupón MAMA50 aplicado!" : "Coupon MAMA50 applied!");
  }

  private void RemoveCoupon()
  {
    _discountPercent = 0;
    _couponAppliedCode = string.Empty;
    Toast.ShowToast(LangService.CurrentLanguage == "es" ? "Cupón de descuento removido" : "Discount coupon removed");
  }

  public void Dispose()
  {
    LangService.OnChange -= StateHasChanged;
    Cart.OnChange -= StateHasChanged;
  }
}