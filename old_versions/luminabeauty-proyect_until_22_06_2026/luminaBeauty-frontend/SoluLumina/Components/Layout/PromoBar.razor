@inject LanguageService LangService

<div id="promo-banner" class="bg-[#FFF0F3] border-b border-[#FFE3E8]/80 py-2.5 px-4 text-center z-40 relative text-[11px] sm:text-xs tracking-wider text-[#C7346A] shadow-xs flex items-center justify-between">
    <div class="max-w-7xl mx-auto w-full flex flex-col md:flex-row items-center justify-between gap-2">
        <div class="flex-1 font-semibold text-center select-none">
            <span>@LangService.Translate("banner") <strong>MAMA50</strong></span>
            <button @onclick="PromoClick" class="underline font-bold hover:text-[#A31E51] transition inline-block ml-1 cursor-pointer">
                @LangService.Translate("compraAhora")
            </button>
        </div>

        <div class="relative shrink-0 select-none">
            <button @onclick="ToggleDropdown" class="flex items-center gap-1 bg-white/50 hover:bg-white/90 border border-stone-200/50 rounded-full py-1 px-3 text-[10px] font-bold text-stone-700 transition cursor-pointer">
                <span>Español</span>
                <span class="w-3 h-3 text-stone-500 text-[10px]">▼</span>
            </button>

            @if (_dropdownOpen)
            {
                <div class="absolute right-0 mt-1 bg-white/95 backdrop-blur-md rounded-xl border border-stone-100 shadow-xl overflow-hidden py-1 z-50 w-24 text-left">
                    <button @onclick='() => SelectLanguage("es")' class="w-full text-left px-3 py-1.5 text-[10px] hover:bg-[#FFF0F3] text-stone-700 font-medium tracking-wide cursor-pointer">
                        Español
                    </button>
                    <button @onclick='() => SelectLanguage("en")' class="w-full text-left px-3 py-1.5 text-[10px] hover:bg-[#FFF0F3] text-stone-700 font-medium tracking-wide cursor-pointer">
                        Español
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool _dropdownOpen;

    private void ToggleDropdown()
    {
        _dropdownOpen = !_dropdownOpen;
    }

    private void SelectLanguage(string code)
    {
        LangService.SetLanguage(code);
        _dropdownOpen = false;
    }

    private void PromoClick()
    {
        // Smooth scroll to catalog
    }
}
