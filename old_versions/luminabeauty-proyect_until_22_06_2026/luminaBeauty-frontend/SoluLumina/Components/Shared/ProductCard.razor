@inject WishlistService Wishlist
@inject CartService Cart
@inject LayoutStateService LayoutState
@inject ToastService Toast
@inject LanguageService LangService
@inject NavigationManager Navigator
@implements IDisposable

<div class="group relative flex flex-col justify-between overflow-hidden bg-white/70 backdrop-blur-md rounded-2xl border border-white/50 transition-all duration-500 hover:shadow-xl hover:shadow-pink-100 hover:-translate-y-1.5"
     id="product-card-@Product.Id">
    
    <!-- Top left discount badge if exists -->
    <div class="absolute top-3 left-3 z-10 flex flex-col gap-1.5">
        @if (!string.IsNullOrEmpty(Product.Discount))
        {
            <span class="px-2.5 py-1 font-sans text-[10px] font-bold tracking-wider text-white uppercase bg-[#FF76A5] rounded-lg shadow-sm">
                @Product.Discount
            </span>
        }
    </div>

    <!-- Top Right actions (Heart and Quickview Eye) -->
    <div class="absolute top-3 right-3 z-10 flex flex-col gap-1.5 opacity-100 md:opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-x-2 group-hover:translate-x-0">
        <button @onclick="ToggleWishlist"
                class="p-2 rounded-full transition-all duration-300 shadow cursor-pointer @(Wishlist.IsInWishlist(Product.Id) ? "bg-[#FF76A5] text-white" : "bg-white/90 hover:bg-[#FFF0F3] text-gray-500 hover:text-[#FF76A5]")"
                title="Añadir a deseos">
            <span class="text-xs">❤️</span>
        </button>

        <button @onclick="OpenQuickView"
                class="p-2 rounded-full bg-white/90 hover:bg-[#FFF0F3] text-gray-500 hover:text-[#FF76A5] transition-all duration-300 shadow cursor-pointer"
                title="Vista rápida">
            <span class="text-xs">👁️</span>
        </button>
    </div>

    <!-- Clickable product image zone -->
    <div class="relative aspect-square w-full bg-[#FFF0F3]/40 flex items-center justify-center p-6 overflow-hidden select-none cursor-pointer"
         @onclick="NavigateToDetail">
        <img src="@Product.Image"
             alt="@Product.Name"
             class="w-auto max-h-40 object-contain drop-shadow-md transition-transform duration-1000 group-hover:scale-105"
             referrerpolicy="no-referrer" />
        <div class="absolute bottom-0 inset-x-0 h-10 bg-gradient-to-t from-white/30 to-transparent pointer-events-none" />
    </div>

    <!-- Product Text Details and Cart Button -->
    <div class="p-4.5 flex flex-col flex-1 justify-between text-left">
        <div>
            <!-- Brand / Category info row -->
            <div class="flex items-center justify-between mb-1">
                <span class="text-[10px] font-bold tracking-widest text-[#c5a880] uppercase">
                    @Product.Brand
                </span>
                <span class="text-[10px] px-2 py-0.5 rounded bg-[#FFF0F3] text-[#C7346A] font-semibold transform scale-90 origin-right">
                    @Product.Category
                </span>
            </div>

            <!-- Title -->
            <h3 @onclick="NavigateToDetail"
                class="text-gray-900 font-sans text-xs font-semibold leading-snug group-hover:text-[#FF76A5] transition-colors line-clamp-2 h-9 mb-1.5 cursor-pointer">
                @Product.Name
            </h3>

            <!-- Star Rating row -->
            <div class="flex items-center gap-1 mb-3">
                <div class="flex text-amber-400">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var s = i;
                        <span class="text-xs">
                            <span class="@(s <= Math.Round(Product.Rating) ? "text-amber-400" : "text-gray-200")">★</span>
                        </span>
                    }
                </div>
                <span class="text-[10px] font-bold text-gray-600">@Product.Rating</span>
                <span className="text-[9px] text-gray-400">(@Product.ReviewsCount)</span>
            </div>
        </div>

        <!-- Price and add to cart trigger row -->
        <div class="flex items-center justify-between pt-2.5 border-t border-gray-100/70">
            <div class="flex flex-col">
                @if (Product.OriginalPrice != null && Product.OriginalPrice > Product.Price)
                {
                    <span class="text-[10px] text-gray-400 line-through">
                        S/ @Product.OriginalPrice.Value.ToString("0.00")
                    </span>
                }
                <span class="text-sm font-bold text-gray-900 font-mono">
                    S/ @Product.Price.ToString("0.00")
                </span>
            </div>

            <button @onclick="AddToCart"
                    class="p-2 rounded-xl border transition-all duration-300 flex items-center justify-center cursor-pointer @(_added ? "bg-green-600 border-green-600 text-white shadow-md shadow-green-100" : "bg-white hover:bg-[#FF76A5] border-gray-200 hover:border-[#FF76A5] text-gray-700 hover:text-white")"
                    title="Añadir directo">
                @if (_added)
                {
                    <span class="text-xs">✓</span>
                }
                else
                {
                    <span class="text-xs">🛒</span>
                }
            </button>
        </div>
    </div>

</div>

@code {
    [Parameter] public Product Product { get; set; } = new();

    private bool _added;

    protected override void OnInitialized()
    {
        Wishlist.OnChange += StateHasChanged;
    }

    private async Task ToggleWishlist()
    {
        await Wishlist.ToggleWishlistAsync(Product.Id);
        var msg = Wishlist.IsInWishlist(Product.Id)
            ? (LangService.CurrentLanguage == "es" ? "Guardado en favoritos" : "Saved to wishlist")
            : (LangService.CurrentLanguage == "es" ? "Removido de favoritos" : "Removed from wishlist");
        
        Toast.ShowToast(msg);
    }

    private void OpenQuickView()
    {
        LayoutState.SetQuickViewProduct(Product);
    }

    private void NavigateToDetail()
    {
        Navigator.NavigateTo($"/product/{Product.Id}");
    }

    private async Task AddToCart()
    {
        await Cart.AddToCartAsync(Product, 1);
        _added = true;
        Toast.ShowToast($"Agregado a la bolsa: {Product.Name}");
        
        await Task.Delay(1800);
        _added = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        Wishlist.OnChange -= StateHasChanged;
    }
}
