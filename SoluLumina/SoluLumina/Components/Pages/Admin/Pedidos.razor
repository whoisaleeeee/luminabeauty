@page "/Pedidos"
@using SoluLumina.Components.Pages.Shared
@rendermode InteractiveServer

<div class="d-flex w-100 min-vh-100 m-0 p-0 bg-light">

    <NavBar />

    <div class="flex-grow-1 p-4" style="background-color: #fcfafb;">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded-4 shadow-sm">
            <h3 class="fw-bold m-0 text-dark px-2" style="font-size: 1.6rem; color: #6a3849 !important;">Pedidos</h3>
            
            <div class="d-flex align-items-center gap-3">
                <div class="input-group" style="width: 250px;">
                    <span class="input-group-text bg-light border-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control bg-light border-0 small" placeholder="Buscar pedido..." style="font-size: 0.9rem;">
                </div>
                <button class="btn btn-link text-secondary position-relative p-1">
                    <i class="bi bi-bell fs-5"></i>
                </button>
                <button class="btn btn-link text-secondary p-1"><i class="bi bi-envelope fs-5"></i></button>
                <div class="d-flex align-items-center gap-2 border-start ps-3" style="border-color: #f0e6e8 !important;">
                    <div class="text-end d-none d-md-block">
                        <h6 class="m-0 fw-bold text-dark text-uppercase" style="font-size: 0.85rem;">Juan Perez</h6>
                        <small class="text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px; color: #d9557b;">Admin</small>
                    </div>
                    <div class="rounded-circle bg-secondary shadow-sm" style="width: 38px; height: 38px; background-image: url('https://images.unsplash.com/photo-1560250097-0b93528c311a?ixlib=rb-4.0.3&auto=format&fit=crop&w=150&q=80'); background-size: cover; background-position: center; border: 2px solid #fbf2f4;"></div>
                </div>
            </div>
        </div>

        <!-- KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">Pedidos Hoy</small>
                        <i class="bi bi-receipt fs-5" style="color: #834a5d;"></i>
                    </div>
                    <div class="d-flex align-items-end gap-2 mt-auto">
                        <h2 class="fw-black m-0" style="font-size: 2.2rem; color: #2d2d2d; line-height: 1;">23</h2>
                        <small class="fw-semibold pb-1" style="color: #198754; font-size: 0.8rem;">+12%</small>
                    </div>
                </div>
            </div>
            
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100" style="border-left: 4px solid #fd7e14 !important;">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">Pendientes</small>
                        <i class="bi bi-clipboard-pulse fs-5" style="color: #fd7e14;"></i>
                    </div>
                    <div class="d-flex flex-column justify-content-end mt-auto">
                        <h2 class="fw-black m-0" style="font-size: 2.2rem; color: #2d2d2d; line-height: 1;">5</h2>
                        <small class="fw-semibold mt-1" style="color: #fd7e14; font-size: 0.75rem;">Atención requerida</small>
                    </div>
                </div>
            </div>
            
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100" style="border-left: 4px solid #0d6efd !important;">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">En Camino</small>
                        <i class="bi bi-truck fs-5" style="color: #0d6efd;"></i>
                    </div>
                    <div class="d-flex flex-column justify-content-end mt-auto">
                        <h2 class="fw-black m-0" style="font-size: 2.2rem; color: #2d2d2d; line-height: 1;">11</h2>
                        <small class="fw-semibold mt-1" style="color: #0d6efd; font-size: 0.75rem;">En tránsito</small>
                    </div>
                </div>
            </div>
            
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">Ingresos Hoy</small>
                        <i class="bi bi-cash-stack fs-5" style="color: #834a5d;"></i>
                    </div>
                    <div class="d-flex flex-column justify-content-end mt-auto">
                        <h2 class="fw-black m-0" style="font-size: 2.2rem; color: #2d2d2d; line-height: 1;">S/1,840</h2>
                        <small class="fw-semibold mt-1" style="color: #198754; font-size: 0.75rem;">Meta alcanzada</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filtros -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-2">
                    <label class="form-label text-muted small fw-bold" style="font-size: 0.75rem;">ID de Pedido</label>
                    <input type="text" class="form-control bg-light border-1" placeholder="#ORD-">
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label text-muted small fw-bold" style="font-size: 0.75rem;">Cliente</label>
                    <input type="text" class="form-control bg-light border-1" placeholder="Nombre">
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label text-muted small fw-bold" style="font-size: 0.75rem;">Estado</label>
                    <select class="form-select bg-light border-1 text-secondary">
                        <option selected>Todos</option>
                        <option value="1">Pendiente</option>
                        <option value="2">Preparando</option>
                        <option value="3">En Camino</option>
                        <option value="4">Entregado</option>
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label text-muted small fw-bold" style="font-size: 0.75rem;">Fecha</label>
                    <input type="date" class="form-control bg-light border-1 text-secondary">
                </div>
                <div class="col-12 col-md-3 d-flex justify-content-end gap-2">
                    <button class="btn btn-light px-3 border rounded-3 text-secondary shadow-sm" style="font-size: 0.9rem; font-weight: 500;">
                        Limpiar
                    </button>
                    <!-- Improved action button: Replaced Exportar with Buscar -->
                    <button class="btn text-white px-3 d-flex align-items-center gap-2 rounded-3 shadow-sm" style="background-color: #834a5d; font-size: 0.9rem; font-weight: 500;">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                </div>
            </div>
        </div>

        <!-- Tabla de Pedidos Mejorada -->
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle table-hover m-0">
                    <thead style="background-color: #fbf8f9; color: #6c757d; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        <tr>
                            <th class="py-3 px-4 border-bottom-0">ID Pedido</th>
                            <th class="py-3 border-bottom-0">Cliente</th>
                            <th class="py-3 border-bottom-0">Fecha y Hora</th>
                            <th class="py-3 border-bottom-0">Estado</th>
                            <th class="py-3 border-bottom-0">Total</th>
                            <th class="py-3 px-4 border-bottom-0 text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody style="font-size: 0.85rem; color: #4f4f4f;">
                        <!-- Fila 1 -->
                        <tr class="border-bottom" style="border-color: #f7eff1 !important;">
                            <td class="py-3 px-4 fw-bold text-dark">#ORD-9012</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-secondary fw-bold" style="width: 32px; height: 32px; font-size: 0.7rem;">VA</div>
                                    <span class="fw-medium text-dark">Valeria Arias</span>
                                </div>
                            </td>
                            <td>Hoy, 10:45 AM</td>
                            <td><span class="badge rounded-pill fw-medium" style="background-color: #e2f3eb; color: #198754; padding: 0.4em 0.8em;">Entregado</span></td>
                            <td class="fw-bold text-dark">S/ 420.00 <span class="text-muted fw-normal small">(3 prod.)</span></td>
                            <td class="py-3 px-4 text-end">
                                <button class="btn btn-sm btn-light text-secondary rounded-3 px-3"><i class="bi bi-eye"></i> Detalles</button>
                            </td>
                        </tr>
                        
                        <!-- Fila 2 -->
                        <tr class="border-bottom" style="border-color: #f7eff1 !important;">
                            <td class="py-3 px-4 fw-bold text-dark">#ORD-9013</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-secondary fw-bold" style="width: 32px; height: 32px; font-size: 0.7rem;">CM</div>
                                    <span class="fw-medium text-dark">Camila Mendoza</span>
                                </div>
                            </td>
                            <td>Hoy, 09:20 AM</td>
                            <td><span class="badge rounded-pill fw-medium" style="background-color: #fff3cd; color: #fd7e14; padding: 0.4em 0.8em;">Preparando</span></td>
                            <td class="fw-bold text-dark">S/ 185.50 <span class="text-muted fw-normal small">(1 prod.)</span></td>
                            <td class="py-3 px-4 text-end">
                                <button class="btn btn-sm btn-light text-secondary rounded-3 px-3"><i class="bi bi-eye"></i> Detalles</button>
                            </td>
                        </tr>
                        
                        <!-- Fila 3 -->
                        <tr class="border-bottom" style="border-color: #f7eff1 !important;">
                            <td class="py-3 px-4 fw-bold text-dark">#ORD-9014</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-secondary fw-bold" style="width: 32px; height: 32px; font-size: 0.7rem;">LR</div>
                                    <span class="fw-medium text-dark">Luciana Rojas</span>
                                </div>
                            </td>
                            <td>Hoy, 08:15 AM</td>
                            <td><span class="badge rounded-pill fw-medium" style="background-color: #cff4fc; color: #0dcaf0; padding: 0.4em 0.8em;">En Camino</span></td>
                            <td class="fw-bold text-dark">S/ 290.00 <span class="text-muted fw-normal small">(2 prod.)</span></td>
                            <td class="py-3 px-4 text-end">
                                <button class="btn btn-sm btn-light text-secondary rounded-3 px-3"><i class="bi bi-eye"></i> Detalles</button>
                            </td>
                        </tr>
                        
                        <!-- Fila 4 -->
                        <tr class="border-bottom" style="border-color: #f7eff1 !important;">
                            <td class="py-3 px-4 fw-bold text-dark">#ORD-9005</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-secondary fw-bold" style="width: 32px; height: 32px; font-size: 0.7rem;">SG</div>
                                    <span class="fw-medium text-dark">Sofia Galdos</span>
                                </div>
                            </td>
                            <td>Ayer, 07:45 PM</td>
                            <td><span class="badge rounded-pill fw-medium" style="background-color: #f8d7da; color: #dc3545; padding: 0.4em 0.8em;">Pendiente</span></td>
                            <td class="fw-bold text-dark">S/ 844.00 <span class="text-muted fw-normal small">(5 prod.)</span></td>
                            <td class="py-3 px-4 text-end">
                                <button class="btn btn-sm btn-light text-secondary rounded-3 px-3"><i class="bi bi-eye"></i> Detalles</button>
                            </td>
                        </tr>

                        <!-- Fila 5 -->
                        <tr class="border-bottom" style="border-color: #f7eff1 !important;">
                            <td class="py-3 px-4 fw-bold text-dark">#ORD-9004</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-secondary fw-bold" style="width: 32px; height: 32px; font-size: 0.7rem;">DP</div>
                                    <span class="fw-medium text-dark">Daniela Paz</span>
                                </div>
                            </td>
                            <td>Ayer, 04:30 PM</td>
                            <td><span class="badge rounded-pill fw-medium" style="background-color: #e2f3eb; color: #198754; padding: 0.4em 0.8em;">Entregado</span></td>
                            <td class="fw-bold text-dark">S/ 105.00 <span class="text-muted fw-normal small">(2 prod.)</span></td>
                            <td class="py-3 px-4 text-end">
                                <button class="btn btn-sm btn-light text-secondary rounded-3 px-3"><i class="bi bi-eye"></i> Detalles</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Paginación -->
            <div class="d-flex justify-content-between align-items-center p-4 border-top" style="border-color: #f7eff1 !important; background-color: #fbf8f9;">
                <small class="text-muted" style="font-size: 0.85rem;">Mostrando 1-5 de 23 pedidos</small>
                <nav>
                    <ul class="pagination pagination-sm m-0 gap-1">
                        <li class="page-item disabled"><a class="page-item btn btn-white border bg-white text-secondary btn-sm p-1 px-2 rounded-2 shadow-sm"><i class="bi bi-chevron-left"></i></a></li>
                        <li class="page-item"><a class="page-link rounded-2 active border-0 text-white shadow-sm" style="background-color: #834a5d;">1</a></li>
                        <li class="page-item"><a class="page-link rounded-2 border text-secondary bg-white shadow-sm" href="#">2</a></li>
                        <li class="page-item"><a class="page-link rounded-2 border text-secondary bg-white shadow-sm" href="#">3</a></li>
                        <li class="page-item"><a class="page-link btn btn-white border bg-white text-secondary btn-sm p-1 px-2 rounded-2 shadow-sm" href="#"><i class="bi bi-chevron-right"></i></a></li>
                    </ul>
                </nav>
            </div>
        </div>

    </div>

</div>

