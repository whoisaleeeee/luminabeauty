@page "/Inventario"
@using SoluLumina.Components.Pages.Shared
@rendermode InteractiveServer

<div class="d-flex w-100 min-vh-100 m-0 p-0 bg-light">

    <NavBar />

    <div class="flex-grow-1 p-4" style="background-color: #fcfafb;">

        <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded-4 shadow-sm">
            <h3 class="fw-bold m-0 text-dark px-2" style="font-size: 1.6rem; color: #6a3849 !important;">Inventario</h3>

            <div class="d-flex align-items-center gap-3">
                <div class="input-group" style="width: 280px;">
                    <span class="input-group-text bg-light border-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control bg-light border-0 small" placeholder="Buscar productos..." style="font-size: 0.9rem;">
                </div>
                <button class="btn btn-link text-secondary position-relative p-1">
                    <i class="bi bi-bell fs-5"></i>
                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
                        <span class="visually-hidden">New alerts</span>
                    </span>
                </button>
                <button class="btn btn-link text-secondary p-1"><i class="bi bi-envelope fs-5"></i></button>
                <div class="d-flex align-items-center gap-2 border-start ps-3" style="border-color: #f0e6e8 !important;">
                    <div class="text-end d-none d-md-block">
                        <h6 class="m-0 fw-bold text-dark text-uppercase" style="font-size: 0.85rem;">Juan Perez</h6>
                        <small class="text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px; color: #d9557b;">Admin</small>
                    </div>
                    <div class="rounded-circle bg-secondary shadow-sm" style="width: 38px; height: 38px; background-image: url('https://images.unsplash.com/photo-1560250097-0b93528c311a?ixlib=rb-4.0.3&auto=format&fit=crop&w=150&q=80'); background-size: cover; background-position: center; border: 2px solid #fbf2f4;"></div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <small class="text-muted text-uppercase fw-bold mb-2 d-block" style="font-size: 0.7rem; letter-spacing: 0.5px;">Unidades Totales</small>
                    <div class="d-flex align-items-end justify-content-between mt-auto">
                        <h2 class="fw-black m-0" style="font-size: 2.2rem; color: #2d2d2d; line-height: 1;">4,821</h2>
                        <span class="p-2 rounded-3 bg-light text-muted d-flex align-items-center justify-content-center" style="color: #f1aeb5 !important; width: 40px; height: 40px; background-color: #fef4f6 !important;"><i class="bi bi-box-seam fs-5"></i></span>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 position-relative overflow-hidden" style="border-right: 4px solid #dc3545 !important;">
                    <small class="text-danger text-uppercase fw-bold mb-2 d-block" style="font-size: 0.7rem; letter-spacing: 0.5px;">Alertas Activas</small>
                    <div class="d-flex align-items-end justify-content-between mt-auto">
                        <h2 class="fw-black m-0 text-danger" style="font-size: 2.2rem; line-height: 1;">3</h2>
                        <span class="p-2 rounded-3 d-flex align-items-center justify-content-center" style="color: #dc3545; width: 40px; height: 40px; background-color: #fdf5f5;"><i class="bi bi-exclamation-triangle-fill fs-5"></i></span>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <small class="text-muted text-uppercase fw-bold mb-2 d-block" style="font-size: 0.7rem; letter-spacing: 0.5px;">Valor Inventario</small>
                    <div class="d-flex align-items-end justify-content-between mt-auto">
                        <h2 class="fw-black m-0" style="font-size: 2.2rem; color: #2d2d2d; line-height: 1;">S/142k</h2>
                        <span class="p-2 rounded-3 bg-light text-muted d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;"><i class="bi bi-cash-stack fs-5"></i></span>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <small class="text-muted text-uppercase fw-bold mb-2 d-block" style="font-size: 0.7rem; letter-spacing: 0.5px;">Sin Stock</small>
                    <div class="d-flex align-items-end justify-content-between mt-auto">
                        <h2 class="fw-black m-0" style="font-size: 2.2rem; color: #2d2d2d; line-height: 1;">7</h2>
                        <span class="p-2 rounded-3 bg-light text-muted d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;"><i class="bi bi-slash-circle fs-5"></i></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-3 px-4 bg-white mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <span class="rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; background-color: #fdf5f5; color: #dc3545;">
                        <i class="bi bi-bell fs-5"></i>
                    </span>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h6 class="m-0 fw-bold text-dark">Control de stock</h6>
                            <span class="badge rounded-pill" style="background-color: #fdf5f5; color: #dc3545; font-size: 0.65rem;">URGENTE</span>
                        </div>
                        <small class="text-muted" style="font-size: 0.85rem;">2 productos requieren reposición inmediata para evitar quiebre de stock.</small>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-light bg-white border text-secondary px-3 py-2 rounded-3 shadow-sm d-flex align-items-center gap-2" style="font-size: 0.85rem; font-weight: 500;">
                        <i class="bi bi-download"></i> Exportar
                    </button>
                    <button class="btn text-white px-4 py-2 rounded-3 shadow-sm border-0 d-flex align-items-center gap-2"
                            style="background-color: #834a5d; font-size: 0.85rem; font-weight: 500;"
                            @onclick="OpenAddEntryModal">
                        <i class="bi bi-plus-lg"></i> Nueva Entrada
                    </button>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
            <div class="d-flex justify-content-between align-items-center p-4 border-bottom" style="border-color: #f7eff1 !important;">
                <h6 class="m-0 fw-bold text-dark">Listado de Existencias</h6>
                <div class="d-flex gap-2">
                    <button class="btn btn-light btn-sm text-secondary border-0 bg-transparent"><i class="bi bi-filter"></i></button>
                    <button class="btn btn-light btn-sm text-secondary border-0 bg-transparent"><i class="bi bi-list-task"></i></button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle table-hover m-0">
                    <thead style="background-color: #fbf8f9; color: #6c757d; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        <tr>
                            <th class="py-3 px-4 fw-semibold border-bottom-0">SKU</th>
                            <th class="py-3 fw-semibold border-bottom-0">Categoría</th>
                            <th class="py-3 px-4 fw-semibold border-bottom-0 w-25">Stock</th>
                        </tr>
                    </thead>
                    <tbody style="font-size: 0.85rem; color: #4f4f4f;">
                        <!-- Row 1 -->
                        <tr class="border-bottom" style="border-color: #f7eff1 !important;">
                            <td class="py-4 px-4 font-monospace text-muted">RS-SER-021</td>
                            <td class="py-4 fw-medium">Cuidado Facial</td>
                            <td class="py-4 px-4">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="fw-semibold text-dark">150 <span class="text-muted fw-normal">/ 200</span></span>
                                </div>
                                <div class="progress" style="height: 4px; background-color: #f0e6e8;">
                                    <div class="progress-bar" role="progressbar" style="width: 75%; background-color: #834a5d;" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </td>
                        </tr>
                        <!-- Row 2 -->
                        <tr class="border-bottom" style="border-color: #f7eff1 !important;">
                            <td class="py-4 px-4 font-monospace text-muted">RF-LP-018</td>
                            <td class="py-4 fw-medium">Labiales</td>
                            <td class="py-4 px-4">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="fw-semibold text-dark">12 <span class="text-muted fw-normal">/ 100</span></span>
                                </div>
                                <div class="progress position-relative overflow-visible" style="height: 4px; background-color: #f0e6e8;">
                                    <div class="progress-bar" role="progressbar" style="width: 12%; background-color: #6c757d;" aria-valuenow="12" aria-valuemin="0" aria-valuemax="100"></div>
                                    <div class="position-absolute" style="left: 12%; top: -3px; width: 10px; height: 10px; border-radius: 50%; background-color: #6c757d; border: 2px solid white; transform: translateX(-50%);"></div>
                                </div>
                            </td>
                        </tr>
                        <!-- Row 3 -->
                        <tr class="border-bottom" style="border-color: #f7eff1 !important;">
                            <td class="py-4 px-4 font-monospace text-muted">RF-EP-019</td>
                            <td class="py-4 fw-medium">Sombras</td>
                            <td class="py-4 px-4">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="fw-semibold text-danger">4 <span class="text-danger fw-normal">/ 150</span></span>
                                </div>
                                <div class="progress position-relative overflow-visible" style="height: 4px; background-color: #fdf5f5;">
                                    <div class="progress-bar bg-danger" role="progressbar" style="width: 2.6%;" aria-valuenow="2.6" aria-valuemin="0" aria-valuemax="100"></div>
                                    <div class="position-absolute" style="left: 2.6%; top: -3px; width: 10px; height: 10px; border-radius: 50%; background-color: #dc3545; border: 2px solid white; transform: translateX(-50%);"></div>
                                </div>
                            </td>
                        </tr>
                        <!-- Row 4 -->
                        <tr class="border-bottom" style="border-color: #f7eff1 !important;">
                            <td class="py-4 px-4 font-monospace text-muted">FR-AZ-992</td>
                            <td class="py-4 fw-medium">Fragancias</td>
                            <td class="py-4 px-4">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="fw-semibold text-dark">42 <span class="text-muted fw-normal">/ 80</span></span>
                                </div>
                                <div class="progress" style="height: 4px; background-color: #f0e6e8;">
                                    <div class="progress-bar" role="progressbar" style="width: 52.5%; background-color: #f1aeb5;" aria-valuenow="52.5" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center p-4 border-top" style="border-color: #f7eff1 !important; background-color: #fbf8f9;">
                <small class="text-muted" style="font-size: 0.85rem;">Mostrando 4 de 1,248 productos</small>
                <nav>
                    <ul class="pagination pagination-sm m-0 gap-1">
                        <li class="page-item disabled"><a class="page-item btn btn-white border bg-white text-secondary btn-sm p-1 px-2 rounded-2 shadow-sm"><i class="bi bi-chevron-left"></i></a></li>
                        <li class="page-item"><a class="page-link rounded-2 active border-0 text-white shadow-sm" style="background-color: #834a5d;">1</a></li>
                        <li class="page-item"><a class="page-link rounded-2 border text-secondary bg-white shadow-sm" href="#">2</a></li>
                        <li class="page-item"><a class="page-link rounded-2 border text-secondary bg-white shadow-sm" href="#">3</a></li>
                        <li class="page-item"><a class="page-link btn btn-white border bg-white text-secondary btn-sm p-1 px-2 rounded-2 shadow-sm" href="#"><i class="bi bi-chevron-right"></i></a></li>
                    </ul>
                </nav>
            </div>
        </div>

    </div>

</div>

@if (showAddEntryModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-bottom-0 pb-0 px-4 pt-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background-color: #fcf0f4; color: #d9557b;">
                            <i class="bi bi-box-arrow-in-down fs-5"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold" style="color: #6a3849;">Registrar Entrada</h5>
                            <p class="text-muted small m-0">Ingreso de stock al inventario.</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close mb-auto" @onclick="CloseAddEntryModal" aria-label="Close"></button>
                </div>
                <div class="modal-body px-4 py-4">
                    
                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Producto</label>
                        <div class="input-group shadow-sm rounded-3 overflow-hidden">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control border-start-0" placeholder="Buscar por SKU o nombre de producto...">
                        </div>
                        <small class="text-muted d-block mt-2" style="font-size: 0.75rem;">Ej. RF-LP-018 - Labial Matte Rojo Pasión</small>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-6">
                            <label class="form-label text-muted small fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Cantidad</label>
                            <div class="input-group shadow-sm rounded-3 overflow-hidden">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-123"></i></span>
                                <input type="number" class="form-control border-start-0" placeholder="0">
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-muted small fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Costo Unitario</label>
                            <div class="input-group shadow-sm rounded-3 overflow-hidden">
                                <span class="input-group-text bg-light border-end-0 text-muted">S/</span>
                                <input type="number" step="0.01" class="form-control border-start-0" placeholder="0.00">
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-6">
                            <label class="form-label text-muted small fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Lote (Batch)</label>
                            <input type="text" class="form-control shadow-sm border-1 rounded-3" placeholder="Ej. L-2026X">
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-muted small fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Fecha de Caducidad</label>
                            <input type="date" class="form-control shadow-sm border-1 rounded-3 text-secondary">
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label text-muted small fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Motivo de entrada</label>
                        <select class="form-select shadow-sm border-1 rounded-3 text-secondary">
                            <option selected>Compra a proveedor</option>
                            <option value="1">Devolución de cliente</option>
                            <option value="2">Ajuste de inventario (+)</option>
                        </select>
                    </div>

                </div>
                <div class="modal-footer border-top-0 px-4 pb-4 pt-0">
                    <button type="button" class="btn btn-light px-4 border rounded-3" @onclick="CloseAddEntryModal">Cancelar</button>
                    <button type="button" class="btn text-white px-4 d-flex align-items-center gap-2 rounded-3 shadow-sm" style="background-color: #834a5d;">
                        <i class="bi bi-check2-circle"></i> Confirmar Entrada
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool showAddEntryModal = false;

    private void OpenAddEntryModal()
    {
        showAddEntryModal = true;
    }

    private void CloseAddEntryModal()
    {
        showAddEntryModal = false;
    }
}

