@page "/"
@using SoluLumina.Components.Pages.Shared
@using SoluLumina.Models
@using SoluLumina.Services
@inject IProductoService ProductoService
@inject ICategoriaService CategoriaService
@inject IMarcaService MarcaService
@rendermode InteractiveServer

<div class="d-flex w-100 min-vh-100 m-0 p-0 bg-light">

    <NavBar />

    <div class="flex-grow-1 p-4" style="background-color: #fcfafb;">

        <!-- Header Superior Estándar -->
        <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded-4 shadow-sm flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-light d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <h3 class="fw-bold m-0 text-dark px-2" style="font-size: 1.6rem; color: #6a3849 !important;">Catálogo</h3>
                
            </div>
                
            <div class="d-flex align-items-center gap-3">
                <!-- Search input removed, only title and profile remain -->
                <button class="btn btn-link text-secondary position-relative p-1">
                    <i class="bi bi-bell fs-5"></i>
                </button>
                <button class="btn btn-link text-secondary p-1"><i class="bi bi-envelope fs-5"></i></button>
                <div class="position-relative">
                    <div class="d-flex align-items-center gap-2 border-start ps-3" style="border-color: #f0e6e8 !important; cursor: pointer;" @onclick="ToggleProfileDropdown">
                        <div class="text-end d-none d-md-block">
                            <h6 class="m-0 fw-bold text-dark text-uppercase" style="font-size: 0.85rem;">Juan Perez</h6>
                            <small class="text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px; color: #d9557b;">Admin</small>
                        </div>
                        <div class="rounded-circle bg-secondary shadow-sm" style="width: 38px; height: 38px; background-image: url('https://images.unsplash.com/photo-1560250097-0b93528c311a?ixlib=rb-4.0.3&auto=format&fit=crop&w=150&q=80'); background-size: cover; background-position: center; border: 2px solid #fbf2f4;"></div>
                    </div>

                    @if (showProfileDropdown)
                    {
                        <div class="position-absolute bg-white shadow rounded-4 mt-3" style="right: 0; min-width: 250px; z-index: 1050; border: 1px solid #f7eff1;">
                            <div class="p-3 border-bottom d-flex align-items-center gap-3" style="border-color: #f7eff1 !important;">
                                <div class="rounded-circle bg-secondary shadow-sm" style="width: 42px; height: 42px; background-image: url('https://images.unsplash.com/photo-1560250097-0b93528c311a?ixlib=rb-4.0.3&auto=format&fit=crop&w=150&q=80'); background-size: cover; background-position: center; border: 2px solid #fbf2f4; flex-shrink: 0;"></div>
                                <div class="overflow-hidden">
                                    <h6 class="m-0 fw-bold text-dark text-truncate" style="font-size: 0.9rem;">Juan Perez</h6>
                                    <small class="text-muted text-truncate d-block" style="font-size: 0.75rem;">juan.perez@luminabeauty.com</small>
                                </div>
                            </div>
                            <div class="py-2">
                                <NavLink href="Perfil" class="dropdown-item d-flex align-items-center gap-2 px-3 py-2 text-secondary" style="font-size: 0.85rem; transition: 0.2s;">
                                    <i class="bi bi-person fs-5"></i> Ver Perfil
                                </NavLink>
                                <div class="dropdown-divider my-2" style="border-color: #f7eff1;"></div>
                                <NavLink href="#" class="dropdown-item d-flex align-items-center gap-2 px-3 py-2 text-danger" style="font-size: 0.85rem; transition: 0.2s;">
                                    <i class="bi bi-box-arrow-right fs-5"></i> Cerrar Sesión
                                </NavLink>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border border-light shadow-sm rounded-4 p-4 bg-white h-100 position-relative overflow-hidden">
                    <i class="bi bi-box position-absolute text-light opacity-50" style="font-size: 5rem; top: -10px; right: -10px;"></i>
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <small class="text-muted fw-bold d-block" style="font-size: 0.8rem;">Total Productos</small>
                        <span class="badge rounded-pill" style="background-color: #e2f3eb; color: #198754; font-size: 0.7rem;"><i class="bi bi-arrow-up"></i> @Productos.Count</span>
                    </div>
                    <h2 class="fw-black m-0" style="font-size: 2.2rem; color: #2d2d2d; line-height: 1;">@Productos.Count</h2>
                </div>
            </div>
            
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border border-light shadow-sm rounded-4 p-4 bg-white h-100 position-relative overflow-hidden">
                    <i class="bi bi-tag position-absolute text-light opacity-50" style="font-size: 5rem; top: -10px; right: -10px;"></i>
                    <small class="text-muted fw-bold d-block mb-1" style="font-size: 0.8rem;">Marcas Activas</small>
                    <h2 class="fw-black m-0" style="font-size: 2.2rem; color: #2d2d2d; line-height: 1;">@Marcas.Count</h2>
                </div>
            </div>
            
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border border-light shadow-sm rounded-4 p-4 bg-white h-100 position-relative overflow-hidden">
                    <i class="bi bi-layers position-absolute text-light opacity-50" style="font-size: 5rem; top: -10px; right: -10px;"></i>
                    <small class="text-muted fw-bold d-block mb-1" style="font-size: 0.8rem;">Categorías</small>
                    <h2 class="fw-black m-0" style="font-size: 2.2rem; color: #2d2d2d; line-height: 1;">@Categorias.Count</h2>
                </div>
            </div>
            
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border border-danger-subtle shadow-sm rounded-4 p-4 h-100 position-relative overflow-hidden" style="background-color: #fdf5f5;">
                    <i class="bi bi-exclamation-triangle position-absolute opacity-25" style="font-size: 5rem; top: -10px; right: -10px; color: #d9557b;"></i>
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <small class="fw-bold d-block" style="font-size: 0.8rem; color: #d9557b;">Sin Stock</small>
                        <span class="badge rounded-pill bg-white text-danger border border-danger-subtle" style="font-size: 0.65rem;">@ZeroStockCount</span>
                    </div>
                    <h2 class="fw-black m-0" style="font-size: 2.2rem; color: #b02a37; line-height: 1;">@ZeroStockCount</h2>
                </div>
            </div>
        </div>

        <!-- Main Card -->
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            
            <!-- Filtros y Botón -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-3 border-bottom" style="border-color: #f7eff1 !important;">
                <div class="d-flex flex-wrap gap-3">
                    <div>
                        <label class="form-label text-muted small fw-bold text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Categoría</label>
                        <select class="form-select bg-light border-1 text-secondary rounded-3" style="min-width: 150px;" @onchange="OnCategoryChanged">
                            <option value="0" selected>Todas las categorías</option>
                            @foreach (var cat in Categorias)
                            {
                                <option value="@cat.Id">@cat.Nombre</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label text-muted small fw-bold text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Tipo de Piel</label>
                        <select class="form-select bg-light border-1 text-secondary rounded-3" style="min-width: 150px;" @onchange="OnSkinTypeChanged">
                            <option value="0" selected>Cualquiera</option>
                            <option value="1">Normal</option>
                            <option value="2">Seca</option>
                            <option value="3">Grasa</option>
                            <option value="4">Mixta</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label text-muted small fw-bold text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Marca</label>
                        <select class="form-select bg-light border-1 text-secondary rounded-3" style="min-width: 150px;" @onchange="OnBrandChanged">
                            <option value="0" selected>Todas las marcas</option>
                            @foreach (var marca in Marcas)
                            {
                                <option value="@marca.Id">@marca.Nombre</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="mt-auto">
                    <button class="btn text-white d-flex align-items-center gap-2 px-4 py-2 rounded-3 shadow-sm"
                            style="background-color: #6a3849; font-size: 0.9rem; font-weight: 500;"
                            @onclick="OpenAddProductModal">
                        + Nuevo Producto
                    </button>
                </div>
            </div>

            <!-- Tabla de Productos Mejorada -->
            <div class="table-responsive">
                <table class="table align-middle table-hover m-0">
                     <thead class="bg-light">
                         <tr>
                             <th class="text-center">No.</th>
                             <th>    Producto</th>
                             <th>Categoría</th>
                             <th>Piel</th>
                             <th class="text-center">Precio</th>
                             <th class="text-center">Stock</th>
                             <th class="text-center">Acciones</th>
                         </tr>
                     </thead>
                    <tbody style="font-size: 0.85rem; color: #4f4f4f;">
                        @{ int rowNumber = 1; }
                        @foreach(var p in FilteredProducts)
                        {
                            <tr class="border-bottom" style="border-color: #f7eff1 !important;">
                                <td class="text-center">@(rowNumber++)</td>
                                <td class="py-3 px-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-3 overflow-hidden shadow-sm border" style="width: 48px; height: 48px; flex-shrink: 0; background-color: #f8f9fa;">
                                            @if(!string.IsNullOrEmpty(p.Imagen_url))
                                            {
                                                <img src="@p.Imagen_url" alt="Producto" class="w-100 h-100 object-fit-cover" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-image text-muted opacity-50 d-flex justify-content-center align-items-center h-100 fs-4"></i>
                                            }
                                        </div>
                                        <div>
                                            <h6 class="m-0 fw-bold text-dark">@p.Nombre</h6>
                                            <small class="text-muted font-monospace" style="font-size: 0.7rem;">@p.Slug</small>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge rounded-pill fw-medium" padding: 0.4em 0.8em;">@p.Categoria?.Nombre</span></td>
                                <td class="text-secondary">@p.Tipo_piel</td>
                                <td class="fw-bold text-dark">S/ @p.Precio.ToString("F2")</td>
                                <td class="text-center"><span class="badge rounded-pill fw-medium" padding: 0.4em 0.8em;">@p.Stock uds</span></td>
                                <td class="py-3 px-4 text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn btn-sm btn-light text-primary rounded-circle" title="Modificar" @onclick="() => EditProduct(p)">
                                <i class="bi bi-pencil"></i>
                            </button>
                                    <button class="btn btn-sm btn-light text-danger rounded-circle" title="Eliminar" @onclick="() => DeleteProduct(p)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginación -->
            <div class="d-flex justify-content-between align-items-center mt-4 border-top pt-3" style="border-color: #f7eff1 !important;">
                <small class="text-muted" style="font-size: 0.85rem;">Mostrando 1 a @Productos.Count de 248 productos</small>
                <nav>
                    <ul class="pagination pagination-sm m-0 gap-1">
                        <li class="page-item disabled"><a class="page-item btn btn-white border bg-white text-secondary btn-sm p-1 px-2 rounded-2 shadow-sm"><i class="bi bi-chevron-left"></i></a></li>
                        <li class="page-item"><a class="page-link rounded-2 active border-0 text-white shadow-sm" style="background-color: #6a3849;">1</a></li>
                        <li class="page-item"><a class="page-link rounded-2 border text-secondary bg-white shadow-sm" href="#">2</a></li>
                        <li class="page-item"><a class="page-link rounded-2 border text-secondary bg-white shadow-sm" href="#">3</a></li>
                        <li class="page-item disabled"><span class="px-1 text-muted">...</span></li>
                        <li class="page-item"><a class="page-link rounded-2 border text-secondary bg-white shadow-sm" href="#">25</a></li>
                        <li class="page-item"><a class="page-link btn btn-white border bg-white text-secondary btn-sm p-1 px-2 rounded-2 shadow-sm" href="#"><i class="bi bi-chevron-right"></i></a></li>
                    </ul>
                </nav>
            </div>
        </div>

    </div>

</div>

<AddProductModal @bind-IsVisible="showAddProductModal" OnProductAdded="OnProductAdded" Categorias="Categorias" Marcas="Marcas" />
<EditProductModal @bind-IsVisible="showEditProductModal" Product="selectedProduct" OnProductUpdated="OnProductUpdated" Categorias="Categorias" Marcas="Marcas" />

@code {
    private bool showAddProductModal = false;
    private bool showProfileDropdown = false;
    private List<Producto> Productos = new List<Producto>();
    private List<CategoriaProducto> Categorias = new();
    private List<Marca> Marcas = new();

    private int selectedCategoryId = 0;
    private int selectedBrandId = 0;
    private int selectedSkinTypeId = 0;
    private string searchTerm = string.Empty;

    private string URL_BASE = "http://localhost:8080/LuminaBeauty-Servicios/webresources";

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        var todosProductos = new HttpClientUtils<List<Producto>>().get(URL_BASE + "/ProductoRS");
        Marcas = new HttpClientUtils<List<Marca>>().get(URL_BASE + "");

        // Mapear los nombres de categoría y marca a los productos si los traen solo con ID
        foreach(var p in Productos)
        {
            if (p.Categoria != null) p.Categoria = Categorias.FirstOrDefault(c => c.Id == p.Categoria.Id);
            if (p.Marca != null) p.Marca = Marcas.FirstOrDefault(m => m.Id == p.Marca.Id);
        }
    }

    private void ToggleProfileDropdown()
    {
        showProfileDropdown = !showProfileDropdown;
    }

    private void OnCategoryChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            selectedCategoryId = id;
        }
    }

    private void OnBrandChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            selectedBrandId = id;
        }
    }

    private void OnSkinTypeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            selectedSkinTypeId = id;
        }
    }

    private string GetSkinTypeName(int id)
    {
        return id switch
        {
            1 => "Normal",
            2 => "Seca",
            3 => "Grasa",
            4 => "Mixta",
            _ => string.Empty,
        };
    }

    private void OpenAddProductModal()
    {
        showAddProductModal = true;
    }

    private IEnumerable<Producto> FilteredByCategory => selectedCategoryId == 0 ? Productos : Productos.Where(p => p.Categoria?.Id == selectedCategoryId);

    private IEnumerable<Producto> FilteredProducts => FilteredByCategory
        .Where(p => selectedBrandId == 0 || p.Marca?.Id == selectedBrandId)
        .Where(p => selectedSkinTypeId == 0 || (p.Tipo_piel != null && p.Tipo_piel.Equals(GetSkinTypeName(selectedSkinTypeId), StringComparison.OrdinalIgnoreCase)))
        .Where(p => string.IsNullOrWhiteSpace(searchTerm) || (p.Nombre != null && p.Nombre.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) || (p.Slug != null && p.Slug.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));

    private int ZeroStockCount => Productos.Count(p => p.Stock == 0);

    private async Task OnProductAdded(Producto newProduct)
    {
        showAddProductModal = false;
        await ProductoService.InsertarAsync(newProduct);
        await CargarDatos();
    }

    private bool showEditProductModal = false;
    private Producto selectedProduct = new Producto();

    private void EditProduct(Producto product)
    {
        showEditProductModal = true;
    }

    private async Task OnProductUpdated(Producto updatedProduct)
    {
        showEditProductModal = false;
        await ProductoService.ActualizarAsync(updatedProduct);
        await CargarDatos();
    }

    private async Task DeleteProduct(Producto product)
    {
        // En una app real, aquí se pondría un confirm de JS
        var exito = await ProductoService.EliminarAsync(product.Id_producto);
        if (exito)
        {
            await CargarDatos();
        }
    }
}
