@using SoluLumina.Models
@using Microsoft.AspNetCore.Components

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    [Parameter]
    public Product Product { get; set; } = new();

    [Parameter]
    public EventCallback<Product> OnProductUpdated { get; set; }

    private void Close()
    {
        IsVisible = false;
        IsVisibleChanged.InvokeAsync(IsVisible);
    }

    private async Task Save()
    {
        await OnProductUpdated.InvokeAsync(Product);
        Close();
    }
}

<div class="modal fade @(IsVisible ? "show d-block" : "")" tabindex="-1" style="background: rgba(0,0,0,0.5);">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar Producto</h5>
                <button type="button" class="btn-close" @onclick="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <input class="form-control" @bind="Product.Nombre" />
                </div>
                <div class="mb-3">
                    <label class="form-label">SKU</label>
                    <input class="form-control" @bind="Product.SKU" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Precio Venta</label>
                    <input type="number" step="0.01" class="form-control" @bind="Product.PrecioVenta" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Stock</label>
                    <input type="number" class="form-control" @bind="Product.Stock" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Tipo de Piel</label>
                    <input class="form-control" @bind="Product.TipoPiel" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Marca</label>
                    <input class="form-control" @bind="Product.Marca" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Categoría</label>
                    <input class="form-control" @bind="Product.Categoria" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="Close">Cancelar</button>
                <button class="btn btn-primary" @onclick="Save">Guardar</button>
            </div>
        </div>
    </div>
</div>
